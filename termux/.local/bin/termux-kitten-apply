#!/data/data/com.termux/files/usr/bin/bash
# Kitten TTS in the enclave (on-device consort voices)
# The consort voice family (Bella, Luna, Kiki, Jasper, Rosie — the pvox kitten bank) rendered fleet-side only, because kittentts pulls =misaki[en]= which pins Python ≤3.12 and bare Termux/Bionic cannot hold that stack. The enclave can: inside the Debian proot, stock manylinux aarch64 wheels (onnxruntime included) just work. This chapter, ruled 2026-08-17 ("my phone has more horsepower for rendering on device than the rest of the fleet" — and Q8 agrees: kitten ~0.4–0.9 RTF on the S24), installs a uv-managed Python 3.12 venv with the SAME kittentts 0.8.1 wheel the HelmCortex conda env pins, plus a one-shot synth script. The Termux-side speaker below splits the lanes on-device: render in the enclave (glibc), play through Termux's pulseaudio (sox) — same WAV-with-header law as the fleet.


# [[file:../../../package-termux.org::*Kitten TTS in the enclave (on-device consort voices)][Kitten TTS in the enclave (on-device consort voices):1]]
# ~/DotCortex/termux/.local/bin/termux-kitten-apply
set -euo pipefail

echo "== termux kitten apply (enclave) =="
command -v proot-distro >/dev/null || { echo "!! proot-distro missing — run termux-pkg-apply"; exit 1; }

proot-distro login debian -- bash -lc '
  set -e
  export PATH="$HOME/.local/bin:$PATH"
  command -v uv >/dev/null || { curl -LsSf https://astral.sh/uv/install.sh | sh; }
  export PATH="$HOME/.local/bin:$PATH"
  # proot forbids hardlinks (EPERM) — uv must copy out of its cache
  export UV_LINK_MODE=copy
  uv python install 3.12
  [ -x "$HOME/kitten-venv/bin/python" ] || uv venv --python 3.12 "$HOME/kitten-venv"
  # misaki pinned to the fleet-proven 0.9.4: unpinned, uv resolves a newer
  # misaki whose chain drags torch + nvidia wheels onto the phone (bitten
  # live 2026-08-17, 107-package resolution for a 25MB model). The conda
  # env runs kitten with misaki 0.9.4 and NO torch — mirror that truth.
  uv pip install --python "$HOME/kitten-venv/bin/python" \
    "misaki[en]==0.9.4" \
    "kittentts @ https://github.com/KittenML/KittenTTS/releases/download/0.8.1/kittentts-0.8.1-py3-none-any.whl"
  # the curated branch (misaki[en] -> spacy-curated-transformers ->
  # curated-transformers) DECLARES torch, but the kitten synth path never
  # imports it — the fleet conda env runs exactly this shape: curated pair
  # present, torch absent. Strip the dead weight (torch + nvidia + triton
  # is hundreds of MB of phone storage) to mirror the proven state.
  uv pip uninstall --python "$HOME/kitten-venv/bin/python" \
    torch triton $(uv pip list --python "$HOME/kitten-venv/bin/python" 2>/dev/null | awk "/^nvidia-/ {print \$1}") 2>/dev/null || true
  uv cache prune >/dev/null 2>&1 || true

  # one-shot synth: text on stdin, headered WAV on stdout (never raw PCM).
  # Sentence-chunked like the fleet daemon (kitten degrades on very long
  # single inputs); wordless chunks dropped and failed chunks skipped for now,
  # but every reply emits a chunk-count summary so a partial render cannot
  # masquerade as a complete one. Markdown
  # cleanup is NOT here: the caller (fleet hook) cleans via `pvox clean`,
  # one source of truth.
  cat > "$HOME/kitten-say.py" <<"PY"
import argparse, contextlib, io, os, re, sys, wave
import numpy as np

def chunks(s, maxc=300):
    parts = re.split(r"(?<=[\.\?\!])\s+", s)
    out, buf = [], ""
    for t in parts:
        t = t.strip()
        if not t:
            continue
        if len(buf) + len(t) + 1 <= maxc:
            buf = (buf + " " + t).strip() if buf else t
        else:
            if buf:
                out.append(buf)
            buf = t
            while len(buf) > maxc:
                out.append(buf[:maxc])
                buf = buf[maxc:]
    if buf:
        out.append(buf)
    return [c for c in out if re.search(r"\w", c)]

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--voice", default="Bella")
    ap.add_argument("--speed", type=float, default=1.0)
    ap.add_argument("--stream", action="store_true",
                    help="raw s16le 24k PCM to stdout per chunk (local pipe to a player with explicit rate flags)")
    args = ap.parse_args()
    text = sys.stdin.read().strip()
    if not text:
        return
    from kittentts import KittenTTS
    # fp32, NOT int8, on this phone — measured on the S24 2026-08-17:
    # int8 RTF 0.95 (playback catches the renderer -> audible gaps between
    # chunks), fp32 RTF 0.64 with identical 2.8s cached load. Q8 called it:
    # int8 quantization is SLOWER than full precision on ARM.
    m = KittenTTS(os.environ.get("KITTEN_MODEL", "KittenML/kitten-tts-nano-0.8-fp32"))
    reply_chunks = chunks(text)
    rendered = 0
    skipped = 0

    def report():
        print(
            f"[kitten-say] summary chunks={len(reply_chunks)} "
            f"rendered={rendered} skipped={skipped}",
            file=sys.stderr,
        )

    def synth(ck):
        try:
            # stdout is the audio transport in both stream and WAV modes.
            # KittenTTS 0.8.1 prints generation diagnostics to stdout, so
            # quarantine all library chatter on stderr or SoX interprets the
            # text bytes as signed 16-bit PCM (full-scale static).
            with contextlib.redirect_stdout(sys.stderr):
                try:
                    return m.generate(ck, voice=args.voice, speed=args.speed)
                except TypeError:
                    return m.generate(ck, voice=args.voice)
        except Exception as e:
            print(f"[kitten-say] chunk skipped ({e}): {ck[:60]!r}", file=sys.stderr)
            return None

    if args.stream:
        # streaming: each chunk plays while the next renders — first audio in
        # seconds instead of after the whole reply (RTF<1, so playback of one
        # chunk outlasts the render of the next and the lead only grows)
        for ck in reply_chunks:
            audio = synth(ck)
            if audio is None:
                skipped += 1
                continue
            rendered += 1
            pcm = np.clip(np.asarray(audio), -1.0, 1.0)
            sys.stdout.buffer.write((pcm * 32767).astype("<i2").tobytes())
            sys.stdout.buffer.flush()
        report()
        return

    pieces = []
    for ck in reply_chunks:
        audio = synth(ck)
        if audio is not None:
            rendered += 1
            pieces.append(np.asarray(audio))
        else:
            skipped += 1
    report()
    if not pieces:
        return
    pcm = np.clip(np.concatenate(pieces), -1.0, 1.0)
    pcm16 = (pcm * 32767).astype("<i2").tobytes()
    out = io.BytesIO()
    with wave.open(out, "wb") as w:
        w.setnchannels(1); w.setsampwidth(2); w.setframerate(24000)
        w.writeframes(pcm16)
    sys.stdout.buffer.write(out.getvalue())

if __name__ == "__main__":
    main()
PY
  # torch in this venv is always wrong (fleet parity: kitten runs without
  # it) — its presence means resolver drift or a polluted venv from a
  # failed round; fail loud instead of importing a broken half-install
  "$HOME/kitten-venv/bin/python" -c "
import importlib.util, sys
if importlib.util.find_spec(\"torch\"):
    sys.exit(\"!! torch present in kitten-venv — polluted or drifted; rm -rf ~/kitten-venv and re-run\")
"
  "$HOME/kitten-venv/bin/python" -c "import kittentts; print(\"kittentts importable\")"
'
echo "Done. Model downloads from HuggingFace on first synth. Test: echo hello | termux-kitten-say"
# Kitten TTS in the enclave (on-device consort voices):1 ends here
