#!/sbin/openrc-run
# Warm consort boot owner, multi-account (agents-codex-idle-supervisor.org,
# "Multi-account boot owner on OpenRC hosts"). Installed as
# /etc/init.d/claude-warm and /etc/init.d/codex-warm; instances are symlinks
# <kind>-warm.<account>. Per-instance values: /etc/conf.d/<kind>-warm.<account>.
# Re-install from DotCortex instead of editing this file.

warm_kind="${RC_SVCNAME%%-warm*}"
warm_instance=""
case "${RC_SVCNAME}" in
    *.*) warm_instance="${RC_SVCNAME#*.}" ;;
esac

# Instance defaults, derived from the service name; conf.d wins.
warm_user="${warm_user:-${warm_instance}}"
warm_socket="${warm_socket:-${warm_instance:+${warm_kind}-warm}}"
warm_session="${warm_session:-${warm_kind}-warm}"
xdg="${xdg:-/run/${RC_SVCNAME}}"
warm_pidfile="${warm_pidfile:-${xdg}/${RC_SVCNAME}.pid}"
warm_log="${warm_log:-/var/log/${RC_SVCNAME}.log}"
warm_log_mode="${warm_log_mode:-0640}"
warm_host="${warm_host:-$(hostname -s 2>/dev/null || hostname)}"
warm_agent="${warm_agent:-${warm_host}-${warm_kind}-${warm_user}}"
warm_args="${warm_args:-}"
# warm_path: empty = append ~/.local/bin to the login PATH; set = use exactly.
warm_path="${warm_path:-}"

name="${RC_SVCNAME}"
description="Warm ${warm_kind} consort for ${warm_user:-?} (PTY supervisor + idle auto-compaction)"

depend() {
    # Soft deps: Honey has no hard `net` service; `need net` fails there.
    use net dns
    after net elogind dbus
}

warm_home() { getent passwd "${warm_user}" | cut -d: -f6; }

# The account's stowed ~/.local/bin, else the host's root-owned system checkout
# (agents-bots-honey.org "Service lane"; agent accounts are not stowed), else
# the account's own DotCortex checkout.
warm_checkout="${warm_checkout:-/usr/local/share/dotcortex/DotCortex}"
warm_find_bin() {
    local home
    home="$(warm_home)"
    if [ -n "${warm_bin:-}" ]; then printf '%s' "${warm_bin}"
    elif [ -x "${home}/.local/bin/${warm_kind}-warm" ]; then printf '%s' "${home}/.local/bin/${warm_kind}-warm"
    elif [ -x "${warm_checkout}/all/.local/bin/${warm_kind}-warm" ]; then printf '%s' "${warm_checkout}/all/.local/bin/${warm_kind}-warm"
    else printf '%s' "${home}/DotCortex/all/.local/bin/${warm_kind}-warm"
    fi
}

warm_valid() {
    case "${warm_kind}" in
        claude|codex) ;;
        *) eerror "${RC_SVCNAME}: kind must be claude or codex"; return 1 ;;
    esac
    [ -n "${warm_user}" ] || { eerror "${RC_SVCNAME}: no account (use ${warm_kind}-warm.<account>, or set warm_user in /etc/conf.d/${RC_SVCNAME})"; return 1; }
    local uid
    uid="$(getent passwd "${warm_user}" | cut -d: -f3)"
    [ -n "${uid}" ] || { eerror "${RC_SVCNAME}: unknown account ${warm_user}"; return 1; }
    [ "${uid}" != 0 ] || { eerror "${RC_SVCNAME}: refusing to run a consort as root"; return 1; }
    warm_cwd="${warm_cwd:-$(warm_home)/metsatron-peer}"
    [ -d "${warm_cwd}" ] || { eerror "${RC_SVCNAME}: working dir ${warm_cwd} missing (set warm_cwd)"; return 1; }
    warm_bin="$(warm_find_bin)"
    [ -x "${warm_bin}" ] || { eerror "${RC_SVCNAME}: ${warm_bin} missing (set warm_bin)"; return 1; }
    return 0
}

warm_tmux() { printf 'tmux%s' "${warm_socket:+ -L '${warm_socket}'}"; }

# The supervisor's pid: the pid file the pane writes just before its exec
# (same pid), checked against the command line; else, for a supervisor started
# by a pre-body script, the account's process running this exact binary.
# Several supervisors of one kind can share an account (agents-bots-honey.org),
# so the pid file is the source of truth once the body has started it.
warm_pid() {
    local pid bin
    bin="$(warm_find_bin)"
    if [ -r "${warm_pidfile}" ]; then
        pid="$(cat "${warm_pidfile}" 2>/dev/null)"
        if [ -n "${pid}" ] && tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null | grep -qF "${bin}"; then
            printf '%s' "${pid}"; return 0
        fi
        return 1
    fi
    pgrep -u "${warm_user}" -f "${bin}" 2>/dev/null | head -n 1
}

start_pre() {
    warm_valid || return 1
    checkpath -d -m 0700 -o "${warm_user}:${warm_user}" "${xdg}"
    checkpath -f -m "${warm_log_mode}" -o "${warm_user}:${warm_user}" "${warm_log}"
}

start() {
    local env_path herdr=""
    warm_valid || return 1
    ebegin "Starting ${description} (tmux: ${warm_socket:-default}/${warm_session}, cwd: ${warm_cwd})"
    if [ -n "${warm_path}" ]; then env_path="'${warm_path}'"; else env_path="\"\${PATH}:\${HOME}/.local/bin\""; fi
    # Only claude-warm reads the Herdr name from the environment; codex-warm
    # carries its own HERDR_SOURCE.
    [ "${warm_kind}" = claude ] && herdr="CLAUDE_WARM_HERDR_AGENT='${warm_agent}'"
    # exec makes the pane's process the supervisor; the pid file names it.
    su -l "${warm_user}" -c "export XDG_RUNTIME_DIR='${xdg}' PATH=${env_path} ${herdr}; \
        $(warm_tmux) new-session -d -s '${warm_session}' -c '${warm_cwd}' \
        -e XDG_RUNTIME_DIR='${xdg}' -e PATH=\"\${PATH}\" ${herdr:+-e ${herdr}} \
        'echo \$\$ > ${warm_pidfile}; exec ${warm_bin} ${warm_args} >> ${warm_log} 2>&1'"
    eend $? "Failed to start ${RC_SVCNAME}"
}

stop() {
    local pid i=0
    ebegin "Stopping ${description}"
    [ -n "${warm_user}" ] || { eend 1 "no account"; return 1; }
    # The supervisor ignores SIGHUP and survives its pane: SIGTERM it by pid,
    # then tear down this instance's tmux session only.
    pid="$(warm_pid)"
    if [ -n "${pid}" ]; then
        kill -TERM "${pid}" 2>/dev/null
        while kill -0 "${pid}" 2>/dev/null && [ $i -lt 10 ]; do sleep 1; i=$((i+1)); done
        kill -0 "${pid}" 2>/dev/null && kill -KILL "${pid}" 2>/dev/null
    fi
    rm -f "${warm_pidfile}"
    su -l "${warm_user}" -c "$(warm_tmux) kill-session -t '${warm_session}'" 2>/dev/null
    eend 0
}

status() {
    local pid
    pid="$( [ -n "${warm_user}" ] && warm_pid )"
    if [ -n "${pid}" ]; then
        einfo "${RC_SVCNAME} supervisor is running as ${warm_user} (pid ${pid})"
        return 0
    fi
    einfo "${RC_SVCNAME} is not running"
    return 3
}
