#!/usr/bin/env bash
# [[file:../../../package-pip.org::*Nano Telegram idle-prompt admission][Nano Telegram idle-prompt admission:4]]
# ~/DotCortex/linux/.local/bin/nanobot-health
set -euo pipefail
case "${1:-}" in
    -h|--help)
        echo 'Usage: nanobot-health'
        echo 'Check pinned runtime and managed-file drift locally without downloads or installs.'
        exit 0 ;;
    '') [ "$#" -eq 0 ] || exit 2 ;;
    *) echo 'nanobot-health: unknown argument' >&2; exit 2 ;;
esac
script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
exec "$script_dir/nanobot-apply" --check
