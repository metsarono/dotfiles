def eprint(*args: Any, **kwargs: Any) -> None:
    print(*args, file=sys.stderr, **kwargs)


def load_dotenv_exports() -> dict[str, str]:
    path = os.path.expanduser("~/.env")
    exports: dict[str, str] = {}

    if not os.path.exists(path):
        return exports

    try:
        with open(path, "r", encoding="utf-8") as handle:
            for raw_line in handle:
                line = raw_line.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("export "):
                    line = line[7:].strip()
                if "=" not in line:
                    continue
                key, value = line.split("=", 1)
                key = key.strip()
                value = value.strip()
                if not key:
                    continue
                if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                    value = value[1:-1]
                exports.setdefault(key, value)
    except OSError:
        return {}

    return exports


def nested_get(obj: Any, *path: str) -> Any:
    cur = obj
    for key in path:
        if not isinstance(cur, dict) or key not in cur:
            return None
        cur = cur[key]
    return cur


def compact_json(obj: Any, limit: int = 240) -> str:
    text = json.dumps(obj, ensure_ascii=True, sort_keys=True, separators=(",", ":"))
    if len(text) <= limit:
        return text
    return text[: limit - 3] + "..."


def strip_ansi_codes(text: str) -> str:
    return ANSI_ESCAPE_RE.sub("", text).replace("\r", "\n")


def last_meaningful_line(*texts: str) -> str:
    for text in texts:
        for line in text.splitlines():
            line = line.strip()
            if line:
                return line
    return ""


def parse_json_docs(text: str) -> list[Any]:
    text = text.strip()
    if not text:
        return []

    try:
        return [json.loads(text)]
    except json.JSONDecodeError:
        pass

    docs: list[Any] = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line[0] not in "[{":
            continue
        try:
            docs.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return docs


def first_item(doc: Any) -> Any:
    if isinstance(doc, list):
        return doc[0] if doc else None
    return doc


def choose_provider_doc(docs: list[Any], provider: str | None) -> Any:
    if provider:
        for doc in docs:
            item = first_item(doc)
            if isinstance(item, dict) and item.get("provider") == provider:
                return item
    return first_item(docs[0]) if docs else None


def requested_source(spec: ProviderSpec) -> str:
    args = list(spec.codexbar_args)
    if "--source" in args:
        index = args.index("--source")
        if index + 1 < len(args):
            return args[index + 1]
    return "auto"


def requested_fuelcheck_source(spec: ProviderSpec) -> str:
    args = list(spec.fuelcheck_args)
    if "--source" in args:
        index = args.index("--source")
        if index + 1 < len(args):
            return args[index + 1]
    return "auto"


def claude_cookie_env() -> dict[str, str]:
    if os.environ.get("CLAUDE_COOKIE") or load_dotenv_exports().get("CLAUDE_COOKIE"):
        return {}

    cookie_path = Path.home() / ".config" / "Claude" / "Cookies"
    if not cookie_path.exists():
        return {}

    try:
        conn = sqlite3.connect(f"file:{cookie_path}?mode=ro", uri=True)
    except sqlite3.Error:
        return {}

    try:
        now_chrome = int((time.time() + 11644473600) * 1000000)
        rows = conn.execute(
            """
            select name, value, expires_utc
              from cookies
             where host_key in ('claude.ai', '.claude.ai')
               and value != ''
             order by case name when 'sessionKey' then 0 else 1 end, name
            """
        ).fetchall()
    except sqlite3.Error:
        return {}
    finally:
        conn.close()

    parts: list[str] = []
    for name, value, expires_utc in rows:
        if not isinstance(name, str) or not isinstance(value, str):
            continue
        try:
            expires = int(expires_utc)
        except (TypeError, ValueError):
            expires = 0
        if expires and expires <= now_chrome:
            continue
        parts.append(f"{name}={value}")

    if not any(part.startswith("sessionKey=") for part in parts):
        return {}
    return {"CLAUDE_COOKIE": "; ".join(parts)}


def gemini_cli_oauth_env() -> dict[str, str]:
    home = Path.home()
    search_roots = [
        home / ".npm-global" / "lib" / "node_modules",
        home / ".npm-global" / "lib",
        home / ".nvm" / "versions",
    ]

    client_id = None
    client_secret = None
    pattern_id = re.compile(r"const OAUTH_CLIENT_ID = '([^']+)';")
    pattern_secret = re.compile(r"const OAUTH_CLIENT_SECRET = '([^']+)';")

    for root in search_roots:
        if not root.exists():
            continue
        for oauth2_path in root.rglob("oauth2.js"):
            path_text = str(oauth2_path)
            if "@google/gemini-cli-core" not in path_text or "code_assist" not in path_text:
                continue
            try:
                source = oauth2_path.read_text(encoding="utf-8")
            except OSError:
                continue
            id_match = pattern_id.search(source)
            secret_match = pattern_secret.search(source)
            if id_match and secret_match:
                client_id = id_match.group(1)
                client_secret = secret_match.group(1)
                break
        if client_id and client_secret:
            break

    if client_id and client_secret:
        return {
            "GEMINI_OAUTH_CLIENT_ID": client_id,
            "GEMINI_OAUTH_CLIENT_SECRET": client_secret,
        }

    return {}


def parse_iso_datetime(value: str | None) -> datetime | None:
    if not value or not isinstance(value, str):
        return None

    text = value.strip()
    if not text:
        return None

    if text.endswith("Z"):
        text = text[:-1] + "+00:00"

    try:
        dt = datetime.fromisoformat(text)
    except ValueError:
        return None

    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt


def format_absolute_reset(value: str | None) -> str | None:
    dt = parse_iso_datetime(value)
    if not dt:
        return None
    local_dt = dt.astimezone()
    now = datetime.now().astimezone()
    if local_dt.date() == now.date():
        return local_dt.strftime("%-I:%M %p")
    return local_dt.strftime("%-d %b %Y at %-I:%M %p")


def format_countdown(value: str | None) -> str | None:
    dt = parse_iso_datetime(value)
    if not dt:
        return None
    delta = dt - datetime.now(timezone.utc)
    seconds = max(0, int(delta.total_seconds()))
    days, rem = divmod(seconds, 86400)
    hours, rem = divmod(rem, 3600)
    minutes = rem // 60
    if days:
        return f"{days}d {hours}h {minutes}m"
    if hours:
        return f"{hours}h {minutes}m"
    return f"{minutes}m"


def extract_reset_hint(raw_text: str | None, label: str) -> str | None:
    if not raw_text:
        return None

    lines = raw_text.splitlines()
    label_lc = label.lower()
    for line in lines:
        clean = " ".join(line.split())
        clean_lc = clean.lower()
        if label_lc == "5h":
            matches_label = clean_lc.startswith("5h") or "session" in clean_lc
        else:
            matches_label = clean_lc.startswith(("1w", "wk")) or "weekly" in clean_lc
        if not matches_label:
            continue

        match = re.search(r"resets?\s+(.*?)(?:\)|$)", clean, flags=re.IGNORECASE)
        if match:
            return match.group(1).strip()

    return None


def format_minutes_window(value: Any) -> str | None:
    if not isinstance(value, (int, float)):
        return None
    minutes = int(value)
    if minutes % (60 * 24 * 7) == 0 and minutes >= 60 * 24 * 7:
        weeks = minutes // (60 * 24 * 7)
        return f"{weeks}w"
    if minutes % (60 * 24) == 0 and minutes >= 60 * 24:
        days = minutes // (60 * 24)
        return f"{days}d"
    if minutes % 60 == 0 and minutes >= 60:
        hours = minutes // 60
        return f"{hours}h"
    return f"{minutes}m"


def detect_windows(item: dict[str, Any]) -> list[tuple[str, dict[str, Any]]]:
    usage = item.get("usage") if isinstance(item.get("usage"), dict) else item
    windows: list[tuple[str, dict[str, Any]]] = []
    primary = nested_get(usage, "primary")
    secondary = nested_get(usage, "secondary")
    if isinstance(primary, dict) and primary:
        windows.append(("Current", primary))
    if isinstance(secondary, dict) and secondary:
        windows.append(("Secondary", secondary))
    return windows


def format_percent(value: Any) -> str | None:
    if not isinstance(value, (int, float)):
        return None
    pct = max(0.0, min(100.0, float(value)))
    return f"{pct:.0f}%"


def format_bar(pct: float, width: int = 10, color: str | None = None) -> str:
    total_width = max(2, width)
    inner_width = total_width - 2
    filled = round((pct / 100.0) * inner_width)
    filled = max(0, min(inner_width, filled))
    bar_color = color or (GR if pct >= 99.5 else (YL if pct >= 40 else RD))
    empty = inner_width - filled
    return f"{bar_color}{'█' * filled}{BAR_BG}{'█' * empty}{R}"


def format_reset_line(value: str | None) -> str:
    absolute = format_absolute_reset(value)
    countdown = format_countdown(value)
    if absolute and countdown:
        if absolute in countdown:
            return f"{FGY}{NF['hourglass']} {absolute}{R}"
        return f"{FGY}{NF['hourglass']} {absolute} ({countdown}){R}"
    if absolute:
        return f"{FGY}{NF['hourglass']} {absolute}{R}"
    if countdown:
        return f"{FGY}{NF['hourglass']} {countdown}{R}"
    return f"{FGY}{NF['hourglass']} —{R}"


def format_quota_line(label: str, quota: dict[str, Any]) -> str | None:
    pct = quota.get("usedPercent")
    if not isinstance(pct, (int, float)):
        pct = quota.get("remainingFraction")
        if isinstance(pct, (int, float)):
            pct = (1.0 - float(pct)) * 100.0
    if not isinstance(pct, (int, float)):
        return None

    used = format_percent(pct)
    window = format_minutes_window(quota.get("windowMinutes"))
    reset_desc = quota.get("resetDescription")
    resets_at = quota.get("resetsAt")
    if isinstance(reset_desc, str) and reset_desc:
        reset = reset_desc
    elif isinstance(resets_at, str) and resets_at:
        absolute = format_absolute_reset(resets_at)
        reset = absolute or resets_at
    else:
        reset = ""

    parts = [f"{label}: {used} used"]
    if window:
        parts.append(f"of {window} window")
    if reset:
        parts.append(f"resets {reset}")
    return "  " + ", ".join(parts)


def format_window_line(label: str, window_data: dict[str, Any]) -> str | None:
    if not isinstance(window_data, dict):
        return None

    used = window_data.get("usedPercent")
    if not isinstance(used, (int, float)):
        remaining = window_data.get("remainingFraction")
        if isinstance(remaining, (int, float)):
            used = (1.0 - float(remaining)) * 100.0
    if not isinstance(used, (int, float)):
        return None

    parts = [f"{label}: {format_percent(used)} used"]
    window = format_minutes_window(window_data.get("windowMinutes"))
    if window:
        parts.append(f"of {window} window")

    reset_desc = window_data.get("resetDescription")
    resets_at = window_data.get("resetsAt")
    if isinstance(reset_desc, str) and reset_desc:
        parts.append(f"resets {reset_desc}")
    elif isinstance(resets_at, str) and resets_at:
        absolute = format_absolute_reset(resets_at)
        countdown = format_countdown(resets_at)
        if absolute and countdown:
            parts.append(f"resets {absolute} ({countdown})")
        elif absolute:
            parts.append(f"resets {absolute}")
        elif countdown:
            parts.append(f"resets {countdown}")
    return "  " + ", ".join(parts)


def format_antigravity_models(snapshot: dict[str, Any], width: int | None = None) -> list[str]:
    models = snapshot.get("models")
    if not isinstance(models, list) or not models:
        return []

    table_width = width or terminal_width()
    label_width = max(18, min(24, table_width - 44))
    header = f"  {FGY}{'Model':<{label_width}} Remaining                Resets In{R}"
    lines = [header]

    for model in models:
        if not isinstance(model, dict):
            continue
        label = str(model.get("name") or model.get("label") or model.get("modelId") or "Unknown")
        remaining = model.get("percentage")
        if not isinstance(remaining, (int, float)):
            remaining = model.get("remainingPercentage")
        if not isinstance(remaining, (int, float)):
            remaining = model.get("remainingFraction")

        if isinstance(remaining, (int, float)):
            pct = float(remaining)
            if pct <= 1.0:
                pct *= 100.0
            remaining_text = f"{round(pct):>3d}%"
            bar = format_bar(pct, 20)
        else:
            remaining_text = "  ?%"
            bar = format_bar(0.0, 20)
        reset_value = model.get("resetTime")
        if isinstance(reset_value, str) and reset_value.strip():
            reset_text = format_countdown(reset_value) or reset_value.strip()
        else:
            reset_text = "?"
        lines.append(f"  {FGY}{label[:label_width]:<{label_width}}{R} {bar} {remaining_text:>3}  {FGY}{NF['hourglass']} {reset_text}{R}")

    return lines


def format_gemini_buckets(account_quota: dict[str, Any], width: int | None = None) -> list[str]:
    buckets = account_quota.get("buckets")
    if not isinstance(buckets, list) or not buckets:
        return []

    table_width = width or terminal_width()
    label_width = max(18, min(24, table_width - 44))
    lines = [f"  {FGY}{'Model':<{label_width}} Remaining                Resets In{R}"]
    for bucket in buckets:
        if not isinstance(bucket, dict):
            continue
        label = str(bucket.get("model") or bucket.get("label") or "Unknown")
        if "pro" in label.lower():
            continue
        used_pct = bucket.get("used_pct")
        remaining_fraction = bucket.get("remaining_fraction")
        if remaining_fraction is None:
            remaining_fraction = bucket.get("remainingFraction")
        if used_pct is None:
            used_pct = bucket.get("usedPercent")
        remaining_pct = None
        if isinstance(remaining_fraction, (int, float)):
            remaining_pct = round((float(remaining_fraction) * 100))
        elif isinstance(used_pct, (int, float)):
            remaining_pct = round(max(0.0, 100.0 - float(used_pct)))

        if remaining_pct is None:
            remaining_pct = 0
        bar = format_bar(float(remaining_pct), 20)

        reset_text = format_countdown(bucket.get("reset_time")) or "?"
        reset_text = reset_text.replace(f"{FGY}{NF['hourglass']} ", "").replace(R, "")
        lines.append(f"  {FGY}{label[:label_width]:<{label_width}}{R} {bar} {remaining_pct:>3d}%  {FGY}{NF['hourglass']} {reset_text}{R}")

    return lines


def quota_remaining_fraction(quota: dict[str, Any]) -> float | None:
    remaining = quota.get("remainingFraction")
    if isinstance(remaining, (int, float)):
        return max(0.0, min(1.0, float(remaining)))

    used = quota.get("usedPercent")
    if isinstance(used, (int, float)):
        return max(0.0, min(1.0, 1.0 - (float(used) / 100.0)))

    return None


def quota_display_label(provider_key: str, index: int, quota: dict[str, Any]) -> str:
    label = quota.get("label")
    if isinstance(label, str) and label:
        return label

    window = format_minutes_window(quota.get("windowMinutes"))
    if window:
        if provider_key == "claude" and index == 0 and window == "5h":
            return "5h"
        return window

    if provider_key == "claude" and index == 0:
        return "5h"
    if index == 1:
        return "wk"
    return "Current" if index == 0 else "Weekly"


def format_compact_quota_line(label: str, quota: dict[str, Any]) -> str | None:
    remaining_fraction = quota_remaining_fraction(quota)
    if remaining_fraction is None:
        return None

    bar = format_bar(remaining_fraction * 100.0, 20)
    remaining_pct = round(remaining_fraction * 100)
    reset_at = quota.get("resetTime") or quota.get("resetsAt")
    reset = format_countdown(reset_at) if isinstance(reset_at, str) else None
    reset_text = f"  {FGY}{NF['hourglass']} {reset}{R}" if reset else ""
    return f"  {FGY}{label:<8}{R} {bar} {remaining_pct:>3d}%{reset_text}"


def format_codex_status_line(label: str, pct_left: Any, raw: dict[str, Any]) -> str | None:
    if not isinstance(pct_left, (int, float)):
        return None

    remaining_pct = max(0.0, min(100.0, float(pct_left)))
    bar = format_bar(remaining_pct, 20)
    reset_text: str | None = None
    if label in {"1w", "wk"}:
        weekly_reset = raw.get("weeklyResetDescription")
        if isinstance(weekly_reset, str) and weekly_reset:
            reset_text = weekly_reset
        else:
            weekly_reset_at = raw.get("weeklyResetsAt")
            if isinstance(weekly_reset_at, str):
                reset_text = format_countdown(weekly_reset_at)
    else:
        raw_text = raw.get("rawText")
        if isinstance(raw_text, str):
            reset_text = extract_reset_hint(raw_text, label)

    reset_suffix = f"  {FGY}{NF['hourglass']} {reset_text}{R}" if reset_text else ""
    return f"  {FGY}{label:<8}{R} {bar} {round(remaining_pct):>3d}%{reset_suffix}"


def expiry_week_percent(value: str | None, now: datetime | None = None) -> float | None:
    expiry = parse_iso_datetime(value)
    if not expiry:
        return None

    current = now or datetime.now(timezone.utc)
    seconds_left = max(
        0.0,
        min(float(7 * 24 * 60 * 60), (expiry - current).total_seconds()),
    )
    return (seconds_left / (7 * 24 * 60 * 60)) * 100.0


def format_codex_reset_credit_lines(raw: dict[str, Any]) -> list[str]:
    reset_credits = raw.get("resetCredits")
    if not isinstance(reset_credits, dict):
        error = raw.get("resetCreditsError")
        if isinstance(error, str) and error:
            bar = format_bar(0.0, 20, color=RD)
            return [
                f"  {FGY}{'banked':<8}{R} {bar}   ?  "
                f"{RD}{NF['hourglass']} unavailable ({error}){R}"
            ]
        return []

    credits = reset_credits.get("credits")
    if not isinstance(credits, list):
        credits = []

    available = reset_credits.get("availableCount")
    if not isinstance(available, int) or isinstance(available, bool):
        available = sum(
            1
            for credit in credits
            if isinstance(credit, dict) and credit.get("status") == "available"
        )

    available_credits = [
        credit
        for credit in credits
        if isinstance(credit, dict) and credit.get("status") == "available"
    ]
    available_credits.sort(key=lambda credit: str(credit.get("expiresAt") or ""))

    if not available_credits:
        bar = format_bar(0.0, 20)
        return [f"  {FGY}{'banked':<8}{R} {bar}   0"]

    lines: list[str] = []
    for index, credit in enumerate(available_credits, start=1):
        expires_at = credit.get("expiresAt")
        expiry_text = expires_at if isinstance(expires_at, str) else None
        pct = expiry_week_percent(expiry_text)
        countdown = format_countdown(expiry_text) or "?"
        if pct is None:
            bar = format_bar(0.0, 20, color=RD)
            pct_text = "  ?%"
        else:
            bar = format_bar(pct, 20)
            pct_text = f"{round(pct):>3d}%"
        lines.append(
            f"  {FGY}{f'bank {index}':<8}{R} {bar} {pct_text}  "
            f"{FGY}{NF['hourglass']} {countdown}{R}"
        )

    return lines


def week_of_year_label(value: str | None) -> str | None:
    dt = parse_iso_datetime(value)
    if not dt:
        return None
    return str(dt.astimezone().isocalendar().week)


def format_window_left_line(
    label: str,
    reset_at: str | None,
    window_minutes: Any = None,
    now: datetime | None = None,
) -> str | None:
    dt = parse_iso_datetime(reset_at)
    if not dt:
        return None

    if not isinstance(window_minutes, (int, float)) or isinstance(window_minutes, bool) or window_minutes <= 0:
        window_minutes = 7 * 24 * 60

    window_seconds = float(window_minutes) * 60.0
    current = now or datetime.now(timezone.utc)
    delta = dt - current.astimezone(timezone.utc)
    seconds = max(0.0, min(window_seconds, delta.total_seconds()))
    pct_left = round((seconds / window_seconds) * 100.0)
    bar = format_bar(float(pct_left), 20, color=IB)

    window_label = format_minutes_window(window_minutes)
    if window_label != "1w":
        cycle = window_label or "quota"
        return f"  {FGY}{label:<8}{R} {bar} {FGY}{pct_left:>3d}% of {cycle} cycle{R}"

    week_no = week_of_year_label(reset_at)
    if not week_no:
        return None
    return f"  {FGY}{label:<8}{R} {bar} {FGY}{pct_left:>3d}% of week {week_no}{R}"


def print_fitted_text(text: str, *, indent: str, width: int, color: str = FGY, dim: bool = True) -> None:
    clean = " ".join(str(text).split())
    if not clean:
        return

    fit_width = max(12, width - len(indent) - 2)
    prefix = f"{indent}{color}{DIM if dim else ''}"
    suffix = R
    if len(clean) > fit_width:
        clean = clean[: max(0, fit_width - 1)] + "…"
    print(f"{prefix}{clean}{suffix}")


def summarize_usage(item: dict[str, Any]) -> str:
    if isinstance(item.get("error"), str):
        return str(item["error"])

    if isinstance(item.get("message"), str) and item.get("status") == "error":
        return str(item["message"])

    usage = item.get("usage") if isinstance(item.get("usage"), dict) else item
    primary = nested_get(usage, "primary") or {}
    secondary = nested_get(usage, "secondary") or {}
    identity = nested_get(usage, "identity") or nested_get(item, "identity") or {}

    parts: list[str] = []

    used = primary.get("usedPercent")
    if isinstance(used, (int, float)):
        parts.append(f"{used:g}% used")

    window_minutes = primary.get("windowMinutes")
    if isinstance(window_minutes, (int, float)):
        parts.append(f"{int(window_minutes)}m window")

    reset_description = primary.get("resetDescription")
    if isinstance(reset_description, str) and reset_description:
        parts.append(reset_description)
    else:
        resets_at = primary.get("resetsAt")
        if isinstance(resets_at, str) and resets_at:
            parts.append(f"resets {resets_at}")

    secondary_used = secondary.get("usedPercent")
    if isinstance(secondary_used, (int, float)):
        parts.append(f"secondary {secondary_used:g}%")

    for key in (
        "creditsRemaining",
        "remainingCredits",
        "remaining",
        "balance",
        "keyUsage",
    ):
        value = usage.get(key)
        if isinstance(value, (int, float)):
            parts.append(f"{key}={value:g}")
            break

    openrouter_usage = usage.get("openRouterUsage")
    if isinstance(openrouter_usage, dict):
        balance = openrouter_usage.get("balance")
        key_usage = openrouter_usage.get("keyUsage")
        if isinstance(balance, (int, float)):
            parts.append(f"balance=${balance:g}")
        if isinstance(key_usage, (int, float)):
            parts.append(f"keyUsage=${key_usage:g}")

    if isinstance(identity, dict):
        for key in ("plan", "email", "org", "loginMethod", "providerID"):
            value = identity.get(key)
            if isinstance(value, str) and value:
                parts.append(f"{key}={value}")
                break

    if parts:
        return "; ".join(parts)

    return compact_json(item)


def run_command(
    cmd: list[str],
    timeout_seconds: float,
    extra_env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    env = os.environ.copy()
    env["HOME"] = os.path.expanduser("~")
    env.update({k: v for k, v in load_dotenv_exports().items() if k not in env})
    if extra_env:
        env.update(extra_env)
    return subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        timeout=timeout_seconds,
        env=env,
    )


def codexbar_path() -> list[str] | None:
    home = os.path.expanduser("~")
    brew_env = os.path.join(home, "DotCortex", "all", ".local", "bin", "dotcortex-brew-env")
    if os.path.exists(brew_env):
        return [brew_env, "codexbar"]
    if shutil.which("codexbar"):
        return ["codexbar"]
    return None


def codex_auth_tokens() -> tuple[str | None, str | None]:
    try:
        data = json.loads(CODEX_AUTH_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None, None

    tokens = data.get("tokens") if isinstance(data, dict) else None
    if not isinstance(tokens, dict):
        return None, None

    access_token = tokens.get("access_token")
    account_id = tokens.get("account_id")
    if not isinstance(access_token, str) or not access_token:
        access_token = None
    if not isinstance(account_id, str) or not account_id:
        account_id = None
    return access_token, account_id


def fetch_codex_reset_credits(timeout_seconds: float) -> tuple[dict[str, Any] | None, str | None]:
    access_token, account_id = codex_auth_tokens()
    if not access_token or not account_id:
        return None, "Codex auth tokens unavailable"

    request = urllib.request.Request(
        CODEX_RESET_CREDITS_URL,
        headers={
            "Authorization": f"Bearer {access_token}",
            "ChatGPT-Account-ID": account_id,
            "Accept": "application/json",
            "User-Agent": "DotCortex ai-usage",
        },
    )

    try:
        with urllib.request.urlopen(request, timeout=timeout_seconds) as response:
            data = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        return None, f"HTTP {error.code}"
    except urllib.error.URLError as error:
        return None, f"request failed: {error.reason}"
    except (TimeoutError, ValueError):
        return None, "invalid or timed-out response"

    if not isinstance(data, dict) or not isinstance(data.get("credits"), list):
        return None, "unexpected response shape"

    credits: list[dict[str, Any]] = []
    for credit in data["credits"]:
        if not isinstance(credit, dict):
            continue
        credits.append(
            {
                "resetType": credit.get("reset_type"),
                "status": credit.get("status"),
                "expiresAt": credit.get("expires_at"),
            }
        )

    available_count = data.get("available_count")
    if not isinstance(available_count, int) or isinstance(available_count, bool):
        available_count = sum(1 for credit in credits if credit.get("status") == "available")

    total_earned_count = data.get("total_earned_count")
    if not isinstance(total_earned_count, int) or isinstance(total_earned_count, bool):
        total_earned_count = None

    return {
        "availableCount": available_count,
        "totalEarnedCount": total_earned_count,
        "credits": credits,
    }, None


def enrich_codex_reset_credits(
    result: dict[str, Any],
    timeout_seconds: float,
) -> dict[str, Any]:
    reset_credits, error = fetch_codex_reset_credits(timeout_seconds)
    raw = result.get("raw")
    if not isinstance(raw, dict):
        raw = {}
    else:
        raw = dict(raw)

    if reset_credits is not None:
        raw["resetCredits"] = reset_credits
        raw.pop("resetCreditsError", None)
    elif error:
        raw["resetCreditsError"] = error

    result = dict(result)
    result["raw"] = raw
    return result


def _codex_epoch_to_iso(value: Any) -> str | None:
    if isinstance(value, (int, float)) and not isinstance(value, bool) and value > 0:
        return datetime.fromtimestamp(float(value), tz=timezone.utc).isoformat()
    return None


def _codex_window_to_quota(window: Any) -> dict[str, Any] | None:
    if not isinstance(window, dict):
        return None
    pct = window.get("used_percent")
    if not isinstance(pct, (int, float)) or isinstance(pct, bool):
        return None
    quota: dict[str, Any] = {"usedPercent": float(pct)}
    secs = window.get("limit_window_seconds")
    if isinstance(secs, (int, float)) and not isinstance(secs, bool) and secs > 0:
        quota["windowMinutes"] = int(secs) // 60
    iso = _codex_epoch_to_iso(window.get("reset_at"))
    if iso:
        quota["resetsAt"] = iso
    return quota


def build_codex_native_result(spec: ProviderSpec, data: dict[str, Any]) -> dict[str, Any]:
    rate_limit = data.get("rate_limit") if isinstance(data.get("rate_limit"), dict) else {}
    windows: list[dict[str, Any]] = []
    for key in ("primary_window", "secondary_window"):
        quota = _codex_window_to_quota(rate_limit.get(key))
        if quota:
            windows.append(quota)
    # Order by window length so the short (5h-ish) window renders first and the longer
    # allowance window second, regardless of whether that allowance is weekly, monthly,
    # or another duration returned by the API, and regardless of which API slot carries it.
    windows.sort(key=lambda q: q.get("windowMinutes", 1 << 30))
    usage: dict[str, Any] = {}
    if len(windows) >= 2:
        usage["primary"] = windows[0]
        usage["secondary"] = windows[-1]
    elif len(windows) == 1:
        only = windows[0]
        if only.get("windowMinutes", 0) >= 24 * 60:
            usage["secondary"] = only  # a lone long allowance belongs in the second slot
        else:
            usage["primary"] = only

    identity: dict[str, Any] = {}
    plan = data.get("plan_type")
    if isinstance(plan, str) and plan:
        identity["plan"] = plan
    email = data.get("email")
    if isinstance(email, str) and email:
        identity["email"] = email
    if identity:
        usage["identity"] = identity

    raw: dict[str, Any] = {"provider": "codex", "source": "codex-native", "usage": usage}

    if usage.get("secondary", {}).get("usedPercent") is not None:
        secondary = usage["secondary"]
        period = format_minutes_window(secondary.get("windowMinutes"))
        period_label = "weekly" if period == "1w" else (period or "allowance")
        summary = f"{period_label} {format_percent(secondary['usedPercent'])}"
    elif usage.get("primary", {}).get("usedPercent") is not None:
        summary = f"{format_percent(usage['primary']['usedPercent'])}"
    else:
        summary = "Codex usage"
    if isinstance(plan, str) and plan:
        summary += f"; plan={plan}"

    return {
        "provider": spec.key,
        "label": spec.label,
        "state": "ok",
        "source": "codex-native",
        "summary": summary,
        "raw": raw,
    }


def fetch_codex_native(spec: ProviderSpec, timeout_seconds: float) -> dict[str, Any]:
    access_token, account_id = codex_auth_tokens()
    if not access_token or not account_id:
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "missing",
            "source": "",
            "summary": "Codex auth tokens unavailable (~/.codex/auth.json).",
            "raw": None,
        }

    request = urllib.request.Request(
        CODEX_USAGE_URL,
        headers={
            "Authorization": f"Bearer {access_token}",
            "ChatGPT-Account-ID": account_id,
            "Accept": "application/json",
            "User-Agent": "DotCortex ai-usage",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout_seconds) as response:
            data = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        return {
            "provider": spec.key, "label": spec.label, "state": "error",
            "source": "codex-native", "summary": f"HTTP {error.code}", "raw": None,
        }
    except urllib.error.URLError as error:
        return {
            "provider": spec.key, "label": spec.label, "state": "error",
            "source": "codex-native", "summary": f"request failed: {error.reason}", "raw": None,
        }
    except (TimeoutError, ValueError):
        return {
            "provider": spec.key, "label": spec.label, "state": "error",
            "source": "codex-native", "summary": "invalid or timed-out response", "raw": None,
        }
    if not isinstance(data, dict) or not isinstance(data.get("rate_limit"), dict):
        return {
            "provider": spec.key, "label": spec.label, "state": "error",
            "source": "codex-native", "summary": "unexpected response shape", "raw": None,
        }
    return build_codex_native_result(spec, data)


def fetch_codexbar(spec: ProviderSpec, timeout_seconds: float) -> dict[str, Any]:
    base = codexbar_path()
    if not base:
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "missing",
            "source": "",
            "summary": "codexbar is not installed or not reachable.",
            "raw": None,
        }

    cmd = base + [
        "usage",
        "--provider",
        spec.codexbar_provider or spec.key,
        "--json-only",
        *spec.codexbar_args,
    ]

    try:
        proc = run_command(cmd, timeout_seconds)
    except subprocess.TimeoutExpired:
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "timeout",
            "source": requested_source(spec),
            "summary": f"Timed out after {timeout_seconds:g}s waiting for codexbar.",
            "raw": None,
        }

    docs = parse_json_docs(proc.stdout)
    item = choose_provider_doc(docs, spec.codexbar_provider or spec.key)

    if isinstance(item, dict) and isinstance(item.get("error"), dict):
        error = item["error"]
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "error",
            "source": item.get("source", ""),
            "summary": error.get("message", "Provider error"),
            "raw": item,
        }

    if isinstance(item, dict):
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "ok",
            "source": item.get("source", "") or requested_source(spec),
            "summary": summarize_usage(item),
            "raw": item,
        }

    summary = last_meaningful_line(proc.stdout, proc.stderr)
    return {
        "provider": spec.key,
        "label": spec.label,
        "state": "error" if proc.returncode else "ok",
        "source": requested_source(spec) if proc.returncode else "",
        "summary": summary or "No JSON payload returned by codexbar.",
        "raw": None,
    }


def fetch_fuelcheck(spec: ProviderSpec, timeout_seconds: float) -> dict[str, Any]:
    exe = shutil.which("fuelcheck-cli")
    if not exe:
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "missing",
            "source": "",
            "summary": "fuelcheck-cli is not installed or not reachable.",
            "raw": None,
        }

    provider = spec.fuelcheck_provider or spec.key
    source_args_list: list[tuple[str, ...]] = [spec.fuelcheck_args]
    if spec.key == "claude":
        source_args_list = [("--source", "web"), ("--source", "oauth")]

    last_error: dict[str, Any] | None = None
    for source_args in source_args_list:
        cmd = [exe, "usage", "--provider", provider, "--json-only", *source_args]
        extra_env = (
            claude_cookie_env()
            if spec.key == "claude" and len(source_args) > 1 and source_args[1] == "web"
            else None
        )

        try:
            proc = run_command(cmd, timeout_seconds, extra_env=extra_env)
        except subprocess.TimeoutExpired:
            return {
                "provider": spec.key,
                "label": spec.label,
                "state": "timeout",
                "source": source_args[1] if len(source_args) > 1 else requested_fuelcheck_source(spec),
                "summary": f"Timed out after {timeout_seconds:g}s waiting for fuelcheck-cli.",
                "raw": None,
            }

        docs = parse_json_docs(proc.stdout)
        item = choose_provider_doc(docs, provider)

        if isinstance(item, dict):
            error = item.get("error")
            if isinstance(error, dict):
                message = error.get("message") or compact_json(error)
                last_error = {
                    "provider": spec.key,
                    "label": spec.label,
                    "state": "error",
                    "source": item.get("source", "") or (source_args[1] if len(source_args) > 1 else requested_fuelcheck_source(spec)),
                    "summary": message,
                    "raw": item,
                }
                continue
            if isinstance(error, str):
                last_error = {
                    "provider": spec.key,
                    "label": spec.label,
                    "state": "error",
                    "source": item.get("source", "") or (source_args[1] if len(source_args) > 1 else requested_fuelcheck_source(spec)),
                    "summary": error,
                    "raw": item,
                }
                continue
            if item.get("status") == "error":
                last_error = {
                    "provider": spec.key,
                    "label": spec.label,
                    "state": "error",
                    "source": item.get("source", "") or (source_args[1] if len(source_args) > 1 else requested_fuelcheck_source(spec)),
                    "summary": str(item.get("message") or compact_json(item)),
                    "raw": item,
                }
                continue

            return {
                "provider": spec.key,
                "label": spec.label,
                "state": "ok",
                "source": item.get("source", "") or (source_args[1] if len(source_args) > 1 else requested_fuelcheck_source(spec)),
                "summary": summarize_usage(item),
                "raw": item,
            }

    if last_error is not None:
        return last_error

    summary = last_meaningful_line(proc.stdout, proc.stderr)
    return {
        "provider": spec.key,
        "label": spec.label,
        "state": "error" if proc.returncode else "ok",
        "source": source_args_list[-1][1] if source_args_list and len(source_args_list[-1]) > 1 else requested_fuelcheck_source(spec),
        "summary": summary or "No JSON payload returned by fuelcheck-cli.",
        "raw": None,
    }


def load_antigravity_token_store() -> dict[str, Any]:
    if not ANTIGRAVITY_TOKENS_FILE.exists():
        return {}

    try:
        content = ANTIGRAVITY_TOKENS_FILE.read_text(encoding="utf-8")
    except OSError:
        return {}

    try:
        data = json.loads(content)
    except json.JSONDecodeError:
        return {}

    return data if isinstance(data, dict) else {}


def antigravity_active_email(store: dict[str, Any]) -> str | None:
    if ANTIGRAVITY_ACTIVE_PROFILE.is_symlink():
        try:
            active_name = ANTIGRAVITY_ACTIVE_PROFILE.resolve(strict=False).name
        except OSError:
            active_name = ""
        if active_name and active_name in store:
            return active_name

    if len(store) == 1:
        return next(iter(store))

    if store:
        return sorted(store)[0]

    return None


def antigravity_refresh_token(store: dict[str, Any], email: str) -> str | None:
    entry = store.get(email)
    if not isinstance(entry, dict):
        return None

    refresh_token = entry.get("refreshToken")
    if not isinstance(refresh_token, str) or not refresh_token.strip():
        return None
    if refresh_token == "[keychain]":
        return None
    return refresh_token


def antigravity_client_credentials(exe: str) -> tuple[str | None, str | None]:
    try:
        source = Path(exe).read_text(encoding="utf-8")
    except OSError:
        return None, None

    client_id_match = re.search(r'CLIENT_ID\s*=\s*"([^"]+)"', source)
    client_secret_match = re.search(r'CLIENT_SECRET\s*=\s*"([^"]+)"', source)
    client_id = client_id_match.group(1) if client_id_match else None
    client_secret = client_secret_match.group(1) if client_secret_match else None
    return client_id, client_secret


def antigravity_post_json(
    url: str,
    body: dict[str, Any],
    timeout_seconds: float,
    headers: dict[str, str] | None = None,
) -> dict[str, Any]:
    request_headers = {
        "Content-Type": "application/json",
        "Accept": "application/json",
    }
    if headers:
        request_headers.update(headers)

    request = urllib.request.Request(
        url,
        method="POST",
        headers=request_headers,
        data=json.dumps(body).encode("utf-8"),
    )

    try:
        with urllib.request.urlopen(request, timeout=timeout_seconds) as response:
            text = response.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as error:
        text = error.read().decode("utf-8", errors="replace").strip()
        raise RuntimeError(text or f"HTTP {error.code}") from error

    try:
        parsed = json.loads(text)
    except json.JSONDecodeError as exc:
        raise RuntimeError("Invalid JSON response from Antigravity") from exc

    if not isinstance(parsed, dict):
        raise RuntimeError("Unexpected Antigravity response shape")

    return parsed


def antigravity_post_form(
    url: str,
    body: dict[str, Any],
    timeout_seconds: float,
    headers: dict[str, str] | None = None,
) -> dict[str, Any]:
    request_headers = {
        "Content-Type": "application/x-www-form-urlencoded",
        "Accept": "application/json",
    }
    if headers:
        request_headers.update(headers)

    request = urllib.request.Request(
        url,
        method="POST",
        headers=request_headers,
        data=urllib.parse.urlencode(body).encode("utf-8"),
    )

    try:
        with urllib.request.urlopen(request, timeout=timeout_seconds) as response:
            text = response.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as error:
        text = error.read().decode("utf-8", errors="replace").strip()
        raise RuntimeError(text or f"HTTP {error.code}") from error

    try:
        parsed = json.loads(text)
    except json.JSONDecodeError as exc:
        raise RuntimeError("Invalid JSON response from Antigravity") from exc

    if not isinstance(parsed, dict):
        raise RuntimeError("Unexpected Antigravity response shape")

    return parsed


def antigravity_get_json(
    url: str,
    access_token: str,
    timeout_seconds: float,
) -> dict[str, Any]:
    request = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Bearer {access_token}",
            "Accept": "application/json",
        },
    )

    try:
        with urllib.request.urlopen(request, timeout=timeout_seconds) as response:
            text = response.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as error:
        text = error.read().decode("utf-8", errors="replace").strip()
        raise RuntimeError(text or f"HTTP {error.code}") from error

    try:
        parsed = json.loads(text)
    except json.JSONDecodeError as exc:
        raise RuntimeError("Invalid JSON response from Antigravity") from exc

    if not isinstance(parsed, dict):
        raise RuntimeError("Unexpected Antigravity response shape")

    return parsed


def antigravity_refresh_access_token(
    refresh_token: str,
    client_id: str,
    client_secret: str,
    timeout_seconds: float,
) -> dict[str, Any]:
    body = {
        "client_id": client_id,
        "client_secret": client_secret,
        "refresh_token": refresh_token,
        "grant_type": "refresh_token",
    }
    return antigravity_post_form(
        ANTIGRAVITY_TOKEN_URL,
        body,
        timeout_seconds,
    )


def antigravity_fetch_project_id(access_token: str, timeout_seconds: float) -> dict[str, Any]:
    body = {"metadata": {"ideType": "ANTIGRAVITY"}}
    return antigravity_post_json(
        ANTIGRAVITY_LOAD_CODE_ASSIST_URL,
        body,
        timeout_seconds,
        headers={
            "Authorization": f"Bearer {access_token}",
            "User-Agent": "antigravity/windows/amd64",
        },
    )


def antigravity_fetch_quota(access_token: str, project_id: str, timeout_seconds: float) -> dict[str, Any]:
    body = {"project": project_id or "bamboo-precept-lgxtn"}
    return antigravity_post_json(
        ANTIGRAVITY_QUOTA_API_URL,
        body,
        timeout_seconds,
        headers={
            "Authorization": f"Bearer {access_token}",
            "User-Agent": ANTIGRAVITY_USER_AGENT,
        },
    )


def fetch_antigravity_quota(spec: ProviderSpec, timeout_seconds: float) -> dict[str, Any]:
    exe = shutil.which("antigravity-kit")
    if not exe:
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "missing",
            "source": "",
            "summary": "antigravity-kit is not installed or not reachable.",
            "raw": None,
        }

    store = load_antigravity_token_store()
    email = antigravity_active_email(store)
    if not email:
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "missing",
            "source": "tokens",
            "summary": "No Antigravity account found in ~/.antigravity-kit/tokens.json.",
            "raw": None,
        }

    refresh_token = antigravity_refresh_token(store, email)
    if not refresh_token:
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "missing",
            "source": "tokens",
            "summary": f"No readable refresh token found for {email}.",
            "raw": None,
        }

    client_id, client_secret = antigravity_client_credentials(exe)
    if not client_id or not client_secret:
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "missing",
            "source": "binary",
            "summary": "Could not extract Antigravity OAuth client credentials.",
            "raw": None,
        }

    try:
        token_response = antigravity_refresh_access_token(refresh_token, client_id, client_secret, timeout_seconds)
        access_token = token_response["access_token"]
        user_info = antigravity_get_json("https://www.googleapis.com/oauth2/v2/userinfo", access_token, timeout_seconds)
        project_info = antigravity_fetch_project_id(access_token, timeout_seconds)
        quota_result = antigravity_fetch_quota(
            access_token,
            str(project_info.get("cloudaicompanionProject") or "bamboo-precept-lgxtn"),
            timeout_seconds,
        )
    except (RuntimeError, urllib.error.URLError, OSError, ValueError) as exc:
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "error",
            "source": "local",
            "summary": f"Antigravity fetch failed: {exc}",
            "raw": None,
        }
    except KeyError:
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "error",
            "source": "local",
            "summary": "Antigravity token refresh did not return an access token.",
            "raw": None,
        }

    subscription_tier = project_info.get("paidTier", {}).get("id") if isinstance(project_info.get("paidTier"), dict) else None
    if not subscription_tier and isinstance(project_info.get("currentTier"), dict):
        subscription_tier = project_info["currentTier"].get("id")

    models: list[dict[str, Any]] = []
    raw_models = quota_result.get("models")
    if isinstance(raw_models, dict):
        for name, info in raw_models.items():
            if not isinstance(info, dict):
                continue
            quota_info = info.get("quotaInfo")
            if not isinstance(quota_info, dict):
                continue
            remaining_fraction = quota_info.get("remainingFraction")
            if not isinstance(remaining_fraction, (int, float)):
                continue
            pct = int(round(max(0.0, min(1.0, float(remaining_fraction))) * 100))
            if "gemini" in name.lower() or "claude" in name.lower():
                models.append({
                    "name": name,
                    "percentage": pct,
                    "resetTime": quota_info.get("resetTime") or "",
                })

    raw: dict[str, Any] = {
        "email": str(user_info.get("email") or email),
        "method": "auth quota",
        "models": sorted(models, key=lambda model: str(model.get("name", ""))),
    }
    if subscription_tier:
        raw["subscriptionTier"] = subscription_tier
    if quota_result.get("isForbidden"):
        raw["isForbidden"] = True

    if quota_result.get("isForbidden"):
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "error",
            "source": "local",
            "summary": "Account forbidden (403).",
            "raw": raw,
        }

    return {
        "provider": spec.key,
        "label": spec.label,
        "state": "ok",
        "source": "local",
        "summary": str(subscription_tier or user_info.get("email") or "antigravity-kit"),
        "raw": raw,
    }


def fetch_gemini_cli_usage(spec: ProviderSpec, timeout_seconds: float) -> dict[str, Any]:
    exe = shutil.which("gemini-cli-usage") or shutil.which("gemini_cli_usage")
    if not exe:
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "missing",
            "source": "",
            "summary": "gemini-cli-usage is not installed or not reachable.",
            "raw": None,
        }

    candidates = [
        [exe, "json"],
        [exe, "json", "--refresh"],
    ]
    cache_file = os.path.expanduser("~/.cache/gemini-cli-usage/usage-limits.json")
    run_env = {"GEMINI_CLI_USAGE_FILE": cache_file}
    run_env.update(gemini_cli_oauth_env())

    for cmd in candidates:
        try:
            proc = run_command(cmd, timeout_seconds, extra_env=run_env)
        except subprocess.TimeoutExpired:
            return {
                "provider": spec.key,
                "label": spec.label,
                "state": "timeout",
                "source": "cli",
                "summary": f"Timed out after {timeout_seconds:g}s waiting for gemini-cli-usage.",
                "raw": None,
            }

        docs = parse_json_docs(proc.stdout)
        item = choose_provider_doc(docs, spec.key)
        if isinstance(item, dict):
            if item.get("quota_error"):
                return {
                    "provider": spec.key,
                    "label": spec.label,
                    "state": "error",
                    "source": "cli",
                    "summary": str(item.get("quota_error")),
                    "raw": item,
                }

            if item.get("account_quota"):
                return {
                    "provider": spec.key,
                    "label": spec.label,
                    "state": "ok",
                    "source": "cli",
                    "summary": str(item.get("auth_label") or item.get("auth_type") or "Gemini CLI"),
                    "raw": item,
                }

            return {
                "provider": spec.key,
                "label": spec.label,
                "state": "ok" if not item.get("error") else "error",
                "source": "cli",
                "summary": summarize_usage(item),
                "raw": item,
            }

    return {
        "provider": spec.key,
        "label": spec.label,
        "state": "error",
        "source": "cli",
        "summary": "Unable to parse gemini-cli-usage output.",
        "raw": None,
    }


def deepinfra_token(timeout_seconds: float) -> tuple[str | None, str]:
    token, source = _env_token("DEEPINFRA_API_KEY", "DEEPINFRA_TOKEN", "DEEPINFRA_API_TOKEN")
    if token:
        return token, source

    if not shutil.which("deepctl"):
        return None, "deepctl"

    try:
        proc = run_command(["deepctl", "auth", "token"], timeout_seconds)
    except subprocess.TimeoutExpired:
        return None, "deepctl"

    for line in reversed(proc.stdout.splitlines()):
        line = line.strip()
        if line:
            return line, "deepctl"
    return None, "deepctl"


CLAUDE_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
CLAUDE_OAUTH_BETA = "oauth-2025-04-20"
CLAUDE_CREDENTIALS = os.path.expanduser("~/.claude/.credentials.json")


def claude_oauth_token() -> str | None:
    try:
        with open(CLAUDE_CREDENTIALS, encoding="utf-8") as handle:
            oauth = json.load(handle).get("claudeAiOauth") or {}
    except (OSError, ValueError):
        return None

    token = oauth.get("accessToken")
    if not isinstance(token, str) or not token:
        return None

    # expiresAt is epoch milliseconds. An expired token is not our job to
    # refresh — say so and let the fuelcheck fallback try.
    expires_at = oauth.get("expiresAt")
    if isinstance(expires_at, (int, float)) and time.time() >= (float(expires_at) / 1000.0):
        return None

    return token


def _claude_quota(percent: Any, resets_at: Any, label: str) -> dict[str, Any]:
    return {
        "label": label,
        "usedPercent": float(percent) if isinstance(percent, (int, float)) else None,
        "resetsAt": resets_at if isinstance(resets_at, str) else None,
    }


def fetch_claude_oauth(spec: ProviderSpec, timeout_seconds: float) -> dict[str, Any]:
    """Read Claude usage straight from the OAuth endpoint.

    fuelcheck-cli only reports the top-level five_hour/seven_day figures and drops
    the `limits` array entirely — which is where the per-model scoped limits now
    live (the legacy seven_day_opus / seven_day_sonnet fields are always null).
    That array is the only place a Fable limit is visible, and it can sit at 99%
    while the headline weekly reads a comfortable 70%. So fetch it ourselves and
    render every limit the account actually has, whatever models Anthropic adds
    later. Falls back to fuelcheck when there is no usable token.
    """
    token = claude_oauth_token()
    if not token:
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "missing",
            "source": "oauth",
            "summary": "No usable Claude OAuth token in ~/.claude/.credentials.json.",
            "raw": None,
        }

    request = urllib.request.Request(
        CLAUDE_USAGE_URL,
        headers={
            "Authorization": f"Bearer {token}",
            "anthropic-beta": CLAUDE_OAUTH_BETA,
            "Accept": "application/json",
        },
    )

    try:
        with urllib.request.urlopen(request, timeout=timeout_seconds) as response:
            data = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        # Say 429 in words the backoff layer recognises.
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "error",
            "source": "oauth",
            "summary": f"Claude OAuth usage fetch failed (HTTP {error.code})",
            "raw": None,
        }
    except (urllib.error.URLError, TimeoutError, ValueError) as error:
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "error",
            "source": "oauth",
            "summary": f"Claude OAuth usage fetch failed: {error}",
            "raw": None,
        }

    five = data.get("five_hour") or {}
    seven = data.get("seven_day") or {}

    primary = _claude_quota(five.get("utilization"), five.get("resets_at"), "5h")
    secondary = _claude_quota(seven.get("utilization"), seven.get("resets_at"), "wk")

    # Every scoped limit the account carries — one line each, named by the model.
    scoped: list[dict[str, Any]] = []
    for limit in data.get("limits") or []:
        if not isinstance(limit, dict) or limit.get("kind") != "weekly_scoped":
            continue
        model = ((limit.get("scope") or {}).get("model") or {})
        name = model.get("display_name") or model.get("id") or "scoped"
        quota = _claude_quota(limit.get("percent"), limit.get("resets_at"), str(name))
        quota["severity"] = limit.get("severity")
        scoped.append(quota)

    return {
        "provider": spec.key,
        "label": spec.label,
        "state": "ok",
        "source": "oauth",
        "summary": f"{spec.label} usage",
        "raw": {"usage": {"primary": primary, "secondary": secondary}, "scoped": scoped},
    }


def fetch_deepinfra(timeout_seconds: float) -> dict[str, Any]:
    token, token_source = deepinfra_token(timeout_seconds)
    if not token:
        return {
            "provider": "deepinfra",
            "label": "DeepInfra",
            "state": "missing",
            "source": token_source,
            "summary": "No DeepInfra token found in env or deepctl auth token.",
            "raw": None,
        }

    url = os.environ.get("DEEPINFRA_USAGE_URL", "https://api.deepinfra.com/v1/usage")
    request = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/json",
            "User-Agent": "DotCortex ai-usage",
        },
    )

    try:
        with urllib.request.urlopen(request, timeout=timeout_seconds) as response:
            body = response.read().decode("utf-8", errors="replace")
            data = json.loads(body)
    except urllib.error.HTTPError as error:
        body = error.read().decode("utf-8", errors="replace")
        try:
            data = json.loads(body)
            detail = data.get("detail") if isinstance(data, dict) else None
        except json.JSONDecodeError:
            detail = body.strip()
            data = None
        return {
            "provider": "deepinfra",
            "label": "DeepInfra",
            "state": "error",
            "source": "api",
            "summary": f"{url} returned HTTP {error.code}" + (f": {detail}" if detail else ""),
            "raw": data,
        }
    except urllib.error.URLError as error:
        return {
            "provider": "deepinfra",
            "label": "DeepInfra",
            "state": "error",
            "source": "api",
            "summary": f"Request failed: {error.reason}",
            "raw": None,
        }
    except json.JSONDecodeError:
        return {
            "provider": "deepinfra",
            "label": "DeepInfra",
            "state": "error",
            "source": "api",
            "summary": "Response was not valid JSON.",
            "raw": None,
        }

    if isinstance(data, dict) and data.get("detail"):
        return {
            "provider": "deepinfra",
            "label": "DeepInfra",
            "state": "error",
            "source": "api",
            "summary": str(data.get("detail")),
            "raw": data,
        }

    return {
        "provider": "deepinfra",
        "label": "DeepInfra",
        "state": "ok",
        "source": "api",
        "summary": compact_json(data),
        "raw": data,
    }


# --- NeuralWatt + Fireworks usage probes ------------------------------------
#
# Both are Bearer-token JSON usage endpoints, the same shape as DeepInfra, so
# they share one probe helper. Research (2026-07-15, Perplexity + Brave):
#
#   NeuralWatt: OpenAI-compatible, base https://api.neuralwatt.com/v1, key is
#     an sk-... token in NEURALWATT_API_KEY. It ships its OWN usage routes (NOT
#     OpenAI's /dashboard/billing path): /v1/quota (balance/usage/limits),
#     /v1/usage/energy, /v1/usage/summary. Schema CONFIRMED 2026-09-25 against
#     the official docs (docs.neuralwatt.com/api/quota) and a live response:
#     snapshot_at, balance, usage.{lifetime,current_month}, limits,
#     subscription (object or null), key.{name,allowance}. The live balance
#     also carries undocumented legacy_credits_usd/new_credits_usd, kept raw.
#     Rate limit: 1 req/s per customer (429 + Retry-After). Parsed by
#     neuralwatt_observation(); drift from the schema is an error, not a guess.
#
#   Fireworks: auth is Bearer FIREWORKS_API_KEY. There is NO numeric spend or
#     credit REST endpoint — that data is firectl-CLI / Stripe only. The one
#     account-level route, /v1/accounts/{id}, returns account state plus a
#     status.reason enum (UNSUSPENDED / CREDIT_DEPLETED /
#     MONTHLY_SPEND_LIMIT_EXCEEDED / ...): a health signal, not dollars. We
#     surface that reason; that is the honest ceiling of what Fireworks exposes.
def _env_token(*env_names: str) -> tuple[str | None, str]:
    # Process env first, then ~/.env: interactive shells no longer export the
    # private key file (2026-09-25), so the probe loads its own key at runtime.
    for env_name in env_names:
        token = os.environ.get(env_name, "").strip()
        if token:
            return token, f"env:{env_name}"
    dotenv = load_dotenv_exports()
    for env_name in env_names:
        token = dotenv.get(env_name, "").strip()
        if token:
            return token, f"dotenv:{env_name}"
    return None, "env"


def _bearer_json_probe(
    provider: str,
    label: str,
    url: str,
    token: str,
    timeout_seconds: float,
    summarize: Any = None,
) -> dict[str, Any]:
    request = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/json",
            "User-Agent": "DotCortex ai-usage",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout_seconds) as response:
            body = response.read().decode("utf-8", errors="replace")
            data = json.loads(body)
    except urllib.error.HTTPError as error:
        body = error.read().decode("utf-8", errors="replace")
        try:
            data = json.loads(body)
            detail = data.get("detail") if isinstance(data, dict) else None
        except json.JSONDecodeError:
            detail = body.strip()
            data = None
        return {
            "provider": provider,
            "label": label,
            "state": "error",
            "source": "api",
            "summary": f"{url} returned HTTP {error.code}" + (f": {detail}" if detail else ""),
            "raw": data,
        }
    except urllib.error.URLError as error:
        return {
            "provider": provider,
            "label": label,
            "state": "error",
            "source": "api",
            "summary": f"Request failed: {error.reason}",
            "raw": None,
        }
    except json.JSONDecodeError:
        return {
            "provider": provider,
            "label": label,
            "state": "error",
            "source": "api",
            "summary": "Response was not valid JSON.",
            "raw": None,
        }

    return {
        "provider": provider,
        "label": label,
        "state": "ok",
        "source": "api",
        "summary": summarize(data) if summarize else compact_json(data),
        "raw": data,
    }


def fetch_openrouter(timeout_seconds: float) -> dict[str, Any]:
    # Native OpenRouter probe (2026-10-09), replacing the codexbar dependency.
    # codexbar's openrouter fetch needs cookie auth (a signed-in web session) —
    # on every Linux host in the fleet it reported $0 from stale cookie caches
    # or 'not found' where codexbar is absent. OpenRouter's own API is the right
    # source: GET /api/v1/credits (account balance) and GET /api/v1/auth/key
    # (key usage/limit) both accept the plain OPENROUTER_API_KEY bearer token.
    token, token_source = _env_token("OPENROUTER_API_KEY")
    if not token:
        return {
            "provider": "openrouter",
            "label": "OpenRouter",
            "state": "missing",
            "source": token_source,
            "summary": "no OPENROUTER_API_KEY found (env or ~/.env).",
            "raw": None,
        }

    credits = _bearer_json_probe(
        "openrouter", "OpenRouter",
        "https://openrouter.ai/api/v1/credits",
        token, timeout_seconds,
    )
    if credits.get("state") != "ok":
        return credits

    key_info = _bearer_json_probe(
        "openrouter", "OpenRouter",
        "https://openrouter.ai/api/v1/auth/key",
        token, timeout_seconds,
    )

    credits_data = nested_get(credits.get("raw"), "data") or {}
    total_credits = credits_data.get("total_credits")
    total_usage = credits_data.get("total_usage")
    key_data = nested_get(key_info.get("raw"), "data") or {}
    key_usage = key_data.get("usage")
    key_label = key_data.get("label")

    # Balance is pre-paid credits minus spend; key usage is this key's spend.
    balance = None
    if isinstance(total_credits, (int, float)) and isinstance(total_usage, (int, float)):
        balance = round(total_credits - total_usage, 6)

    usage: dict[str, Any] = {
        "openRouterUsage": {
            "balance": balance,
            "keyUsage": key_usage,
            "totalCredits": total_credits,
        }
    }
    identity: dict[str, Any] = {"loginMethod": f"Balance: ${balance:g}"}
    if isinstance(key_label, str) and key_label:
        identity["providerID"] = key_label

    summary_parts = []
    if isinstance(balance, (int, float)):
        summary_parts.append(f"balance=${balance:g}")
    if isinstance(key_usage, (int, float)):
        summary_parts.append(f"keyUsage=${key_usage:g}")
    summary_parts.append(f"loginMethod=Balance: ${balance:g}" if isinstance(balance, (int, float)) else "credits unavailable")

    return {
        "provider": "openrouter",
        "label": "OpenRouter",
        "state": "ok",
        "source": "api",
        "summary": "; ".join(summary_parts),
        "raw": {"provider": "openrouter", "source": "api", "usage": usage, "identity": identity},
    }


NEURALWATT_CONSOLE_USAGE_URL = os.environ.get(
    "NEURALWATT_CONSOLE_USAGE_URL",
    "https://portal.neuralwatt.com/dashboard/api/usage",
)
NEURALWATT_USAGE_SUMMARY_URL = os.environ.get(
    "NEURALWATT_USAGE_SUMMARY_URL",
    "https://api.neuralwatt.com/v1/usage/summary",
)
# Where ai-usage reads the coordinator's provider-bonuses feed (format
# centre-provider-bonuses.v1, written by the caddy/centre lane) for active
# NeuralWatt offers. Private host state: only ever an env var, never a
# tracked default path.
BONUS_FEED_ENV = "NEURALWATT_OFFERS_FEED"


def _cookie_jar_path(env_name: str) -> str:
    # Call-time resolution, same rule as the Mistral jar: os.environ first,
    # then the untracked ~/.env exports (shells stopped exporting ~/.env
    # 2026-09-25).
    jar = os.environ.get(env_name, "").strip()
    if not jar:
        jar = load_dotenv_exports().get(env_name, "").strip()
    return os.path.expanduser(jar)


def _cookie_header_from_jar(env_name: str) -> str:
    jar_path = _cookie_jar_path(env_name)
    if not jar_path or not os.path.exists(jar_path):
        return ""
    pairs = []
    try:
        with open(jar_path) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split("\t")
                if len(parts) >= 7:
                    pairs.append(f"{parts[5]}={parts[6]}")
    except OSError:
        return ""
    return "; ".join(pairs)


def _neuralwatt_console_usage(timeout_seconds: float) -> dict[str, Any] | None:
    """Console balance/spend from the signed-in browser session. None when the
    jar is unset or the session fails — callers fall back to API-key numbers."""
    cookie = _cookie_header_from_jar("NEURALWATT_COOKIE_JAR")
    if not cookie:
        return None
    request = urllib.request.Request(
        NEURALWATT_CONSOLE_USAGE_URL,
        headers={
            "Cookie": cookie,
            "Accept": "application/json",
            "User-Agent": _MISTRAL_UA,
            "Referer": "https://portal.neuralwatt.com/dashboard",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout_seconds) as response:
            body = json.loads(response.read().decode("utf-8", errors="replace"))
    except (urllib.error.URLError, json.JSONDecodeError, OSError):
        return None
    return body if isinstance(body, dict) else None


def _neuralwatt_seven_day_burn(token: str, timeout_seconds: float) -> float | None:
    """7-day spend from /v1/usage/summary (API key). None on failure."""
    start = (datetime.now(timezone.utc) - timedelta(days=7)).strftime("%Y-%m-%d")
    url = f"{NEURALWATT_USAGE_SUMMARY_URL}?start_date={start}&granularity=daily"
    try:
        with urllib.request.urlopen(
            urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"}),
            timeout=timeout_seconds,
        ) as response:
            body = json.loads(response.read().decode("utf-8", errors="replace"))
    except (urllib.error.URLError, json.JSONDecodeError, OSError):
        return None
    totals = nested_get(body, "totals") if isinstance(body, dict) else None
    value = totals.get("total_cost_usd") if isinstance(totals, dict) else None
    return float(value) if isinstance(value, (int, float)) else None


def _neuralwatt_active_offer(timeout_seconds: float) -> dict[str, Any] | None:
    """Active NeuralWatt offer from the coordinator's provider-bonuses feed
    (the caddy/centre lane already tracks specials like weekend double
    inference). Returns one offer row with title/amount/reset, or None."""
    feed_path = _cookie_jar_path(BONUS_FEED_ENV)
    if not feed_path or not os.path.exists(feed_path):
        return None
    try:
        with open(feed_path) as fh:
            feed = json.load(fh)
    except (OSError, ValueError):
        return None
    if not isinstance(feed, dict) or feed.get("format") != "centre-provider-bonuses.v1":
        return None
    offers = feed.get("offers")
    if not isinstance(offers, list):
        return None
    now = datetime.now(timezone.utc)

    def _parse(stamp: Any) -> datetime | None:
        if not isinstance(stamp, str):
            return None
        try:
            return datetime.fromisoformat(stamp.replace("Z", "+00:00"))
        except ValueError:
            return None

    for offer in offers:
        if not isinstance(offer, dict) or offer.get("provider") != "neuralwatt":
            continue
        start = _parse(offer.get("starts_at"))
        end = _parse(offer.get("expires_at"))
        if start and end and start <= now < end:
            return offer
    return None


def fetch_neuralwatt(timeout_seconds: float) -> dict[str, Any]:
    token, token_source = _env_token("NEURALWATT_API_KEY", "NEURALWATT_TOKEN")
    if not token:
        return {
            "provider": "neuralwatt",
            "label": "NeuralWatt",
            "state": "missing",
            "source": token_source,
            "summary": "No NeuralWatt token found (set NEURALWATT_API_KEY).",
            "raw": None,
        }
    url = os.environ.get("NEURALWATT_USAGE_URL", "https://api.neuralwatt.com/v1/quota")
    result = _bearer_json_probe("neuralwatt", "NeuralWatt", url, token, timeout_seconds)
    result = apply_neuralwatt_observation(result, collected_at=datetime.now(timezone.utc))

    # Console session (optional): the signed-in browser sees the same balance
    # and spend the dashboard renders. Unset jar -> API-key numbers, saying so.
    console = _neuralwatt_console_usage(timeout_seconds)
    jar_set = bool(_cookie_jar_path("NEURALWATT_COOKIE_JAR"))
    if console is not None:
        result["console"] = console
        result["summary"] += " · console session live"
    elif jar_set:
        result["summary"] += " · console session failed (NEURALWATT_COOKIE_JAR set)"

    # 7-day burn from the usage summary (API key, no extra credentials).
    burn = _neuralwatt_seven_day_burn(token, timeout_seconds)
    if burn is not None:
        result["seven_day_burn_usd"] = round(burn, 6)

    # Active offer from the existing coordinator feed, if any.
    offer = _neuralwatt_active_offer(timeout_seconds)
    if offer is not None:
        result["active_offer"] = {
            "title": offer.get("title"),
            "amount_wh": offer.get("amount_wh"),
            "expires_at": offer.get("expires_at"),
            "next_reset_at": offer.get("next_reset_at"),
        }
    return result


NEURALWATT_SCHEMA = "neuralwatt.quota.v1"
NEURALWATT_REQUIRED = ("snapshot_at", "balance", "usage", "limits", "subscription", "key")


def _num(value: Any) -> float | None:
    return float(value) if isinstance(value, (int, float)) and not isinstance(value, bool) else None


def neuralwatt_observation(data: Any, collected_at: datetime) -> dict[str, Any]:
    """Normalize a /v1/quota body. Raises ValueError on schema drift."""
    if not isinstance(data, dict):
        raise ValueError("quota body is not an object")
    missing = [key for key in NEURALWATT_REQUIRED if key not in data]
    if missing:
        raise ValueError("quota schema drift: missing " + ", ".join(missing))
    balance = data["balance"] if isinstance(data["balance"], dict) else None
    usage = data["usage"] if isinstance(data["usage"], dict) else None
    limits = data["limits"] if isinstance(data["limits"], dict) else None
    key = data["key"] if isinstance(data["key"], dict) else None
    if balance is None or usage is None or limits is None or key is None:
        raise ValueError("quota schema drift: balance/usage/limits/key must be objects")
    if _num(balance.get("credits_remaining_usd")) is None:
        raise ValueError("quota schema drift: balance.credits_remaining_usd is not a number")
    month = usage.get("current_month") if isinstance(usage.get("current_month"), dict) else {}
    sub_raw = data["subscription"] if isinstance(data["subscription"], dict) else None
    allowance_raw = key.get("allowance") if isinstance(key.get("allowance"), dict) else None
    subscription = None
    if sub_raw is not None:
        subscription = {
            "plan": sub_raw.get("plan"),
            "status": sub_raw.get("status"),
            "billing_interval": sub_raw.get("billing_interval"),
            "period_start": sub_raw.get("current_period_start"),
            "period_end": sub_raw.get("current_period_end"),
            "kwh_included": _num(sub_raw.get("kwh_included")),
            "kwh_used": _num(sub_raw.get("kwh_used")),
            "kwh_remaining": _num(sub_raw.get("kwh_remaining")),
            "in_overage": sub_raw.get("in_overage"),
        }
    allowance = None
    if allowance_raw is not None:
        allowance = {
            "period": allowance_raw.get("period"),
            "limit_usd": _num(allowance_raw.get("limit_usd")),
            "spent_usd": _num(allowance_raw.get("spent_usd")),
            "remaining_usd": _num(allowance_raw.get("remaining_usd")),
            "blocked": allowance_raw.get("blocked"),
        }
    # Balance, subscription allowance and key allowance are separate quantities
    # with separate owners of truth; they are never summed or substituted.
    return {
        "schema": NEURALWATT_SCHEMA,
        "observed_at": data.get("snapshot_at"),
        "collected_at": collected_at.astimezone(timezone.utc).isoformat(),
        "accounting_method": balance.get("accounting_method"),
        "balance": {
            "remaining_usd": _num(balance.get("credits_remaining_usd")),
            "total_usd": _num(balance.get("total_credits_usd")),
            "used_usd": _num(balance.get("credits_used_usd")),
        },
        "current_month": {
            "cost_usd": _num(month.get("cost_usd")),
            "requests": month.get("requests") if isinstance(month.get("requests"), int) else None,
            "tokens": month.get("tokens") if isinstance(month.get("tokens"), int) else None,
            "energy_kwh": _num(month.get("energy_kwh")),
        },
        "overage_limit_usd": _num(limits.get("overage_limit_usd")),
        "rate_limit_tier": limits.get("rate_limit_tier"),
        "subscription": subscription,
        "key_allowance": allowance,
    }


def neuralwatt_summary(observation: dict[str, Any]) -> str:
    parts: list[str] = []
    remaining = observation["balance"]["remaining_usd"]
    parts.append(f"balance ${remaining:.2f}")
    month_cost = observation["current_month"]["cost_usd"]
    if month_cost is not None:
        parts.append(f"month ${month_cost:.2f}")
    subscription = observation["subscription"]
    if subscription:
        plan = subscription.get("plan") or "plan"
        status = subscription.get("status") or "?"
        used, included = subscription.get("kwh_used"), subscription.get("kwh_included")
        if used is not None and included:
            parts.append(f"{plan} {status} {used:g}/{included:g} kWh")
        else:
            parts.append(f"{plan} {status}")
        if subscription.get("in_overage"):
            parts.append("IN OVERAGE")
    else:
        parts.append("no subscription")
    allowance = observation["key_allowance"]
    if allowance and allowance.get("remaining_usd") is not None:
        parts.append(f"key {allowance.get('period')} ${allowance['remaining_usd']:.2f} left")
        if allowance.get("blocked"):
            parts.append("KEY BLOCKED")
    return "; ".join(parts)


def apply_neuralwatt_observation(result: dict[str, Any], collected_at: datetime) -> dict[str, Any]:
    if result.get("state") != "ok":
        return result
    try:
        observation = neuralwatt_observation(result.get("raw"), collected_at)
    except ValueError as error:
        return {**result, "state": "error", "summary": str(error)}
    return {**result, "summary": neuralwatt_summary(observation), "observation": observation}


def _fireworks_summary(data: Any) -> str:
    # The account endpoint carries no dollar figures — only lifecycle state and a
    # status.reason enum. Surface those; it is all Fireworks exposes over REST.
    if isinstance(data, dict):
        status = data.get("status") if isinstance(data.get("status"), dict) else {}
        bits = [str(b) for b in (data.get("state"), status.get("reason")) if b]
        if bits:
            return " / ".join(bits)
    return compact_json(data)


def fetch_fireworks(timeout_seconds: float) -> dict[str, Any]:
    token, token_source = _env_token(
        "FIREWORKS_API_KEY", "FIREWORKS_AI_API_KEY", "FIREWORKS_TOKEN"
    )
    if not token:
        return {
            "provider": "fireworks",
            "label": "Fireworks",
            "state": "missing",
            "source": token_source,
            "summary": "No Fireworks token found (set FIREWORKS_API_KEY).",
            "raw": None,
        }
    url = os.environ.get("FIREWORKS_ACCOUNT_URL", "").strip()
    if not url:
        account = os.environ.get("FIREWORKS_ACCOUNT_ID", "").strip()
        if not account:
            return {
                "provider": "fireworks",
                "label": "Fireworks",
                "state": "missing",
                "source": token_source,
                "summary": (
                    "Set FIREWORKS_ACCOUNT_ID — Fireworks exposes no spend endpoint; "
                    "/v1/accounts/{id} returns account status only."
                ),
                "raw": None,
            }
        url = f"https://api.fireworks.ai/v1/accounts/{account}"
    return _bearer_json_probe(
        "fireworks", "Fireworks", url, token, timeout_seconds, summarize=_fireworks_summary
    )


# --- OpenCode Go usage probe ------------------------------------------------
#
# OpenCode Go is the subscription that fuels OpenCode's own harness. Its usage
# endpoint is the one CodexBar adopted in PR #2879 (merged 2026-08-19):
#   GET https://opencode.ai/zen/go/v1/usage  (Authorization: Bearer <key>)
# The key is OPENCODE_API_KEY, else the one OpenCode stores at login in
# ~/.local/share/opencode/auth.json under the "opencode-go" provider entry
# (type "api", field "key").
#
# Live shape CONFIRMED 2026-09-25 by a single shape-only probe:
#   {"usage": {"rolling": {"percent": int 0-100, "resetsAt": ISO-8601 Z,
#              "status": "ok"}, "weekly": {...}, "monthly": {...}}}
# There is NO per-model breakdown and no dollar/limit field in this response:
# percent is the used share of that window's allowance, so remaining is derived
# as 100 - percent. A missing window, a non-numeric or out-of-0-100 percent, a
# non-ISO reset or a missing status is schema drift -> ValueError -> state:
# error, never a guessed display.
OPENCODE_GO_SCHEMA = "opencode-go.usage.v1"
OPENCODE_GO_WINDOW_NAMES = ("rolling", "weekly", "monthly")
OPENCODE_GO_WINDOW_LABELS = {"rolling": "5h", "weekly": "wk", "monthly": "30d"}
OPENCODE_GO_WINDOW_MINUTES = {
    "rolling": 5 * 60,
    "weekly": 7 * 24 * 60,
    "monthly": 30 * 24 * 60,
}
OPENCODE_GO_PACE_LABELS = {"weekly": "wk pace", "monthly": "30d pace"}


def opencode_api_key() -> tuple[str | None, str]:
    """OPENCODE_API_KEY first, else OpenCode's own login store."""
    token, source = _env_token("OPENCODE_API_KEY")
    if token:
        return token, source
    try:
        data = json.loads(OPENCODE_AUTH_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None, "auth"
    if not isinstance(data, dict):
        return None, "auth"
    names = ["opencode-go"]
    names += sorted(name for name in data if name != "opencode-go" and "opencode" in name.lower())
    for name in names:
        entry = data.get(name)
        if not isinstance(entry, dict):
            continue
        for field in ("key", "apiKey", "api_key"):
            value = entry.get(field)
            if isinstance(value, str) and value.strip():
                return value.strip(), f"auth:{name}"
    return None, "auth"


def fetch_opencode_go(timeout_seconds: float) -> dict[str, Any]:
    token, token_source = opencode_api_key()
    if not token:
        return {
            "provider": "opencode-go",
            "label": "OpenCode Go",
            "state": "missing",
            "source": token_source,
            "summary": "No OpenCode API key found (set OPENCODE_API_KEY or run `opencode auth login`).",
            "raw": None,
        }
    url = os.environ.get("OPENCODE_GO_USAGE_URL", OPENCODE_GO_USAGE_URL)
    result = _bearer_json_probe("opencode-go", "OpenCode Go", url, token, timeout_seconds)
    return apply_opencode_go_observation(result, collected_at=datetime.now(timezone.utc))


def opencode_go_observation(data: Any, collected_at: datetime) -> dict[str, Any]:
    """Normalize a /zen/go/v1/usage body. Raises ValueError on schema drift."""
    if not isinstance(data, dict):
        raise ValueError("usage body is not an object")
    usage = data.get("usage")
    if not isinstance(usage, dict):
        raise ValueError("usage schema drift: missing usage object")
    windows: dict[str, dict[str, Any]] = {}
    for name in OPENCODE_GO_WINDOW_NAMES:
        window = usage.get(name)
        if not isinstance(window, dict):
            raise ValueError(f"usage schema drift: missing usage.{name}")
        percent = window.get("percent")
        if not isinstance(percent, (int, float)) or isinstance(percent, bool):
            raise ValueError(f"usage schema drift: usage.{name}.percent is not a number")
        used = float(percent)
        if not 0.0 <= used <= 100.0:
            raise ValueError(f"usage schema drift: usage.{name}.percent={used:g} outside 0-100")
        resets_at = window.get("resetsAt")
        if not isinstance(resets_at, str) or parse_iso_datetime(resets_at) is None:
            raise ValueError(f"usage schema drift: usage.{name}.resetsAt is not an ISO timestamp")
        status = window.get("status")
        if not isinstance(status, str) or not status:
            raise ValueError(f"usage schema drift: usage.{name}.status is not a string")
        windows[name] = {
            "used_percent": used,
            "remaining_percent": 100.0 - used,
            "resets_at": resets_at,
            "status": status,
        }
    return {
        "schema": OPENCODE_GO_SCHEMA,
        "collected_at": collected_at.astimezone(timezone.utc).isoformat(),
        "windows": windows,
    }


def opencode_go_summary(observation: dict[str, Any]) -> str:
    windows = observation["windows"]
    tightest_name = max(windows, key=lambda name: windows[name]["used_percent"])
    tightest = windows[tightest_name]
    parts = [
        f"tightest {OPENCODE_GO_WINDOW_LABELS[tightest_name]} {tightest['used_percent']:.0f}% used"
    ]
    for name in OPENCODE_GO_WINDOW_NAMES:
        status = windows[name]["status"]
        if status != "ok":
            parts.append(f"{OPENCODE_GO_WINDOW_LABELS[name]} status={status}")
    return "; ".join(parts)


def apply_opencode_go_observation(result: dict[str, Any], collected_at: datetime) -> dict[str, Any]:
    if result.get("state") != "ok":
        return result
    try:
        observation = opencode_go_observation(result.get("raw"), collected_at)
    except ValueError as error:
        return {**result, "state": "error", "summary": str(error)}
    return {**result, "summary": opencode_go_summary(observation), "observation": observation}


# --- Mistral usage probe ----------------------------------------------------
#
# Mistral's Vibe monthly-plan percentage is NOT on the public API. The tRPC
# endpoint `console.mistral.ai/api-ui/trpc/billing.vibeUsage` requires a browser
# session (ory_session + csrftoken cookies) and is Cloudflare-gated — an API key
# gets HTTP 401/403 there. What DOES accept the plain MISTRAL_API_KEY is:
#   GET https://console.mistral.ai/api/vibe/whoami
# which returns plan_type/plan_name plus `prompt_switching_to_pro_plan`.
# The whoami payload carries no usage percentage, so this probe reports the
# plan identity and a truthful "usage % unavailable via API key" hint pointing
# at the console UI (Code > CLI > View organization usage) and at the Admin API
# (/v1/admin/usage, needs a separate admin API key from the Backoffice).
# It never fabricates a percentage.
MISTRAL_WHOAMI_URL = os.environ.get(
    "MISTRAL_WHOAMI_URL", "https://console.mistral.ai/api/vibe/whoami"
)

# Admin console tRPC endpoints (admin.mistral.ai) accept the browser session
# cookie jar exported from the signed-in browser (Netscape cookie-jar format,
# carrying the ory_session + csrf cookies for .mistral.ai). billing.budget
# returns the REAL api_budget and vibe_budget usage percentages plus reset
# date — the numbers the console subscription page renders. Discovered
# 2026-10-08. The jar path is private host state: it comes ONLY from the
# MISTRAL_COOKIE_JAR environment variable (e.g. from a private, untracked
# ai-usage env file) — no default path, no username, no host paths in tracked
# source. Unset => the budget probe is skipped and the probe falls back to
# whoami, saying so in its output. Resolved at CALL time (2026-10-09), not
# import time: the module-level constant used to be baked in before ~/.env
# was loaded, so a jar deployed via the untracked env file was invisible
# outside login shells (the T480s/SSH case). _mistral_cookie_header now
# checks os.environ and load_dotenv_exports() on every probe.
MISTRAL_ADMIN_TRPC = os.environ.get(
    "MISTRAL_ADMIN_TRPC", "https://admin.mistral.ai/api/local-trpc"
)
_MISTRAL_UA = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36"
)


def _mistral_cookie_jar_path() -> str:
    # Call-time resolution via the generic helper: os.environ first, then the
    # untracked ~/.env exports. Interactive shells stopped exporting ~/.env
    # 2026-09-25, so the dotenv fallback is what makes the TUI/SSH case work
    # (2026-10-09).
    return _cookie_jar_path("MISTRAL_COOKIE_JAR")


def _mistral_cookie_header() -> str:
    jar_path = _mistral_cookie_jar_path()
    if not jar_path or not os.path.exists(jar_path):
        return ""
    pairs = []
    try:
        with open(jar_path) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split("\t")
                if len(parts) >= 7:
                    pairs.append(f"{parts[5]}={parts[6]}")
    except OSError:
        return ""
    return "; ".join(pairs)


def _mistral_trpc(endpoint: str, params: dict[str, Any], timeout_seconds: float):
    """GET an admin.mistral.ai tRPC query with session cookies. None on failure."""
    cookie = _mistral_cookie_header()
    if not cookie:
        return None
    url = f"{MISTRAL_ADMIN_TRPC}/{endpoint}?input={urllib.parse.quote(json.dumps(params))}"
    request = urllib.request.Request(url, headers={
        "Cookie": cookie,
        "Accept": "application/json",
        "User-Agent": _MISTRAL_UA,
        "Referer": "https://admin.mistral.ai/subscription",
    })
    try:
        with urllib.request.urlopen(request, timeout=timeout_seconds) as response:
            body = json.loads(response.read().decode("utf-8", errors="replace"))
    except (urllib.error.URLError, json.JSONDecodeError, OSError):
        return None
    if not isinstance(body, dict) or body.get("error"):
        return None
    return nested_get(body, "result", "data", "json")


def _mistral_budget_to_quota(budget: dict[str, Any], label: str) -> dict[str, Any]:
    """Admin-trpc budget dict -> the standard quota shape ({usedPercent,
    windowMinutes, resetsAt ISO, label}), the same shape _codex_window_to_quota
    emits for Codex windows so format_compact_quota_line draws the gauge."""
    initial = budget.get("initial_budget")
    used_percent = budget.get("usage_percentage")
    quota: dict[str, Any] = {}
    if isinstance(used_percent, (int, float)) and not isinstance(used_percent, bool):
        quota["usedPercent"] = float(used_percent)
    if isinstance(initial, (int, float)) and not isinstance(initial, bool):
        quota["limit"] = float(initial)
    reset_at = budget.get("reset_at")
    if isinstance(reset_at, str) and reset_at:
        quota["resetsAt"] = reset_at
    # Monthly budget window (resets on the 1st): rendered as '30d'.
    quota["windowMinutes"] = 30 * 24 * 60
    quota["label"] = label
    return quota


def fetch_mistral(timeout_seconds: float) -> dict[str, Any]:
    result = {
        "provider": "mistral",
        "label": "Mistral",
        "state": "missing",
        "source": "admin-trpc",
        "summary": "",
        "raw": None,
    }
    # Preferred path: real budget numbers from the admin console session.
    budget = _mistral_trpc(
        "billing.budget",
        {"json": None, "meta": {"values": ["undefined"], "v": 1}},
        timeout_seconds,
    )
    if isinstance(budget, dict) and budget.get("initial_budget"):
        api_budget = budget.get("api_budget") or budget
        vibe_budget = budget.get("vibe_budget") or {}
        result["state"] = "ok"
        result["identity"] = {"plan_name": "Pro", "plan_type": "chat"}
        # Standard quota shape (2026-10-09, Admiral's pattern conformance): the
        # Mistral budgets render as gauges exactly like Codex/OpenCode Go —
        # bars plus reset countdowns through the existing format_compact_quota_line
        # path. Vibe is the primary gauge ($x/$300), API the secondary ($x/$30);
        # both are monthly, resetting on the 1st, so windowMinutes=30d.
        # The quota dicts live inside raw.usage, where the existing renderer and
        # the remote-panel path expect them (same as codex-native).
        usage = {
            "primary": _mistral_budget_to_quota(vibe_budget, "Vibe"),
            "secondary": _mistral_budget_to_quota(api_budget, "API"),
        }
        result["raw"] = {**budget, "usage": usage}
        result["usage"] = usage
        result["summary"] = _mistral_budget_summary(api_budget, vibe_budget)
        return result
    # Fallback: whoami identity only. The budget probe was skipped either because
    # MISTRAL_COOKIE_JAR is unset (say so) or the session failed (whoami still
    # gives the plan identity; the summary keeps pointing at the console).
    token, token_source = _env_token("MISTRAL_VIBE_API_KEY", "MISTRAL_API_KEY")
    budget_skipped = (
        "budget probe skipped: MISTRAL_COOKIE_JAR not set; "
        if not _mistral_cookie_jar_path() else
        "budget probe unavailable (cookie session failed); "
    )
    if not token:
        return {
            "provider": "mistral",
            "label": "Mistral",
            "state": "missing",
            "source": token_source,
            "summary": budget_skipped
                       + "no Mistral API key found (set MISTRAL_COOKIE_JAR, or MISTRAL_VIBE_API_KEY / MISTRAL_API_KEY).",
            "raw": None,
        }
    result = _bearer_json_probe(
        "mistral", "Mistral", MISTRAL_WHOAMI_URL, token, timeout_seconds,
        summarize=_mistral_summary,
    )
    if result.get("state") == "ok" and isinstance(result.get("raw"), dict):
        result["identity"] = _mistral_identity(result["raw"])
        result["summary"] = budget_skipped + result.get("summary", "")
    return result


def _mistral_budget_summary(api_budget: dict[str, Any], vibe_budget: dict[str, Any]) -> str:
    def fmt(b: dict[str, Any]) -> str:
        try:
            budget = float(b.get("initial_budget", 0))
            used = float(b.get("usage_percentage", 0)) / 100.0 * budget
            return f"${used:.2f}/${budget:.0f} ({float(b.get('usage_percentage', 0)):.1f}%)"
        except (TypeError, ValueError):
            return "n/a"
    reset = (api_budget or {}).get("reset_at") or "?"
    return (
        f"API {fmt(api_budget)} · Vibe {fmt(vibe_budget)} · resets {reset[:10]}"
    )


def _mistral_identity(data: dict[str, Any]) -> dict[str, Any]:
    identity: dict[str, Any] = {}
    for field in ("plan_type", "plan_name", "organization_kind", "customer_id"):
        value = data.get(field)
        if isinstance(value, str) and value:
            identity[field] = value
    return identity


def _mistral_summary(data: dict[str, Any]) -> str:
    plan = data.get("plan_name")
    plan_type = data.get("plan_type")
    parts: list[str] = []
    if isinstance(plan, str) and plan:
        parts.append(f"plan={plan}")
    if isinstance(plan_type, str) and plan_type:
        parts.append(f"type={plan_type}")
    if data.get("prompt_switching_to_pro_plan") is True:
        parts.append("pro upgrade prompted")
    parts.append("usage % needs console session or Admin API key")
    return "; ".join(parts) if parts else "Mistral whoami ok"


# --- Shared result cache + rate-limit backoff -------------------------------
#
# Every provider probe funnels through fetch_provider, so the cache lives here
# rather than in each fetcher.
#
# Why this exists (2026-07-13): Claude's OAuth usage endpoint tolerates only a
# trickle of requests. Five `ai-usage --watch` panes, each polling on the 30s
# default, hit it roughly every 6 seconds for three days and earned a permanent
# HTTP 429 — while /api/oauth/profile kept returning 200, so the token was never
# the problem. Nothing here cached, nothing backed off, and each watcher fetched
# independently, so the throttle could never lift. The fix is twofold: concurrent
# watchers share ONE fetch through an on-disk cache, and a 429 is respected with
# escalating backoff instead of being retried into the ground.

CACHE_DIR = os.path.expanduser("~/.cache/ai-usage")
CACHE_TTL_SECONDS = float(os.environ.get("AI_USAGE_CACHE_TTL", "180"))
BACKOFF_STEPS = (60, 120, 300, 600, 900)


def _cache_path(key: str) -> str:
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", key)
    return os.path.join(CACHE_DIR, f"{safe}.json")


def _cache_read(key: str) -> dict[str, Any]:
    try:
        with open(_cache_path(key), encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def _cache_write(key: str, entry: dict[str, Any]) -> None:
    # Atomic: concurrent watchers must never read a half-written file.
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        path = _cache_path(key)
        tmp = f"{path}.{os.getpid()}.tmp"
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(entry, handle)
        os.replace(tmp, path)
    except OSError:
        pass


def _is_rate_limited(result: dict[str, Any]) -> bool:
    if result.get("state") != "error":
        return False
    return "429" in str(result.get("detail") or result.get("error") or result)


def _cacheable(result: dict[str, Any]) -> dict[str, Any]:
    """Drop the ProviderSpec — it is a dataclass, not JSON, and the caller has it."""
    return {k: v for k, v in result.items() if k != "spec"}


def _revive(cached: dict[str, Any], spec: ProviderSpec) -> dict[str, Any]:
    # Return the cached result verbatim. Do NOT re-embed the ProviderSpec: nothing
    # downstream reads result["spec"], and a dataclass in the result makes
    # `ai-usage --json` crash (ProviderSpec is not JSON serializable) on every
    # cache hit within the TTL. `spec` is kept as a parameter only for call-site
    # stability; the caller already holds it.
    return dict(cached)


def _provider_cache_key(spec: ProviderSpec) -> str:
    # The Codex result grew resetCredits in 2026-07. Keep it isolated from
    # pre-feature watchers that still read and write the older result shape.
    if spec.key == "codex":
        return "codex-v2"
    return spec.key


def fetch_provider(spec: ProviderSpec, timeout_seconds: float) -> dict[str, Any]:
    now = time.time()
    cache_key = _provider_cache_key(spec)
    entry = _cache_read(cache_key)
    cached = entry.get("result")

    # Serve a fresh cache without touching the network. This is what makes N
    # concurrent watchers cost one fetch instead of N.
    if cached and (now - float(entry.get("ts", 0))) < CACHE_TTL_SECONDS:
        return _revive(cached, spec)

    # Still inside a backoff window from a previous 429: do not make it worse.
    # Serve the last good result if we have one, marked stale.
    backoff_until = float(entry.get("backoff_until", 0))
    if now < backoff_until:
        if cached:
            return _revive({**cached, "stale": True}, spec)
        wait = int(backoff_until - now)
        # Standard result shape (with label, JSON-serializable) — a bare
        # {spec, state, detail} dict has no label for render_text and cannot be
        # serialized by --json.
        return {
            "provider": spec.key,
            "label": spec.label,
            "state": "error",
            "source": "",
            "summary": f"rate limited (HTTP 429) — backing off, retrying in {wait}s",
            "raw": None,
        }

    result = _fetch_provider_uncached(spec, timeout_seconds)

    if _is_rate_limited(result):
        # Escalate the backoff each consecutive time we are throttled.
        step = int(entry.get("backoff_step", 0))
        delay = BACKOFF_STEPS[min(step, len(BACKOFF_STEPS) - 1)]
        _cache_write(
            cache_key,
            {
                "ts": float(entry.get("ts", 0)),
                "result": cached,
                "backoff_until": now + delay,
                "backoff_step": step + 1,
            },
        )
        if cached:
            return _revive({**cached, "stale": True}, spec)
        return result

    # Success: reset the backoff ladder. Only good results are cached — caching
    # an error would serve the error back for the whole TTL.
    if result.get("state") != "error":
        _cache_write(
            cache_key,
            {"ts": now, "result": _cacheable(result), "backoff_until": 0, "backoff_step": 0},
        )
    return result


def _fetch_provider_uncached(spec: ProviderSpec, timeout_seconds: float) -> dict[str, Any]:
    if spec.key == "codex":
        # Native ChatGPT usage endpoint first: works on any Linux box straight from
        # ~/.codex/auth.json, no Homebrew/codexbar, and never triggers codexbar's
        # brew-bootstrap on a box without it. codexbar stays as the fallback.
        result = fetch_codex_native(spec, timeout_seconds)
        if result["state"] == "ok":
            return enrich_codex_reset_credits(result, timeout_seconds)
        fallback = fetch_codexbar(spec, timeout_seconds)
        if fallback["state"] == "ok":
            return enrich_codex_reset_credits(fallback, timeout_seconds)
        return result

    if spec.key == "gemini":
        result = fetch_gemini_cli_usage(spec, timeout_seconds)
        if result["state"] == "missing" and spec.fuelcheck_provider:
            return fetch_fuelcheck(spec, timeout_seconds)
        return result

    if spec.key == "claude":
        # Native OAuth first: it is the only source that carries the per-model
        # scoped limits (Fable). fuelcheck stays as the fallback for when there
        # is no usable token.
        result = fetch_claude_oauth(spec, timeout_seconds)
        if result["state"] == "ok":
            return result
        fallback = fetch_fuelcheck(spec, timeout_seconds)
        return fallback if fallback["state"] == "ok" else result

    if spec.kind == "openrouter":
        # Native OpenRouter API first (2026-10-09): works on any host from
        # OPENROUTER_API_KEY in env or ~/.env. codexbar stays as a fallback —
        # its openrouter fetch needs cookie auth, which only macOS had.
        result = fetch_openrouter(timeout_seconds)
        if result["state"] == "ok":
            return result
        fallback = fetch_codexbar(spec, timeout_seconds)
        return fallback if fallback["state"] == "ok" else result

    if spec.kind == "deepinfra":
        return fetch_deepinfra(timeout_seconds)

    if spec.kind == "neuralwatt":
        return fetch_neuralwatt(timeout_seconds)

    if spec.kind == "fireworks":
        return fetch_fireworks(timeout_seconds)

    if spec.kind == "opencode_go":
        return fetch_opencode_go(timeout_seconds)

    if spec.kind == "mistral":
        return fetch_mistral(timeout_seconds)

    if spec.kind == "antigravity_kit":
        result = fetch_antigravity_quota(spec, timeout_seconds)
        if result["state"] == "missing" and spec.codexbar_provider:
            return fetch_codexbar(spec, timeout_seconds)
        return result

    if spec.kind == "fuelcheck":
        result = fetch_fuelcheck(spec, timeout_seconds)
        if result["state"] == "missing" and spec.codexbar_provider:
            return fetch_codexbar(spec, timeout_seconds)
        return result

    return fetch_codexbar(spec, timeout_seconds)


def fetch_provider_with_index(args: tuple[int, ProviderSpec, float]) -> tuple[int, dict[str, Any]]:
    index, spec, timeout_seconds = args
    return index, fetch_provider(spec, timeout_seconds)


def provider_lines(item: dict[str, Any]) -> list[str]:
    label = item["label"]
    state = item["state"]
    source = item.get("source", "")
    raw = item.get("raw")

    lines = [f"{label} [{source or '-'}] {state}"]
    windows: list[tuple[str, dict[str, Any]]] = []
    model_lines: list[str] = []

    if isinstance(raw, dict):
        windows = detect_windows(raw)
        for index, (window_label, window_data) in enumerate(windows):
            normalized_label = window_label
            if index == 1 and normalized_label == "Secondary":
                normalized_label = "Weekly"
            line = format_window_line(normalized_label, window_data)
            if line:
                lines.append(f"  {line}")

        identity = nested_get(raw, "usage", "identity") or raw.get("identity") or {}
        if isinstance(identity, dict):
            for key, title in (
                ("plan", "Plan"),
                ("loginMethod", "Login"),
                ("email", "Account"),
                ("providerID", "Provider"),
            ):
                value = identity.get(key)
                if isinstance(value, str) and value:
                    lines.append(f"  {title}: {value}")

        if item["provider"] == "antigravity":
            email = raw.get("email")
            method = raw.get("method")
            if isinstance(email, str) and email:
                lines.append(f"  Account: {email}")
            if isinstance(method, str) and method:
                lines.append(f"  Method: {method}")
            model_lines = format_antigravity_models(raw, width=width)
            if model_lines:
                lines.extend(model_lines)

    if len(lines) == 1:
        lines.append(f"  {item['summary']}")
    elif item["state"] == "ok" and item["summary"] and not windows and not model_lines:
        lines.append(f"  {item['summary']}")
    elif item["state"] != "ok" and item["summary"]:
        lines.append(f"  {item['summary']}")

    return lines


def render_text(results: list[dict[str, Any]]) -> None:
    now = datetime.now().astimezone().strftime("%Y-%m-%d %H:%M %Z")
    hdr = f"  {NF['bolt']} AI Usage"
    ts = f"{now}  "
    width = terminal_width()
    mid = " " * max(0, width - 2 - len(hdr) - len(ts))
    print()
    print(f"{GY}╭{'─' * (width - 2)}╮{R}")
    print(f"{GY}│{R}{WH}{B}{hdr}{R}{mid}{FGY}{ts}{GY}│{R}")

    for item in results:
        print(f"{GY}├{'─' * (width - 2)}┤{R}")
        method = item.get("source") or "-"
        ok = item["state"] == "ok"
        badge = f"{GR}{NF['check']}{R}" if ok else f"{RD}{NF['cross']}{R}"
        extra = item.get("extra", "")
        raw = item.get("raw") if isinstance(item.get("raw"), dict) else {}

        if item["provider"] != "openrouter" and not extra and isinstance(raw, dict):
            if item["provider"] == "gemini":
                auth_label = raw.get("auth_label")
                if isinstance(auth_label, str) and auth_label:
                    extra = auth_label
                else:
                    auth_type = raw.get("auth_type")
                    if isinstance(auth_type, str) and auth_type:
                        extra = auth_type

        if item["provider"] not in {"antigravity", "openrouter"} and not extra and isinstance(raw, dict):
                identity = nested_get(raw, "usage", "identity") or raw.get("identity") or {}
                if isinstance(identity, dict):
                    for key in ("plan", "loginMethod", "email"):
                        value = identity.get(key)
                        if isinstance(value, str) and value:
                            extra = value
                            break
                if not extra and item["provider"] == "codex":
                    for key in ("accountPlan", "loginMethod", "signedInEmail"):
                        value = raw.get(key)
                        if isinstance(value, str) and value:
                            extra = value
                            break

        if item["provider"] == "codex" and extra == "plus":
            extra = "Plus"

        extra_text = f"  {FGY}{extra}{R}" if extra else ""
        print(f"  {CY}{item['label']}{R}  {GY}[{method}]{R}  {badge}{extra_text}")

        if item["state"] != "ok":
            print_fitted_text(item["summary"], indent="    ", width=width, color=RD, dim=True)
            continue

        if item["provider"] == "codex" and isinstance(raw, dict):
            dashboard = raw.get("dashboard") if isinstance(raw.get("dashboard"), dict) else {}
            if isinstance(dashboard, dict) and (
                isinstance(dashboard.get("primaryLimit"), dict) or isinstance(dashboard.get("secondaryLimit"), dict)
            ):
                current = format_compact_quota_line(
                    "5h",
                    dashboard.get("primaryLimit") if isinstance(dashboard.get("primaryLimit"), dict) else {},
                )
                secondary_limit = dashboard.get("secondaryLimit")
                secondary_quota = secondary_limit if isinstance(secondary_limit, dict) else {}
                allowance_label = quota_display_label("codex", 1, secondary_quota)
                weekly = format_compact_quota_line(allowance_label, secondary_quota)
                if current:
                    print(current)
                if weekly:
                    print(weekly)
                weekly_reset_at = None
                if isinstance(secondary_limit, dict):
                    weekly_reset_at = secondary_limit.get("resetTime") or secondary_limit.get("resetsAt")
                ideal = format_window_left_line(
                    "pace",
                    weekly_reset_at if isinstance(weekly_reset_at, str) else None,
                    secondary_quota.get("windowMinutes"),
                )
                if ideal:
                    print(ideal)
                for line in format_codex_reset_credit_lines(raw):
                    print(line)
                continue

        if item["provider"] == "codex" and isinstance(raw, dict) and (
            "fiveHourPercentLeft" in raw or "weeklyPercentLeft" in raw
        ):
            current = format_codex_status_line("5h", raw.get("fiveHourPercentLeft"), raw)
            weekly = format_codex_status_line("wk", raw.get("weeklyPercentLeft"), raw)
            if current:
                print(current)
            if weekly:
                print(weekly)
            weekly_reset_at = raw.get("weeklyResetsAt") if isinstance(raw.get("weeklyResetsAt"), str) else None
            ideal = format_window_left_line("pace", weekly_reset_at)
            if ideal:
                print(ideal)
            for line in format_codex_reset_credit_lines(raw):
                print(line)
            continue

        if item["provider"] in {"codex", "claude"} and isinstance(raw, dict):
            usage = raw.get("usage") if isinstance(raw.get("usage"), dict) else raw
            primary = nested_get(usage, "primary") or {}
            secondary = nested_get(usage, "secondary") or {}

            current = format_compact_quota_line(
                quota_display_label(item["provider"], 0, primary),
                primary,
            )
            weekly = format_compact_quota_line(
                quota_display_label(item["provider"], 1, secondary),
                secondary,
            )
            if current:
                print(current)
            if weekly:
                print(weekly)

            # Per-model scoped limits (Fable, and whatever Anthropic scopes next).
            # These are invisible in the headline weekly figure: Fable can sit at
            # 99% while the weekly reads 70%, so it earns its own line.
            for quota in raw.get("scoped") or []:
                if not isinstance(quota, dict):
                    continue
                line = format_compact_quota_line(str(quota.get("label") or "scoped"), quota)
                if line:
                    print(line)

            weekly_reset_at = None
            if isinstance(secondary, dict):
                weekly_reset_at = secondary.get("resetTime") or secondary.get("resetsAt")
            ideal_label = (
                "pace"
                if item["provider"] == "codex"
                else ("wk" if format_minutes_window(secondary.get("windowMinutes")) == "1w" else "pace")
            )
            ideal = format_window_left_line(
                ideal_label,
                weekly_reset_at if isinstance(weekly_reset_at, str) else None,
                secondary.get("windowMinutes"),
            )
            if ideal:
                print(ideal)
            if item["provider"] == "codex":
                for line in format_codex_reset_credit_lines(raw):
                    print(line)

        elif item["provider"] == "gemini" and isinstance(raw, dict):
            account_quota = raw.get("account_quota")
            if isinstance(account_quota, dict):
                bucket_lines = format_gemini_buckets(account_quota, width=width)
                if bucket_lines:
                    print(bucket_lines[0])
                    for line in bucket_lines[1:]:
                        print(line)
                else:
                    print_fitted_text(item["summary"], indent="  ", width=width)
            elif item["summary"]:
                print_fitted_text(item["summary"], indent="  ", width=width)

        elif item["provider"] == "antigravity" and isinstance(raw, dict):
            email = raw.get("email")
            method = raw.get("method")
            if isinstance(email, str) and email:
                print(f"  {FGY}Account: {email}{R}")
            if isinstance(method, str) and method:
                print(f"  {FGY}Method: {method}{R}")
            subscription = raw.get("subscriptionTier")
            if isinstance(subscription, str) and subscription:
                print(f"  {FGY}Subscription: {subscription}{R}")

            model_lines = format_antigravity_models(raw, width=width)
            if model_lines:
                print(model_lines[0])
                for line in model_lines[1:]:
                    print(line)
            else:
                print_fitted_text(item["summary"], indent="  ", width=width)

        elif item["provider"] == "openrouter" and isinstance(raw, dict):
            usage = raw.get("usage") if isinstance(raw.get("usage"), dict) else raw
            openrouter_usage = nested_get(usage, "openRouterUsage") or {}
            if isinstance(openrouter_usage, dict):
                balance = openrouter_usage.get("balance")
                key_usage = openrouter_usage.get("keyUsage")
                total_credits = openrouter_usage.get("totalCredits")
                parts: list[str] = []
                if isinstance(balance, (int, float)):
                    parts.append(f"Balance: ${balance:g}")
                if isinstance(key_usage, (int, float)):
                    parts.append(f"Key usage: ${key_usage:g}")
                if isinstance(total_credits, (int, float)) and isinstance(key_usage, (int, float)):
                    # Prepaid reserve: what was bought minus what this key spent.
                    parts.append(f"burn-to-date: ${key_usage:g} of ${total_credits:g}")
                if parts:
                    print(f"  {FGY}{' · '.join(parts)}{R}")
            print(f"  {YL}{NF['fuel']} reserve fuel{R}{FGY} — prepaid balance, used when subscriptions run out{R}")

        elif item["provider"] == "neuralwatt" and isinstance(item.get("observation"), dict):
            # Balance line first, like the OpenRouter reserve panel: the remaining
            # prepaid fuel is the number that matters most.
            summary = item.get("summary")
            if isinstance(summary, str) and summary:
                print(f"  {FGY}{summary.replace('; ', ' · ')}{R}")
            burn = item.get("seven_day_burn_usd")
            if isinstance(burn, (int, float)):
                print(f"  {FGY}7-day burn: ${burn:.2f}{R}")
            offer = item.get("active_offer") if isinstance(item.get("active_offer"), dict) else None
            if offer:
                title = offer.get("title") or "active offer"
                amount = offer.get("amount_wh")
                amount_text = f" · {amount:g} Wh/day" if isinstance(amount, (int, float)) else ""
                print(f"  {YL}{NF['zap']} OFFER: {title}{amount_text}{R}")
            print(f"  {YL}{NF['fuel']} reserve fuel{R}{FGY} — prepaid balance, used when subscriptions run out{R}")

        elif item["provider"] == "opencode-go" and isinstance(raw, dict):
            observation = item.get("observation") if isinstance(item.get("observation"), dict) else {}
            windows = observation.get("windows") if isinstance(observation.get("windows"), dict) else {}
            if windows:
                for name in OPENCODE_GO_WINDOW_NAMES:
                    window = windows.get(name)
                    if not isinstance(window, dict):
                        continue
                    line = format_compact_quota_line(
                        OPENCODE_GO_WINDOW_LABELS.get(name, name),
                        {
                            "usedPercent": window.get("used_percent"),
                            "resetsAt": window.get("resets_at"),
                        },
                    )
                    if line:
                        status = window.get("status")
                        if isinstance(status, str) and status and status != "ok":
                            line += f"  {RD}{status}{R}"
                        print(line)
                    pace_label = OPENCODE_GO_PACE_LABELS.get(name)
                    if pace_label:
                        pace = format_window_left_line(
                            pace_label,
                            window.get("resets_at") if isinstance(window.get("resets_at"), str) else None,
                            OPENCODE_GO_WINDOW_MINUTES[name],
                        )
                        if pace:
                            print(pace)
            else:
                print_fitted_text(item["summary"], indent="  ", width=width)

        elif item["provider"] == "mistral" and isinstance(raw, dict):
            identity = item.get("identity") if isinstance(item.get("identity"), dict) else {}
            if identity:
                parts: list[str] = []
                plan = identity.get("plan_name")
                if isinstance(plan, str) and plan:
                    parts.append(f"Plan: {plan}")
                org = identity.get("organization_kind")
                if isinstance(org, str) and org:
                    parts.append(f"Org: {org}")
                if parts:
                    print(f"  {FGY}{' · '.join(parts)}{R}")
            # Budgets as gauges (2026-10-09): same renderer as Codex/OpenCode Go —
            # bars plus reset countdowns, no bespoke text path.
            usage = raw.get("usage") if isinstance(raw.get("usage"), dict) else {}
            primary = usage.get("primary") if isinstance(usage.get("primary"), dict) else {}
            secondary = usage.get("secondary") if isinstance(usage.get("secondary"), dict) else {}
            vibe_line = format_compact_quota_line("Vibe", primary)
            api_line = format_compact_quota_line("API", secondary)
            if vibe_line:
                print(vibe_line)
            if api_line:
                print(api_line)
            # The dollar figures ride the summary line, the way other panels
            # carry extras.
            print_fitted_text(item["summary"], indent="  ", width=width)

        else:
            print_fitted_text(item["summary"], indent="  ", width=width)

    print(f"{GY}╰{'─' * (width - 2)}╯{R}\n")


def _remote_error(label: str, summary: str) -> dict[str, Any]:
    return {
        "provider": "remote",
        "label": label,
        "state": "error",
        "source": "ssh",
        "summary": summary,
        "raw": None,
        "remote": label,
    }


def load_remotes(path: Path) -> list[dict[str, Any]]:
    """Read the runtime remotes file. Missing file = no remotes (not an error)."""
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return []
    except OSError as exc:
        return [_remote_error("remote", f"remotes file unreadable: {exc}")]
    try:
        data = json.loads(text)
    except ValueError as exc:
        return [_remote_error("remote", f"remotes file is not valid JSON: {exc}")]
    entries = data.get("remotes") if isinstance(data, dict) else data
    if not isinstance(entries, list):
        return [_remote_error("remote", "remotes file has no 'remotes' list")]
    return [entry for entry in entries if isinstance(entry, dict)]


def fetch_one_remote(entry: dict[str, Any], default_timeout: float) -> list[dict[str, Any]]:
    """SSH to one fleet host, run `ai-usage --json --no-remote`, and prefix its panels."""
    target = entry.get("ssh") or entry.get("host")
    label = str(entry.get("label") or target or "remote")
    if not target:
        return [_remote_error(label, "remote entry missing 'ssh'/'host' target")]
    providers = str(entry.get("providers") or "codex,claude").replace(" ", "").lower()
    if not REMOTE_PROVIDERS_RE.match(providers):
        return [_remote_error(label, f"invalid providers spec: {providers!r}")]
    try:
        timeout = float(entry.get("timeout", max(default_timeout, 25.0)))
    except (TypeError, ValueError):
        timeout = max(default_timeout, 25.0)

    # Login shell so ~/.local/bin (and linuxbrew) are on PATH under non-interactive SSH.
    inner = f"ai-usage --providers {providers} --json --no-remote"
    remote_cmd = f"bash -lc {shlex.quote(inner)}"
    ssh_cmd = [
        "ssh",
        "-o", "BatchMode=yes",
        "-o", "PasswordAuthentication=no",
        "-o", "KbdInteractiveAuthentication=no",
        "-o", "PreferredAuthentications=publickey",
        "-o", f"ConnectTimeout={max(1, int(timeout))}",
        "-o", "ConnectionAttempts=1",
        str(target),
        remote_cmd,
    ]
    try:
        proc = subprocess.run(
            ssh_cmd,
            capture_output=True,
            text=True,
            timeout=timeout + 5.0,
        )
    except subprocess.TimeoutExpired:
        return [_remote_error(label, f"unreachable (timed out after {timeout:.0f}s)")]
    except OSError as exc:
        return [_remote_error(label, f"ssh failed to launch: {exc}")]
    if proc.returncode != 0:
        tail = (proc.stderr or proc.stdout or "").strip().splitlines()
        detail = tail[-1] if tail else f"exit {proc.returncode}"
        return [_remote_error(label, f"unreachable: {detail}")]
    try:
        items = json.loads(proc.stdout)
    except ValueError:
        return [_remote_error(label, "remote returned unparseable JSON")]
    if not isinstance(items, list):
        return [_remote_error(label, "remote returned unexpected shape")]
    out: list[dict[str, Any]] = []
    for item in items:
        if not isinstance(item, dict):
            continue
        merged = dict(item)
        merged["label"] = f"{label} · {item.get('label', '')}".rstrip(" ·")
        merged["remote"] = label
        out.append(merged)
    return out or [_remote_error(label, "remote returned no panels")]


def fetch_remote_results(remotes_file: Path, default_timeout: float) -> list[dict[str, Any]]:
    results: list[dict[str, Any]] = []
    for entry in load_remotes(remotes_file):
        if "__error__" in entry:  # defensive; load_remotes returns _remote_error dicts
            continue
        results.extend(fetch_one_remote(entry, default_timeout))
    return results


# Display grouping (2026-09-25): panels are grouped per provider, local first,
# then remote, so Codex (mine, then Gillean's) reads as one block, then Claude,
# then the direct probes. Remote panels keep their remotes-file order; providers
# outside the list keep their existing relative order after these.
# mistral moved above openrouter/opencode-go 2026-10-09 so OpenRouter sits
# directly underneath the Mistral panel (Admiral's requested order).
# Final panel order (2026-10-09, Admiral): subscriptions first — codex, claude,
# opencode-go (back where it was), mistral last of them — then the reserve
# tank: OpenRouter directly beneath Mistral, then NeuralWatt.
PROVIDER_DISPLAY_ORDER = ("codex", "claude", "opencode-go", "mistral", "openrouter", "neuralwatt")


def order_results(results: list[dict[str, Any]]) -> list[dict[str, Any]]:
    def sort_key(indexed: tuple[int, dict[str, Any]]) -> tuple[int, int, int]:
        index, item = indexed
        provider = str(item.get("provider") or "")
        if provider in PROVIDER_DISPLAY_ORDER:
            group = PROVIDER_DISPLAY_ORDER.index(provider)
        else:
            group = len(PROVIDER_DISPLAY_ORDER)
        remote_rank = 1 if item.get("remote") else 0
        return (group, remote_rank, index)

    return [item for _, item in sorted(enumerate(results), key=sort_key)]


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Linux usage wrapper for CodexBar, Fuelcheck, Antigravity, and Gemini CLI."
    )
    parser.add_argument("--json", action="store_true", help="Emit the normalized report as JSON.")
    parser.add_argument(
        "--providers",
        default="all",
        help="Comma-separated provider list. Available: " + ", ".join(spec.key for spec in PROVIDERS),
    )
    parser.add_argument(
        "--timeout",
        type=float,
        default=float(os.environ.get("AI_USAGE_TIMEOUT", "20")),
        help="Per-provider timeout in seconds.",
    )
    parser.add_argument("--watch", action="store_true", help="Refresh continuously.")
    parser.add_argument(
        "--interval",
        type=float,
        default=120.0,
        help="Refresh interval in seconds when --watch is enabled.",
    )
    parser.add_argument(
        "--no-remote",
        action="store_true",
        help="Skip remote fleet feeds (also set automatically on remote invocations to prevent recursion).",
    )
    parser.add_argument(
        "--remotes-file",
        default=str(REMOTES_FILE_DEFAULT),
        help=f"JSON file listing remote fleet feeds (default: {REMOTES_FILE_DEFAULT}).",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()

    if args.providers == "all":
        selected = list(DEFAULT_PROVIDER_KEYS)
    else:
        selected = [chunk.strip().lower() for chunk in args.providers.split(",") if chunk.strip()]

    known = {spec.key for spec in PROVIDERS}
    unknown = [name for name in selected if name not in known]
    if unknown:
        eprint("Unknown providers:", ", ".join(unknown))
        return 2

    def collect_results() -> list[dict[str, Any]]:
        selected_specs = [spec for spec in PROVIDERS if spec.key in selected]
        tasks = [
            (index, spec, args.timeout)
            for index, spec in enumerate(selected_specs)
        ]
        results: list[dict[str, Any] | None] = [None for _ in tasks]
        if not tasks:
            return []

        done_count = 0
        done_lock = threading.Lock()

        def worker(index: int, spec: ProviderSpec, timeout_seconds: float) -> None:
            nonlocal done_count
            try:
                result = fetch_provider(spec, timeout_seconds)
            except Exception as exc:
                result = {
                    "provider": spec.key,
                    "label": spec.label,
                    "state": "error",
                    "source": "",
                    "summary": f"Unhandled error: {exc}",
                    "raw": None,
                }
            results[index] = result
            with done_lock:
                done_count += 1

        for index, spec, timeout_seconds in tasks:
            threading.Thread(
                target=worker,
                args=(index, spec, timeout_seconds),
                daemon=True,
                name=f"ai-usage-{spec.key}",
            ).start()

        while True:
            if stop_event.is_set():
                raise KeyboardInterrupt
            with done_lock:
                if done_count >= len(tasks):
                    break
            time.sleep(0.1)

        return [result for result in results if result is not None]

    def start_watch_input_thread(stop_event: threading.Event) -> tuple[threading.Thread | None, list[tuple[int, Any]]]:
        if not sys.stdin.isatty():
            return None, []

        def watcher() -> None:
            fd = sys.stdin.fileno()
            old_attrs = termios.tcgetattr(fd)
            try:
                tty.setcbreak(fd)
                while not stop_event.is_set():
                    readable, _, _ = select.select([fd], [], [], 0.2)
                    if not readable:
                        continue
                    try:
                        ch = os.read(fd, 1)
                    except OSError:
                        continue
                    if ch in {b"q", b"Q", b"\x03", b"\x04"}:
                        stop_event.set()
                        return
            finally:
                termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)

        thread = threading.Thread(target=watcher, name="ai-usage-watch", daemon=True)
        thread.start()
        return thread, []

    stop_event = threading.Event()
    watch_thread: threading.Thread | None = None
    if args.watch:
        watch_thread, _ = start_watch_input_thread(stop_event)

    try:
        while True:
            results = collect_results()

            if not args.no_remote:
                results = results + fetch_remote_results(Path(args.remotes_file), args.timeout)

            results = order_results(results)

            if args.json:
                print(json.dumps(results, indent=2, ensure_ascii=True))
            else:
                if args.watch:
                    print("\033[2J\033[H", end="")
                render_text(results)

            if not args.watch:
                return 0

            if stop_event.wait(max(1.0, args.interval)):
                return 0
    except KeyboardInterrupt:
        return 130
    finally:
        stop_event.set()
        if watch_thread and watch_thread.is_alive():
            watch_thread.join(timeout=0.5)


if __name__ == "__main__":
    raise SystemExit(main())
