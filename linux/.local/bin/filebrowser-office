#!/usr/bin/python3
"""Private OnlyOffice provisioning and foreground Podman owner; default is read-only."""
import argparse, hashlib, ipaddress, json, os, pathlib, re, secrets, stat, subprocess, sys, tempfile
IMAGE = 'docker.io/onlyoffice/documentserver@sha256:3ab6ebc7c605e5a32b7ae3ff19daed4925090245acc8100ce2230bd766c88212'
NAME = 'filebrowser-onlyoffice'
HOME = pathlib.Path.home()
ROOT = HOME / '.config/filebrowser'
SECRET = ROOT / 'onlyoffice-secret'
ENV = ROOT / 'office.env'
KEYS = ('YOUR_OFFICE_URL', 'YOUR_OFFICE_INTERNAL_URL', 'YOUR_CALLBACK_URL', 'YOUR_OFFICE_PUBLISH', 'YOUR_OFFICE_SITE', 'YOUR_OFFICE_UPSTREAM', 'YOUR_FILEBROWSER_SITE', 'YOUR_FILEBROWSER_UPSTREAM', 'YOUR_TLS_CERT', 'YOUR_TLS_KEY')

def private(path):
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600:
        raise ValueError('private file must be regular, owned by this user and mode 0600: ' + str(path))

def secret():
    private(SECRET)
    value = SECRET.read_text().strip()
    if not re.fullmatch(r'[0-9a-f]{64}', value):
        raise ValueError('invalid local OnlyOffice secret format')
    return value

def settings():
    private(ENV)
    result = {}
    for line in ENV.read_text().splitlines():
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        key, sep, value = line.partition('=')
        if not sep or key not in KEYS or key in result or not value or 'YOUR_' in value or any(c in value for c in '\r\n\x00{};"\'`$\\'):
            raise ValueError('invalid or unresolved office.env setting')
        result[key] = value
    if set(result) != set(KEYS):
        raise ValueError('office.env must supply all template keys')
    from urllib.parse import urlsplit
    for key in KEYS[:3]:
        u = urlsplit(result[key])
        if u.scheme not in ('https', 'http') or not u.hostname or u.username or u.password or u.query or u.fragment or u.path not in ('', '/'):
            raise ValueError('invalid integration URL')
        if key != 'YOUR_OFFICE_INTERNAL_URL' and u.scheme != 'https':
            raise ValueError('external and callback URLs require TLS')
        _ = u.port
    host, port, target = result['YOUR_OFFICE_PUBLISH'].split(':')
    if not ipaddress.ip_address(host).is_loopback or not port.isdigit() or not target.isdigit() or not (0 < int(port) < 65536) or not (0 < int(target) < 65536):
        raise ValueError('Document Server publish must be loopback only')
    for key in KEYS[4:8]:
        if not re.fullmatch(r'[a-zA-Z0-9.-]+:[0-9]+', result[key]) or not 0 < int(result[key].rsplit(':', 1)[1]) < 65536:
            raise ValueError('invalid Caddy endpoint')
    for key in ('YOUR_OFFICE_UPSTREAM', 'YOUR_FILEBROWSER_UPSTREAM'):
        if not ipaddress.ip_address(result[key].split(':')[0]).is_loopback:
            raise ValueError('Caddy upstream must be loopback only')
    if result['YOUR_OFFICE_UPSTREAM'] != host + ':' + port or result['YOUR_OFFICE_INTERNAL_URL'].rstrip('/') != 'http://' + host + ':' + port or result['YOUR_OFFICE_URL'].rstrip('/') != 'https://' + result['YOUR_OFFICE_SITE'] or result['YOUR_CALLBACK_URL'].rstrip('/') != 'https://' + result['YOUR_FILEBROWSER_SITE']:
        raise ValueError('Office, publish, proxy and callback endpoints disagree')
    for key in KEYS[8:]:
        if not pathlib.Path(result[key]).is_absolute() or any(c.isspace() for c in result[key]):
            raise ValueError('TLS paths must be absolute without whitespace')
    return result

def provision(apply):
    if SECRET.exists() or SECRET.is_symlink():
        secret()
        print('OnlyOffice secret already provisioned; retained')
        return
    if not apply:
        print('Dry-run: create private OnlyOffice secret on first provision')
        return
    ROOT.mkdir(parents=True, exist_ok=True)
    if ROOT.is_symlink() or ROOT.stat().st_uid != os.getuid():
        raise ValueError('FileBrowser config directory must be local and user-owned')
    os.chmod(ROOT, 0o700)
    fd, name = tempfile.mkstemp(prefix='.onlyoffice-secret-', dir=ROOT)
    try:
        with os.fdopen(fd, 'w') as f:
            os.fchmod(f.fileno(), 0o600)
            f.write(secrets.token_hex(32) + '\n')
            f.flush()
            os.fsync(f.fileno())
        # Link without replacement: simultaneous provisions retain the winner.
        try:
            os.link(name, SECRET)
        except FileExistsError:
            secret()
    finally:
        os.unlink(name)
    print('Provisioned private OnlyOffice secret')

def run_office(apply, serve):
    s = settings()
    jwt = secret()
    podman = os.environ.get('FILEBROWSER_PODMAN_BIN', '/usr/bin/podman')
    storage = HOME / '.local/share/filebrowser/onlyoffice'
    mounts = [('logs', '/var/log/onlyoffice'), ('data', '/var/www/onlyoffice/Data'), ('lib', '/var/lib/onlyoffice'), ('db', '/var/lib/postgresql')]
    spec = json.dumps({'image': IMAGE, 'publish': s['YOUR_OFFICE_PUBLISH'], 'home': str(HOME), 'jwt': hashlib.sha256(jwt.encode()).hexdigest(), 'memory': '2g', 'swap': '3g'}, sort_keys=True)
    label = hashlib.sha256(spec.encode()).hexdigest()
    args = [podman, 'create', '--name', NAME, '--label', 'org.dotcortex.filebrowser.office=' + label, '--restart', 'unless-stopped', '--memory', '2g', '--memory-swap', '3g', '--publish', s['YOUR_OFFICE_PUBLISH'], '--env', 'JWT_ENABLED=true', '--env', 'JWT_SECRET', '--env', 'JWT_HEADER=Authorization', '--env', 'ALLOW_PRIVATE_IP_ADDRESS=true']
    for folder, dest in mounts:
        args.extend(['--volume', str(storage / folder) + ':' + dest + ':rw'])
    args.append(IMAGE)
    if not apply:
        print('Dry-run: create pinned Document Server, loopback publish, memory 2g, memory+swap 3g; secret inherited privately')
        return
    env = os.environ.copy()
    env['JWT_SECRET'] = jwt
    found = subprocess.run([podman, 'container', 'exists', NAME], env=env)
    if found.returncode not in (0, 1):
        raise ValueError('Podman container lookup failed')
    if found.returncode == 1:
        if serve:
            raise ValueError('Document Server not provisioned; run --container --apply after review')
        for folder, _ in mounts:
            (storage / folder).mkdir(parents=True, exist_ok=True)
        subprocess.run(args, env=env, check=True)
    else:
        check = subprocess.check_output([podman, 'inspect', '--format', '{{ index .Config.Labels "org.dotcortex.filebrowser.office" }}', NAME], env=env, text=True).strip()
        if check != label:
            raise ValueError('existing container differs from reviewed definition; refusing replacement')
    if serve:
        # Podman is the foreground child; cron + flock supervise its lifetime.
        os.execve(podman, [podman, 'start', '--attach', NAME], env)
    print('Document Server provisioned; not started')

def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--apply', action='store_true')
    p.add_argument('--container', action='store_true')
    p.add_argument('--serve', action='store_true')
    p.add_argument('--render', metavar='TEMPLATE')
    p.add_argument('--exec', dest='command', nargs=argparse.REMAINDER)
    a = p.parse_args()
    if a.command:
        env = os.environ.copy()
        if SECRET.exists() or SECRET.is_symlink():
            env['FILEBROWSER_ONLYOFFICE_SECRET'] = secret()
        elif '-c' in a.command:
            import yaml
            config = pathlib.Path(a.command[a.command.index('-c') + 1])
            office = (yaml.safe_load(config.read_text()) or {}).get('integrations', {}).get('office')
            if office:
                raise ValueError('OnlyOffice secret has not been provisioned')
        cmd = [v for v in a.command if v != '--require-office-secret']
        os.execvpe(cmd[0], cmd, env)
    elif a.render:
        text = pathlib.Path(a.render).read_text().replace('$HOME', str(HOME))
        for key, value in settings().items():
            text = text.replace(key, value)
        if re.search(r'YOUR_[A-Z_]+', text):
            raise ValueError('unresolved template setting')
        sys.stdout.write(text)
    elif a.container or a.serve:
        if a.serve and not a.apply:
            p.error('--serve requires --apply')
        run_office(a.apply, a.serve)
    else:
        provision(a.apply)

if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError) as e:
        print('filebrowser-office: ' + str(e), file=sys.stderr)
        sys.exit(1)
