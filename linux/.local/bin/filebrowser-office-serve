#!/bin/bash
set -euo pipefail
helper="${FILEBROWSER_OFFICE_HELPER:-$HOME/.local/bin/filebrowser-office}"
case "${1:-}" in
  '') exec "$helper" --container ;;
  --apply) [ "$#" = 1 ] || exit 2; exec "$helper" --serve --apply ;;
  --help) echo 'Usage: filebrowser-office-serve [--apply] (default: dry-run)' ;;
  *) exit 2 ;;
esac
