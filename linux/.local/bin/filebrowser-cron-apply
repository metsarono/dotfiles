#!/usr/bin/env bash
# Cron supervision: filebrowser-cron-apply

# Mirrors agentify-cortex-supervise-cron-apply: expected-host guard, dry-run/remove modes, atomic root-owned receipt. The cron contract starts at boot and liveness-checks every 2 minutes; the supervisor body (filebrowser-supervise) holds the flock singleton.


# [[file:../../../app.org::*Cron supervision: filebrowser-cron-apply][Cron supervision: filebrowser-cron-apply:1]]
set -euo pipefail

TAG="filebrowser-cron-apply"
TARGET="/etc/cron.d/dotcortex-filebrowser"
EXPECTED_HOST=""
DRY=0
REMOVE=0
HOSTNAME_BIN="${FILEBROWSER_CRON_HOSTNAME_BIN:-hostname}"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --host) [ "$#" -ge 2 ] || { echo "$TAG: --host requires a value" >&2; exit 2; }; EXPECTED_HOST="$2"; shift ;;
    --dry-run) DRY=1 ;;
    --remove) REMOVE=1 ;;
    -h|--help|help) echo "Usage: $TAG --host EXACT_HOST [--dry-run] [--remove]"; exit 0 ;;
    *) echo "$TAG: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

run_priv() { if [ "$(id -u)" = 0 ]; then "$@"; else sudo -n "$@"; fi; }

if [ "$REMOVE" = 1 ]; then
  if [ "$DRY" = 1 ]; then echo "remove $TARGET"; else run_priv rm -f "$TARGET"; echo "$TAG: removed $TARGET"; fi
  exit 0
fi

[ -n "$EXPECTED_HOST" ] || { echo "$TAG: --host EXACT_HOST is required" >&2; exit 2; }
CURRENT_HOST="$($HOSTNAME_BIN -s)"
[ "$CURRENT_HOST" = "$EXPECTED_HOST" ] || { echo "$TAG: refusing installation on $CURRENT_HOST; expected $EXPECTED_HOST" >&2; exit 1; }

USER_NAME="$(id -un)"
USER_ID="$(id -u)"
TARGET_HOME="$HOME"
SUPERVISOR="$TARGET_HOME/.local/bin/filebrowser-supervise"
[ "$DRY" = 1 ] || [ -x "$SUPERVISOR" ] || { echo "$TAG: missing $SUPERVISOR; tangle and stow first" >&2; exit 1; }

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT
cat >"$TMP" <<EOF
# DotCortex FileBrowser Quantum owner; managed by $TAG.
@reboot $USER_NAME HOME=$TARGET_HOME PATH=$TARGET_HOME/.guix-extra-profiles/core/core/bin:$TARGET_HOME/.local/bin:/usr/local/bin:/usr/bin:/bin XDG_RUNTIME_DIR=/run/user/$USER_ID $SUPERVISOR --expected-host $EXPECTED_HOST --delay 15 --retry-seconds 15
*/2 * * * * $USER_NAME HOME=$TARGET_HOME PATH=$TARGET_HOME/.guix-extra-profiles/core/core/bin:$TARGET_HOME/.local/bin:/usr/local/bin:/usr/bin:/bin XDG_RUNTIME_DIR=/run/user/$USER_ID $SUPERVISOR --expected-host $EXPECTED_HOST
EOF

if [ "$DRY" = 1 ]; then
  cat "$TMP"
else
  run_priv install -o root -g root -m 0644 "$TMP" "$TARGET"
  echo "$TAG: installed $TARGET"
fi
# Cron supervision: filebrowser-cron-apply:1 ends here
