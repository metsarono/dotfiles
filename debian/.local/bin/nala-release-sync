#!/usr/bin/env bash
# Shared release sync implementation

# [[file:../../../package-nala.org::*Shared release sync implementation][Shared release sync implementation:1]]
set -euo pipefail

MAN="${NALA_RELEASES_SSV:-$HOME/.nala/manifest/releases.ssv}"
CACHE_BASE="${XDG_CACHE_HOME:-$HOME/.cache}/nala/releases"
HOST_EXCLUDES_BIN="${HOME}/.local/bin/host-excludes"
[ -x "$HOST_EXCLUDES_BIN" ] || HOST_EXCLUDES_BIN="${HOME}/DotCortex/all/.local/bin/host-excludes"

# A previous root-run release sync may have left the normal cache tree
# unwritable. Preserve it and fall back to a user-owned cache rather than
# failing every download or requiring a manual XDG_CACHE_HOME override.
cache_probe=""
if mkdir -p "$CACHE_BASE" 2>/dev/null \
  && cache_probe="$(mktemp "$CACHE_BASE/.write-test.XXXXXX" 2>/dev/null)"; then
  rm -f "$cache_probe"
else
  CACHE_BASE="$HOME/.cache/nala-user/releases"
  mkdir -p "$CACHE_BASE"
  cache_probe="$(mktemp "$CACHE_BASE/.write-test.XXXXXX")"
  rm -f "$cache_probe"
  echo "nala-release-sync: normal cache is not writable; using $CACHE_BASE" >&2
fi

[ -f "$MAN" ] || exit 0

OS_ID="unknown"
if [ -f "${NALA_OS_RELEASE:-/etc/os-release}" ]; then
  # shellcheck disable=SC1091
  . "${NALA_OS_RELEASE:-/etc/os-release}"
  OS_ID="$ID"
fi
IS_DEVUAN=0
[ -f "${NALA_DEVUAN_VERSION_FILE:-/etc/devuan_version}" ] && IS_DEVUAN=1
ARCH="${NALA_ARCH:-$(dpkg --print-architecture)}"

chatgpt_supported_platform() {
  [ "$IS_DEVUAN" -eq 0 ] || return 1
  case "$OS_ID:${VERSION_ID:-}" in
    debian:13|ubuntu:24.04|ubuntu:26.04) return 0 ;;
    *) return 1 ;;
  esac
}

scope_matches() {
  local scope="$1"
  case "$scope" in
    shared|"") return 0 ;;
    unsupported-devuan) return 1 ;;
    chatgpt-supported) chatgpt_supported_platform ;;
    devuan-only) [ "$IS_DEVUAN" -eq 1 ] ;;
    ubuntu-only) [ "$OS_ID" = "ubuntu" ] ;;
    vendefoul-only) [ "$OS_ID" = "vendefoul" ] ;;
    *) return 0 ;;
  esac
}

arch_matches() {
  local want="$1"
  case "$want" in
    any|all|"") return 0 ;;
    "$ARCH") return 0 ;;
    *) return 1 ;;
  esac
}

detect_apt() {
  if command -v nala &>/dev/null; then
    printf '%s\n' nala
  else
    printf '%s\n' apt-get
  fi
}

if [ "${NALA_SCOPE_PROBE:-0}" = 1 ]; then
  scope_matches chatgpt-supported
  exit $?
fi
if [ "${NALA_PLATFORM_PROBE:-0}" = 1 ]; then
  scope_matches chatgpt-supported && [ "$ARCH" = amd64 ]
  exit $?
fi

gh_latest_json() {
  local repo="$1" url="https://api.github.com/repos/${repo}/releases/latest"
  if [ -n "${GH_TOKEN:-}" ]; then
    curl -fsSL -H "Authorization: Bearer $GH_TOKEN" "$url"
  else
    curl -fsSL "$url"
  fi
}

normalize_ver() {
  sed -E 's/^v//' <<<"$1"
}

installed_version() {
  local pkg="$1"
  dpkg-query -W -f='${Version}\n' "$pkg" 2>/dev/null || true
}

cache_dir() {
  local pkg="$1"
  printf '%s/%s\n' "$CACHE_BASE" "$pkg"
}

write_cache_meta() {
  local dir="$1" json="$2" tag="$3" name="$4" url="$5" digest="$6"
  mkdir -p "$dir"
  printf '%s\n' "$json" > "$dir/latest.json"
  printf '%s\n' "$tag" > "$dir/tag"
  printf '%s\n' "$name" > "$dir/asset.name"
  printf '%s\n' "$url" > "$dir/asset.url"
  printf '%s\n' "$digest" > "$dir/asset.digest"
}

install_local_deb() {
  local apt_bin="$1" bundle="$2"
  local pkg_name pkg_version installed_status installed_version
  local install_options=(-y)
  if [ "$apt_bin" = nala ]; then
    install_options+=(--no-autoremove)
  else
    install_options+=(--no-remove -o APT::Get::AutomaticRemove=false)
  fi
  if ! pkg_name="$(dpkg-deb --field "$bundle" Package 2>/dev/null)" || [ -z "$pkg_name" ]; then
    echo "  ! cannot extract package name from $(basename "$bundle")" >&2
    return 1
  fi
  if ! pkg_version="$(dpkg-deb --field "$bundle" Version 2>/dev/null)" || [ -z "$pkg_version" ]; then
    echo "  ! cannot extract package version from $(basename "$bundle")" >&2
    return 1
  fi
  package_is_exactly_installed() {
    installed_status=""
    installed_version=""
    IFS=$'\t' read -r installed_status installed_version < <(dpkg-query -W -f='${Status}\t${Version}\n' "$pkg_name" 2>/dev/null) || return 1
    [ "$installed_status" = "install ok installed" ] && [ "$installed_version" = "$pkg_version" ]
  }
  echo "  -> installing $(basename "$bundle") with $apt_bin"
  if ! sudo DEBIAN_FRONTEND=noninteractive "$apt_bin" install "${install_options[@]}" "$bundle"; then
    echo "  -> $apt_bin install failed; retrying with dpkg + apt-get -f" >&2
  fi
  # Nala sometimes returns 0 but silently skips — verify the package is installed
  if package_is_exactly_installed; then
    return 0
  fi
  echo "  -> $apt_bin did not install $pkg_name, retrying with dpkg + apt-get -f"
  if ! sudo DEBIAN_FRONTEND=noninteractive dpkg -i "$bundle"; then
    echo "  -> dpkg dependency setup incomplete; running apt-get -f" >&2
  fi
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -f -y --no-remove -o APT::Get::AutomaticRemove=false
  if package_is_exactly_installed; then
    return 0
  fi
  echo "  ! package $pkg_name is not installed at bundle version $pkg_version after dependency repair" >&2
  return 1
}

if [ "${NALA_INSTALL_PROBE:-0}" = 1 ]; then
  install_local_deb "${NALA_TEST_APT_BIN:-apt-get}" "$NALA_TEST_BUNDLE"
  exit $?
fi

sync_one() {
  local apt_bin="$1" repo="$2" pkg="$3" asset_glob="$4" want_arch="$5" scope="$6" extra="$7"
  local json latest_tag latest_ver asset_name asset_url asset_digest dir bundle tmp old_name cached_digest cached_tag installed
  local bundle_pkg bundle_ver effective_pkg compare_ver
  local asset_entry_name asset_entry_url asset_entry_digest

  if ! scope_matches "$scope"; then
    echo "  skip $pkg (scope=$scope, this=$OS_ID)"
    return 0
  fi

  if [ -x "$HOST_EXCLUDES_BIN" ] && "$HOST_EXCLUDES_BIN" nala "$pkg"; then
    echo "  skip $pkg (host-excluded)"
    return 0
  fi

  if ! arch_matches "$want_arch"; then
    echo "  skip $pkg (arch=$want_arch, this=$ARCH)"
    return 0
  fi

  if [ "${NALA_SYNC_PROBE:-0}" = 1 ]; then
    case " ${NALA_SYNC_FAIL_PKGS:-} " in
      *" $pkg "*) return 1 ;;
    esac
    echo "  probed $pkg"
    return 0
  fi

  if [[ "$repo" == signed-deb://* ]]; then
    local repo_base="${repo#signed-deb://}" metadata_parent metadata_tmp keyring packages_rel expected_packages_sha package_stanza package_version package_filename package_digest metadata_exit_trap metadata_cleanup_trap
    case "$repo_base" in https://*) ;; *) echo "  ! signed Debian repo must use HTTPS: $repo_base" >&2; return 1 ;; esac
    metadata_parent="${NALA_RELEASE_TMPDIR:-${TMPDIR:-/tmp}}"
    mkdir -p "$metadata_parent" || { echo "  ! cannot create signed metadata parent: $metadata_parent" >&2; return 1; }
    metadata_tmp="$(mktemp -d "$metadata_parent/nala-release.XXXXXX")" || { echo "  ! cannot create signed metadata workspace" >&2; return 1; }
    metadata_exit_trap="$(trap -p EXIT || true)"
    printf -v metadata_cleanup_trap 'rm -rf -- %q' "$metadata_tmp"
    trap "$metadata_cleanup_trap" EXIT
    keyring="$metadata_tmp/openai-repo-keyring.gpg"
    if ! {
    printf '%s' '' | base64 -d | gpg --batch --quiet --dearmor --output "$keyring"
    }; then
      echo "  ! cannot construct pinned OpenAI repository keyring" >&2
      rm -rf -- "$metadata_tmp"
      [ -n "$metadata_exit_trap" ] && eval "$metadata_exit_trap" || trap - EXIT
      return 1
    fi
    if ! curl -fsSL "$repo_base/dists/stable/InRelease" -o "$metadata_tmp/InRelease"; then
      echo "  ! cannot download signed InRelease from $repo_base" >&2
      rm -rf -- "$metadata_tmp"
      [ -n "$metadata_exit_trap" ] && eval "$metadata_exit_trap" || trap - EXIT
      return 1
    fi
    if ! gpgv --keyring "$keyring" "$metadata_tmp/InRelease" >/dev/null; then
      echo "  ! OpenAI InRelease signature verification failed" >&2
      rm -rf -- "$metadata_tmp"
      [ -n "$metadata_exit_trap" ] && eval "$metadata_exit_trap" || trap - EXIT
      return 1
    fi
    packages_rel="main/binary-$ARCH/Packages"
    if ! curl -fsSL "$repo_base/dists/stable/$packages_rel" -o "$metadata_tmp/Packages"; then
      echo "  ! cannot download signed Packages metadata for $ARCH" >&2
      rm -rf -- "$metadata_tmp"
      [ -n "$metadata_exit_trap" ] && eval "$metadata_exit_trap" || trap - EXIT
      return 1
    fi
    expected_packages_sha="$(awk -v path="$packages_rel" '$0 == "SHA256:" {found=1; next} found && $3 == path {print $1; exit}' "$metadata_tmp/InRelease")"
    [ -n "$expected_packages_sha" ] || { echo "  ! signed InRelease has no SHA-256 for $packages_rel" >&2; rm -rf -- "$metadata_tmp"; [ -n "$metadata_exit_trap" ] && eval "$metadata_exit_trap" || trap - EXIT; return 1; }
    if ! printf '%s  %s\n' "$expected_packages_sha" "$metadata_tmp/Packages" | sha256sum -c - >/dev/null; then
      echo "  ! Packages metadata SHA-256 verification failed" >&2
      rm -rf -- "$metadata_tmp"
      [ -n "$metadata_exit_trap" ] && eval "$metadata_exit_trap" || trap - EXIT
      return 1
    fi
    package_stanza="$(awk -v pkg="$pkg" 'BEGIN{RS=""} $1 == "Package:" && $2 == pkg {print; exit}' "$metadata_tmp/Packages")"
    package_version="$(awk '$1 == "Version:" {print $2}' <<<"$package_stanza")"
    package_filename="$(awk '$1 == "Filename:" {print $2}' <<<"$package_stanza")"
    package_digest="$(awk '$1 == "SHA256:" {print $2}' <<<"$package_stanza")"
    [ -n "$package_version" ] && [ -n "$package_filename" ] && [ -n "$package_digest" ] || { echo "  ! signed Packages has no complete $pkg stanza" >&2; rm -rf -- "$metadata_tmp"; [ -n "$metadata_exit_trap" ] && eval "$metadata_exit_trap" || trap - EXIT; return 1; }
    json='{}'; latest_tag="$package_version"; latest_ver="$package_version"; asset_name="$(basename "$package_filename")"; asset_url="$repo_base/$package_filename"; asset_digest="$package_digest"
    rm -rf -- "$metadata_tmp"
    [ -n "$metadata_exit_trap" ] && eval "$metadata_exit_trap" || trap - EXIT
  elif [[ "$repo" == direct://* ]]; then
    json='{}'
    latest_tag="${extra%%,*}"
    latest_ver="$latest_tag"
    asset_name="$asset_glob"
    asset_url="${repo#direct://}"
    asset_digest="${extra#*,}"
  else
    json="$(gh_latest_json "$repo")"
    latest_tag="$(jq -r '.tag_name' <<<"$json")"
    latest_ver="$(normalize_ver "$latest_tag")"

    while IFS=$'\t' read -r asset_entry_name asset_entry_url asset_entry_digest; do
      case "$asset_entry_name" in
        $asset_glob)
          asset_name="$asset_entry_name"
          asset_url="$asset_entry_url"
          asset_digest="$asset_entry_digest"
          break
          ;;
      esac
    done < <(jq -r '.assets[] | [.name, .browser_download_url, (.digest // "")] | @tsv' <<<"$json")
  fi

  [ -n "${asset_url:-}" ] || {
    echo "  ! no release asset matching $asset_glob for $repo" >&2
    return 1
  }
  case "$asset_url" in https://*) ;; *) echo "  ! refusing non-HTTPS asset URL: $asset_url" >&2; return 1 ;; esac

  if [ "${NALA_RELEASE_DIFF_ONLY:-0}" = 1 ]; then
    echo "  release: pkg=$pkg arch=$want_arch latest=$latest_ver installed=$(installed_version "$pkg" || true)"
    return 0
  fi

  dir="$(cache_dir "$pkg")"
  if ! mkdir -p "$dir"; then
    echo "  ! cannot create release cache directory $dir" >&2
    return 1
  fi
  bundle="$dir/$asset_name"
  old_name="$( [ -f "$dir/asset.name" ] && cat "$dir/asset.name" || true )"
  cached_digest="$( [ -f "$dir/asset.digest" ] && cat "$dir/asset.digest" || true )"
  cached_tag="$( [ -f "$dir/tag" ] && cat "$dir/tag" || true )"

  if [ -n "$old_name" ] && [ "$old_name" != "$asset_name" ] && [ -f "$dir/$old_name" ]; then
    rm -f "$dir/$old_name"
  fi

  if [ ! -s "$bundle" ] \
    || { [ -n "$asset_digest" ] && [ "$cached_digest" != "$asset_digest" ]; } \
    || { [ -z "$asset_digest" ] && [ "$cached_tag" != "$latest_tag" ]; }; then
    tmp="$bundle.part"
    if ! curl -fL "$asset_url" -o "$tmp"; then
      echo "  ! cannot download release asset $asset_url" >&2
      return 1
    fi
    if [ -n "$asset_digest" ]; then
      if ! printf '%s  %s\n' "$asset_digest" "$tmp" | sha256sum -c - >/dev/null; then
        echo "  ! release asset SHA-256 verification failed for $asset_name" >&2
        return 1
      fi
    fi
    if ! mv -f "$tmp" "$bundle"; then
      echo "  ! cannot promote downloaded release asset to $bundle" >&2
      return 1
    fi
  fi

  if ! write_cache_meta "$dir" "$json" "$latest_tag" "$asset_name" "$asset_url" "$asset_digest"; then
    echo "  ! cannot write release cache metadata in $dir" >&2
    return 1
  fi

  if ! bundle_pkg="$(dpkg-deb -f "$bundle" Package 2>/dev/null)" || [ -z "$bundle_pkg" ]; then
    echo "  ! cannot extract package name from $bundle" >&2
    return 1
  fi
  if ! bundle_ver="$(dpkg-deb -f "$bundle" Version 2>/dev/null)" || [ -z "$bundle_ver" ]; then
    echo "  ! cannot extract package version from $bundle" >&2
    return 1
  fi
  effective_pkg="$pkg"
  compare_ver="$bundle_ver"

  if [ -n "$bundle_pkg" ] && [ "$bundle_pkg" != "$pkg" ]; then
    echo "  ! manifest package $pkg differs from deb metadata $bundle_pkg; using deb metadata"
    effective_pkg="$bundle_pkg"
  fi

  installed="$(installed_version "$effective_pkg")"
  echo "  release: pkg=$effective_pkg arch=$want_arch latest=$compare_ver installed=${installed:-none}"
  if [ "$installed" = "$compare_ver" ]; then
    echo "  -> already current, skipping install for $effective_pkg"
    return 0
  fi

  install_local_deb "$apt_bin" "$bundle"
}

APT_BIN="$(detect_apt)"

echo "== Syncing release-backed .deb packages =="
failures=0
while IFS='|' read -r repo pkg asset_glob want_arch scope _extra; do
  [ -n "$repo" ] || continue
  if ! sync_one "$APT_BIN" "$repo" "$pkg" "$asset_glob" "$want_arch" "$scope" "$_extra"; then
    echo "  ! failed $pkg" >&2
    failures=$((failures + 1))
  fi
done < <(
  awk -v FS='[ \t]+' '
    function dq(s){ return (s == "\"\"" ? "" : s) }
    /^[ \t]*#/ || NF==0 { next }
    {
      printf "%s|%s|%s|%s|%s|%s\n",
        dq($1), dq($2), dq($3), dq($4), dq($5), dq($6)
    }
  ' "$MAN"
)
if [ "$failures" -ne 0 ]; then
  echo "nala-release-sync: $failures manifest row(s) failed" >&2
  exit 1
fi
# Shared release sync implementation:1 ends here
