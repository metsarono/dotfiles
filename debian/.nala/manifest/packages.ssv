earlyoom "" system shared ""
smartmontools "" system shared ""
flatpak "" system shared ""
gnome-software-plugin-flatpak "" system shared ""
# fastfetch - moved to Guix (not in Noble repos)
sshfs "" system shared ""
nfs-common "" system shared ""
nfs-kernel-server "" system ubuntu-only ""
autofs "" system devuan-only ""
nftables "" system shared ""
joystick "" system shared ""
evtest "" system shared ""
xinput "" system shared ""
apparmor-profiles "" system ubuntu-only ""
apparmor-utils "" system ubuntu-only ""
# AMD RX 560 (Baffin/Polaris, gfx803) firmware — required for amdgpu driver to bind and /dev/dri to appear.
# non-free-firmware is already in excalibur sources.list.
firmware-amd-graphics "" system kikin-kushi ""
# Kikin runs sysvinit with no journald and, until 2026-10-08, no syslog daemon: elogind, earlyoom,
# cron and kernel userspace messages had nowhere to go. Added after a user-wide SIGTERM at 21:01
# that day left no record of who sent it. rsyslog ships its own logrotate policy.
rsyslog "" system kikin-kushi ""

# --- Network ---
samba "" network shared ""
# NIC offload/flow-control/EEE inspection — required to diagnose e1000e TX stalls.
ethtool "" network shared ""

