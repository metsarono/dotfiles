# --- Virtual Habitat — container runtime + nested X ---
podman "" virtualisation devuan-only ""
uidmap "" virtualisation devuan-only ""
slirp4netns "" virtualisation devuan-only ""
fuse-overlayfs "" virtualisation devuan-only ""
distrobox "" virtualisation devuan-only ""
xserver-xephyr "" virtualisation shared ""
# xpra — persistent headless virtual display for remote sanctuaries (ruling 2026-07-28:
# nala lane, same category as its podman/distrobox siblings). First consumer: the T1700
# kikin-kushi, whose sanctuary-cortex projects over the tailnet with no monitor attached —
# the remote, persistent evolution of the Xephyr arrangement (Xephyr needs a parent
# display; xpra creates and persists its own).
xpra "" virtualisation devuan-only ""

# --- System ---
libfuse2t64 "" system shared ""
bubblewrap "" system shared ""
