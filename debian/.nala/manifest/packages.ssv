# --- Desktop Apps ---
gparted "" desktop shared ""
kdeconnect "" desktop shared ""
python3-gi "" desktop shared ""
yad "" desktop shared ""
# menulibre: XFCE application-menu editor (native host tool; the Flatpak build is
# reserved for the sanctuary-godzilla-xs guest, which runs it via sanctuary-flatpak-run).
menulibre "" desktop shared ""
# deskflow - moved to Guix (not in Noble repos)
font-manager "" desktop shared ""
grsync "" desktop shared ""
gthumb "" desktop shared ""
seahorse "" desktop shared ""
picom "" desktop shared ""
pluma "" desktop shared ""
audacity "" desktop shared ""
# transmission-QT, not -gtk: Devuan/Ubuntu both ship transmission-gtk as GTK4,
# and GTK4 cannot export a clickable menu to the vala-panel-appmenu global menu
# (no GTK4 appmenu module exists; upstream lists transmission-gtk as broken).
# The Qt build exports via the working dbusmenu codepath, so the global menu
# works — and it themes via QT_QPA_PLATFORMTHEME=gtk3 (see the launcher below).
transmission-qt "" desktop shared ""
# Kvantum — SVG-based Qt6 theme engine (Devuan, where transmission-qt is Qt6).
# Qt6 dropped QGtkStyle, so Kvantum is the only way to give Qt6 apps a genuine
# themed look — WhiteSur-opaqueDark on T480s (theme selected per-machine via
# ~/.config/Kvantum). Ubuntu's Qt5 build takes the QGtkStyle path below instead.
qt6-style-kvantum "" desktop devuan-only ""
# X230 (Qt5) uses QGtkStyle instead of Kvantum — renders transmission-qt through
# the actual OneStepBack GTK2 engine, matching the desktop natively (Qt5-only).
qt5-style-plugins "" desktop ubuntu-only ""
# MATE replacements for the GNOME apps: baobab and gnome-calculator are CSD/Adwaita
# and export no menubar, so they ignore the GTK theme and never reach the global
# menu. mate-utils ships mate-disk-usage-analyzer (plus dictionary, screenshot,
# search-tool); there is no standalone mate-disk-usage-analyzer package in Devuan.
mate-calc "" desktop shared ""
mate-utils "" desktop shared ""

