@@ -1842,6 +1842,85 @@ class GatewayInboundMixin:
 
         clear_published_gateway_message_host(self)
 
+    async def _gateway_idle_prompt_target(self, session_key: str):
+        """Resolve one durable session back to its authorized delivery adapter."""
+        accepting = (getattr(self, "_running", False)
+                     and not getattr(self, "_draining", False)
+                     and not getattr(self, "_external_drain_active", False))
+        if not accepting:
+            return None
+        try:
+            entry = await self.async_session_store.lookup_by_session_key(session_key)
+            if entry is None or entry.origin is None:
+                return None
+            from gateway.session_identity import replace_source
+            source = replace_source(self._restored_source(entry))
+            if source.platform != Platform.TELEGRAM or source.chat_type != "dm":
+                return None
+            authorized = self._is_user_authorized_for_source(
+                source, allow_adapter_delegation=False)
+            adapter = self._delivery_adapter_for(source) if authorized else None
+        except Exception:
+            logger.warning("Idle-prompt target resolution failed", exc_info=True)
+            return None
+        return (entry, source, adapter) if adapter is not None else None
+
+    def _gateway_idle_prompt_busy(self, session_key: str, entry: Any, adapter: Any) -> bool:
+        """Whether *session_key* has turn-scoped work that must precede an idle prompt.
+
+        Runner and adapter ``_background_tasks`` are lifecycle buckets, not busy signals: they
+        contain permanent watchers and work for unrelated sessions.  The adapter maps below close
+        the session's pre-turn admission window, while the runner state and durable marker cover
+        the turn, its lease, and reply delivery.  An unreadable source fails closed.
+        """
+        try:
+            state = self._peek_session_state(session_key)
+            if state is not None:
+                turn = state.turn
+                if (turn.agent is not None or turn.lease is not None
+                        or bool(turn.lease_tokens)):
+                    return True
+            if getattr(entry, "active_turn_token", None):
+                return True
+
+            session_work = getattr(adapter, "_session_has_pending_work")
+            return bool(session_work(session_key))
+        except Exception:
+            logger.warning(
+                "Idle-prompt busy state unreadable for session %s", session_key, exc_info=True)
+            return True
+
+    async def gateway_idle_prompt_status(self, session_key: str) -> str:
+        """Return ``idle``, ``busy`` or ``unavailable`` for one platform session."""
+        target = await self._gateway_idle_prompt_target(session_key)
+        if target is None:
+            return "unavailable"
+        entry, _source, adapter = target
+        return "busy" if self._gateway_idle_prompt_busy(session_key, entry, adapter) else "idle"
+
+    async def admit_gateway_idle_prompt(self, session_key: str, content: str) -> str:
+        """Atomically claim an idle platform adapter and schedule its routed reply."""
+        target = await self._gateway_idle_prompt_target(session_key)
+        if target is None:
+            return "unavailable"
+        entry, source, adapter = target
+        if self._gateway_idle_prompt_busy(session_key, entry, adapter):
+            return "busy"
+        event = MessageEvent(
+            text=content, message_type=MessageType.TEXT, source=source, internal=True,
+            allow_gateway_control=False,
+            metadata={
+                "hermes_plugin_id": "mailcortex", "hermes_plugin_injection": True,
+                "gateway_session_key": session_key, "gateway_session_id": entry.session_id,
+                "gateway_session_strict": True,
+            },
+        )
+        # BasePlatformAdapter installs its per-session guard synchronously before
+        # its first suspension when gateway_session_key is explicit. No other
+        # gateway coroutine can enter between the busy decision and that claim.
+        await adapter.handle_message(event)
+        return "accepted" if getattr(event, "_gateway_accepted", False) else "unavailable"
+
