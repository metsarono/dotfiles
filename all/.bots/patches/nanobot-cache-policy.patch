+    @staticmethod
+    def _policy_identity(runtime: LLMRuntime) -> tuple[str, str, str] | None:
+        """Bind evidence to a proven wire route, never a provider display label."""
+        from nanobot.providers.anthropic_provider import AnthropicProvider
+        from nanobot.providers.openai_codex_provider import (
+            DEFAULT_CODEX_URL, OpenAICodexProvider, _strip_model_prefix,
+        )
+        from nanobot.providers.openai_compat_provider import OpenAICompatProvider
+
+        provider = runtime.provider
+        model = runtime.model
+        name = provider.provider_name
+        if not isinstance(model, str) or not model.strip():
+            return None
+        if not isinstance(name, str) or not name.strip():
+            return None
+        # Overrides and failover wrappers can select a different physical model.
+        # Unknown provider implementations remain disabled until explicitly bound.
+        if type(provider) is OpenAICodexProvider:
+            if (DEFAULT_CODEX_URL != "https://chatgpt.com/backend-api/codex/responses"
+                    or provider.api_base is not None
+                    or "model" in provider._extra_body):
+                return None
+            return "openai", "openai-codex-oauth", _strip_model_prefix(model).lower().replace("_", "-")
+        if type(provider) is OpenAICompatProvider:
+            if "model" in provider._extra_body or provider._extra_query:
+                return None
+            endpoint = (str(provider._client.base_url) if provider._client is not None
+                        else provider._effective_base)
+            model = provider._request_model_name(model)
+        elif type(provider) is AnthropicProvider:
+            endpoint = str(provider._client.base_url)
+            model = provider._strip_prefix(model)
+        else:
+            return None
+        if not isinstance(endpoint, str) or not endpoint:
+            return None
+        if (endpoint != endpoint.strip() or "\\" in endpoint or "?" in endpoint or "#" in endpoint
+                or re.search(r"%(?![0-9A-Fa-f]{2})", endpoint)
+                or any(char.isspace() or ord(char) < 32 or ord(char) == 127 for char in endpoint)):
+            return None
+        try:
+            parsed = urlsplit(endpoint)
+            parsed.port
+        except ValueError:
+            return None
+        scheme = parsed.scheme.lower()
+        if (scheme not in {"http", "https"} or not parsed.hostname
+                or parsed.username is not None or parsed.password is not None):
+            return None
+        path = parsed.path
+        if path.endswith("//"):
+            return None
+        if path == "/":
+            path = ""
+        elif path.endswith("/"):
+            path = path[:-1]
+        endpoint_key = f"{scheme}://{parsed.netloc.lower()}{path}"
+        name = name.strip().lower().replace("_", "-")
+        name = {"openai-codex": "openai", "openai-codex-oauth": "openai"}.get(name, name)
+        model = model.strip().lower().replace("_", "-")
+        if name == "anthropic":
+            model = re.sub(r"[ .]+", "-", model)
+            model = re.sub(r"-+", "-", model).strip("-")
+            if not model.startswith("claude-"):
+                model = "claude-" + model
+        if not model:
+            return None
+        return name, endpoint_key, model
+
+    @staticmethod
+    def _policy_env_integer(name: str, default: str) -> int:
+        value = os.environ.get(name, default)
+        if not value or not value.isascii() or not value.isdecimal():
+            raise ValueError("invalid cache-policy environment integer")
+        result = int(value)
+        if not math.isfinite(result):
+            raise ValueError("nonfinite cache-policy environment integer")
+        return result
+
+    @staticmethod
+    def _policy_json_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+        result: dict[str, Any] = {}
+        for key, value in pairs:
+            if key in result:
+                raise ValueError("duplicate cache-policy key")
+            result[key] = value
+        return result
