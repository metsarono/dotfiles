+            )
+            if not helper_value.strip() or not policy_value.strip():
+                return None
+            helper = Path(helper_value).expanduser()
+            policy = Path(policy_value).expanduser()
+            completed = subprocess.run(
+                [str(helper), "resolve", "--policy", str(policy),
+                 "--harness", "nanobot", "--provider", provider,
+                 "--endpoint", endpoint, "--model", model,
+                 "--fallback-compact", str(fallback_compact),
+                 "--fallback-cache", str(fallback_cache), "--allow-observed"],
+                capture_output=True, text=True, timeout=5, check=True,
+            )
+            decision = json.loads(completed.stdout, object_pairs_hook=AutoCompact._policy_json_object)
+            if not isinstance(decision, dict):
+                return None
+            mode, confidence = decision.get("mode"), decision.get("confidence")
+            if (mode, confidence) not in (("measured", "supported"), ("observed", "observed")):
+                return None
+            if (decision.get("provider"), decision.get("endpoint_id"), decision.get("model")) != identity:
+                return None
+            compact, expiry = decision.get("compact_before_seconds"), decision.get("cache_expires_seconds")
+            if any(type(value) not in (int, float) or not math.isfinite(value)
+                   for value in (compact, expiry)):
+                return None
+            if not 0 < compact < expiry:
