+    @staticmethod
+    def _policy_ttl_seconds(runtime: LLMRuntime) -> float | None:
+        try:
+            identity = AutoCompact._policy_identity(runtime)
+            if identity is None:
+                return None
+            provider, endpoint, model = identity
+            fallback_compact = AutoCompact._policy_env_integer(
+                "NANOBOT_CACHE_POLICY_FALLBACK_COMPACT_SECONDS", "1620",
