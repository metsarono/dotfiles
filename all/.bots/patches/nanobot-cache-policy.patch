+                stamp = datetime.fromisoformat(value.replace("Z", "+00:00"))
+                return stamp.tzinfo is not None and stamp > datetime.now(timezone.utc)
+            if not fresh_until(evidence.get("fresh_until")):
+                return None
+            entries = evidence.get("entries")
