+                        or not fresh_until(entry.get("fresh_until"))):
+                    return None
+        except (AttributeError, ImportError, OSError, OverflowError, TypeError,
+                ValueError, KeyError, subprocess.SubprocessError):
+            return None
+        logger.debug(
+            "Auto-compact policy provider={} model={} mode={} threshold={}s",
+            provider, model, mode, compact,
+        )
+        return float(compact)
