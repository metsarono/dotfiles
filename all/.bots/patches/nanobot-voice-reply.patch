+    def _queue_voice_reply(self, text: str) -> None:
+        """Speak one delivered terminal reply without delaying Telegram."""
+        if not text.strip() or os.environ.get("PVOX_REPLY_OFF"):
+            return
+        task = asyncio.create_task(self._run_voice_reply(text))
+        self._voice_reply_tasks.add(task)
+        task.add_done_callback(self._voice_reply_tasks.discard)
+
+    async def _run_voice_reply(self, text: str) -> None:
+        """Feed the shared DotCortex relay its established hook payload."""
+        command = Path(os.environ.get(
+            "NANOBOT_VOICE_REPLY_COMMAND",
+            "~/.local/bin/claude-hook-voice-reply",
+        )).expanduser()
+        if not command.is_file() or not os.access(command, os.X_OK):
+            self.logger.warning("voice reply relay unavailable: {}", command)
+            return
+
+        payload = json.dumps(
+            {"tool_input": {"text": text}}, ensure_ascii=False,
+        ).encode("utf-8")
+        env = os.environ.copy()
+        env["CLAUDE_WARM_HERDR_AGENT"] = "Nanobot"
+        process: asyncio.subprocess.Process | None = None
+        try:
+            process = await asyncio.create_subprocess_exec(
+                str(command),
+                stdin=asyncio.subprocess.PIPE,
+                stdout=asyncio.subprocess.DEVNULL,
+                stderr=asyncio.subprocess.DEVNULL,
+                env=env,
+                start_new_session=os.name != "nt",
+            )
+            await asyncio.wait_for(process.communicate(payload), timeout=5.0)
+            if process.returncode != 0:
+                self.logger.warning(
+                    "voice reply relay exited with status {}", process.returncode,
+                )
+        except asyncio.CancelledError:
+            if process is not None and process.returncode is None:
+                process.kill()
+                await process.wait()
+            raise
+        except asyncio.TimeoutError:
+            if process is not None and process.returncode is None:
+                process.kill()
+                await process.wait()
+            self.logger.warning("voice reply relay timed out")
+        except OSError as exc:
+            self.logger.warning("voice reply relay failed: {}", exc)
+
