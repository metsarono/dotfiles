# HelmCortex Nano private runtime environment
# Copy to ~/.config/nanobot-telegram/env, set the dedicated BotFather token,
# and keep the installed file mode 0600.
# TELEGRAM_BOT_TOKEN=
# Network identity is provisioned only in this uncommitted machine-local file.
# NANOBOT_RECALL_MCP_URL=
# NANOBOT_TOOLS__SSRF_WHITELIST=
# NANOBOT_GATEWAY__HOST=
# NANOBOT_GATEWAY__PORT=
