{
  "agents": {
    "defaults": {
      "workspace": "~/HelmCortex/FORGE/brain/nanobot",
      "modelPreset": "telegram",
      "botName": "HelmCortex Nano",
      "botIcon": "🐈",
      "unifiedSession": true,
      "idleCompactAfterMinutes": 0,
      "idleCompactCheckIntervalSeconds": 60,
      "timezone": "Australia/Melbourne",
      "timezoneMode": "manual"
    }
  },
  "modelPresets": {
    "telegram": {
      "model": "openai-codex/gpt-5.6-sol",
      "provider": "openai_codex",
      "maxTokens": 8192,
      "contextWindowTokens": 200000,
      "temperature": 0.1,
      "reasoningEffort": "high"
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "mode": "polling",
      "groupPolicy": "mention",
      "streaming": true,
      "richMessages": false
    }
  },
  "tools": {
    "restrictToWorkspace": false,
    "exec": {
      "enable": true,
      "sandbox": ""
    },
    "mcpServers": {
      "timeark": {
        "type": "stdio",
        "command": "/home/metsatron/.local/hx/bin/helmcortex-anaconda",
        "args": ["/home/metsatron/HelmCortex/CORE/TimeArk/server.py"],
        "cwd": "/home/metsatron/HelmCortex/CORE/TimeArk",
        "toolTimeout": 60
      },
      "recall": {
        "type": "streamableHttp",
        "url": "${NANOBOT_RECALL_MCP_URL}",
        "toolTimeout": 60
      },
      "agentify": {
        "type": "stdio",
        "command": "/home/metsatron/.local/bin/agentify-desktop-mcp",
        "toolTimeout": 60
      }
    }
  },
  "gateway": {
    "restartMode": "auto",
    "heartbeat": {
      "enabled": true,
      "intervalS": 1800
    }
  }
}
