#!/sbin/openrc-run
# Ductor Telegram bot as an OpenRC service (one body, one conf.d file per bot).
#
# Install: this body as /etc/init.d/<svc>, the bot's settings as
# /etc/conf.d/<svc>. start_pre re-applies DotCortex's fleet seams
# (ductor-seam-apply, idle compaction) as the bot's own user before every
# start, so a pip upgrade can never silently drop them; a failing seam
# refuses the start instead of running an unpatched daemon.
#
# Settings (conf.d):
#   ductor_user        account that runs the bot (required)
#   ductor_group       its group (default: ductor_user)
#   ductor_home        DUCTOR_HOME (required)
#   ductor_workdir     working directory (default: the user's home)
#   ductor_port        DUCTOR_INTERAGENT_PORT (optional; pin it when several
#                      Ductors share a host, or delegations land in the wrong hub)
#   ductor_log_group   group that may read the log (default: ductor_group)
#   ductor_path_add    extra PATH entries appended after ~/.local/bin and
#                      ~/.npm-global/bin (e.g. the agent's Guix node profile)
#   ductor_seams       seam directory holding ductor-seam-apply, readable by
#                      ductor_user (default /usr/local/share/dotcortex/ductor-seams)
#   ductor_umask       default 027

: "${ductor_group:=${ductor_user}}"
: "${ductor_log_group:=${ductor_group}}"
: "${ductor_seams:=/usr/local/share/dotcortex/ductor-seams}"
: "${ductor_umask:=027}"

user_home="$(getent passwd "${ductor_user}" | cut -d: -f6)"
: "${ductor_workdir:=${user_home}}"

name="${RC_SVCNAME}"
description="${ductor_description:-Ductor Telegram bot (${ductor_user})}"
command="${user_home}/.local/bin/ductor"
command_user="${ductor_user}:${ductor_group}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"
directory="${ductor_workdir}"
umask="${ductor_umask}"

export HOME="${user_home}"
export DUCTOR_HOME="${ductor_home}"
[ -n "${ductor_port}" ] && export DUCTOR_INTERAGENT_PORT="${ductor_port}"
export PATH="${PATH}:${user_home}/.local/bin:${user_home}/.npm-global/bin${ductor_path_add:+:${ductor_path_add}}"

depend() {
    # `use`, never `need`: Devuan's OpenRC has no hard `net` service.
    use net dns
    after net
}

start_pre() {
    [ -n "${ductor_user}" ] && [ -n "${ductor_home}" ] \
        || { eerror "ductor_user and ductor_home must be set in /etc/conf.d/${RC_SVCNAME}"; return 1; }
    checkpath -f -m 0640 -o "${ductor_user}:${ductor_log_group}" "${output_log}"
    ebegin "Applying DotCortex Ductor seams as ${ductor_user}"
    su -s /bin/sh "${ductor_user}" -c "cd /tmp && env HOME='${user_home}' PATH='${PATH}' \
        DOTCORTEX_DUCTOR_SEAMS='${ductor_seams}' bash '${ductor_seams}/ductor-seam-apply'" \
        >>"${output_log}" 2>&1
    eend $? "ductor-seam-apply failed (see ${output_log}); refusing an unpatched start"
}
