#!/usr/bin/env bash
# ductor-openrc-install — install a Ductor bot as an OpenRC service from DotCortex.
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: ductor-openrc-install [--dry-run] <svc> <conf-file>
       ductor-openrc-install -h|--help

Run as root. Installs, from this DotCortex checkout:
  - the seam applier and seam files into /usr/local/share/dotcortex/ductor-seams
    (root-owned, world-readable, so every bot user can re-apply them)
  - the shared OpenRC body as /etc/init.d/<svc>
  - <conf-file> as /etc/conf.d/<svc>
Existing files are backed up next to themselves as <file>.bak-<timestamp>
before they are replaced. Nothing is started or restarted.

  --dry-run   print what would change; change nothing
USAGE
}

DRY=0
case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    --dry-run) DRY=1; shift ;;
esac
[ $# -eq 2 ] || { usage >&2; exit 2; }
svc="$1"; conf="$2"
case "$svc" in *[!a-z0-9-]*|"") echo "bad service name: $svc" >&2; exit 2 ;; esac
[ -r "$conf" ] || { echo "conf file not readable: $conf" >&2; exit 2; }

self="$(readlink -f "${BASH_SOURCE[0]}")"
seams="$(dirname "$self")/.."
seams="$(cd "$seams" && pwd)"
applier="$(cd "$seams/../../../bin" && pwd)/ductor-seam-apply"
body="$seams/openrc/ductor"
dest=/usr/local/share/dotcortex/ductor-seams
ts="$(date +%Y%m%d-%H%M%S)"
for f in "$applier" "$body" "$seams/idle_compact.py" "$seams/idle_compact_lifecycle.patch" "$seams/busy_state.py" "$seams/busy_state_api.patch" "$seams/idle_prompt.py" "$seams/idle_prompt_api.patch" "$seams/idle_prompt_telegram.patch"; do
    [ -r "$f" ] || { echo "missing source: $f" >&2; exit 1; }
done

run() { if [ "$DRY" -eq 1 ]; then echo "would: $*"; else "$@"; fi; }
place() {  # src dst mode
    if [ -e "$2" ] && cmp -s "$1" "$2"; then echo "unchanged $2"; return; fi
    [ -e "$2" ] && run cp -p "$2" "$2.bak-$ts"
    run install -m "$3" -o root -g root "$1" "$2"
    [ "$DRY" -eq 1 ] || echo "installed $2"
}

[ "$DRY" -eq 1 ] || [ "$(id -u)" -eq 0 ] || { echo "run as root" >&2; exit 1; }
run install -d -m 0755 -o root -g root "$dest"
place "$applier" "$dest/ductor-seam-apply" 0755
place "$seams/idle_compact.py" "$dest/idle_compact.py" 0644
place "$seams/idle_compact_lifecycle.patch" "$dest/idle_compact_lifecycle.patch" 0644
place "$seams/busy_state.py" "$dest/busy_state.py" 0644
place "$seams/busy_state_api.patch" "$dest/busy_state_api.patch" 0644
place "$seams/idle_prompt.py" "$dest/idle_prompt.py" 0644
place "$seams/idle_prompt_api.patch" "$dest/idle_prompt_api.patch" 0644
place "$seams/idle_prompt_telegram.patch" "$dest/idle_prompt_telegram.patch" 0644
place "$body" "/etc/init.d/$svc" 0755
place "$conf" "/etc/conf.d/$svc" 0644
