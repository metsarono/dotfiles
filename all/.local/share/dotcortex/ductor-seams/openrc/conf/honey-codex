# Honey's Codex Ductor for Mètsàtron, as agent-codex (moved 2026-09-25).
ductor_description="Ductor (Codex) Telegram bot for Metsatron on Honey"
ductor_user="agent-codex"
ductor_home="/home/agent-codex/.ductor-codex"
ductor_workdir="/home/agent-codex"
# Ductor's task tools default to port 8799 (Honey Badger's hub); pinning this
# keeps honey-codex delegations in its own hub (incident 2026-09-16).
ductor_port="8800"
ductor_log_group="gille"
# The agent's Guix node (agent-guix-apply). It comes after ~/.local/bin, so the
# hand-copied node there wins until cutover step 4 removes it
# (agents-bots-honey.org, "Flying Fox and Possum lanes").
ductor_path_add="/home/agent-codex/.guix-extra-profiles/agent/agent/bin"
