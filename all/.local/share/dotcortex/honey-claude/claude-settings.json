{
  "extraKnownMarketplaces": {
    "claude-plugins-official": {"source": {"source": "github", "repo": "anthropics/claude-plugins-official"}}
  },
  "enabledPlugins": {"telegram@claude-plugins-official": true},
  "promptSuggestionEnabled": false,
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "claude-hook-idle-event", "timeout": 10}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "claude-hook-idle-event", "timeout": 10},
                 {"type": "command", "command": "claude-hook-voice-transcribe", "timeout": 600}]}
    ],
    "PreCompact": [
      {"hooks": [{"type": "command", "command": "claude-hook-idle-event", "timeout": 10}]}
    ],
    "PostCompact": [
      {"hooks": [{"type": "command", "command": "claude-hook-idle-event", "timeout": 10}]}
    ],
    "Notification": [
      {"matcher": "permission_prompt|elicitation_dialog",
       "hooks": [{"type": "command", "command": "claude-hook-idle-event", "timeout": 10}]}
    ],
    "PreToolUse": [
      {"matcher": "ScheduleWakeup",
       "hooks": [{"type": "command", "command": "honey-claude-wakeup-guard", "timeout": 5}]},
      {"hooks": [{"type": "command", "command": "claude-hook-idle-event", "timeout": 10}]}
    ],
    "PostToolUse": [
      {"matcher": "mcp__plugin_telegram_telegram__reply",
       "hooks": [{"type": "command", "command": "honey-claude-voice-reply", "timeout": 10}]},
      {"hooks": [{"type": "command", "command": "claude-hook-idle-event", "timeout": 10}]}
    ],
    "PermissionRequest": [
      {"hooks": [{"type": "command", "command": "SO_APPROVAL_KIKIN_MANIFEST=$HOME/.config/dotcortex/claude-approval-bunta.honey.local.json claude-hook-permission-request-kikin", "timeout": 5}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "claude-hook-telegram-delivery-guard", "timeout": 10},
                 {"type": "command", "command": "claude-hook-idle-event", "timeout": 10}]}
    ],
    "StopFailure": [
      {"hooks": [{"type": "command", "command": "claude-hook-idle-event", "timeout": 10}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "claude-hook-idle-event", "timeout": 10}]}
    ]
  }
}
