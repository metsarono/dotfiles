# NFS network configuration — machine-local, do NOT commit to DotCortex
# Copy to ~/.local/share/dotcortex/nfs/nfs.env and fill in real values

# X230 NFS server static LAN setup (for nmcli/netplan only)
X230_LAN_IP=
X230_LAN_PREFIX=24
X230_GATEWAY_IP=
X230_DNS_IP=

# Tailscale IPs — used for NFS transport (work at home and remotely)
X230_TS_IP=
T480S_TS_IP=
T480_TS_IP=
T1700_TS_IP=

# HelmCortex hub — codename of the machine that hosts HelmCortex natively
# (x230 | t480s | t480 | t1700). Set on CLIENT machines only; this is what
# keeps ~/HelmCortex a first-class NFS mount instead of the legacy symlink.
# Leave it blank on the hub itself. See nfs.org §Hub consumer mount.
HELMCORTEX_HUB=
