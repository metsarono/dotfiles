# ~/DotCortex/all/.local/share/dotcortex/manifests/bun/build.ssv
# NAME MODE ROOT REPO REF SUBDIR INSTALL BUILD HEALTH EXTRA
# maestro submodule vendor/agent-maestro https://github.com/subhangR/agent-maestro.git REF . "" "bun run build:all" "" ""
codex-desktop-linux git ~/.local/share/dotcortex/src/codex-desktop-linux https://github.com/ilysenko/codex-desktop-linux.git bb40cf5e1cec8df665d85c04390d37c54603a56b . "./install.sh" "python3 -c 'from pathlib import Path; import re; p=Path(\"codex-app/start.sh\"); text=p.read_text(); repl=\"SCRIPT_DIR=\\\"$(cd \\\"$(dirname \\\"$(readlink -f \\\"${BASH_SOURCE[0]:-$0}\\\")\\\")\\\" && pwd -P)\\\"\"; text=re.sub(r\"^SCRIPT_DIR=.*$\", repl, text, count=1, flags=re.M); p.write_text(text)' && python3 -c 'from pathlib import Path; p=Path(\"codex-app/start.sh\"); q=chr(34); bs=chr(92); nl=chr(10); t=p.read_text(); npm=\"npm-global/bin/codex\"; ins=\"        \"+q+\"$HOME/.\"+npm+q+\" \"+bs+nl; needle=q+\".nvm/versions/node\"+q+\"/*/bin/codex\"; lines=t.splitlines(keepends=True); out=[]; [out.extend([l,ins]) if needle in l else out.append(l) for l in lines]; p.write_text(\"\".join(out)) if npm not in t else None' && mkdir -p \"$HOME/.local/share/applications\" \"$HOME/.local/share/icons/hicolor/256x256/apps\" && ln -sf \"$PWD/assets/codex.png\" \"$HOME/.local/share/icons/hicolor/256x256/apps/codex-desktop.png\" && printf '%s\n' '[Desktop Entry]' 'Name=Codex Desktop (Unofficial)' 'Comment=Community OpenAI Codex desktop app' \"Exec=env PATH=$HOME/.npm-global/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin $HOME/.local/bin/codex-desktop\" 'Icon=codex-desktop' 'Terminal=false' 'Type=Application' 'Categories=Development;Chat;' 'StartupWMClass=codex-desktop' 'X-GNOME-WMClass=codex-desktop' > \"$HOME/.local/share/applications/codex-desktop.desktop\" && command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database \"$HOME/.local/share/applications\" >/dev/null 2>&1 || true" ""
dsh-telegram git ~/HelmCortex/NEXUS/git/dsh-telegram https://github.com/xqicxx/dsh-telegram.git f9f1e310c3ee319b7186ca67f0c0884d96f70f1d . "npm ci" "npm run build && install -m 0644 ~/DotCortex/all/.bots/templates/dsh-telegram-bundle.patch.yml ./cordis.patch.yml" "npm run check" "patches=all/.local/share/dotcortex/patches/dsh-telegram-dsh-0.1.5.patch,all/.local/share/dotcortex/patches/dsh-telegram-continuity.patch,all/.local/share/dotcortex/patches/dsh-telegram-mailcortex-wake.patch,all/.local/share/dotcortex/patches/dsh-telegram-readiness.patch;allow-untracked=cordis.patch.yml"
