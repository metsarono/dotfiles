#!/usr/bin/env bash
# ductor-seam-apply — apply DotCortex's fleet-wide seams to an installed ductor_bot.
#
# DotCortex installs Ductor (package-pip.org, pinned). Seams that every Ductor on
# the fleet needs, whatever host or user runs it, live here; HelmCortex-only
# seams (voice, continuity, task budget) stay in HelmCortex's ductor-patch-apply.
# A pip reinstall wipes site-packages, so run this after every install and as a
# preflight before the daemon starts. Idempotent; fails loud on upstream drift.
set -euo pipefail

TARGET_VERSION="0.20.1"
CHECK_ONLY=0
SITE_OVERRIDE=""

usage() {
    cat <<'EOF'
Usage: ductor-seam-apply [--check] [--site DIR] [-h|--help]

Apply DotCortex's fleet-wide ductor_bot seams to the installed package.

  (no args)     Apply missing seams idempotently, then byte-compile-verify.
  --check       Report applied/missing per seam; change nothing. Exit 1 if any
                seam is missing.
  --site DIR    Operate on the site-packages root DIR instead of the one the
                `ductor` launcher's interpreter uses.
  -h, --help    Show this help and exit (no side effects).

Seams:
  idle_compact  compact idle main sessions before the provider cache expires
                (Claude 55/60 min, Codex 25/30 min; config.json "idle_compaction")
  busy_state    authenticated loopback GET /busy for the default main session
  idle_prompt   encrypted idle-only prompt admission holding API and bus locks

Seam files:  <dotcortex>/all/.local/share/dotcortex/ductor-seams/
             (override with DOTCORTEX_DUCTOR_SEAMS)
Target:      ductor 0.20.1 (drift fails loud; regenerate the seam)
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --check)   CHECK_ONLY=1; shift ;;
        --site)    SITE_OVERRIDE="${2:-}"; [ -n "$SITE_OVERRIDE" ] || { usage >&2; exit 2; }; shift 2 ;;
        *) echo "ductor-seam-apply: unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
done

fail() { echo "ductor-seam-apply: ERROR: $*" >&2; exit 1; }
command -v patch >/dev/null 2>&1 || fail "'patch' not found on PATH"

self="$(readlink -f "${BASH_SOURCE[0]}")"
SEAMS_DIR="${DOTCORTEX_DUCTOR_SEAMS:-$(dirname "$self")/../share/dotcortex/ductor-seams}"
[ -d "$SEAMS_DIR" ] || fail "seam dir not found: $SEAMS_DIR"
SEAMS_DIR="$(cd "$SEAMS_DIR" && pwd)"

# The interpreter that runs the daemon decides which site-packages matters.
if [ -n "$SITE_OVERRIDE" ]; then
    SITE="$SITE_OVERRIDE"
    PYTHON_BIN="$(command -v python3)" || fail "python3 not found on PATH"
else
    launcher="$(command -v ductor)" || fail "ductor launcher not on PATH"
    PYTHON_BIN="$(head -n1 "$launcher" | sed -n 's/^#!\s*//p' | awk '{print $1}')"
    [ -x "$PYTHON_BIN" ] || fail "cannot read the interpreter from $launcher"
    SITE="$(cd /tmp && "$PYTHON_BIN" -c 'import ductor_bot, os; print(os.path.dirname(os.path.dirname(ductor_bot.__file__)))')" \
        || fail "ductor_bot not importable by $PYTHON_BIN"
fi
SITE="$(cd "$SITE" && pwd)" || fail "site not found: $SITE"
PKG="$SITE/ductor_bot"
[ -d "$PKG" ] || fail "ductor_bot not found under $SITE"

version="$(cd /tmp && PYTHONPATH="$SITE" "$PYTHON_BIN" -c 'from importlib.metadata import version; print(version("ductor"))' 2>/dev/null || true)"
if [ -n "$version" ] && [ "$version" != "$TARGET_VERSION" ]; then
    fail "installed ductor $version, seams target $TARGET_VERSION: regenerate the seams first"
fi

missing=0
changed=0

seam_file_state() {  # $1 = seam source, $2 = installed path
    if [ -f "$2" ] && cmp -s "$1" "$2"; then echo applied; else echo missing; fi
}

seam_patch_state() {  # $1 = patch file
    if patch -d "${2:-$SITE}" -p1 --fuzz=0 --dry-run --reverse --force -s <"$1" >/dev/null 2>&1; then
        echo applied
    elif patch -d "${2:-$SITE}" -p1 --fuzz=0 --dry-run --forward --force -s <"$1" >/dev/null 2>&1; then
        echo missing
    else
        echo drifted
    fi
}

# --- idle_compact -----------------------------------------------------------
module_src="$SEAMS_DIR/idle_compact.py"
module_dst="$PKG/orchestrator/idle_compact.py"
hook_patch="$SEAMS_DIR/idle_compact_lifecycle.patch"
[ -f "$module_src" ] && [ -f "$hook_patch" ] || fail "idle_compact seam files missing in $SEAMS_DIR"

module_state="$(seam_file_state "$module_src" "$module_dst")"

busy_src="$SEAMS_DIR/busy_state.py"
busy_dst="$PKG/api/busy_state.py"
busy_patch="$SEAMS_DIR/busy_state_api.patch"
[ -f "$busy_src" ] && [ -f "$busy_patch" ] || fail "busy_state seam files missing in $SEAMS_DIR"
busy_module_state="$(seam_file_state "$busy_src" "$busy_dst")"

prompt_src="$SEAMS_DIR/idle_prompt.py"
prompt_dst="$PKG/api/idle_prompt.py"
prompt_patch="$SEAMS_DIR/idle_prompt_api.patch"
mirror_patch="$SEAMS_DIR/idle_prompt_telegram.patch"
[ -f "$prompt_src" ] && [ -f "$prompt_patch" ] && [ -f "$mirror_patch" ] \
    || fail "idle_prompt seam files missing in $SEAMS_DIR"
prompt_module_state="$(seam_file_state "$prompt_src" "$prompt_dst")"

# Validate the complete ordered series on a disposable staged copy first.
# Later patches overlap earlier context. Peel an applied admission hook off
# this copy before classifying its prerequisites; never reverse the live target.
preflight="$(mktemp -d)"
trap 'rm -rf "$preflight"' EXIT
mkdir -p "$preflight/ductor_bot/orchestrator" "$preflight/ductor_bot/api"
cp "$PKG/orchestrator/lifecycle.py" "$preflight/ductor_bot/orchestrator/"
cp "$PKG/orchestrator/core.py" "$preflight/ductor_bot/orchestrator/"
cp "$PKG/api/server.py" "$preflight/ductor_bot/api/"
install -m 0644 "$module_src" "$preflight/ductor_bot/orchestrator/idle_compact.py"
install -m 0644 "$busy_src" "$preflight/ductor_bot/api/busy_state.py"
install -m 0644 "$prompt_src" "$preflight/ductor_bot/api/idle_prompt.py"
prompt_hook_state=missing
if patch -d "$preflight" -p1 --fuzz=0 --dry-run --reverse --force -s <"$prompt_patch" >/dev/null 2>&1; then
    prompt_hook_state=applied
    patch -d "$preflight" -p1 --fuzz=0 --reverse --force -s <"$prompt_patch" || fail "idle_prompt reverse preflight failed"
fi
hook_state="$(seam_patch_state "$hook_patch" "$preflight")"
[ "$hook_state" != drifted ] || fail "idle_compact: orchestrator/lifecycle.py drifted from the seam; regenerate it"
echo "idle_compact: module=$module_state hook=$hook_state"
busy_hook_state="$(seam_patch_state "$busy_patch" "$preflight")"
[ "$busy_hook_state" != drifted ] || fail "busy_state: API/lifecycle upstream drift; regenerate it"
echo "busy_state: module=$busy_module_state hook=$busy_hook_state"
if [ "$hook_state" = missing ]; then
    patch -d "$preflight" -p1 --fuzz=0 --forward -s <"$hook_patch" || fail "idle_compact preflight failed"
fi
if [ "$busy_hook_state" = missing ]; then
    patch -d "$preflight" -p1 --fuzz=0 --forward -s <"$busy_patch" || fail "busy_state preflight failed"
fi
[ "$(seam_patch_state "$prompt_patch" "$preflight")" = missing ] || fail "idle_prompt: API/lifecycle upstream drift; regenerate it"
echo "idle_prompt: module=$prompt_module_state hook=$prompt_hook_state"
patch -d "$preflight" -p1 --fuzz=0 --forward -s <"$prompt_patch" || fail "idle_prompt preflight failed"
mirror_hook_state="$(seam_patch_state "$mirror_patch" "$preflight")"
[ "$mirror_hook_state" != drifted ] || fail "idle_prompt: Telegram bus hook drifted"
if [ "$mirror_hook_state" = missing ]; then
    patch -d "$preflight" -p1 --fuzz=0 --forward -s <"$mirror_patch" || fail "Telegram bus preflight failed"
fi
"$PYTHON_BIN" -m compileall -q "$preflight/ductor_bot" || fail "complete series preflight compile failed"

if [ "$CHECK_ONLY" -eq 1 ]; then
    [ "$module_state" = applied ] && [ "$hook_state" = applied ] || missing=1
    [ "$busy_module_state" = applied ] && [ "$busy_hook_state" = applied ] || missing=1
    [ "$prompt_module_state" = applied ] && [ "$prompt_hook_state" = applied ] \
        && [ "$mirror_hook_state" = applied ] || missing=1
    exit "$missing"
fi

if [ "$module_state" = missing ]; then
    install -m 0644 "$module_src" "$module_dst"
    changed=1
fi
if [ "$hook_state" = missing ]; then
    patch -d "$SITE" -p1 --fuzz=0 --forward -s <"$hook_patch"
    changed=1
fi

if [ "$busy_module_state" = missing ]; then
    install -m 0644 "$busy_src" "$busy_dst"
    changed=1
fi
if [ "$busy_hook_state" = missing ]; then
    patch -d "$SITE" -p1 --fuzz=0 --forward -s <"$busy_patch"
    changed=1
fi

if [ "$prompt_module_state" = missing ]; then
    install -m 0644 "$prompt_src" "$prompt_dst"
    changed=1
fi
if [ "$prompt_hook_state" = missing ]; then
    patch -d "$SITE" -p1 --fuzz=0 --forward -s <"$prompt_patch"
    changed=1
fi
if [ "$mirror_hook_state" = missing ]; then
    patch -d "$SITE" -p1 --fuzz=0 --forward -s <"$mirror_patch"
    changed=1
fi

(cd /tmp && "$PYTHON_BIN" -m py_compile "$module_dst" "$busy_dst" "$prompt_dst" "$PKG/api/server.py" "$PKG/orchestrator/lifecycle.py" "$PKG/orchestrator/core.py") \
    || fail "py_compile failed after applying seams"
[ "$changed" -eq 1 ] && echo "ductor-seam-apply: seams applied to $SITE" || echo "ductor-seam-apply: already applied"
