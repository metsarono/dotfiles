#!/usr/bin/env python3
import importlib.util
import os
from pathlib import Path
import sys


def runtime():
    here = Path(__file__).resolve()
    candidates = [here.parent / 'claude_approval_runtime.py', here.parents[1] / 'lib/dotcortex/claude_approval_runtime.py']
    path = next(p for p in candidates if p.is_file())
    spec = importlib.util.spec_from_file_location('approval_runtime', path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module
import hashlib
import json
import subprocess

_runtime = runtime()
_away_status = _runtime._away_status
_present_refusal = _runtime._present_refusal


def _inversion_enabled(manifest):
    # Keep this identical to the engine's root_default_allow switch. A
    # timeout is allowed to fail open only while the inverted gate is active.
    section = manifest.get('gate_inversion', {'enabled': True})
    return isinstance(section, dict) and section.get('enabled') is True


def _floor_reason(event, manifest):
    """Re-check deterministic hard floors before an unavailable-engine allow."""
    try:
        here = Path(__file__).resolve()
        engine = next(path for path in (
            here.parent / 'claude_approval_kikin.py',
            here.parents[1] / 'lib/dotcortex/claude_approval_kikin.py')
            if path.is_file())
        spec = importlib.util.spec_from_file_location('approval_floor_check', engine)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        allow, reason = module.classify(event, module._load_manifest(manifest))
        if not allow and module._hard_refusal(reason):
            return reason
    except (OSError, ValueError, TypeError, AttributeError, ImportError, StopIteration):
        pass
    return None


def _log_timeout_allow(event):
    """Record a hash-only fail-open decision without making logging fatal."""
    try:
        import datetime
        path = Path(os.environ.get('SO_APPROVAL_KIKIN_LOG') or
                    Path.home() / '.local/state/dotcortex/claude-approval-kikin.jsonl')
        path.parent.mkdir(parents=True, exist_ok=True)
        event = event if isinstance(event, dict) else {}
        digest = hashlib.sha256(json.dumps(event.get('tool_input'), sort_keys=True,
                                           default=str).encode()).hexdigest()[:12]
        record = {
            'ts': datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds'),
            'session': str(event.get('session_id') or '')[:64],
            'tool': str(event.get('tool_name') or '')[:64],
            'decision': 'allow',
            'reason': 'engine-timeout-failed-open-under-inversion',
            'input_sha': digest,
            'decision_path': 'engine_timeout_fail_open',
            'judge_verdict': 'unavailable',
        }
        flags = os.O_WRONLY | os.O_APPEND | os.O_CREAT
        if hasattr(os, 'O_NOFOLLOW'):
            flags |= os.O_NOFOLLOW
        fd = os.open(path, flags, 0o600)
        with os.fdopen(fd, 'a') as handle:
            handle.write(json.dumps(record, separators=(',', ':')) + '\n')
    except Exception:
        pass


def defer(raw):
    try:
        manifest = _runtime._runtime_manifest()
    except (OSError, ValueError, TypeError):
        manifest = {}
    try:
        event = json.loads(raw)
    except ValueError:
        event = {'raw_input':raw}
    if (_inversion_enabled(manifest)
            and isinstance(event, dict)
            and event.get('hook_event_name') == 'PermissionRequest'
            and _floor_reason(event, manifest) is None):
        _log_timeout_allow(event)
        return {'hookSpecificOutput': {'hookEventName': 'PermissionRequest',
                'decision': {'behavior': 'allow'}}}
    away, away_reason = _away_status(manifest)
    if not away and away_reason != 'presence' and _present_refusal(manifest) == 'ask':
        return None
    try:
        item = _runtime._queue_upsert(event, 'engine_unavailable', away_reason, manifest)
    except (OSError, ValueError, TypeError, TimeoutError):
        item = None
    notification = False
    try:
        argv = manifest.get('notifications', {}).get('argv')
        if isinstance(argv, list) and argv and argv[0].startswith('/') and all(isinstance(a,str) and a and 'YOUR_' not in a for a in argv):
            message = {'schema':'dotcortex.approval.notification.v1', 'request_sha':hashlib.sha256(json.dumps(event,sort_keys=True,default=str).encode()).hexdigest()[:16],
                'reason':'engine_unavailable', 'away':away, 'queued':item is not None}
            notification = subprocess.run(argv, input=json.dumps(message), text=True, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL, timeout=0.75, check=False).returncode == 0
    except (OSError, ValueError, TypeError, AttributeError, subprocess.TimeoutExpired):
        pass
    note = 'deferred: engine unavailable; '+("queued for the Admiral's morning review" if away or away_reason == 'presence' else "awaiting the Admiral's approval on the Desk/Telegram")
    note += '; queue item '+item if item else '; morning queue unavailable'
    if not notification: note += '; Telegram notification unavailable'
    return {'hookSpecificOutput':{'hookEventName':'PermissionRequest','decision':{'behavior':'deny','message':note+'; '+_runtime.DEFERRED_ACTION,'interrupt':False}}}


def recall_prompt(raw, started, outcome=None):
    # The plugin posts a Telegram prompt for every PermissionRequest at once;
    # retract it after an allow (agents-approval-telegram-recall.org).
    if not os.environ.get('TELEGRAM_STATE_DIR'):
        return
    helper = Path(__file__).resolve().parents[1] / 'lib/dotcortex/telegram_permission_recall.py'
    try:
        argv=['/usr/bin/python3',str(helper),repr(started)]
        if outcome:argv.append(outcome)
        child = subprocess.Popen(argv, stdin=subprocess.PIPE,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True, text=True)
        child.stdin.write(raw)
        child.stdin.close()
    except (OSError, ValueError):
        pass


def main():
    import time
    started = time.time()
    raw = sys.stdin.read(1024*1024+1)
    here = Path(__file__).resolve()
    override = os.environ.get('DOTCORTEX_KIKIN_APPROVAL_ENGINE') or os.environ.get('DOTCORTEX_APPROVAL_ENGINE')
    candidates = [Path(override)] if override else [here.parent/'claude_approval_kikin.py', here.parents[1]/'lib/dotcortex/claude_approval_kikin.py']
    output = None
    try:
        engine = next(p for p in candidates if p.is_file())
        manifest = _runtime._runtime_manifest()
        away, why = _away_status(manifest)
        budget = 6.0 + (_runtime._hold_seconds(manifest) if not away and why == 'presence' else 0)
        result = subprocess.run(['/usr/bin/python3',str(engine)],input=raw,text=True,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,timeout=budget,check=False)
        if result.returncode == 0 and not result.stdout.strip() and not away and why != 'presence' and _present_refusal(manifest) == 'ask':
            return 0
        parsed = json.loads(result.stdout)
        hook = parsed['hookSpecificOutput']; decision = hook['decision']
        if result.returncode == 0 and hook['hookEventName'] == 'PermissionRequest' and decision['behavior'] in {'allow','deny'} and (decision['behavior'] == 'allow' or decision.get('interrupt') is False):
            output = parsed
    except (StopIteration, OSError, ValueError, TypeError, KeyError, subprocess.TimeoutExpired):
        pass
    if output is None: output = defer(raw)
    if output is not None: print(json.dumps(output,ensure_ascii=True,separators=(',',':')), flush=True)
    if output is not None and output['hookSpecificOutput']['decision']['behavior'] == 'allow':
        recall_prompt(raw, started)
    elif output is not None:
        recall_prompt(raw,started,'denied')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
