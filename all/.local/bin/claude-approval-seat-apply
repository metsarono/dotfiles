#!/usr/bin/env python3
import argparse
import json
import os
from pathlib import Path
import tempfile


SEATS = ("fable", "opus", "haiku", "auryn")
HOOK_NAME = "claude-hook-permission-request-kikin"
FRAGMENT = Path(__file__).resolve().parents[2] / ".config/dotcortex/claude-kikin-settings.fragments.json"


def load_fragment(path=FRAGMENT):
    value = json.loads(Path(path).read_text(encoding="utf-8"))
    if value.get("schema") != "hc.approval.canary.kikin.settings-fragments.v1":
        raise ValueError("unsupported Kikin approval fragment")
    if tuple(value.get("required_seats", ())) != SEATS:
        raise ValueError("Kikin approval fragment does not cover all seats")
    entries = value.get("entries")
    if not isinstance(entries, dict) or set(entries) != set(SEATS):
        raise ValueError("Kikin approval fragment seat set is incomplete")
    for seat in SEATS:
        groups = entries[seat].get("PermissionRequest")
        if not isinstance(groups, list) or len(groups) != 1:
            raise ValueError(f"invalid PermissionRequest fragment for {seat}")
        hooks = groups[0].get("hooks")
        if not isinstance(hooks, list) or len(hooks) != 1:
            raise ValueError(f"invalid hook fragment for {seat}")
        command = hooks[0].get("command")
        if not isinstance(command, str) or HOOK_NAME not in command:
            raise ValueError(f"invalid approval hook command for {seat}")
    return value


def _regular_json(path):
    candidate = Path(path).expanduser()
    if candidate.is_symlink() or not candidate.is_file():
        raise ValueError(f"settings file must be a regular file: {candidate}")
    value = json.loads(candidate.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise ValueError("settings root must be an object")
    return candidate, value


def _seat_group(fragment, seat):
    return json.loads(json.dumps(fragment["entries"][seat]["PermissionRequest"]))


def merge_seat_settings(settings, fragment, seat):
    if seat not in SEATS:
        raise ValueError(f"unknown Kikin Claude seat: {seat}")
    hooks = settings.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise ValueError("settings hooks must be an object")
    groups = hooks.setdefault("PermissionRequest", [])
    if not isinstance(groups, list):
        raise ValueError("settings PermissionRequest must be an array")
    retained = []
    for group in groups:
        if not isinstance(group, dict):
            raise ValueError("settings hook group must be an object")
        group_hooks = group.get("hooks", [])
        if not isinstance(group_hooks, list):
            raise ValueError("settings hook group hooks must be an array")
        if any(isinstance(item, dict) and HOOK_NAME in str(item.get("command", ""))
               for item in group_hooks):
            continue
        retained.append(group)
    hooks["PermissionRequest"] = retained + _seat_group(fragment, seat)
    return settings


def write_json(path, value):
    path = Path(path)
    mode = path.stat().st_mode & 0o777
    if mode & 0o077:
        raise ValueError("settings file must not be group/other readable")
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent,
                                    prefix=path.name + ".", delete=False) as handle:
        temporary = Path(handle.name)
        os.fchmod(handle.fileno(), mode)
        json.dump(value, handle, ensure_ascii=False, indent=2, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, path)


def main(argv=None):
    parser = argparse.ArgumentParser(description="Apply one reviewed Kikin Claude approval hook")
    parser.add_argument("--seat", required=True, choices=SEATS)
    parser.add_argument("--settings", required=True, type=Path)
    parser.add_argument("--fragment", type=Path, default=FRAGMENT)
    parser.add_argument("--apply", action="store_true", help="write the merged settings")
    args = parser.parse_args(argv)
    fragment = load_fragment(args.fragment)
    settings_path, settings = _regular_json(args.settings)
    merged = merge_seat_settings(settings, fragment, args.seat)
    if args.apply:
        write_json(settings_path, merged)
        print(f"applied {args.seat} approval hook to {settings_path}")
    else:
        print(json.dumps(merged, ensure_ascii=False, sort_keys=True))
        print(f"dry-run {args.seat}: pass --apply to write {settings_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
