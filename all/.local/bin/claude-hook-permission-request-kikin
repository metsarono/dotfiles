#!/usr/bin/env python3
import json
import os
import subprocess
import sys
import time
from pathlib import Path


def recall_prompt(raw, started):
    if not os.environ.get("TELEGRAM_STATE_DIR"):
        return
    helper = Path(__file__).resolve().parents[1] / "lib/dotcortex/telegram_permission_recall.py"
    if not helper.is_file():
        return
    try:
        child = subprocess.Popen(["/usr/bin/python3", str(helper), repr(started)], stdin=subprocess.PIPE,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True, text=True)
        child.stdin.write(raw)
        child.stdin.close()
    except (OSError, ValueError):
        pass


def allowed(stdout):
    try:
        return json.loads(stdout)["hookSpecificOutput"]["decision"]["behavior"] == "allow"
    except (ValueError, TypeError, KeyError):
        return False


def main():
    started = time.time()
    raw = sys.stdin.read()
    override = os.environ.get("DOTCORTEX_KIKIN_APPROVAL_ENGINE")
    if override:
        candidates = [Path(override)]
    else:
        candidates = [
            Path.home() / ".local/lib/dotcortex/claude_approval_kikin.py",
            Path(__file__).resolve().parents[1] / "lib/dotcortex/claude_approval_kikin.py",
        ]
    for engine in candidates:
        if engine.is_file():
            try:
                # Claude invokes hooks with a deliberately small environment;
                # retain the seat's CLI prefixes so coordinator_codex_dispatch
                # resolves the same codex binary the seat uses interactively.
                env = os.environ.copy()
                prefixes = [Path.home() / ".local/bin", Path.home() / ".npm-global/bin", Path.home() / ".bun/bin"]
                env["PATH"] = ":".join(str(path) for path in prefixes) + ":" + env.get("PATH", "/usr/bin:/bin")
                result = subprocess.run(["/usr/bin/python3", str(engine)], input=raw, text=True,
                                        stdout=subprocess.PIPE, env=env, check=False)
            except OSError:
                return 0
            sys.stdout.write(result.stdout)
            sys.stdout.flush()
            if result.returncode == 0 and allowed(result.stdout):
                recall_prompt(raw, started)
            return result.returncode
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
