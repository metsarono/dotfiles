#!/usr/bin/env python3
"""Relaunch dead enabled Telegram agents and publish alerts to the notification spool."""
from __future__ import annotations

import argparse
from contextlib import closing
import datetime as dt
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import re
import shutil
import socket
import sqlite3
import stat as statmod
import subprocess
import sys
import tempfile
import time
import uuid

SOURCE = "agent_watchdog"
SCHEMA = "helmcortex.notification.v1"
STATE_SCHEMA = "dotcortex.telegram-agent-watchdog.v1"
REQUEST_SCHEMA = "dotcortex.telegram-agent-revive-request.v1"
RENEW_JOURNAL_SCHEMA = "codex.telegram.renew-watchdog.v1"
PROC_ROOT = Path("/proc")

# Agents whose supervisor exposes a pid file: the request records that
# process's identity (pid and start-time) as the generation fence. Agents not
# listed here are unfenced and are revived only while they read as up.
PID_FILES = {
    "codex": "codex-helmastra-telegram.pid",
}

WARM_PREFIX = "warm-"
WARM_REVIVE_GRACE = 30

# Enabled-agent name -> the status line that reports its liveness.
STATUS_LABELS = {
    "opencode": r"opencode:",
    "ductor": r"ductor:",
    "claudecode": r"claudecode \(",
    "hermes": r"hermes gateway run:",
    "codex": r"codex-helmastra",
    "deepseek-harness": r"deepseek-harness:",
    "pi-agent": r"pi-agent:",
    "nanobot": r"nanobot:",
}


def state_home() -> Path:
    return Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="telegram-agent-watchdog",
        description="Relaunch dead enabled Telegram agents and alert through the notification spool.",
    )
    parser.add_argument("--expected-host", required=True, help="refuse to run on any other host")
    parser.add_argument("--manager", default=str(Path.home() / ".local/bin/telegram-agent-host"))
    parser.add_argument("--state-dir", default=str(state_home() / "telegram-agent-watchdog"))
    parser.add_argument("--intent-dir", default=str(state_home() / "telegram-agents/intentional-stop"))
    parser.add_argument("--boot-lock", default=str(state_home() / "telegram-agent-boot/boot.lock"))
    parser.add_argument("--spool", default=str(state_home() / "helmcortex-notifications/spool"))
    parser.add_argument("--pid-dir", default=str(state_home() / "telegram-agents"))
    parser.add_argument("--adapter-state-dir", default=str(Path.home() / ".local/state/codex-telegram-helmastra"),
                        help="operator-owned Codex adapter state root; renewal never trusts a path from a request")
    parser.add_argument("--codex-supervisor",
                        help="optional exact codex_supervisor.py source path to check against the live managed process")
    parser.add_argument("--revive-cooldown", type=int, default=600, help="seconds between self-revives of one agent")
    parser.add_argument("--request-timeout", type=int, default=900, help="drop a revive request whose requester never detaches")
    parser.add_argument("--max-attempts", type=int, default=3, help="relaunch attempts per down episode")
    parser.add_argument("--backoff", type=int, default=120, help="base seconds between attempts; doubles each attempt")
    parser.add_argument("--start-timeout", type=int, default=240)
    parser.add_argument("--warm-revive-grace", type=float, default=WARM_REVIVE_GRACE,
                        help="seconds to wait for a warm seat's graceful exit before self-request force escalation")
    parser.add_argument("--warm-file", default=str(Path.home() / ".config/telegram-agent-watchdog/warm-sessions"),
                        help="private list of nurse-joy warm sessions to supervise, one name per line")
    parser.add_argument("--nurse", default=shutil.which("nurse-joy") or str(Path.home() / ".local/hx/bin/nurse-joy"))
    parser.add_argument("--tmux", default=shutil.which("tmux") or "tmux", help="tmux binary used to tell a dead server from a stale reading")
    parser.add_argument("--dry-run", action="store_true", help="report decisions without relaunching or publishing")
    return parser.parse_args(argv)


def atomic_write(path: Path, data: bytes) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".tmp-", dir=str(path.parent))
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def load_state(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {"schema": STATE_SCHEMA, "agents": {}}
    except (OSError, ValueError):
        return {"schema": STATE_SCHEMA, "agents": {}}
    if not isinstance(value, dict) or not isinstance(value.get("agents"), dict):
        return {"schema": STATE_SCHEMA, "agents": {}}
    return value


def child_env() -> dict[str, str]:
    """Cron carries no XDG_RUNTIME_DIR. A tmux server or warm session started from here inherits
    this environment, and claude-warm refuses to supervise without it (2026-10-09: every warm
    revive failed after a kill until the tmux global env was fixed by hand)."""
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    return env


def run_manager(manager: str, args: list[str], timeout: int) -> subprocess.CompletedProcess:
    return subprocess.run(
        [manager, *args],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        timeout=timeout,
        close_fds=True,
        env=child_env(),
    )


def classify(agent: str, status_text: str) -> str:
    """Return up, down, or unknown from the agent's own status line."""
    pattern = STATUS_LABELS.get(agent)
    if pattern is None:
        return "unknown"
    verdicts = set()
    for line in status_text.splitlines():
        if re.match(r"^\s*" + pattern, line):
            if re.search(r"\bRUNNING\b", line):
                verdicts.add("up")
            elif re.search(r"\bSTOPPED\b", line):
                verdicts.add("down")
    return verdicts.pop() if len(verdicts) == 1 else "unknown"


def read_warm_sessions(path: Path) -> list[str]:
    """Warm Claude sessions to supervise, from a private machine-local list (topology stays out of source)."""
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    names: list[str] = []
    for line in lines:
        name = line.split("#", 1)[0].strip()
        if name and re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]*", name) and name.lower() not in [n.lower() for n in names]:
            names.append(name)
    return names


def tmux_server_running(tmux: str) -> bool | None:
    """True or False when tmux answers clearly; None when the probe itself fails."""
    try:
        run = subprocess.run([tmux, "ls"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.PIPE, text=True, timeout=15, close_fds=True)
    except (OSError, subprocess.SubprocessError):
        return None
    if run.returncode == 0:
        return True
    if re.search(r"no server running|error connecting to .*No such file or directory", run.stderr or ""):
        return False
    return None


def warm_verdicts(nurse: str, names: list[str], timeout: int, tmux: str | None = None) -> dict[str, str]:
    """Map each warm session to up, down, or unknown from nurse-joy's own verdict; anything unreadable is unknown."""
    verdicts = {name: "unknown" for name in names}
    if not names:
        return verdicts
    try:
        run = subprocess.run([nurse, "status", "--json"], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, text=True, timeout=timeout, close_fds=True)
        members = json.loads(run.stdout).get("members", [])
    except (OSError, subprocess.SubprocessError, ValueError, AttributeError):
        return verdicts
    seen = {str(m.get("name", "")).lower(): m.get("verdict") for m in members if isinstance(m, dict)}
    for name in names:
        verdict = seen.get(name.lower())
        # field and degraded (alive, e.g. stale agent code) are up; only down drives action.
        verdicts[name] = "up" if verdict in ("field", "degraded") else "down" if verdict == "down" else "unknown"
    # Every warm session lives in tmux. When the tmux server itself is gone (a user-wide kill took it),
    # nurse-joy can only report "unknown"; that is not ambiguity, every warm session is down.
    if tmux and "unknown" in verdicts.values() and tmux_server_running(tmux) is False:
        verdicts = {name: ("down" if verdict == "unknown" else verdict) for name, verdict in verdicts.items()}
    return verdicts


def warm_members(nurse: str, timeout: int) -> dict[str, dict]:
    """Return nurse-joy's reported warm-seat members, or an empty map on unreadable status."""
    try:
        run = subprocess.run([nurse, "status", "--json"], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, text=True, timeout=timeout, close_fds=True)
        value = json.loads(run.stdout)
    except (OSError, subprocess.SubprocessError, ValueError):
        return {}
    members = value.get("members", []) if isinstance(value, dict) else []
    return {str(m.get("name", "")).lower(): m for m in members
            if isinstance(m, dict) and isinstance(m.get("name"), str)}


def warm_state(name: str, member: dict | None = None) -> dict:
    """Read the live claude-warm runtime state for a label, resolving its channel privately."""
    state_root = state_home() / "claude-idle-compaction"
    label = name.replace(" ", "-")
    last_path = state_root / ("last-session.%s.json" % label)
    try:
        last = json.loads(last_path.read_text(encoding="utf-8"))
        channel = last.get("channel")
        if not isinstance(channel, str) or not re.fullmatch(r"claude-[0-9a-f]{32}", channel):
            return {}
        runtime_root = Path(os.environ.get("XDG_RUNTIME_DIR") or ("/run/user/%d" % os.getuid()))
        state = json.loads((runtime_root / "claude-idle-compaction" / channel / "state.json").read_text(encoding="utf-8"))
    except (OSError, ValueError, AttributeError):
        return {}
    if not isinstance(state, dict):
        return {}
    if member:
        # nurse-joy's live report is the seat roster; reject a mismatched supervisor
        # rather than trusting an old label record after that label has been rebound.
        reported_pid = member.get("supervisor_pid")
        if reported_pid is not None and str(reported_pid) != str(state.get("supervisor_pid")):
            return {}
    return state


def proc_generation(pid: object) -> str | None:
    """Return pid and Linux kernel start-time for a live process, or None."""
    try:
        number = int(pid)
        fields = Path("/proc/%d/stat" % number).read_text().rsplit(")", 1)[1].split()
        if fields[0] == "Z":
            return None
        return "%d:%s" % (number, fields[19])
    except (OSError, ValueError, IndexError, TypeError):
        return None


def warm_resume_identity(name: str, member: dict | None = None) -> tuple[str | None, str | None]:
    """Return supervisor generation and newest reported transcript's session id."""
    state = warm_state(name, member)
    pid = state.get("supervisor_pid")
    generation = proc_generation(pid)
    if generation is None:
        return None, None
    candidates: list[Path] = []
    for value in (state.get("transcript_path"), (member or {}).get("transcript_path"), (member or {}).get("transcript")):
        if isinstance(value, str) and value:
            candidates.append(Path(value).expanduser())
    transcripts = (member or {}).get("transcripts")
    if isinstance(transcripts, list):
        candidates.extend(Path(item).expanduser() for item in transcripts if isinstance(item, str))
    existing: list[tuple[float, Path]] = []
    for candidate in candidates:
        try:
            existing.append((candidate.stat().st_mtime, candidate))
        except OSError:
            pass
    if not existing:
        return generation, None
    transcript = max(existing, key=lambda item: item[0])[1]
    session_id = transcript.name[:-6] if transcript.name.endswith(".jsonl") else transcript.stem
    if not re.fullmatch(r"[A-Fa-f0-9-]{16,64}", session_id):
        return generation, None
    return generation, session_id


def live_session_refusal(nurse: str, name: str, session_id: str) -> str | None:
    """The shared live-session guard (nurse-joy `live-session` verb): the
    refusal message when the resume id is live in another process, else None.

    2026-10-17, Fable seat diagnosis Part 2: a warm revive must never relaunch
    onto a conversation already held by a live pty host — the 2026-10-17
    incident /exit-ed the tmux supervisor for nothing and every relaunch was
    refused by the token preflight. The check itself lives in nurse-joy (one
    copy); this lane only consumes its JSON. Fails CLOSED: an unavailable or
    unreadable check refuses too, because a second writer on a live session is
    the one failure this guard exists to prevent."""
    try:
        proc = subprocess.run([nurse, "live-session", name, session_id], stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
                              timeout=30, close_fds=True, env=child_env())
    except (OSError, subprocess.TimeoutExpired):
        return ("live-session check unavailable (nurse-joy live-session did not run); "
                "refusing rather than risk a second writer on session %s" % session_id)
    if proc.returncode != 0:
        return ("live-session check unavailable (nurse-joy live-session failed); "
                "refusing rather than risk a second writer on session %s" % session_id)
    try:
        payload = json.loads(proc.stdout)
    except ValueError:
        return ("live-session check unreadable; refusing rather than risk a second writer on session %s" % session_id)
    if payload.get("live") is True:
        return str(payload.get("message") or "session %s is live in another process" % session_id)
    return None


def make_event(host: str, agent: str, kind: str, severity: str, title: str, body: str, payload: dict, when: dt.datetime) -> dict:
    return {
        "schema": SCHEMA,
        "source": SOURCE,
        "kind": kind,
        "severity": severity,
        "dedupe_key": "agent_watchdog:%s:%s:%s:%s" % (host, agent, kind, when.strftime("%Y%m%dT%H%M%S")),
        "title": title,
        "body": body,
        "link": None,
        "audience": ["metsatron"],
        "occurred_at": when.isoformat(timespec="seconds"),
        "expires_at": None,
        "payload": dict(payload, host=host, agent=agent),
    }


def publish(event: dict, spool: Path, when: dt.datetime) -> None:
    token = uuid.uuid4().hex
    # Full epoch nanoseconds preserve emission order across second boundaries.
    name = "%s-%s-%019d-%s.json" % (SOURCE, when.astimezone(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ"), time.time_ns(), token)
    atomic_write(spool / name, (json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8"))


def boot_owns_lock(path: Path) -> bool:
    try:
        fd = os.open(str(path), os.O_RDWR)
    except OSError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return True
    finally:
        os.close(fd)
    return False


def generation_of(agent: str, pid_dir: Path) -> str | None:
    """Identity of the agent's supervisor: pid plus kernel start-time, or None when unfenced."""
    name = PID_FILES.get(agent)
    if name is None:
        return None
    try:
        pid = int((pid_dir / name).read_text().strip())
        stat = Path("/proc/%d/stat" % pid).read_text()
    except (OSError, ValueError):
        return "absent"
    # Field 22 (starttime) counted after the parenthesised command name.
    fields = stat.rsplit(")", 1)[1].split()
    return "%d:%s" % (pid, fields[19])


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def private_bytes(path: Path, maximum: int = 4 * 1024 * 1024) -> bytes:
    """Read only a private, same-user regular file without following a link."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        status = os.fstat(fd)
        if (not statmod.S_ISREG(status.st_mode) or status.st_uid != os.getuid()
                or status.st_mode & 0o077 or status.st_size > maximum):
            raise ValueError("renewal input must be an owner-only bounded regular file")
        with os.fdopen(os.dup(fd), "rb") as handle:
            result = handle.read(maximum + 1)
        if len(result) > maximum:
            raise ValueError("renewal input exceeded its bound")
        return result
    finally:
        os.close(fd)


def private_json(path: Path) -> dict:
    result = json.loads(private_bytes(path))
    if not isinstance(result, dict):
        raise ValueError("renewal input is not an object")
    return result


def process_identity(pid: int) -> tuple[str, int, list[bytes]]:
    proc = PROC_ROOT / str(pid)
    fields = (proc / "stat").read_text().rsplit(")", 1)[1].split()
    if proc.stat().st_uid != os.getuid() or fields[0] == "Z":
        raise ValueError("process owner or liveness invalid")
    return f"{pid}:{fields[19]}", int(fields[1]), (proc / "cmdline").read_bytes().split(b"\0")


def codex_owner(args: argparse.Namespace, adapter_identity: str | None = None) -> dict | None:
    """Inspect the exact managed parent and child, independently of receipts."""
    pid_path = Path(args.pid_dir) / PID_FILES["codex"]
    try:
        pid = int(pid_path.read_text().strip())
        identity, _, argv = process_identity(pid)
    except FileNotFoundError:
        return None
    live_scripts = [os.fsdecode(arg) for arg in argv
                    if Path(os.fsdecode(arg)).name == "codex_supervisor.py"]
    if len(live_scripts) != 1 or not Path(live_scripts[0]).is_absolute():
        raise ValueError("canonical Codex supervisor ownership is unproved")
    supervisor = str(Path(live_scripts[0]).resolve())
    if not Path(supervisor).is_file():
        raise ValueError("canonical Codex supervisor source is unavailable")
    if args.codex_supervisor and str(Path(args.codex_supervisor).resolve()) != supervisor:
        raise ValueError("configured Codex supervisor does not match the live managed process")
    # Prior ready receipts supply an adapter identity; successor child-ready
    # is independently written by the new adapter via the existing launcher.
    if adapter_identity is None:
        try:
            child = int((Path(args.pid_dir) / "codex-helmastra-telegram.child.ready").read_text().strip())
        except FileNotFoundError:
            return {"generation": identity, "adapter": None, "uid": os.getuid()}
    else:
        if not re.fullmatch(r"[1-9][0-9]*:[0-9]+", str(adapter_identity)):
            raise ValueError("invalid adapter identity")
        child = int(adapter_identity.split(":", 1)[0])
    try:
        child_identity, parent, child_argv = process_identity(child)
    except FileNotFoundError:
        if adapter_identity is None:
            return {"generation": identity, "adapter": None, "uid": os.getuid()}
        raise
    expected_adapter = str(Path(supervisor).with_name("codex_telegram.py"))
    if (parent != pid or os.fsencode(expected_adapter) not in child_argv
            or (adapter_identity is not None and child_identity != adapter_identity)
            or process_identity(pid)[0] != identity or process_identity(child)[0] != child_identity
            or pid_path.read_text().strip() != str(pid)):
        raise ValueError("Codex adapter/supervisor generation does not match")
    return {"generation": identity, "adapter": child_identity, "uid": os.getuid()}


def require_old_generation_absent(request: dict) -> None:
    """A missing pid marker is not evidence that the old process exited."""
    pid = int(request["generation"].split(":", 1)[0])
    try:
        live, _, _ = process_identity(pid)
    except FileNotFoundError:
        return
    if live == request["generation"]:
        raise ValueError("original supervisor generation remains alive despite absent ownership marker")


def validate_renew_request(request: dict) -> None:
    if (request.get("schema") != REQUEST_SCHEMA or request.get("mode") != "renew"
            or request.get("agent") != "codex"
            or not re.fullmatch(r"[a-f0-9]{32}", str(request.get("id", "")))
            or not re.fullmatch(r"[1-9][0-9]*:[0-9]+", str(request.get("generation", "")))
            or not re.fullmatch(r"[1-9][0-9]*:[0-9]+", str(request.get("adapter", "")))
            or request.get("uid") != os.getuid() or type(request.get("uid")) is not int
            or type(request.get("task_id")) is not int or request["task_id"] <= 0
            or not isinstance(request.get("old_thread_id"), str) or not request["old_thread_id"].strip()
            or type(request.get("requested_at")) not in (int, float)
            or not math.isfinite(request["requested_at"]) or request["requested_at"] < 0):
        raise ValueError("malformed or unsupported renewal request")
    if any(key in request for key in ("continuity_seed", "seed_sha256", "seed_kind")):
        seed = request.get("continuity_seed")
        if (request.get("seed_kind") != "operator-reviewed" or not isinstance(seed, str) or not seed.strip()
                or len(seed.encode()) > 200 * 1024
                or hashlib.sha256(seed.encode()).hexdigest() != request.get("seed_sha256")):
            raise ValueError("reviewed continuity seed does not match its recorded hash")


def renew_pin(args: argparse.Namespace, request: dict, ready: dict | None = None) -> dict:
    """Bind the committed transaction to this exact request, never a nearby pin."""
    sessions = private_json(Path(args.adapter_state_dir) / "sessions.json")
    matches = [row for row in sessions.values() if isinstance(row, dict)
               and isinstance(row.get("renewal"), dict)
               and isinstance(row["renewal"].get("external_request"), dict)
               and row["renewal"]["external_request"].get("id") == request["id"]]
    if len(matches) != 1:
        raise ValueError("committed renewal pin is missing or ambiguous")
    row = matches[0]
    receipt = row.get("renewal", {})
    external = receipt.get("external_request", {})
    bound = ("id", "agent", "mode", "generation", "adapter", "uid", "task_id", "old_thread_id",
             "continuity_seed", "seed_sha256", "seed_kind")
    if (any(external.get(key) != request.get(key) for key in bound)
            or receipt.get("phase") != "committed"
            or receipt.get("old_thread_id") != request["old_thread_id"]
            or not row.get("thread_id") or row.get("thread_id") == request["old_thread_id"]
            or row.get("thread_id") != receipt.get("candidate_thread_id")
            or not re.fullmatch(r"[a-f0-9]{32}", str(receipt.get("id", "")))
            or not isinstance(receipt.get("seed"), str)
            or hashlib.sha256(receipt["seed"].encode()).hexdigest() != receipt.get("seed_sha256")):
        raise ValueError("committed renewal provenance differs from request")
    if ready is not None and (ready.get("transaction_id") != receipt["id"]
            or ready.get("new_thread_id") != row["thread_id"]
            or ready.get("seed_sha256") != receipt["seed_sha256"]):
        raise ValueError("ready receipt differs from committed pin")
    return {"new_thread_id": row["thread_id"], "transaction_id": receipt["id"],
            "seed_sha256": receipt["seed_sha256"]}


def renew_task_delivered(args: argparse.Namespace, task_id: int, request_id: str) -> None:
    """Read the canonical ledger without recovering or mutating any row."""
    database = Path(args.adapter_state_dir) / "tasks.sqlite3"
    # Check file identity and private mode before SQLite opens it read-only.
    fd = os.open(database, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        mode = os.fstat(fd)
        if mode.st_uid != os.getuid() or mode.st_mode & 0o077 or not statmod.S_ISREG(mode.st_mode):
            raise ValueError("renewal task ledger is not private")
        with closing(sqlite3.connect(database.resolve().as_uri() + "?mode=ro", uri=True, timeout=1)) as connection:
            row = connection.execute("SELECT chat_id, status, delivered FROM tasks WHERE task_id = ?", (task_id,)).fetchone()
            unsettled = connection.execute("SELECT COUNT(*) FROM tasks WHERE status = 'running' OR "
                "(status IN ('succeeded','failed','interrupted','cancelled') AND delivered = 0)").fetchone()[0]
        if row is None or row[1:] != ("succeeded", 1) or unsettled:
            raise ValueError("source task or another task is still active or undelivered")
        sessions = private_json(Path(args.adapter_state_dir) / "sessions.json")
        chats = [str(chat) for chat, value in sessions.items() if isinstance(value, dict)
            and isinstance(value.get("renewal"), dict)
            and isinstance(value["renewal"].get("external_request"), dict)
            and value["renewal"]["external_request"].get("id") == request_id]
        if chats != [str(row[0])]:
            raise ValueError("source task belongs to another session chat")
        after = database.stat()
        if (after.st_dev, after.st_ino) != (mode.st_dev, mode.st_ino):
            raise ValueError("renewal ledger identity changed")
    finally:
        os.close(fd)


def renew_journal_write(path: Path, journal: dict) -> None:
    """Durable ordering barrier before manager effects and release publication."""
    atomic_write(path, (json.dumps(journal, sort_keys=True) + "\n").encode())
    # Existing watchdog atomic_write is not a directory durability barrier.
    for directory in (path.parent, path.parent.parent):
        fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)


def renew_refused_pin(args: argparse.Namespace, request: dict, failed: dict) -> None:
    """A failure ack may close only an unchanged source, never a committed pin."""
    if failed.get("old_thread_id") != request["old_thread_id"]:
        raise ValueError("adapter failure acknowledges a different source")
    sessions = private_json(Path(args.adapter_state_dir) / "sessions.json")
    rows = [row for row in sessions.values() if isinstance(row, dict)]
    if sum(row.get("thread_id") == request["old_thread_id"] for row in rows) != 1:
        raise ValueError("adapter failure does not preserve the exact original pin")
    if any(isinstance(row.get("renewal"), dict) and row["renewal"].get("phase") == "committed"
            and isinstance(row["renewal"].get("external_request"), dict)
            and row["renewal"]["external_request"].get("id") == request["id"] for row in rows):
        raise ValueError("adapter failure conflicts with a committed pin; recovery required")


def renew_cooldown(args: argparse.Namespace, completed_at: float | None = None) -> float:
    path = Path(args.state_dir) / "renewal-cooldown.json"
    value = private_json(path) if path.exists() else {}
    prior = value.get("codex", 0)
    if type(prior) not in (int, float) or not math.isfinite(prior):
        raise ValueError("renewal cooldown record is invalid")
    if completed_at is not None:
        prior = max(prior, completed_at)
        renew_journal_write(path, {"codex": prior})
    return prior


def renew_release_accepted(args: argparse.Namespace, request: dict, pin: dict, owner: dict) -> None:
    ack = private_json(Path(args.adapter_state_dir) / "renew-released.json")
    if (ack.get("schema") != "codex.telegram.renew-released.v1"
            or ack.get("request_id") != request["id"] or ack.get("old_generation") != request["generation"]
            or ack.get("new_thread_id") != pin["new_thread_id"] or ack.get("transaction_id") != pin["transaction_id"]
            or ack.get("admission_holding") is not False or any(ack.get(k) != owner[k] for k in owner)
            or owner["generation"] == request["generation"]):
        raise ValueError("adapter release acknowledgement does not match current owner and transaction")
    sessions = private_json(Path(args.adapter_state_dir) / "sessions.json")
    matches = [row for row in sessions.values() if isinstance(row, dict)
        and isinstance(row.get("renewal"), dict) and row["renewal"].get("id") == pin["transaction_id"]]
    if len(matches) != 1 or not isinstance(matches[0]["renewal"].get("released_at"), (int, float)) or not matches[0]["renewal"]["released_at"] > 0:
        raise ValueError("adapter has not durably accepted release")


CODEX_TRAINER = "HelmAstra"


def renew_exp_link(args: argparse.Namespace, request: dict, pin: dict) -> dict:
    """Prove the successor session accrues EXP to its trainer's partner.

    Renewal replaces the session. If the new id is not linked to the same
    partner, EXP silently stops accruing even though the bounce looks healthy.
    Read-only: it never blocks or reverts a committed renewal, but an unlinked
    or unreadable result is recorded and surfaced in the renew_done event.
    """
    record = {
        "schema": "codex.telegram.renew-exp-link.v1",
        "request_id": request.get("id"),
        "new_thread_id": pin.get("new_thread_id"),
        "expected_consort": CODEX_TRAINER,
        "checked_at": None,
        "exit": None,
        "linked": None,
        "partner_key": None,
        "partner_consort": None,
        "exp": None,
        "exp_updated_at": None,
        "reason": None,
        "error": None,
    }
    pokedex = shutil.which("pokedex") or str(Path.home() / "HelmCortex/FORGE/bin/pokedex")
    thread = pin.get("new_thread_id")
    try:
        done = subprocess.run(
            [pokedex, "exp-link", "--session", str(thread), "--consort", CODEX_TRAINER, "--json"],
            capture_output=True, text=True, timeout=25, check=False)
        record["exit"] = done.returncode
        if done.stdout.strip():
            payload = json.loads(done.stdout)
            data = payload.get("data") if isinstance(payload, dict) and isinstance(payload.get("data"), dict) else payload
            for key in ("linked", "partner_key", "partner_consort", "exp", "exp_updated_at", "reason", "resolved_key"):
                if isinstance(data, dict) and key in data:
                    record[key] = data[key]
        elif done.returncode != 0:
            record["error"] = (done.stderr or "exp-link failed").strip()[:200]
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        record["error"] = type(exc).__name__
    record["checked_at"] = time.time()
    try:
        renew_journal_write(Path(args.state_dir) / "renewals" / f"exp-link.{request.get('id')}.json", record)
    except Exception:
        pass
    return record


def process_renewal(args: argparse.Namespace, request: dict, path: Path,
                    host: str, state: dict, when: dt.datetime, now: float) -> list[dict]:
    """Adapter pause -> committed pin -> once-only external bounce -> release.

    A stop-intent whose outcome is unknown is never replayed. A known failed
    manager start is retried only while the old owner is absent, under bounded
    pacing. Every unresolved committed state retains its queue file and records
    actionable recovery, keeping the source/candidate provenance inspectable.
    """
    journal_path = Path(args.state_dir) / "renewals" / (str(request.get("id", "invalid")) + ".json")
    adapter_root = Path(args.adapter_state_dir)
    journal = None
    def event(kind, reason, severity="critical"):
        key = hashlib.sha256((kind + ":" + reason).encode()).hexdigest()
        if journal is not None and journal.get("last_notice") == key:
            return []
        if journal is not None and not args.dry_run:
            journal["last_notice"] = key
            renew_journal_write(journal_path, journal)
        message = make_event(host, "codex", kind, severity, "Codex renewal " + kind.removeprefix("renew_"),
            reason, {"request": request["id"], "recovery": str(journal_path)}, when)
        message["dedupe_key"] = "agent_watchdog:renew:%s:%s" % (request["id"], key)
        return [message]
    def save(phase, **fields):
        journal.update(phase=phase, updated_at=now, **fields)
        renew_journal_write(journal_path, journal)
    try:
        validate_renew_request(request)
        journal = private_json(journal_path) if journal_path.exists() else {
            "schema": RENEW_JOURNAL_SCHEMA, "request_id": request["id"], "phase": "waiting-ready"}
        if journal.get("schema") != RENEW_JOURNAL_SCHEMA or journal.get("request_id") != request["id"]:
            raise ValueError("renewal journal identity mismatch")
        if journal.get("phase") == "released":
            if not args.dry_run:
                renew_cooldown(args, journal["updated_at"])
                path.unlink(missing_ok=True)
            return []
        if journal.get("phase") == "refused":
            failed = private_json(adapter_root / "renew-failed.json")
            if failed != journal.get("failed_ack"):
                raise ValueError("refused renewal acknowledgement changed during recovery")
            renew_refused_pin(args, request, failed)
            if not args.dry_run:
                path.unlink(missing_ok=True)
            return []
        if journal.get("phase") == "recovery-required":
            return event("renew_recovery_required", journal.get("reason", "inspect renewal journal and owner state; no automatic replay"))
        failed_path = adapter_root / "renew-failed.json"
        if journal["phase"] == "waiting-ready" and failed_path.exists():
            failed = private_json(failed_path)
            if failed.get("schema") == "codex.telegram.renew-failed.v1" and failed.get("request_id") == request["id"]:
                renew_refused_pin(args, request, failed)
                if not args.dry_run:
                    save("refused", reason=str(failed.get("reason", "adapter refused")), failed_ack=failed)
                    path.unlink(missing_ok=True)
                return event("renew_rejected", "Adapter refused before pin transition: " + str(failed.get("reason")), "warning")
        if journal["phase"] == "waiting-ready":
            ready_path = adapter_root / "renew-ready.json"
            if not ready_path.exists():
                if now - request["requested_at"] <= args.request_timeout:
                    return []
                # The adapter may be between candidate RPC and atomic pin
                # commit. Never consume a timeout without its explicit abort
                # acknowledgement; a late safe commit must remain observable.
                if not args.dry_run:
                    save("waiting-ready", reason="adapter readiness timed out; inspect adapter outcome, do not clear a candidate or pin while its outcome is unknown")
                return event("renew_pending", "Adapter readiness timed out; request retained for late ready or explicit precommit failure acknowledgement", "warning")
            ready = private_json(ready_path)
            if (ready.get("schema") != "codex.telegram.renew-ready.v1"
                    or ready.get("request_id") != request["id"]
                    or any(ready.get(k) != request[k] for k in ("generation", "uid", "task_id", "old_thread_id"))
                    or ready.get("admission_holding") is not True or ready.get("quiescent") is not True):
                raise ValueError("stale or mismatched adapter readiness")
            pin = renew_pin(args, request, ready)
            renew_task_delivered(args, request["task_id"], request["id"])
            owner = codex_owner(args, ready.get("adapter"))
            if owner != {key: ready[key] for key in ("generation", "adapter", "uid")}:
                raise ValueError("source owner generation changed before restart")
            last_revive = max(float(state.setdefault("revive", {}).get("codex", 0)), renew_cooldown(args))
            if now - last_revive < args.revive_cooldown:
                raise ValueError("Codex renewal is cooling down; keep admission held and retry after cooldown")
            if args.dry_run:
                return []
            save("stop-intent", **pin, source_generation=owner["generation"], attempts=0)
            if codex_owner(args, ready.get("adapter")) != owner or renew_pin(args, request, ready) != pin:
                raise ValueError("source owner or committed pin changed before managed stop")
            stopped = run_manager(args.manager, ["stop", "codex"], args.start_timeout)
            if stopped.returncode != 0:
                save("recovery-required", reason="manager stop failed; inspect exact old generation before explicit recovery, never repeat stop automatically")
                return event("renew_recovery_required", journal["reason"])
            save("stopped")
        # From here, the journal proves the pin transition and exact candidate.
        pin = renew_pin(args, request)
        if any(journal.get(k) != pin[k] for k in pin):
            raise ValueError("committed pin changed after bounce intent")
        if journal["phase"] in {"release-intent", "release-issued"}:
            # The adapter may already have accepted release and started a
            # pending task. Do not require global quiescence after release.
            owner = codex_owner(args)
            if journal["phase"] == "release-intent":
                if args.dry_run:
                    return []
                # Re-publishing the exact release is idempotent. This journal
                # fence precedes file replacement so a crash after publication
                # cannot return to a pre-release quiescence gate.
                release = journal.get("release")
                if not isinstance(release, dict) or release.get("request_id") != request["id"]:
                    raise ValueError("release intent lost its exact payload")
                renew_journal_write(adapter_root / "renew-release.json", release)
                save("release-issued")
            if owner is None or not owner.get("adapter") or not (adapter_root / "renew-released.json").exists():
                if now - journal["updated_at"] > args.request_timeout:
                    return event("renew_pending", "Release acknowledgement timed out; inspect successor release acceptance, no second bounce or automatic pin rollback", "warning")
                return []
            renew_release_accepted(args, request, pin, owner)
            if args.dry_run:
                return []
            save("released", accepted_owner=owner)
            renew_cooldown(args, now)
            state.setdefault("revive", {})["codex"] = int(now)
            path.unlink(missing_ok=True)
            link = renew_exp_link(args, request, pin)
            if link.get("linked"):
                detail = f"trainer link verified ({link.get('partner_key') or CODEX_TRAINER}, exp={link.get('exp')})"
                severity = "notice"
            else:
                detail = f"trainer link NOT verified ({link.get('reason') or link.get('error') or 'unknown'})"
                severity = "warning"
            return event("renew_done", f"Seeded pin and external bounce verified; successor durably accepted release; {detail}", severity)
        renew_task_delivered(args, request["task_id"], request["id"])
        if args.dry_run:
            return []
        phase = journal["phase"]
        if phase == "stop-intent":
            # Crash between durable intent and return from stop: never repeat
            # stop/start merely because a receipt exists. Inspect generation.
            owner = codex_owner(args)
            if owner is not None and owner["generation"] == request["generation"]:
                save("recovery-required", reason="watchdog interrupted at stop-intent with old supervisor alive; stop outcome unknown, explicit operator recovery required")
                return event("renew_recovery_required", journal["reason"])
            if owner is None:
                save("stopped")
                phase = "stopped"
            else:
                save("awaiting-resume")
                phase = "awaiting-resume"
        if phase in {"stopped", "start-retry"}:
            owner = codex_owner(args)
            if owner is not None:
                if owner["generation"] == request["generation"]:
                    raise ValueError("old supervisor still owns the adapter after managed stop")
                save("awaiting-resume")
            else:
                try:
                    require_old_generation_absent(request)
                except (OSError, ValueError) as exc:
                    save("recovery-required", reason=str(exc) + "; inspect exact old supervisor before explicit recovery, no start attempted")
                    return event("renew_recovery_required", journal["reason"])
                attempts = journal.get("attempts", 0)
                if attempts >= args.max_attempts:
                    save("recovery-required", reason="managed start attempt cap reached; inspect quota/wrapper readiness, keep committed pin and recover through manager")
                    return event("renew_recovery_required", journal["reason"])
                if now < journal.get("retry_at", 0):
                    return []
                save("start-intent", attempts=attempts + 1)
                try:
                    started = run_manager(args.manager, ["start", "codex"], args.start_timeout)
                except (OSError, subprocess.SubprocessError) as exc:
                    save("recovery-required", reason="managed start outcome unknown (%s); inspect supervisor and resumed receipt before explicit retry" % type(exc).__name__)
                    return event("renew_recovery_required", journal["reason"])
                if started.returncode != 0:
                    save("start-retry", retry_at=now + args.backoff * (2 ** attempts),
                         reason="managed start refused or failed; waiting for wrapper/quota recovery, never clear pin or launch raw CLI")
                    # Do not leave the operator-stop marker blocking manager
                    # admission, but suppress the generic healer below while
                    # this durable renewal queue owns the target.
                    (Path(args.intent_dir) / "codex").unlink(missing_ok=True)
                    return event("renew_pending", journal["reason"], "warning")
                save("awaiting-resume")
        elif phase == "start-intent":
            # Unknown start outcome after a watchdog crash is observed only.
            save("awaiting-resume")
        owner = codex_owner(args)
        resumed_path = adapter_root / "renew-resumed.json"
        if owner is None or not owner.get("adapter") or not resumed_path.exists():
            if now - journal["updated_at"] > args.request_timeout:
                return event("renew_pending", "Successor readiness timed out; inspect manager/quota and renew-resumed receipt, no automatic second bounce", "warning")
            return []
        resumed = private_json(resumed_path)
        if (owner["generation"] == request["generation"]
                or resumed.get("schema") != "codex.telegram.renew-resumed.v1"
                or resumed.get("request_id") != request["id"]
                or resumed.get("old_generation") != request["generation"]
                or resumed.get("new_thread_id") != pin["new_thread_id"]
                or resumed.get("transaction_id") != pin["transaction_id"]
                or resumed.get("admission_holding") is not True
                or any(resumed.get(k) != owner[k] for k in owner)):
            raise ValueError("successor resumed receipt does not match live owner and committed pin")
        probe = run_manager(args.manager, ["status"], 60)
        if classify("codex", probe.stdout) != "up":
            return event("renew_pending", "Successor is still holding admission; manager has not confirmed readiness", "warning")
        # Final read-only fences immediately precede durable release. The
        # adapter remains paused throughout status polling and these rechecks.
        if codex_owner(args) != owner or renew_pin(args, request) != pin:
            raise ValueError("successor ownership or committed pin changed before release")
        renew_task_delivered(args, request["task_id"], request["id"])
        release = {"schema": "codex.telegram.renew-release.v1", "request_id": request["id"],
            **owner, "old_generation": request["generation"], "new_thread_id": pin["new_thread_id"],
            "transaction_id": pin["transaction_id"]}
        save("release-intent", release=release)
        renew_journal_write(adapter_root / "renew-release.json", release)
        save("release-issued", release=release)
        return event("renew_pending", "Successor verified; release issued and admission acknowledgement pending", "notice")
    except (OSError, ValueError, KeyError, IndexError, TypeError, sqlite3.Error, subprocess.SubprocessError) as exc:
        # Preserve the request and provenance. A malformed receipt never
        # authorizes a restart and a committed adapter cannot be abandoned.
        return event("renew_recovery_required", str(exc))


def request_main(argv: list[str]) -> int:
    """Agent-side entry: ask the external watchdog to restart an agent, then return."""
    default_agent = os.environ.get("TELEGRAM_AGENT_SELF")
    if not default_agent and os.environ.get("CLAUDE_WARM_HERDR_AGENT"):
        default_agent = WARM_PREFIX + os.environ["CLAUDE_WARM_HERDR_AGENT"]
    parser = argparse.ArgumentParser(
        prog="telegram-agent-watchdog request",
        description="Request an external restart of an agent. Returns immediately and never signals any process group.",
    )
    parser.add_argument("agent", nargs="?", default=default_agent,
                        help="agent to restart; defaults to $TELEGRAM_AGENT_SELF or $CLAUDE_WARM_HERDR_AGENT")
    parser.add_argument("--other", action="store_true", help="allow targeting an agent other than $TELEGRAM_AGENT_SELF")
    parser.add_argument("--requester-pid", type=int, default=os.getppid(),
                        help="process whose exit means the requesting turn has detached (default: parent)")
    parser.add_argument("--renew", action="store_true", help="Codex only: request a seeded adapter renewal, then external managed bounce")
    parser.add_argument("--adapter-state-dir", default=str(Path.home() / ".local/state/codex-telegram-helmastra"))
    parser.add_argument("--codex-supervisor",
                        help="optional exact codex_supervisor.py source path to check against the live managed process")
    parser.add_argument("--seed-file", type=Path, help="optional private reviewed continuity seed; text is bound into the request")
    parser.add_argument("--seed-sha256", help="required exact SHA256 when --seed-file is used")
    parser.add_argument("--state-dir", default=str(state_home() / "telegram-agent-watchdog"))
    parser.add_argument("--pid-dir", default=str(state_home() / "telegram-agents"))
    parser.add_argument("--warm-file", default=str(Path.home() / ".config/telegram-agent-watchdog/warm-sessions"))
    parser.add_argument("--nurse", default=shutil.which("nurse-joy") or str(Path.home() / ".local/hx/bin/nurse-joy"))
    args = parser.parse_args(argv)
    if args.renew and args.agent != "codex":
        print("telegram-agent-watchdog request: --renew is implemented only for managed Codex Telegram", file=sys.stderr)
        return 2
    if not args.renew and (args.seed_file or args.seed_sha256):
        print("telegram-agent-watchdog request: seed options require --renew", file=sys.stderr)
        return 2
    warm_target = bool(args.agent and args.agent.startswith(WARM_PREFIX))
    warm_name = args.agent[len(WARM_PREFIX):] if warm_target else ""
    warm_names = read_warm_sessions(Path(args.warm_file)) if warm_target else []
    if warm_target and (not re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]*", warm_name) or warm_name.lower() not in {n.lower() for n in warm_names}):
        print("telegram-agent-watchdog request: warm seat must be listed in --warm-file", file=sys.stderr)
        return 2
    if warm_target:
        warm_name = next(name for name in warm_names if name.lower() == warm_name.lower())
    if not args.agent or (not warm_target and args.agent not in STATUS_LABELS):
        print("telegram-agent-watchdog request: name a known agent (%s) or listed warm-<name>" % ", ".join(sorted(STATUS_LABELS)), file=sys.stderr)
        return 2
    self_name = os.environ.get("TELEGRAM_AGENT_SELF")
    warm_self = os.environ.get("CLAUDE_WARM_HERDR_AGENT")
    is_self = bool(warm_target and warm_self and warm_name.lower() == warm_self.lower()) or bool(not warm_target and self_name and args.agent == self_name)
    if self_name and not warm_target and args.agent != self_name and not args.other:
        print("telegram-agent-watchdog request: %s is not this agent (%s); pass --other to target it" % (args.agent, self_name), file=sys.stderr)
        return 2
    if warm_self and warm_target and warm_name.lower() != warm_self.lower() and not args.other:
        print("telegram-agent-watchdog request: %s is not this warm seat (%s); pass --other to target it" % (warm_name, warm_self), file=sys.stderr)
        return 2
    os.umask(0o077)
    canonical_agent = WARM_PREFIX + warm_name.lower() if warm_target else args.agent
    path = Path(args.state_dir) / "requests" / ("%s.json" % canonical_agent)
    if path.exists():
        if args.renew:
            try:
                previous = private_json(path)
                if previous.get("mode") != "renew":
                    raise ValueError("a revive request is already pending; renewal was not queued")
            except (OSError, ValueError) as exc:
                print("telegram-agent-watchdog request: " + str(exc), file=sys.stderr)
                return 2
        print("telegram-agent-watchdog request: revive of %s already pending" % args.agent)
        return 0
    generation = generation_of(args.agent, Path(args.pid_dir)) if not warm_target else None
    resume_session = None
    if warm_target:
        member = warm_members(args.nurse, 30).get(warm_name.lower())
        generation, resume_session = warm_resume_identity(warm_name, member)
        if generation is None or resume_session is None:
            print("telegram-agent-watchdog request: live warm supervisor or transcript is unavailable", file=sys.stderr)
            return 2
    body = {
        "schema": REQUEST_SCHEMA,
        "id": uuid.uuid4().hex,
        "agent": canonical_agent,
        "requester_pid": args.requester_pid,
        "generation": generation,
        "self_requested": is_self,
        "requested_at": int(time.time()),
    }
    if args.renew:
        try:
            origin = private_json(Path(args.adapter_state_dir) / "renew-origin.json")
            owner = codex_owner(args, origin.get("adapter"))
            if (origin.get("schema") != "codex.telegram.renew-origin.v1"
                    or owner is None or any(origin.get(k) != owner[k] for k in owner)):
                raise ValueError("adapter origin does not match its managed supervisor")
            body.update(mode="renew", **{key: origin[key] for key in
                ("generation", "adapter", "uid", "task_id", "old_thread_id")})
            if args.seed_file is not None:
                seed = private_bytes(args.seed_file, 200 * 1024).decode("utf-8")
                digest = hashlib.sha256(seed.encode()).hexdigest()
                if digest != args.seed_sha256 or not seed.strip():
                    raise ValueError("reviewed seed hash does not match --seed-sha256")
                body.update(continuity_seed=seed, seed_sha256=digest, seed_kind="operator-reviewed")
            elif args.seed_sha256:
                raise ValueError("--seed-sha256 requires --seed-file")
            validate_renew_request(body)
        except (OSError, ValueError, KeyError, TypeError, IndexError, UnicodeError) as exc:
            print("telegram-agent-watchdog request: renewal refused: " + str(exc), file=sys.stderr)
            return 2
    if warm_target:
        body["resume_session"] = resume_session
    atomic_write(path, (json.dumps(body, sort_keys=True) + "\n").encode("utf-8"))
    print(("telegram-agent-watchdog request: renewal queued; adapter quiescence, seeded pin and successor release are required"
           if args.renew else "telegram-agent-watchdog request: revive of %s queued; the watchdog restarts it after this turn detaches" % args.agent))
    return 0


def process_requests(args: argparse.Namespace, host: str, state: dict, when: dt.datetime, now: float) -> list[dict]:
    """Execute pending self-revive requests from outside the requesting process group."""
    events: list[dict] = []
    request_dir = Path(args.state_dir) / "requests"
    revive = state.setdefault("revive", {})
    for path in sorted(request_dir.glob("*.json")):
        try:
            request = json.loads(path.read_text(encoding="utf-8"))
            agent = request["agent"]
            warm_target = isinstance(agent, str) and agent.startswith(WARM_PREFIX)
            if request.get("schema") != REQUEST_SCHEMA or not isinstance(agent, str) or (agent not in STATUS_LABELS and not warm_target):
                raise ValueError("bad request")
        except (OSError, ValueError, KeyError):
            path.unlink(missing_ok=True)
            events.append(make_event(host, "*", "revive_rejected", "warning", "Malformed revive request dropped",
                                     "A revive request in the watchdog queue was unreadable and was dropped", {}, when))
            continue
        if request.get("mode") == "renew":
            # Requester-shell exit does not prove handler or delivery cleanup.
            events.extend(process_renewal(args, request, path, host, state, when, now))
            continue
        requester = int(request.get("requester_pid") or 0)
        age = now - float(request.get("requested_at", now))
        if requester > 1 and pid_alive(requester):
            if age > args.request_timeout:
                path.unlink(missing_ok=True)
                events.append(make_event(host, agent, "revive_rejected", "warning", "%s revive request timed out" % agent,
                                         "The requesting turn never detached within %ss; nothing was restarted" % args.request_timeout,
                                         {"request": request.get("id")}, when))
            continue  # wait until the requesting turn has detached
        warm_name = agent[len(WARM_PREFIX):] if warm_target else None
        warm_names = read_warm_sessions(Path(args.warm_file)) if warm_target else []
        if warm_target and (not warm_name or warm_name.lower() not in {name.lower() for name in warm_names}):
            path.unlink(missing_ok=True)
            events.append(make_event(host, agent, "revive_rejected", "warning", "%s is not an approved warm seat" % agent,
                                     "The requested warm seat is not in the private warm-session roster; no restart was attempted",
                                     {"request": request.get("id")}, when))
            continue
        if warm_target:
            warm_name = next(name for name in warm_names if name.lower() == warm_name.lower())
            current_member = warm_members(args.nurse, 30).get(warm_name.lower())
            current_generation, _ = warm_resume_identity(warm_name, current_member)
        else:
            current_generation = generation_of(agent, Path(args.pid_dir))
        fence = request.get("generation")
        if warm_target and not isinstance(fence, str):
            path.unlink(missing_ok=True)
            events.append(make_event(host, agent, "revive_stale", "notice", "%s revive request has no generation fence" % agent,
                                     "The warm request did not record a supervisor generation; no restart was attempted",
                                     {"request": request.get("id")}, when))
            continue
        if fence is not None and fence != current_generation:
            path.unlink(missing_ok=True)
            events.append(make_event(host, agent, "revive_stale", "notice", "%s revive request is stale" % agent,
                                     "%s was already restarted since the request; no second restart" % agent,
                                     {"request": request.get("id")}, when))
            continue
        if now - float(revive.get(agent, 0)) < args.revive_cooldown:
            path.unlink(missing_ok=True)
            events.append(make_event(host, agent, "revive_rejected", "warning", "%s revive is cooling down" % agent,
                                     "%s was self-revived less than %ss ago; request refused" % (agent, args.revive_cooldown),
                                     {"request": request.get("id")}, when))
            continue
        if warm_target:
            # Live-session guard before anything is killed: a warm revive whose
            # resume id is live in another process (a bg-pty host) is refused as
            # revive_rejected instead of /exit-ing the tmux supervisor for nothing.
            warm_session = request.get("resume_session")
            if isinstance(warm_session, str) and re.fullmatch(r"[A-Fa-f0-9-]{16,64}", warm_session):
                refusal = live_session_refusal(args.nurse, warm_name, warm_session)
                if refusal is not None:
                    path.unlink(missing_ok=True)
                    events.append(make_event(host, agent, "revive_rejected", "warning",
                                             "%s revive refused: the resume session is live in another process" % agent,
                                             refusal, {"request": request.get("id"), "resume_session": warm_session}, when))
                    continue
        if args.dry_run:
            continue
        path.unlink(missing_ok=True)
        revive[agent] = int(now)
        marker = Path(args.intent_dir) / agent
        force_escalated = False
        code_staleness = "not-applicable"
        try:
            if warm_target:
                session_id = request.get("resume_session")
                if not isinstance(session_id, str) or not re.fullmatch(r"[A-Fa-f0-9-]{16,64}", session_id):
                    raise ValueError("missing or invalid live resume session")
                cmd = [args.nurse, "revive", "--no-visit", "--resume", session_id, warm_name]
                try:
                    started = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                             text=True, timeout=args.warm_revive_grace, close_fds=True, env=child_env())
                except subprocess.TimeoutExpired:
                    if not request.get("self_requested"):
                        raise
                    force_escalated = True
                    started = subprocess.run([args.nurse, "revive", "--no-visit", "--force", "--resume", session_id, warm_name],
                                             stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                             text=True, timeout=args.start_timeout, close_fds=True, env=child_env())
                detail = (started.stdout or "").strip()[-300:]
                fresh = warm_members(args.nurse, 60).get(warm_name.lower())
                verdict = fresh.get("verdict") if fresh else None
                ok = started.returncode == 0 and verdict in ("field", "degraded")
                code_stale = bool(fresh and (fresh.get("code_stale") is True or fresh.get("generation_loaded") is False or verdict == "degraded"))
                code_staleness = "stale" if code_stale else "fresh" if ok else "unknown"
                if not ok:
                    detail = detail or "readiness not confirmed by nurse-joy status"
            else:
                stopped = run_manager(args.manager, ["stop", agent], args.start_timeout)
                started = run_manager(args.manager, ["start", agent], args.start_timeout) if stopped.returncode == 0 else stopped
                ok = stopped.returncode == 0 and started.returncode == 0
                detail = (started.stdout or "").strip()[-300:]
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            ok, detail = False, type(exc).__name__
        if ok and not warm_target:
            probe = run_manager(args.manager, ["status"], 60)
            ok = classify(agent, probe.stdout) == "up"
            detail = detail or "readiness not confirmed by status"
        if not ok:
            marker.unlink(missing_ok=True)  # a failed revive must not leave the agent parked as operator-stopped
        events.append(make_event(host, agent, "revive_done" if ok else "revive_failed",
                                 "notice" if ok else "critical",
                                 "%s self-revive %s" % (agent, "completed" if ok else "failed"),
                                 "%s was restarted externally on request and verified up" % agent if ok else
                                 "%s self-revive did not verify; the normal relaunch loop takes over: %s" % (agent, detail),
                                 {"request": request.get("id"), "requester_pid": requester,
                                  "code_staleness": code_staleness, "force_escalated": force_escalated}, when))
    return events


def main(argv: list[str]) -> int:
    if argv and argv[0] == "request":
        return request_main(argv[1:])
    args = parse_args(argv)
    host = socket.gethostname()
    if host != args.expected_host:
        print("telegram-agent-watchdog: refusing host %s; expected %s" % (host, args.expected_host), file=sys.stderr)
        return 1
    os.umask(0o077)
    state_dir = Path(args.state_dir)
    state_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock_fd = os.open(str(state_dir / "watchdog.lock"), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("telegram-agent-watchdog: another run owns the lock")
        return 0
    if boot_owns_lock(Path(args.boot_lock)):
        print("telegram-agent-watchdog: boot owner is running; standing down")
        return 0

    when = dt.datetime.now().astimezone()
    now = time.time()
    spool = Path(args.spool)
    state_path = state_dir / "state.json"
    state = load_state(state_path)
    agents_state: dict = state["agents"]
    outcomes: dict[str, str] = {}
    events: list[dict] = []
    try:
        events.extend(process_requests(args, host, state, when, now))
    except (OSError, subprocess.SubprocessError) as exc:
        print("telegram-agent-watchdog: revive request processing failed: %s" % type(exc).__name__, file=sys.stderr)

    try:
        enabled_run = run_manager(args.manager, ["enabled"], 30)
        status_run = run_manager(args.manager, ["status"], 60)
    except (OSError, subprocess.SubprocessError) as exc:
        enabled_run = status_run = None
        print("telegram-agent-watchdog: manager probe failed: %s" % type(exc).__name__, file=sys.stderr)
    if enabled_run is None or enabled_run.returncode != 0 or not enabled_run.stdout.split():
        events.append(make_event(host, "*", "probe_failed", "warning", "Agent watchdog cannot read the enabled list",
                                 "telegram-agent-host enabled failed or returned nothing on %s" % host, {}, when))
        enabled = []
    else:
        enabled = enabled_run.stdout.split()
    # telegram-agent-host status exits nonzero when any agent is degraded, so its output is
    # read whatever the exit code; a probe that printed nothing still reads as unknown per agent.
    status_text = status_run.stdout if status_run is not None else ""

    # Telegram agents relaunch through the host manager; warm Claude sessions through nurse-joy.
    targets = [(agent, classify(agent, status_text), [args.manager, "start", agent]) for agent in enabled]
    warm = read_warm_sessions(Path(args.warm_file))
    warm_status = warm_verdicts(args.nurse, warm, 60, args.tmux)
    targets += [("warm-" + name.lower(), warm_status[name], [args.nurse, "revive", "--no-visit", name.lower()]) for name in warm]
    supervised = {agent for agent, _, _ in targets}

    for agent, verdict, start_cmd in targets:
        if agent == "codex":
            # The durable renewal state machine exclusively owns stop/start
            # while pending. Generic liveness repair must not race its pause,
            # quota admission, uncertain effects or successor-release checks.
            try:
                queued = private_json(state_dir / "requests/codex.json")
            except FileNotFoundError:
                queued = {}
            except (OSError, ValueError):
                outcomes[agent] = "renewal-request-unreadable"
                continue
            if queued.get("mode") == "renew":
                outcomes[agent] = "renewal-pending"
                continue
        entry = agents_state.setdefault(agent, {})
        marker = Path(args.intent_dir) / agent
        if verdict == "up":
            if entry.get("down_since"):
                events.append(make_event(host, agent, "recovered", "notice", "%s is back" % agent,
                                         "%s is running again on %s after %s relaunch attempt(s)" % (agent, host, entry.get("attempts", 0)),
                                         {"attempts": entry.get("attempts", 0), "down_since": entry["down_since"]}, when))
            agents_state[agent] = {}
            outcomes[agent] = "up"
            continue
        if verdict == "unknown":
            if entry.get("probe") != "unknown":
                events.append(make_event(host, agent, "probe_unknown", "warning", "%s liveness unreadable" % agent,
                                         "The watchdog could not read a liveness line for %s on %s; it did not relaunch anything" % (agent, host), {}, when))
            entry["probe"] = "unknown"
            outcomes[agent] = "unknown"
            continue
        entry.pop("probe", None)
        if marker.exists():
            outcomes[agent] = "stopped-by-operator"
            continue
        if not entry.get("down_since"):
            entry.update(down_since=int(now), attempts=0, last_attempt=0, gave_up=False)
            events.append(make_event(host, agent, "down", "warning", "%s is down" % agent,
                                     "%s is enabled but not running on %s; the watchdog will relaunch it" % (agent, host), {}, when))
        attempts = int(entry.get("attempts", 0))
        if attempts >= args.max_attempts:
            if not entry.get("gave_up"):
                entry["gave_up"] = True
                events.append(make_event(host, agent, "relaunch_failed", "critical", "%s will not come back" % agent,
                                         "%s stayed down after %s relaunch attempts on %s; it needs a hand" % (agent, attempts, host),
                                         {"attempts": attempts}, when))
            outcomes[agent] = "gave-up"
            continue
        wait = args.backoff * (2 ** attempts)
        if now - float(entry.get("last_attempt", 0)) < wait:
            outcomes[agent] = "backing-off"
            continue
        if args.dry_run:
            outcomes[agent] = "would-relaunch"
            continue
        entry["attempts"] = attempts + 1
        entry["last_attempt"] = int(now)
        try:
            started = run_manager(start_cmd[0], start_cmd[1:], args.start_timeout)
            outcomes[agent] = "relaunched" if started.returncode == 0 else "relaunch-failed"
            entry["last_result"] = started.returncode
        except (OSError, subprocess.SubprocessError) as exc:
            outcomes[agent] = "relaunch-failed"
            entry["last_result"] = type(exc).__name__

    agents_state_out = {name: value for name, value in agents_state.items() if name in supervised or value}
    if not args.dry_run:
        for event in events:
            try:
                publish(event, spool, when)
            except OSError as exc:
                print("telegram-agent-watchdog: spool write failed: %s" % type(exc).__name__, file=sys.stderr)
        atomic_write(state_path, (json.dumps({"schema": STATE_SCHEMA, "agents": agents_state_out, "revive": state.get("revive", {})}, sort_keys=True) + "\n").encode("utf-8"))
        request_receipts = [dict(e["payload"], result=e["kind"]) for e in events if e["kind"].startswith(("revive_", "renew_"))]
        atomic_write(state_dir / "receipt.json", (json.dumps({"schema": STATE_SCHEMA, "host": host, "timestamp": int(now), "outcomes": outcomes, "events": [e["kind"] + ":" + e["payload"]["agent"] for e in events], "request_receipts": request_receipts}, sort_keys=True) + "\n").encode("utf-8"))
    for name, outcome in sorted(outcomes.items()):
        print("telegram-agent-watchdog: %s=%s" % (name, outcome))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
