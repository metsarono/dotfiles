#!/usr/bin/env bash
# Ensure the ttyd terminal server (unix socket, services-web-terminal.org) is
# live before opening Logseq. No TCP port: the operator's shell is not reachable
# by other local users (Bunta review, fix round 1).
load_private_env() {
  local line key
  [ -f "$HOME/.env" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    case "$line" in
      export\ *) line="${line#export }" ;;
    esac
    case "$line" in *=*) ;; *) continue ;; esac
    key="${line%%=*}"
    key="${key#"${key%%[![:space:]]*}"}"
    case "$key" in *[!A-Za-z0-9_]*) continue ;; esac
    [ -n "$key" ] && eval "export $line"
  done < "$HOME/.env"
}

load_private_env

SERVE="$HOME/.local/bin/caddy-terminal-serve"
if ! "$SERVE" --check 2>/dev/null; then
  # caddy-terminal-serve owns every ttyd flag (services-web-terminal.org):
  # unix socket in a 0700 dir, patched index via logseq-ttyd-index, same
  # instance the Caddy gate fronts. The supervisor adopts this one too.
  CADDY_TERMINAL_FONT_SIZE="${LOGSEQ_TTYD_FONT_SIZE:-16}" \
  CADDY_TERMINAL_FONT_FAMILY="${LOGSEQ_TTYD_FONT_FAMILY:-SFMono Nerd Font, monospace}" \
    setsid "$SERVE" </dev/null &>/dev/null &
  disown
fi
exec "$HOME/Applications/Logseq-linux-x86_64-latest.AppImage" --no-sandbox "$@"
