#!/usr/bin/env python3
# [[file:../../../agents-hooks.org::*Icon gate regression corpus][Icon gate regression corpus:2]]
"""Regression corpus for the icon-tree single-writer gate."""
import json
import subprocess
import sys
from pathlib import Path

H = str(Path(__file__).resolve().with_name("claude-hook-pre-tool-use-bash"))
I = "~/DotCortex/linux/.local/share/icons"
L = "~/.local/share/icons"

ALLOW = [
    ("echo containing arrow",      'echo "-> Chicago95 fallback"'),
    ("find with 2>/dev/null",      f'find {I}/Win31 -name "x.png" 2>/dev/null | wc -l'),
    ("redirect to /tmp",           f'ls {I}/Win31 > /tmp/out.txt'),
    ("redirect to /dev/null",      f'ls {I}/Win31 >/dev/null 2>&1'),
    ("md5sum read",                f'md5sum {I}/SE98/places/32/folder.png'),
    ("git checkout restore",       f'git -C {I}/Chicago95 checkout -- places/22/folder.png'),
    ("git status",                 f'git -C {I}/Chicago95 status --short -- places'),
    ("git add",                    f'git -C {I}/Chicago95 add places'),
    ("git commit",                 f'git -C {I}/Chicago95 commit -m "feat(places): x"'),
    ("icon-theme-inject",          'icon-theme-inject x --repo-root ~/DotCortex --themes Win31 '
                                   '--category apps --from-theme-icon progm001 --names gnome-applications'),
    ("icons-home-sync",            'icons-home-sync --repo-root /home/YOUR_USER/DotCortex'),
    ("gtk-update-icon-cache",      f'gtk-update-icon-cache {L}/Win31'),
    ("ls -l on icon file",         f'ls -l {I}/Chicago95/places/22/folder-documents.png'),
    ("readlink",                   f'readlink {I}/Chicago95/places/22/folder-documents.png'),
    ("find -exec md5sum",          f'find -L {I}/Win31 -name "*.png" -exec md5sum {{}} \\;'),
    ("python read-only PIL",       f'python3 -c "from PIL import Image; Image.open(\'{I}/Win31/apps/32/progm001.png\')"'),
    ("python writes to /tmp only", f'python3 - <<PY\nfrom PIL import Image\nim=Image.open("{I}/Win31/apps/32/progm001.png")\nim.save("/tmp/sheet.png")\nPY'),
    ("cp entirely outside icons",  'cp -f /tmp/a.png /tmp/b.png'),
    ("stat",                       f'stat -c "%y %n" {I}/Win31/index.theme'),
    ("grep index.theme",           f'grep -i Inherits {I}/Win31/index.theme'),
    ("awk printing an arrow",      f'ls {I}/Win31 | awk "{{print \\$1 \\" -> ok\\"}}"'),
    ("cd then find",               f'cd {I}/Win31 && find . -name "*.png" | head'),
    ("wc -l",                      f'find {I}/Win31 -type f | wc -l'),
    ("basename loop, read-only",   f'for f in {I}/Win31/apps/32/*.png; do basename "$f"; done'),
    ("diff two icons",             f'diff {I}/Win31/apps/32/progm001.png {I}/Win31/apps/32/progm002.png'),
    # (SE98/Win98SE folder.png are near-identical here because both are applied
    # instances of one upstream, nestoris/Win98SE — this only tests that cmp is
    # allowed, it is NOT a duplicate-detector. See the dotcortex-icons skill.)
    ("cmp two icons",              f'cmp -s {I}/SE98/places/32/folder.png {I}/Win98SE/places/32/folder.png'),
]

BLOCK = [
    ("cp into icons",            f'cp -f a.png {I}/Chicago95/places/32/x.png'),
    ("cp with quoted dest",      f'cp -f a.png "{I}/Chicago95/places/32/x.png"'),
    ("redirect into icons",      f'cat a.png > {I}/Win31/apps/32/x.png'),
    ("append into icons",        f'cat a.png >> {I}/Win31/apps/32/x.png'),
    ("rm in icons",              f'rm {I}/Win31/apps/32/x.png'),
    ("rm -rf a size dir",        f'rm -rf {I}/Win31/apps/32'),
    ("mv into icons",            f'mv a {I}/Win31/apps/32/x.png'),
    ("sed -i on index.theme",    f'sed -i s/a/b/ {I}/Win31/index.theme'),
    ("ln -sf in icons",          f'ln -sf a.png {I}/Win31/apps/32/x.png'),
    ("tee into icons",           f'cat a | tee {I}/Win31/apps/32/x.png'),
    ("python open(w)",           f'python3 -c "open(\'{I}/Win31/apps/32/x.png\',\'wb\').write(b\'\')"'),
    ("python .save() into icons", f'python3 -c "im.save(\'{I}/Win31/apps/32/x.png\')"'),
    ("shutil.copy in heredoc",   f'python3 - <<PY\nimport shutil\nshutil.copy("a", "{I}/Win31/apps/32/x.png")\nPY'),
    ("cp after &&",              f'echo hi && cp a.png {I}/Win31/apps/32/x.png'),
    ("cp after ;",               f'echo hi ; cp a.png {I}/Win31/apps/32/x.png'),
    ("for-do-cp loop",           f'for s in 16 32; do cp a.png {I}/Win31/apps/$s/x.png; done'),
    ("while-do-rm loop",         f'while read f; do rm {I}/Win31/apps/32/$f; done'),
    ("if-then-cp",               f'if true; then cp a {I}/Win31/apps/32/x.png; fi'),
    ("sudo cp",                  f'sudo cp a.png {I}/Win31/apps/32/x.png'),
    ("chmod on icons",           f'chmod 644 {I}/Win31/apps/32/x.png'),
    ("live root ~/.local rm",    f'rm {L}/Chicago95/places/32/folder.png'),
]


def run(cmd):
    p = subprocess.run(["bash", H], input=json.dumps({"tool_input": {"command": cmd}}),
                       capture_output=True, text=True)
    return p.returncode


def main():
    fails = 0
    for label, cmd in ALLOW:
        r = run(cmd)
        if r != 0:
            print(f"FAIL(should allow)  {label}: exit={r}")
            fails += 1
    for label, cmd in BLOCK:
        r = run(cmd)
        if r != 2:
            print(f"FAIL(should block)  {label}: exit={r}")
            fails += 1
    print(f"{len(ALLOW)} allow-cases, {len(BLOCK)} block-cases, {fails} failure(s)")
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
# Icon gate regression corpus:2 ends here
