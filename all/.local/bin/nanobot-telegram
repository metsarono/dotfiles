#!/usr/bin/env bash
# HelmCortex Nano Instance Wrapper

# The wrapper selects one Nanobot instance and imports only an allowlist from the private environment file: its dedicated token, MailCortex token-file key, Recall URL, SSRF whitelist, gateway host and port, and the two Mistral keys (=MISTRAL_VIBE_API_KEY= for the Vibe subscription, =MISTRAL_API_KEY= for Studio API credit). Network identity belongs only in this uncommitted machine-local environment. Nanobot resolves the Recall placeholder and parses the nested networking overrides at load. The wrapper never evaluates arbitrary shell content.


# [[file:../../../agents-bots.org::*HelmCortex Nano Instance Wrapper][HelmCortex Nano Instance Wrapper:1]]
# ~/DotCortex/all/.local/bin/nanobot-telegram
set -euo pipefail

WORKSPACE="${NANOBOT_WORKSPACE:-$HOME/HelmCortex/FORGE/brain/nanobot}"
VENV="${NANOBOT_VENV:-$WORKSPACE/.venv}"
CONFIG_DIR="${NANOBOT_CONFIG_DIR:-$HOME/.config/nanobot-telegram}"
CONFIG="${NANOBOT_CONFIG:-$CONFIG_DIR/config.json}"
ENV_FILE="${NANOBOT_ENV_FILE:-$CONFIG_DIR/env}"
BIN="$VENV/bin/nanobot"

# Nanobot's upstream 15-minute timer is disabled in the managed config. The
# patched native scanner resolves this endpoint/model policy on every tick.
export FLEET_CACHE_POLICY_HELPER="${FLEET_CACHE_POLICY_HELPER:-$HOME/HelmCortex/FORGE/bin/cache-policy}"
export FLEET_CACHE_POLICY_PATH="${FLEET_CACHE_POLICY_PATH:-$HOME/HelmCortex/ROOTS/DotRoot/agent-session/centre/data/cache-policy.json}"
export NANOBOT_CACHE_POLICY_FALLBACK_COMPACT_SECONDS="${NANOBOT_CACHE_POLICY_FALLBACK_COMPACT_SECONDS:-1620}"
export NANOBOT_CACHE_POLICY_FALLBACK_CACHE_SECONDS="${NANOBOT_CACHE_POLICY_FALLBACK_CACHE_SECONDS:-1800}"
export NANOBOT_CACHE_POLICY_MIN_TOKENS="${NANOBOT_CACHE_POLICY_MIN_TOKENS:-70000}"
export NANOBOT_CACHE_POLICY_MODE="${NANOBOT_CACHE_POLICY_MODE:-enforce}"

[ -x "$BIN" ] || {
    echo "Nanobot runtime missing: $BIN (run loom nanobot:apply)" >&2
    exit 1
}
[ -r "$CONFIG" ] || {
    echo "Nanobot config missing: $CONFIG (run telegram-agent-host sync)" >&2
    exit 1
}

# Nanobot launches subprocesses and resolves workspace state from cwd. Enter
# its durable workspace so a caller in a deleted directory cannot poison the
# gateway child with repeated getcwd failures.
cd -- "$WORKSPACE"

if [ -r "$ENV_FILE" ]; then
    while IFS='=' read -r key value; do
        key="${key%$'\r'}"
        value="${value%$'\r'}"
        case "$key" in
            TELEGRAM_BOT_TOKEN|NANOBOT_MAILCORTEX_TOKEN_FILE|NANOBOT_RECALL_MCP_URL|\
            NANOBOT_TOOLS__SSRF_WHITELIST|NANOBOT_GATEWAY__HOST|NANOBOT_GATEWAY__PORT|\
            MISTRAL_VIBE_API_KEY|MISTRAL_API_KEY)
                [ -n "$value" ] && export "$key=$value"
                ;;
        esac
    done < "$ENV_FILE"
fi

exec "$BIN" "$@" --config "$CONFIG"
# HelmCortex Nano Instance Wrapper:1 ends here
