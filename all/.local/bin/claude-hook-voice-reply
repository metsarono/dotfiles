#!/usr/bin/env bash
# Voice reply relay (outbound — pvox speaks what the agent sends)

# The other half of the voice loop, per Mètsàtron's ruling (2026-08-16): every Telegram reply an agent sends is ALSO spoken aloud through pvox, automatically, with the voice chosen by the agent's identity — no extra agent action, no extra tokens. A =PostToolUse= hook fires on the Telegram plugin's =reply= tool, lifts the already-generated =text= from the tool input, resolves the speaking identity, and fire-and-forgets it to pvox on the speaker host over SSH. The hook returns immediately (playback is fully detached), so replies are never delayed by synthesis.

# Identity resolution, simplest-first: =CLAUDE_WARM_HERDR_AGENT= (set by every claude-* launcher: Fable, Haiku, Auryn, Opus, or OpenCode's Ecco hook) → the basename suffix of =TELEGRAM_STATE_DIR= (=telegram-fable= → fable) → =Default=. The identity maps onto the pvox agent roster (=pvox agents=); identities without their own pvox voice yet (Fable, Haiku, Opus) speak as =Claude= until Mètsàtron seals dedicated voices in VoxForge. Delivery is split-lane (ruling 2026-08-17, the night the phone earned its voice): synthesis runs on the hook's own machine via pvox (HelmCortex is NFS-shared, so pvox and the conda engines are everywhere), and playback ships as a *headered WAV* to =PVOX_REPLY_HOST= (default =s24= — the phone, always in his pocket), falling back to =PVOX_REPLY_FALLBACK_HOST= (default =t480s=) when the phone is unreachable. The old pvox-over-SSH law forbade piping *raw* PCM across SSH because the player cannot know the rate; WAV carries its header, so that law is honored, not repealed. Disable per-session with =PVOX_REPLY_OFF=1=.

# Delivery is *push-then-play* (fix 2026-08-17, the "stopped halfway" incident): the original design streamed the WAV over SSH straight into =sox='s stdin, which made the entire playback depend on the SSH connection staying alive — when the phone dozed mid-play (screen off, in pocket), the stream stalled and the audio truncated halfway. Now the play host receives the whole WAV into a temp file first, then playback detaches from the SSH session (=nohup=, backgrounded) with a Termux wake-lock held for its duration, so the network matters only during transfer and a doze can no longer cut the voice off. The SSH exit code therefore certifies *delivery*, not playback — the log field says =delivered=, honestly. Every skip and failure path logs one line to =~/.cache/pvox-reply.log= (empty-text skip with stdin byte count, render failure, per-host delivery failure, successful delivery with host + sizes) — the hook's original total silence meant every incident cost a fresh archaeology dig, against the silent-skip law.

# Kitten seats render *on the play host itself* (his ruling 2026-08-17: the S24 out-muscles the fleet for small models, Q8-verified ~0.4–0.9 RTF): the hook resolves the seat via =pvox voicespec= and cleans the text via =pvox clean= (both fleet-side — pvox's config and markdown cleaner stay the single source of truth), then ships CLEANED TEXT instead of a WAV to =termux-kitten-say= on the play host, detached with a wake lock, sharing the same play queue lock as the ship lane. The fleet render+ship path remains the lane for non-kitten seats, fallback hosts, and a dead enclave — on-device failure logs =ON-DEVICE-FAIL= and falls through. Kill switch: =PVOX_REPLY_NO_ONDEVICE=1=.


# [[file:../../../agents-hooks.org::*Voice reply relay (outbound — pvox speaks what the agent sends)][Voice reply relay (outbound — pvox speaks what the agent sends):1]]
# ~/DotCortex/all/.local/bin/claude-hook-voice-reply
# PostToolUse hook (Telegram reply tool): speak the sent text through pvox on
# the speaker host. Fire-and-forget; never blocks or fails the reply.
set -euo pipefail

[ -n "${PVOX_REPLY_OFF:-}" ] && exit 0

LOG="${XDG_CACHE_HOME:-$HOME/.cache}/pvox-reply.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true

# 3s cap: cat returns on EOF immediately (the harness closes stdin after
# writing); the timeout only guards a hang. The original 0.2s was tight
# enough to truncate a large PostToolUse payload under load, and a truncated
# read fails the JSON parse -> silent skip -> unexplained missing audio.
if command -v timeout >/dev/null 2>&1; then
    HOOK_INPUT="$(timeout 3 cat 2>/dev/null || true)"
else
    HOOK_INPUT="$(cat 2>/dev/null || true)"
fi

TEXT="$(printf '%s' "$HOOK_INPUT" | python3 -c '
import json, sys
try:
    j = json.load(sys.stdin)
    t = (j.get("tool_input") or {}).get("text") or ""
    print(t)
except Exception:
    pass
' 2>/dev/null || true)"
if [ -z "$TEXT" ]; then
    printf '%s SKIP empty-text (stdin %s bytes)\n' "$(date '+%F %T')" "${#HOOK_INPUT}" >> "$LOG" 2>/dev/null || true
    exit 0
fi

# Speak the whole reply (ruling 2026-10-07: voice notes must not be cut short).
# Set PVOX_REPLY_MAX_CHARS=N to bound pathological payloads again; 0 or unset = no cap.
MAX_CHARS="${PVOX_REPLY_MAX_CHARS:-0}"
case "$MAX_CHARS" in *[!0-9]*|'') MAX_CHARS=0 ;; esac
ORIGINAL_CHARS="${#TEXT}"
if [ "$MAX_CHARS" -gt 0 ] && [ "$ORIGINAL_CHARS" -gt "$MAX_CHARS" ]; then
    TEXT="$(printf '%s' "$TEXT" | python3 -c '
import sys
limit = int(sys.argv[1])
text = sys.stdin.read()
cut = text[:limit].rsplit(None, 1)[0] if text[:limit].split() else text[:limit]
sys.stdout.write(cut.rstrip() + " Voice reply truncated.")
' "$MAX_CHARS")"
    printf '%s voice-payload truncated original=%s spoken=%s limit=%s\n' \
      "$(date '+%F %T')" "$ORIGINAL_CHARS" "${#TEXT}" "$MAX_CHARS" >> "$LOG" 2>/dev/null || true
fi

AGENT="${CLAUDE_WARM_HERDR_AGENT:-}"
if [ -z "$AGENT" ] && [ -n "${TELEGRAM_STATE_DIR:-}" ]; then
    AGENT="$(basename "$TELEGRAM_STATE_DIR")"; AGENT="${AGENT#telegram-}"
fi
HUD_AGENT=""
case "$(printf '%s' "$AGENT" | tr '[:upper:]' '[:lower:]')" in
    helmastra) VOICE="HelmAstra"; HUD_AGENT="helmastra" ;;
    auryn) VOICE="Auryn"; HUD_AGENT="auryn" ;;
    ductor) VOICE="Ductor"; HUD_AGENT="helmductor" ;;
    deepseek) VOICE="DeepSeek"; HUD_AGENT="orcinus-orca" ;;
    ecco) VOICE="Ecco"; HUD_AGENT="ecco-dolphinus" ;;
    gemma) VOICE="Gemma"; HUD_AGENT="gemma" ;;
    metsatron) VOICE="Metsatron" ;;
    fable) VOICE="Fable"; HUD_AGENT="fable" ;;
    haiku) VOICE="Haiku"; HUD_AGENT="haiku" ;;
    opus|claudeificus) VOICE="Opus"; HUD_AGENT="claudeificus" ;;
    hermes) VOICE="Hermes"; HUD_AGENT="hermes-agent" ;;
    claude) VOICE="Claude" ;;
    *) VOICE="Default" ;;
esac
# The speaker identity can differ from the selected voice. In particular,
# HelmAstra keeps her working Default voice while her own HUD portrait speaks.
case "${PVOX_HUD_AGENT:-}" in
    helmastra|helmductor|auryn|fable|claudeificus|haiku|orcinus-orca|ecco-dolphinus|hermes-agent|gemma)
        HUD_AGENT="$PVOX_HUD_AGENT" ;;
esac

# Split lanes (Mètsàtron's ruling 2026-08-17): synth where pvox lives (this
# machine — HelmCortex is NFS-shared fleet-wide), play wherever he is. The
# phone is the standing default ("my phone's always with me"); the T480s is
# the fallback speaker when the phone is unreachable (Doze, no tailnet).
# Audio travels as headered WAV, never raw PCM — the play side parses the
# header, so mixed engine sample rates (kitten 24k, piper 22.05k) need no
# out-of-band rate agreement. Whole-render before play trades first-sentence
# streaming latency for that robustness; replies are Telegram-sized.
PLAY_HOST="${PVOX_REPLY_HOST:-s24}"
FALLBACK_HOST="${PVOX_REPLY_FALLBACK_HOST:-t480s}"
# Host-agnostic remote play: Termux has sox (+pulse on demand), Guix fleet
# machines have aplay; flock serializes so rapid replies queue, never stack.
# The lock is a FIXED per-host path ($HOME/.pvox-reply-play.lock), NOT under
# $TMPDIR — the ship lane and the on-device kitten lane must resolve the very
# same file or they don't actually share a queue. (Fix 2026-09-18: the kitten
# lane held no lock at all and TMPDIR could differ between lanes, so kokoro
# ship-lane replies overlapped kitten replies on the S24; both lanes now flock
# this one path.)
# Push-then-play (2026-08-17): receive the WHOLE WAV into a temp file, then
# detach playback from the ssh session (nohup + &, stdin closed) with a
# Termux wake-lock held while it plays — a connection drop or phone doze
# mid-play can no longer truncate the audio. The ssh exit code certifies
# delivery of the file, not playback.
REMOTE_PLAY='F="$(mktemp "${TMPDIR:-/tmp}/pvox-reply-XXXXXX.wav")" || exit 1
cat > "$F" || { rm -f "$F"; exit 1; }
pgrep pulseaudio >/dev/null 2>&1 || pulseaudio --start --exit-idle-time=-1 >/dev/null 2>&1 || true
if [ -n "${PVOX_SPEAKER_ID:-}" ] && command -v pvox-speech-receipt >/dev/null 2>&1; then
  pvox-speech-receipt queued "$PVOX_SPEAKER_ID" "$PVOX_PLAYBACK_ID" >/dev/null 2>&1 || true
fi
nohup sh -c "
  command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock >/dev/null 2>&1
  exec 9>\"\$HOME/.pvox-reply-play.lock\"
  flock 9
  if [ -n \"\${PVOX_SPEAKER_ID:-}\" ] && command -v pvox-speech-receipt >/dev/null 2>&1; then
    pvox-speech-receipt player_started \"\$PVOX_SPEAKER_ID\" \"\$PVOX_PLAYBACK_ID\" >/dev/null 2>&1 || true
  fi
  if command -v sox >/dev/null 2>&1; then sox -q \"$F\" -d
  else XDG_RUNTIME_DIR=\"\${XDG_RUNTIME_DIR:-/run/user/1000}\" aplay -q \"$F\"; fi
  if [ -n \"\${PVOX_SPEAKER_ID:-}\" ] && command -v pvox-speech-receipt >/dev/null 2>&1; then
    pvox-speech-receipt player_exited \"\$PVOX_SPEAKER_ID\" \"\$PVOX_PLAYBACK_ID\" >/dev/null 2>&1 || true
  fi
  command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock >/dev/null 2>&1
  rm -f \"$F\"
" </dev/null >/dev/null 2>&1 &'

setsid bash -c '
    VOICE="$1"; TEXT="$2"; PLAY_HOST="$3"; FALLBACK_HOST="$4"; REMOTE_PLAY="$5"; HUD_AGENT="$6"
    PLAYBACK_ID="$(date +%s%N)-$BASHPID"
    LOG="${XDG_CACHE_HOME:-$HOME/.cache}/pvox-reply.log"
    PVOX="$HOME/HelmCortex/FORGE/VoxForge/bin/pvox"
    SSHOPTS="-o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=5 -o ServerAliveCountMax=3"

    # On-device lane (his ruling 2026-08-17: the phone renders its own
    # voices — "my phone has more horsepower for rendering on device").
    # Kitten seats render ON the play host when it carries
    # termux-kitten-say: cleaned text travels (pvox clean here — one
    # source of truth for markdown cleanup), is parked in a temp file on
    # the phone, and render+play detach from the ssh session with a wake
    # lock (doze cannot truncate; exit code means text delivered + spawn
    # ok). Fleet render+ship stays the lane for non-kitten seats, other
    # hosts, and a dead enclave. Kill switch: PVOX_REPLY_NO_ONDEVICE=1.
    SPEC="$("$PVOX" voicespec "$VOICE" 2>/dev/null || true)"
    if [ -n "$SPEC" ] && [ -z "${PVOX_REPLY_NO_ONDEVICE:-}" ]; then
        read -r ENGINE KV KS <<EOF2
$(printf "%s" "$SPEC" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d[\"engine\"], d[\"voice\"], d[\"speed\"])" 2>/dev/null)
EOF2
        if [ "$ENGINE" = "kitten" ]; then
            if printf "%s\n" "$TEXT" | "$PVOX" clean 2>/dev/null | ssh $SSHOPTS "$PLAY_HOST" "
                command -v termux-kitten-say >/dev/null 2>&1 || exit 9
                T=\"\$(mktemp)\"; cat > \"\$T\"
                if command -v pvox-speech-receipt >/dev/null 2>&1; then
                    nohup sh -c \"PVOX_SPEAKER_ID=$HUD_AGENT PVOX_PLAYBACK_ID=$PLAYBACK_ID termux-kitten-say --voice $KV --speed $KS < \$T; rm -f \$T\" </dev/null >/dev/null 2>&1 &
                else
                    nohup sh -c \"flock \$HOME/.pvox-reply-play.lock termux-kitten-say --voice $KV --speed $KS < \$T; rm -f \$T\" </dev/null >/dev/null 2>&1 &
                fi
            " >/dev/null 2>&1; then
                printf "%s voice=%s chars=%s rendered=on-device:%s (%s@%s)\n" "$(date "+%F %T")" "$VOICE" "${#TEXT}" "$PLAY_HOST" "$KV" "$KS" >> "$LOG" 2>/dev/null || true
                exit 0
            fi
            printf "%s voice=%s host=%s ON-DEVICE-FAIL falling back to ship lane\n" "$(date "+%F %T")" "$VOICE" "$PLAY_HOST" >> "$LOG" 2>/dev/null || true
        fi
    fi

    T="$(mktemp)" W="$(mktemp --suffix=.wav)"
    trap "rm -f \"$T\" \"$W\"" EXIT
    printf "%s\n" "$TEXT" > "$T"
    if ! "$PVOX" render --agent "$VOICE" --no-play "$T" "$W" >/dev/null 2>&1; then
        printf "%s voice=%s chars=%s RENDER-FAIL\n" "$(date "+%F %T")" "$VOICE" "${#TEXT}" >> "$LOG" 2>/dev/null || true
        exit 0
    fi
    for H in "$PLAY_HOST" "$FALLBACK_HOST"; do
        if ssh $SSHOPTS "$H" "if [ -n \"$HUD_AGENT\" ] && command -v pvox-phone-play >/dev/null 2>&1; then pvox-phone-play \"$HUD_AGENT\" \"$PLAYBACK_ID\"; else
export PVOX_SPEAKER_ID=\"$HUD_AGENT\" PVOX_PLAYBACK_ID=\"$PLAYBACK_ID\"
$REMOTE_PLAY
fi" < "$W" >/dev/null 2>&1; then
            printf "%s voice=%s chars=%s bytes=%s delivered=%s\n" "$(date "+%F %T")" "$VOICE" "${#TEXT}" "$(wc -c < "$W")" "$H" >> "$LOG" 2>/dev/null || true
            exit 0
        fi
        printf "%s voice=%s host=%s DELIVER-FAIL\n" "$(date "+%F %T")" "$VOICE" "$H" >> "$LOG" 2>/dev/null || true
    done
' _ "$VOICE" "$TEXT" "$PLAY_HOST" "$FALLBACK_HOST" "$REMOTE_PLAY" "$HUD_AGENT" >/dev/null 2>&1 &

exit 0
# Voice reply relay (outbound — pvox speaks what the agent sends):1 ends here
