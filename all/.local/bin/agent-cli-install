#!/usr/bin/env bash
# Script: agent-cli-install (dry-run by default)


# [[file:../../../agents-users.org::*Script: agent-cli-install (dry-run by default)][Script: agent-cli-install (dry-run by default):1]]
# ~/DotCortex/all/.local/bin/agent-cli-install
# Installs each agent's CLI (latest; no pins, ruling 2026-10-05) from all/.config/agent-cli/<tool>.ssv into the
# agent user's own npm prefix (needs the agent Guix profile / node first).
# DRY-RUN unless --apply. npm only for now; extend MANAGER cases as needed.
set -euo pipefail

MANIFEST_DIR="${AGENT_CLI_MANIFESTS:-$HOME/DotCortex/all/.config/agent-cli}"
HOST="${AGENT_CLI_HOST:-$(hostname -s 2>/dev/null || hostname)}"
APPLY=0
ONLY=""

while [ $# -gt 0 ]; do
  case "$1" in
    --apply) APPLY=1 ;;
    --only) shift; ONLY="${1:-}" ;;
    *) echo "usage: agent-cli-install [--apply] [--only TOOL[,TOOL...]]"; exit 1 ;;
  esac
  shift
done

run() {
  if [ "$APPLY" -eq 1 ]; then echo "+ $*"; "$@"; else echo "DRY-RUN: $*"; fi
}

for manifest in "$MANIFEST_DIR"/*.ssv; do
  [ -e "$manifest" ] || continue
  tool="$(basename "$manifest" .ssv)"
  [ -n "$ONLY" ] && case ",$ONLY," in *",$tool,"*) ;; *) continue ;; esac
  user="agent-$tool"
  if ! id "$user" >/dev/null 2>&1; then
    echo "no user: $user (skip)"; continue
  fi
  # A host whose agent needs another package set declares its own lane,
  # hosts/<host>@<user>.ssv (the provision-gate idiom); it replaces the
  # fleet lane for that agent on that host only. No VERSION = latest.
  lane="$MANIFEST_DIR/hosts/$HOST@$user.ssv"
  [ -f "$lane" ] && { echo "$user: host lane $lane"; manifest="$lane"; }
  while read -r manager pkg version _rest; do
    case "$manager" in ""|\#*) continue ;; esac
    [ -z "$pkg" ] && continue
    case "$manager" in
      npm)
        spec="$pkg"
        [ -n "${version:-}" ] && spec="$pkg@$version"
        # node/npm come from the agent's own Guix profile (agent-guix-apply),
        # loaded by its ~/.profile — never from the human home (ruling
        # 2026-06-11; a sealed home would refuse it anyway). Fail loud if the
        # profile is not built yet. Uninstall first to avoid EEXIST on renames.
        # The Guix node's default npm prefix is its read-only store path, so
        # global installs go to the agent's own ~/.npm-global (home layout),
        # and ~/.profile puts its bin on PATH. cwd is /tmp: sudo keeps the
        # caller's cwd, which a sealed operator home refuses to the agent.
        run sudo -u "$user" -H sh -c 'grep -q "npm-global/bin" ~/.profile 2>/dev/null || printf "export NPM_CONFIG_PREFIX=\"\$HOME/.npm-global\"\nexport PATH=\"\$HOME/.npm-global/bin:\$PATH\"\n" >> ~/.profile'
        run sudo -u "$user" -H sh -lc "cd /tmp && command -v npm >/dev/null || { echo '$user: no npm on the agent profile (run agent-guix-apply)' >&2; exit 1; }; mkdir -p \"\$HOME/.npm-global\"; npm uninstall -g '$pkg' 2>/dev/null; npm install -g '$spec'"
        ;;
      *)
        echo "$user: unknown manager '$manager' for $pkg (skip)"
        ;;
    esac
  done < "$manifest"
done

[ "$APPLY" -eq 0 ] && echo "(dry-run complete — re-run with --apply after approval)"
exit 0
# Script: agent-cli-install (dry-run by default):1 ends here
