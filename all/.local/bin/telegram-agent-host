    if pgrep -f "claude.*channels.*telegram" >/dev/null 2>&1; then
        echo "  claudecode (--channels telegram plugin): RUNNING"
    else
        echo "  claudecode (--channels telegram plugin): STOPPED"
    fi
}

check_hermes() {
    if hermes_running; then
        echo "  hermes gateway run: RUNNING"
    else
        echo "  hermes gateway run: STOPPED"
    fi
}

check_codex() {
    if codex_telegram_running; then
        echo "  codex-helmastra (--telegram): RUNNING"
    else
        echo "  codex-helmastra (--telegram): STOPPED"
    fi
}

# Privilege drop (Agent Boundaries phase 8, 2026-09-26). When the operator's
# non-secret run-as file names an agent user, start/stop/status re-run this
# script as that user, so every path it resolves from $HOME (env, token, key,
# DSH home, state dir, log, pid, readiness marker) lives in the agent's home and
# the operator's home stays sealed. Returns 3 when no delegation applies.
#
# Generic form: agent_run_as_delegate VERB AGENT RUN_AS_FILE [EXTRA_PATH [ENV...]].
# EXTRA_PATH is appended after the agent's own bins (read-only operator tool
# profiles, never anything under a sealed home); ENV entries are NAME=VALUE
# pairs passed explicitly through the clean environment.
agent_run_as_delegate() {
    local verb="$1" agent="$2" run_as_file="$3" extra_path="${4:-}" target thome self runtime_path
    shift 4 2>/dev/null || shift $#
    [ -r "$run_as_file" ] || return 3
    target="$(head -n1 "$run_as_file" | tr -d '[:space:]')"
    [ -n "$target" ] || return 3
    [ "$(id -un)" != "$target" ] || return 3
    thome="$(getent passwd "$target" | cut -d: -f6)"
    if [ -z "$thome" ]; then
        echo "$agent run-as user is missing: $target" >&2
        return 1
    fi
    self="$(readlink -f "$0")"
    runtime_path="$thome/.guix-extra-profiles/agent/agent/bin:$thome/.npm-global/bin${extra_path:+:$extra_path}:/usr/local/bin:/usr/bin:/bin"
    # cwd /tmp: sudo keeps the caller's cwd, which the sealed home refuses.
    (cd /tmp && sudo -n -u "$target" -H env -i \
        HOME="$thome" USER="$target" LOGNAME="$target" LANG=C.UTF-8 \
        PATH="$runtime_path" AGENT_RUNTIME_PATH="$runtime_path" \
        DOTCORTEX_AGENTS_DIR="$AGENTS_DIR" "$@" \
        bash "$self" "$verb" "$agent")
}

deepseek_harness_delegate() {
    agent_run_as_delegate "$1" deepseek-harness \
        "${DSH_TELEGRAM_RUN_AS_FILE:-$HOME/.config/deepseek-harness-telegram/run-as}" ""
}

# OpenCode/Ecco (Agent Boundaries phase 8, 2026-09-26). Same drop as DeepSeek.
# The operator's core Guix profile rides on PATH read-only (git, rg, jq for
# Ecco's shell work), and the Ecco voice plugin is pointed at the agent voice
# spool, since the phone relay needs the operator's SSH identity.
opencode_delegate() {
    local ecco_config_content='{"compaction":{"auto":true,"prune":true,"reserved":16000},"provider":{"opencode-go":{"models":{"deepseek-v4.1-flash":{"limit":{"context":832000,"output":384000}}}}}}'
    agent_run_as_delegate "$1" opencode \
        "${OPENCODE_RUN_AS_FILE:-$HOME/.config/opencode-telegram-bot/run-as}" \
        "$CORE_PROFILE_BIN" \
        OPENCODE_VOICE_REPLY="$HOME/DotCortex/all/.local/bin/agent-voice-relay" \
        OPENCODE_CONFIG_CONTENT="$ecco_config_content"
}

# Nano normally shares the trusted OpenAI operator lane with HelmAstra and
# HelmDuctor. A private run-as file moves the whole gateway into a sealed agent
# home before a global-model endpoint is enabled. The target home must be
# provisioned separately; absence of the file intentionally keeps today's lane.
nanobot_delegate() {
    agent_run_as_delegate "$1" nanobot "$NANOBOT_RUN_AS_FILE" "$CORE_PROFILE_BIN"
}

deepseek_harness_config_file() {
    printf '%s\n' "$DSH_TELEGRAM_WORKSPACE/.pi/telegram.json"
}

deepseek_harness_start_ticks() {
    python3 - "$1" <<'PY'
from pathlib import Path
import sys

try:
    stat = Path("/proc", sys.argv[1], "stat").read_text(encoding="utf-8")
    fields = stat[stat.rfind(")") + 2:].split()
    print(fields[19])
except (OSError, IndexError, ValueError):
    raise SystemExit(1)
PY
}

deepseek_harness_pid_matches() {
    local pid="${1:-}" profile="${2:-$DSH_TELEGRAM_PROFILE}"
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    [ -r "/proc/$pid/cmdline" ] || return 1
    python3 - "$pid" "$profile" <<'PY'
from pathlib import Path
import sys

pid, profile = sys.argv[1], sys.argv[2]
raw = Path("/proc", pid, "cmdline").read_bytes().split(b"\0")
argv = [part.decode("utf-8", "replace") for part in raw if part]
basenames = {Path(arg).name for arg in argv}
if "dsh" not in basenames:
    raise SystemExit(1)
for idx, arg in enumerate(argv[:-1]):
    if arg == "--profile" and argv[idx + 1] == profile:
        raise SystemExit(0)
raise SystemExit(1)
PY
}

deepseek_harness_marker_matches() {
    local pid="${1:-}" marker="${2:-$DSH_TELEGRAM_READY_MARKER}" ticks generation
    deepseek_harness_pid_matches "$pid" || return 1
    ticks="$(deepseek_harness_start_ticks "$pid" 2>/dev/null)" || return 1
    generation="$(deepseek_harness_read_generation 2>/dev/null)" || return 1
    python3 - "$marker" "$pid" "$ticks" "$DSH_TELEGRAM_PROFILE" "$generation" <<'PY'
import json
import sys
from pathlib import Path

try:
    data = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
except (OSError, ValueError, TypeError):
    raise SystemExit(1)
if data.get("schema") != 1 or data.get("component") != "dsh-telegram":
    raise SystemExit(1)
if data.get("pid") != int(sys.argv[2]) or str(data.get("start_ticks")) != sys.argv[3]:
    raise SystemExit(1)
if data.get("profile") != sys.argv[4] or data.get("generation") != sys.argv[5]:
    raise SystemExit(1)
if data.get("telegram_bot_identity_validated") is not True or data.get("long_polling_owned") is not True:
    raise SystemExit(1)
PY
}

deepseek_harness_read_generation() {
    local generation
    [ -r "$DSH_TELEGRAM_GENERATION_FILE" ] || return 1
    generation="$(cat "$DSH_TELEGRAM_GENERATION_FILE" 2>/dev/null || true)"
    [[ "$generation" =~ ^[0-9a-f]{32}$ ]] || return 1
    printf '%s\n' "$generation"
}

deepseek_harness_marker_path() {
    local generation
    generation="$(deepseek_harness_read_generation)" || return 1
    printf '%s.%s\n' "$DSH_TELEGRAM_READY_MARKER" "$generation"
}

deepseek_harness_write_generation() {
    local temporary generation
    generation="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')" || return 1
    case "$generation" in
        ''|*[!0-9a-f]*) return 1 ;;
    esac
    temporary="$(mktemp "$DSH_TELEGRAM_GENERATION_FILE.tmp.XXXXXX")" || return 1
    printf '%s\n' "$generation" > "$temporary"
    chmod 600 "$temporary"
    mv -f "$temporary" "$DSH_TELEGRAM_GENERATION_FILE"
    printf '%s\n' "$generation"
}

deepseek_harness_acquire_start_lock() {
    local lock_fd
    command -v flock >/dev/null 2>&1 || {
        echo "DeepSeek Harness start lock requires flock" >&2
        return 1
    }
    exec {lock_fd}>"$DSH_TELEGRAM_START_LOCK"
    if ! flock -n "$lock_fd"; then
        eval "exec ${lock_fd}>&-"
        echo "Refusing DeepSeek Harness start: another DeepSeek Harness starter holds the launch lock" >&2
        return 1
    fi
    DSH_TELEGRAM_START_LOCK_FD="$lock_fd"
}

deepseek_harness_release_start_lock() {
    if [ -n "${DSH_TELEGRAM_START_LOCK_FD:-}" ]; then
        eval "exec ${DSH_TELEGRAM_START_LOCK_FD}>&-"
        DSH_TELEGRAM_START_LOCK_FD=""
    fi
}

deepseek_harness_ready() {
    local pid marker
    marker="$(deepseek_harness_marker_path 2>/dev/null)" || return 1
    [ -r "$DSH_TELEGRAM_PID_FILE" ] && [ -r "$marker" ] || return 1
    pid="$(cat "$DSH_TELEGRAM_PID_FILE" 2>/dev/null || true)"
    deepseek_harness_marker_matches "$pid" "$marker"
}

deepseek_harness_clear_stale_marker() {
    local marker marker_pid
    marker="$(deepseek_harness_marker_path 2>/dev/null || true)"
    [ -n "$marker" ] && [ -e "$marker" ] || return 0
    marker_pid="$(python3 - "$marker" <<'PY'
import json
import sys
from pathlib import Path

try:
    value = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8")).get("pid")
except (OSError, ValueError, TypeError):
    value = None
print(value if isinstance(value, int) else "")
PY
)"
    if [ -n "$marker_pid" ] && deepseek_harness_marker_matches "$marker_pid" "$marker"; then
        echo "DeepSeek Harness readiness marker belongs to a live process; refusing replacement" >&2
        return 1
    fi
    rm -f "$marker"
}

deepseek_harness_retire_stale_owner() {
    local pid other_pid
    [ -r "$DSH_TELEGRAM_PID_FILE" ] || return 0
    pid="$(cat "$DSH_TELEGRAM_PID_FILE" 2>/dev/null || true)"
    if deepseek_harness_pid_matches "$pid"; then
        echo "DeepSeek Harness PID file still names a live matching process; refusing stale-owner retirement" >&2
        return 1
    fi
    other_pid="$(deepseek_harness_find_unowned 2>/dev/null || true)"
    if [ -n "$other_pid" ]; then
        echo "DeepSeek Harness owner state is stale but an unowned poller uses this profile; refusing cleanup" >&2
        return 1
    fi
    rm -f "$DSH_TELEGRAM_PID_FILE" "$DSH_TELEGRAM_READY_MARKER" "$DSH_TELEGRAM_GENERATION_FILE"
    echo "DeepSeek Harness retired dead pre-boot owner state"
}

deepseek_harness_kill_owned() {
    local pid="$1" expected_ticks="$2" current_ticks pgid
    deepseek_harness_pid_matches "$pid" || return 1
    current_ticks="$(deepseek_harness_start_ticks "$pid" 2>/dev/null)" || return 1
    [ "$current_ticks" = "$expected_ticks" ] || return 1
    pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
    if [ "$pgid" = "$pid" ]; then
        kill -TERM -- "-$pgid" 2>/dev/null || true
    else
        kill -TERM "$pid" 2>/dev/null || true
    fi
    for _ in {1..20}; do
        deepseek_harness_pid_matches "$pid" || return 0
        sleep 0.25
    done
    if [ "$pgid" = "$pid" ]; then
        kill -KILL -- "-$pgid" 2>/dev/null || true
    else
        kill -KILL "$pid" 2>/dev/null || true
    fi
    ! deepseek_harness_pid_matches "$pid"
}

deepseek_harness_wait_ready() {
    local timeout="$DSH_TELEGRAM_READY_TIMEOUT" attempts
    case "$timeout" in ''|*[!0-9]*) echo "Invalid DSH_TELEGRAM_READY_TIMEOUT: $timeout" >&2; return 1 ;; esac
    attempts=$((timeout * 2))
    for ((i = 0; i < attempts; i += 1)); do
        if deepseek_harness_ready; then
            sleep 0.1
            deepseek_harness_ready && return 0
        fi
        sleep 0.5
    done
    if deepseek_harness_ready; then
        sleep 0.1
        deepseek_harness_ready
    else
        return 1
    fi
}

deepseek_harness_running() {
    local pid
    [ -r "$DSH_TELEGRAM_PID_FILE" ] || return 1
    pid="$(cat "$DSH_TELEGRAM_PID_FILE" 2>/dev/null || true)"
    deepseek_harness_pid_matches "$pid"
}

deepseek_harness_find_unowned() {
    python3 - "$$" "$DSH_TELEGRAM_PROFILE" "$DSH_TELEGRAM_PID_FILE" <<'PY'
from pathlib import Path
import sys

self_pid = int(sys.argv[1])
profile = sys.argv[2]
pid_file = Path(sys.argv[3])
owned = None
try:
    owned = int(pid_file.read_text().strip())
except Exception:
    pass

for proc in Path("/proc").iterdir():
    if not proc.name.isdigit():
        continue
    pid = int(proc.name)
    if pid in {self_pid, owned}:
        continue
    try:
        raw = (proc / "cmdline").read_bytes().split(b"\0")
    except OSError:
        continue
    argv = [part.decode("utf-8", "replace") for part in raw if part]
    if not argv:
        continue
    if "dsh" not in {Path(arg).name for arg in argv}:
        continue
    for idx, arg in enumerate(argv[:-1]):
        if arg == "--profile" and argv[idx + 1] == profile:
            print(pid)
            raise SystemExit(0)
raise SystemExit(1)
PY
}

deepseek_harness_rotate_log() {
    local log="$DSH_TELEGRAM_LOG_FILE" max="$DSH_TELEGRAM_LOG_MAX_BYTES" keep="$DSH_TELEGRAM_LOG_KEEP"
    case "$max" in ''|*[!0-9]*) max=10485760 ;; esac
    case "$keep" in ''|*[!0-9]*) keep=5 ;; esac
    [ -f "$log" ] || return 0
    local size
    size=$(wc -c < "$log" 2>/dev/null || printf '0')
    [ "$size" -le "$max" ] && return 0
    local i prev
    i="$keep"
    while [ "$i" -gt 1 ]; do
        prev=$((i - 1))
        [ -f "$log.$prev" ] && mv "$log.$prev" "$log.$i"
        i="$prev"
    done
    mv "$log" "$log.1"
}

deepseek_harness_redact_log() {
    sed -u -E \
        -e 's#bot[0-9]{8,}:[A-Za-z0-9_-]{30,}#bot[REDACTED]#g' \
        -e 's#chatId=-?[0-9]+#chatId=[REDACTED]#g' \
        -e 's#bar-sync\(-?[0-9]+\)#bar-sync([REDACTED])#g' \
        -e 's#([?&]token=)[A-Za-z0-9_-]+#\1[REDACTED]#g'
}

deepseek_harness_load_env() {
    local env_file="$DSH_TELEGRAM_ENV_FILE" mode key value
    if [ ! -f "$env_file" ]; then
        echo "DeepSeek Harness private env file is missing: $env_file" >&2
        return 1
    fi
    mode=$(stat -c '%a' "$env_file" 2>/dev/null || printf '000')
    if [ "$mode" != "600" ]; then
        echo "DeepSeek Harness private env file must be mode 0600: $env_file" >&2
        return 1
    fi
    while IFS='=' read -r key value; do
        key="${key#export }"
        key="${key%$'\r'}"
        value="${value%$'\r'}"
        case "$key" in ''|\#*) continue ;; esac
        case "$key" in
            TELEGRAM_BOT_TOKEN_FILE|OPENCODE_GO_API_KEY_FILE|\
            DSH_HOME|DSH_TELEGRAM_PROFILE|DSH_TELEGRAM_WORKSPACE|DSH_TELEGRAM_PLUGIN_ROOT|\
            DSH_TELEGRAM_MODEL_PROVIDER|DSH_TELEGRAM_MODEL|DSH_TELEGRAM_PROVIDER_BASE_URL|\
            DSH_RECALL_MCP_URL|DSH_WEB_TRUSTED_HOST)
                value="${value%\"}"
                value="${value#\"}"
                value="${value%\'}"
                value="${value#\'}"
                export "$key=$value"
                ;;
        esac
    done < "$env_file"
}

deepseek_harness_render_profile_patch() {
    local output="$1" recall_url tailnet_ip
    if grep -q '@DSH_RECALL_MCP_URL@' "$DSH_TELEGRAM_PROFILE_PATCH_TEMPLATE"; then
        recall_url="${DSH_RECALL_MCP_URL:-}"
        if [ -z "$recall_url" ]; then
            tailnet_ip="$(tailscale ip -4 2>/dev/null | grep -m1 -E '^[0-9.]+$' || true)"
            [ -n "$tailnet_ip" ] && recall_url="http://$tailnet_ip:3004/mcp"
        fi
        if [ -z "$recall_url" ]; then
            echo "DeepSeek Harness cannot resolve the Recall MCP URL (set DSH_RECALL_MCP_URL in the private env file, or bring the tailnet up)" >&2
            return 1
        fi
    fi
    DSH_RENDER_RECALL_URL="${recall_url:-}" python3 - "$DSH_TELEGRAM_PROFILE_PATCH_TEMPLATE" "$output" <<'PY'
import json
import os
from pathlib import Path
import re
import subprocess
import sys

template = Path(sys.argv[1]).read_text(encoding="utf-8")
if "@DSH_WEB_TRUSTED_HOST@" in template:
    authority = os.environ.get("DSH_WEB_TRUSTED_HOST", "")
    # Only bare DNS authorities can enter the quoted YAML scalar. Reject URLs,
    # wildcards, whitespace and non-canonical ports before publishing anything.
    label = r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?"
    dns_host = rf"{label}(?:\.{label})*"
    if not authority:
        try:
            status = subprocess.run(
                ["tailscale", "status", "--json"], check=True,
                capture_output=True, text=True, timeout=5,
            )
            dns_name = json.loads(status.stdout)["Self"]["DNSName"].removesuffix(".").lower()
            if not re.fullmatch(dns_host, dns_name) or "." not in dns_name:
                raise ValueError("missing tailnet suffix")
            short_host = subprocess.run(
                ["hostname", "-s"], check=True,
                capture_output=True, text=True, timeout=5,
            ).stdout.strip().lower()
            if not re.fullmatch(label, short_host):
                raise ValueError("invalid short hostname")
            authority = f"{short_host}.{dns_name.split('.', 1)[1]}:3080"
        except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError, AttributeError):
            sys.exit("DeepSeek Harness cannot resolve the web trusted host (set DSH_WEB_TRUSTED_HOST in the private env file, or bring the tailnet up)")
    match = re.fullmatch(rf"({dns_host})(?::([1-9][0-9]{{0,4}}))?", authority.lower())
    if not match or len(match[1]) > 253 or (match[2] and int(match[2]) > 65535):
        sys.exit("DeepSeek Harness DSH_WEB_TRUSTED_HOST must be a bare DNS host[:port] authority")
    template = template.replace("@DSH_WEB_TRUSTED_HOST@", authority.lower())
template = template.replace("@DSH_RECALL_MCP_URL@", os.environ["DSH_RENDER_RECALL_URL"])
Path(sys.argv[2]).write_text(template, encoding="utf-8")
PY
}

deepseek_harness_sync_profile_patch() {
    local profile_dir profile_patch rendered
    deepseek_harness_load_env || return 1
    if [ ! -r "$DSH_TELEGRAM_PROFILE_PATCH_TEMPLATE" ]; then
        echo "DeepSeek Harness credential-containment patch template is missing: $DSH_TELEGRAM_PROFILE_PATCH_TEMPLATE" >&2
        return 1
    fi
    profile_dir="$DSH_HOME/profiles/$DSH_TELEGRAM_PROFILE"
    profile_patch="$profile_dir/cordis.patch.yml"
    mkdir -p "$profile_dir"
    rendered="$(mktemp "$profile_dir/.cordis.patch.yml.XXXXXX")"
    if ! deepseek_harness_render_profile_patch "$rendered"; then
        rm -f "$rendered"
        return 1
    fi
    chmod 600 "$rendered"
    mv "$rendered" "$profile_patch"
    echo "DeepSeek Harness managed profile patch refreshed"
}

deepseek_harness_validate_private_config() {
    local token_file key_file config settings profile_patch
    deepseek_harness_load_env || return 1

    token_file="${TELEGRAM_BOT_TOKEN_FILE:-}"
    if [ -z "$token_file" ]; then
        echo "DeepSeek Harness Telegram token file is missing; set TELEGRAM_BOT_TOKEN_FILE" >&2
        return 1
    fi
    if [ ! -r "$token_file" ]; then
        echo "DeepSeek Harness token file is not readable: $token_file" >&2
        return 1
    fi
    if [ "$(stat -c '%a' "$token_file" 2>/dev/null || printf '000')" != "600" ]; then
        echo "DeepSeek Harness token file must be mode 0600: $token_file" >&2
        return 1
    fi
    if [ ! -s "$token_file" ]; then
        echo "DeepSeek Harness token file is empty: $token_file" >&2
        return 1
    fi

    key_file="${OPENCODE_GO_API_KEY_FILE:-}"
    if [ -z "$key_file" ] || [ "$key_file" = "YOUR_HELMCORTEX_OPENCODE_GO_KEY_FILE" ]; then
        echo "DeepSeek Harness requires OPENCODE_GO_API_KEY_FILE pointing to the private HelmCortex OpenCode Go key" >&2
        return 1
    fi
    if [ ! -r "$key_file" ]; then
        echo "HelmCortex OpenCode Go key file is not readable: $key_file" >&2
        return 1
    fi
    if [ "$(stat -c '%a' "$key_file" 2>/dev/null || printf '000')" != "600" ]; then
        echo "HelmCortex OpenCode Go key file must be mode 0600: $key_file" >&2
        return 1
    fi
    if [ ! -s "$key_file" ]; then
        echo "HelmCortex OpenCode Go key file is empty: $key_file" >&2
        return 1
    fi

    if [ "$DSH_TELEGRAM_MODEL_PROVIDER" != "helmcortex-opencode-go" ] || \
       [ "$DSH_TELEGRAM_MODEL" != "deepseek-v4.1-flash" ] || \
       [ "$DSH_TELEGRAM_PROVIDER_BASE_URL" != "https://opencode.ai/zen/go/v1" ]; then
        echo "DeepSeek Harness must target helmcortex-opencode-go/deepseek-v4.1-flash at https://opencode.ai/zen/go/v1; no fallback is permitted" >&2
        return 1
    fi

    settings="$DSH_HOME/settings.yaml"
    if [ ! -r "$DSH_TELEGRAM_SETTINGS_TEMPLATE" ]; then
        echo "DeepSeek Harness OpenCode Go settings template is missing: $DSH_TELEGRAM_SETTINGS_TEMPLATE" >&2
        return 1
    fi
    if [ ! -r "$settings" ]; then
        echo "DeepSeek Harness settings are missing: $settings (copy the OpenCode Go template exactly)" >&2
        return 1
    fi
    if ! cmp -s "$settings" "$DSH_TELEGRAM_SETTINGS_TEMPLATE"; then
        echo "DeepSeek Harness settings differ from the single-model OpenCode Go V4.1 Flash template; refusing possible fallback" >&2
        return 1
    fi

    profile_patch="$DSH_HOME/profiles/$DSH_TELEGRAM_PROFILE/cordis.patch.yml"
    if [ ! -r "$DSH_TELEGRAM_PROFILE_PATCH_TEMPLATE" ]; then
        echo "DeepSeek Harness credential-containment patch template is missing: $DSH_TELEGRAM_PROFILE_PATCH_TEMPLATE" >&2
        return 1
    fi
    if [ ! -r "$profile_patch" ]; then
        echo "DeepSeek Harness profile patch is missing: $profile_patch (copy the credential-containment template exactly)" >&2
        return 1
    fi
    local expected_patch
    expected_patch="$(mktemp)"
    if ! deepseek_harness_render_profile_patch "$expected_patch"; then
        rm -f "$expected_patch"
        return 1
    fi
    if ! cmp -s "$profile_patch" "$expected_patch"; then
        rm -f "$expected_patch"
        echo "DeepSeek Harness profile patch does not disable native DeepSeek chat/search routes; refusing credential egress" >&2
        return 1
    fi
    rm -f "$expected_patch"

    config="$(deepseek_harness_config_file)"
    if [ ! -r "$config" ]; then
        echo "DeepSeek Harness Telegram config is missing: $config" >&2
        return 1
    fi
    python3 - "$config" "$DSH_TELEGRAM_MODEL_PROVIDER" "$DSH_TELEGRAM_MODEL" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
expected_provider, expected_model = sys.argv[2], sys.argv[3]
try:
    data = json.loads(path.read_text(encoding="utf-8"))
except Exception as exc:
    print(f"DeepSeek Harness Telegram config is invalid JSON: {exc}", file=sys.stderr)
    raise SystemExit(1)
allowed = (((data.get("security") or {}).get("allowedChatIds")) or [])
if not isinstance(allowed, list):
    print("DeepSeek Harness security.allowedChatIds must be a list", file=sys.stderr)
    raise SystemExit(1)
if not allowed:
    print("DeepSeek Harness security.allowedChatIds is empty; startup remains deny-all", file=sys.stderr)
    raise SystemExit(1)
if not all(isinstance(item, int) for item in allowed):
    print("DeepSeek Harness security.allowedChatIds must contain numeric chat IDs only", file=sys.stderr)
    raise SystemExit(1)
model = data.get("model") or {}
if model.get("provider") != expected_provider or model.get("model") != expected_model:
    print(
        f"DeepSeek Harness Telegram model must be {expected_provider}/{expected_model}; no fallback is permitted",
        file=sys.stderr,
    )
    raise SystemExit(1)
PY
}

deepseek_harness_preflight_model() {
    env -u DEEPSEEK_API_KEY -u DEEPSEEK_API_KEY_FILE -u NEURALWATT_API_KEY -u OPENCODE_API_KEY -u OPENCODE_GO_API_KEY \
        OPENCODE_GO_API_KEY_FILE="$OPENCODE_GO_API_KEY_FILE" \
        DSH_TELEGRAM_PROVIDER_BASE_URL="$DSH_TELEGRAM_PROVIDER_BASE_URL" \
        DSH_TELEGRAM_MODEL="$DSH_TELEGRAM_MODEL" \
        python3 - <<'PY'
import json
import os
import ssl
import sys
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

from pathlib import Path

base_url = os.environ["DSH_TELEGRAM_PROVIDER_BASE_URL"].rstrip("/")
model = os.environ["DSH_TELEGRAM_MODEL"]
api_key = Path(os.environ["OPENCODE_GO_API_KEY_FILE"]).read_text(encoding="utf-8").splitlines()[0]
request = Request(
    f"{base_url}/models",
    headers={"Authorization": f"Bearer {api_key}", "User-Agent": "telegram-agent-host/preflight"},
)
try:
    # Cron's Python trust path may differ from the interactive shell's. Pin the
    # system CA bundle instead of relying on ambient SSL_CERT_FILE/SSL_CERT_DIR.
    context = ssl.create_default_context(cafile="/etc/ssl/certs/ca-certificates.crt")
    with urlopen(request, timeout=15, context=context) as response:
        payload = json.load(response)
except HTTPError as exc:
    print(f"OpenCode Go model visibility preflight failed: HTTP {exc.code}", file=sys.stderr)
    raise SystemExit(1)
except (URLError, TimeoutError, OSError, ValueError) as exc:
    print(f"OpenCode Go model visibility preflight failed: {exc}", file=sys.stderr)
    raise SystemExit(1)

visible = set()
data = payload.get("data") if isinstance(payload, dict) else None
if isinstance(data, list):
    visible.update(item.get("id") for item in data if isinstance(item, dict) and isinstance(item.get("id"), str))
models = payload.get("models") if isinstance(payload, dict) else None
if isinstance(models, dict):
    visible.update(key for key in models if isinstance(key, str))
if model not in visible:
    print(
        f"OpenCode Go does not expose required model {model}; refusing undeclared fallback and poller start",
        file=sys.stderr,
    )
    raise SystemExit(1)
print(f"OpenCode Go model visibility preflight passed: {model}")
PY
}

deepseek_harness_validate_install() {
    if ! env PATH="$AGENT_RUNTIME_PATH" bash -c 'command -v dsh >/dev/null 2>&1'; then
        echo "DeepSeek Harness CLI not found in PATH; run loom npm:apply after tangling" >&2
        return 1
    fi
    if [ ! -d "$DSH_TELEGRAM_PLUGIN_ROOT" ]; then
        echo "dsh-telegram checkout missing: $DSH_TELEGRAM_PLUGIN_ROOT" >&2
        return 1
    fi
    python3 - "$DSH_TELEGRAM_PLUGIN_ROOT/package.json" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
try:
    data = json.loads(path.read_text(encoding="utf-8"))
except Exception as exc:
    print(f"dsh-telegram package.json unreadable: {exc}", file=sys.stderr)
    raise SystemExit(1)
if data.get("name") != "dsh-telegram":
    print(f"dsh-telegram package name mismatch: {data.get('name')}", file=sys.stderr)
    raise SystemExit(1)
PY
    [ -f "$DSH_TELEGRAM_PLUGIN_ROOT/package-lock.json" ] || {
        echo "dsh-telegram package-lock.json missing; refusing unverified build source" >&2
        return 1
    }
    [ -f "$DSH_TELEGRAM_PLUGIN_ROOT/cordis.patch.yml" ] || {
        echo "dsh-telegram bundle patch missing; rerun the targeted Loom build" >&2
        return 1
    }
    [ -f "$DSH_TELEGRAM_PLUGIN_ROOT/dist/index.js" ] || {
        echo "dsh-telegram build output missing; run loom bun:apply before startup" >&2
        return 1
    }
    python3 - "$DSH_HOME/profiles/$DSH_TELEGRAM_PROFILE/package.json" "$DSH_TELEGRAM_PLUGIN_ROOT" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
plugin_root = Path(sys.argv[2]).expanduser()
try:
    data = json.loads(path.read_text(encoding="utf-8"))
except Exception as exc:
    print(f"dsh profile package.json unreadable: {exc}", file=sys.stderr)
    raise SystemExit(1)

deps = {}
for key in ("dependencies", "devDependencies", "optionalDependencies"):
    value = data.get(key)
    if isinstance(value, dict):
        deps.update(value)

expected = f"link:{plugin_root}"
if deps.get("dsh-telegram") != expected:
    print(f"dsh profile '{path.parent.name}' does not depend on dsh-telegram as {expected}", file=sys.stderr)
    raise SystemExit(1)
PY
}

check_deepseek_harness() {
    local delegated=0
    deepseek_harness_delegate status || delegated=$?
    [ "$delegated" -eq 3 ] || return "$delegated"
    if deepseek_harness_ready; then
        local pid
        pid="$(cat "$DSH_TELEGRAM_PID_FILE")"
        echo "  deepseek-harness: RUNNING pid=$pid profile=$DSH_TELEGRAM_PROFILE"
    elif [ -r "$DSH_TELEGRAM_PID_FILE" ] || [ -r "$DSH_TELEGRAM_READY_MARKER" ]; then
        echo "  deepseek-harness: STOPPED (readiness owner state not verified)"
        return 1
    else
        echo "  deepseek-harness: STOPPED"
        return 1
    fi
}

codex_telegram_start_ticks() {
    python3 - "$1" <<'PY'
from pathlib import Path
import sys

try:
    stat = Path("/proc", sys.argv[1], "stat").read_text(encoding="utf-8")
    fields = stat[stat.rfind(")") + 2:].split()
    print(fields[19])
except (OSError, IndexError, ValueError):
    raise SystemExit(1)
PY
}

codex_telegram_supervisor_matches() {
    local pid="${1:-}" expected_ticks="${2:-}" current_ticks argument supervisor_match=0
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    [ -r "/proc/$pid/cmdline" ] || return 1
    while IFS= read -r -d '' argument; do
        case "$argument" in */FORGE/scripts/codex_supervisor.py) supervisor_match=1 ;; esac
    done < "/proc/$pid/cmdline"
    [ "$supervisor_match" = 1 ] || return 1
    if [ -n "$expected_ticks" ]; then
        current_ticks="$(codex_telegram_start_ticks "$pid" 2>/dev/null)" || return 1
        [ "$current_ticks" = "$expected_ticks" ] || return 1
    fi
}

codex_telegram_running() {
    local pid_file="$STATE_DIR/codex-helmastra-telegram.pid"
    local ready_file="$STATE_DIR/codex-helmastra-telegram.ready"
    local child_file="$STATE_DIR/codex-helmastra-telegram.child.ready"
    local pid ready child parent argument adapter_match=0
    [ -r "$pid_file" ] && [ -r "$ready_file" ] && [ -r "$child_file" ] || return 1
    pid=$(cat "$pid_file")
    ready=$(cat "$ready_file")
    child=$(cat "$child_file")
    case "$pid:$child" in *[!0-9:]*|:*|*:) return 1 ;; esac
    [ "$ready" = "$pid" ] || return 1
    codex_telegram_supervisor_matches "$pid" || return 1
    [ -r "/proc/$child/cmdline" ] || return 1
    while IFS= read -r -d '' argument; do
        case "$argument" in */FORGE/scripts/codex_telegram.py) adapter_match=1 ;; esac
    done < "/proc/$child/cmdline"
    [ "$adapter_match" = 1 ] || return 1
    parent=$(awk '/^PPid:/ {print $2}' "/proc/$child/status" 2>/dev/null) || return 1
    [ "$parent" = "$pid" ]
}

gemma_telegram_running() {
    local pid argument
    [ -f "$GEMMA_TELEGRAM_PID_FILE" ] || return 1
    pid="$(cat "$GEMMA_TELEGRAM_PID_FILE" 2>/dev/null)" || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    while IFS= read -r -d '' argument; do
        case "$argument" in
            */gemma_telegram.py|gemma_telegram.py)
                return 0
                ;;
        esac
    done < "/proc/$pid/cmdline"
    return 1
}

start_pi_agent() {
    if gemma_telegram_running; then
        echo "pi-agent (Gemma Telegram): already running"
        return 0
    fi
    if [ ! -x "$GEMMA_TELEGRAM_WRAPPER" ]; then
        echo "Gemma Telegram wrapper not found: $GEMMA_TELEGRAM_WRAPPER" >&2
        return 1
    fi
    if [ ! -f "$HOME/.config/gemma-pi-telegram/.env" ]; then
        echo "Gemma Telegram private env missing: $HOME/.config/gemma-pi-telegram/.env" >&2
        return 1
    fi
    mkdir -p "$GEMMA_TELEGRAM_STATE_DIR"
    echo "Starting pi-agent (Gemma Telegram)..."
    nohup setsid env PATH="$AGENT_RUNTIME_PATH" "$GEMMA_TELEGRAM_WRAPPER" > "$GEMMA_TELEGRAM_LOG_FILE" 2>&1 </dev/null &
    for _ in {1..20}; do
        gemma_telegram_running && return 0
        sleep 0.5
    done
    echo "Gemma Telegram failed readiness; inspect $GEMMA_TELEGRAM_LOG_FILE" >&2
    return 1
}

stop_pi_agent() {
    if ! gemma_telegram_running; then
        echo "pi-agent: not running"
        return 0
    fi
    local pid pgid
    pid="$(cat "$GEMMA_TELEGRAM_PID_FILE" 2>/dev/null)"
    pgid=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
    if [ "$pgid" = "$pid" ]; then
        kill -TERM -- "-$pgid" 2>/dev/null || true
    else
        kill -TERM "$pid" 2>/dev/null || true
    fi
    for _ in {1..20}; do
        gemma_telegram_running || break
        sleep 0.25
    done
    if gemma_telegram_running; then
        echo "Gemma Telegram did not stop gracefully; forcing verified process group" >&2
        if [ "$pgid" = "$pid" ]; then
            kill -KILL -- "-$pgid" 2>/dev/null || true
        else
            kill -KILL "$pid" 2>/dev/null || true
        fi
    fi
    gemma_telegram_running && return 1
    rm -f "$GEMMA_TELEGRAM_PID_FILE"
}

check_pi_agent() {
    if gemma_telegram_running; then
        echo "pi-agent: RUNNING pid=$(cat "$GEMMA_TELEGRAM_PID_FILE") (gemma-pi-telegram)"
    else
        echo "pi-agent: STOPPED (gemma-pi-telegram)"
    fi
}

# Shoukichi (vibe-bridge). The wrapper execs the pinned venv python with
# `-m vibe_bridge.main`, so ownership is verified against that exact argv
# plus the PID file — never a broad process-name match.
shoukichi_running() {
    local pid argument found_bridge=0 found_module=0
    [ -f "$SHOUKICHI_PID_FILE" ] || return 1
    pid="$(cat "$SHOUKICHI_PID_FILE" 2>/dev/null)" || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    # PID 0/1 can never be the adapter; refuse before touching /proc so a
    # stale pid file pointing at init is reported as stopped, not owned.
    [ "$pid" -gt 1 ] || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    while IFS= read -r -d '' argument; do
        case "$argument" in
            */vibe_bridge.main|vibe_bridge.main) found_module=1 ;;
            */.venv/bin/python|.venv/bin/python) found_bridge=1 ;;
        esac
    done < "/proc/$pid/cmdline"
    [ "$found_bridge" = 1 ] && [ "$found_module" = 1 ]
}

start_shoukichi() {
    if shoukichi_running; then
        echo "shoukichi (vibe-bridge): already running"
        return 0
    fi
    if [ ! -x "$SHOUKICHI_WRAPPER" ]; then
        echo "Shoukichi wrapper not found: $SHOUKICHI_WRAPPER (stow DotCortex)" >&2
        return 1
    fi
    if [ ! -f "$HOME/.config/vibe-telegram/env" ]; then
        echo "Shoukichi private env missing: $HOME/.config/vibe-telegram/env" >&2
        return 1
    fi
    mkdir -p "$SHOUKICHI_STATE_DIR"
    echo "Starting shoukichi (vibe-bridge)..."
    # The bridge does not write its own PID file; the host script owns it.
    # setsid gives the adapter its own process group so stop can signal the
    # group (the bridge spawns a vibe-acp child that must die with it).
    nohup setsid env PATH="$AGENT_RUNTIME_PATH" "$SHOUKICHI_WRAPPER" > "$SHOUKICHI_LOG_FILE" 2>&1 </dev/null &
    local launched_pid="$!"
    printf '%s\n' "$launched_pid" > "$SHOUKICHI_PID_FILE"
    # Capture the process start time at launch so a recycled PID can never
    # impersonate the owner between launch and stop (same discipline as the
    # codex lane). The .start file only ever names this exact incarnation.
    ps -o lstart= -p "$launched_pid" > "$SHOUKICHI_PID_FILE.start" 2>/dev/null || rm -f "$SHOUKICHI_PID_FILE.start"
    for _ in {1..30}; do
        shoukichi_running && return 0
        sleep 0.5
    done
    echo "Shoukichi vibe-bridge failed readiness; inspect $SHOUKICHI_LOG_FILE" >&2
    rm -f "$SHOUKICHI_PID_FILE"
    return 1
}

# Kill-target guard (Fable 2026-10-09, the three-kill night): no signal may
# leave this function before the target is proven ours. Refuse PID 1, PID 0,
# non-numeric, empty pgid, and pgid/PID mismatches outright; a recycled PID
# that happens to look like ours in argv is caught by re-verifying identity
# immediately before every signal, and a wrong-but-matching pgid can never
# widen into kill -- -1 because empty or foreign pgids never reach the group
# form. Every kill target is logged before it is signalled.
shoukichi_verified_kill() {
    local pid="$1" sig="$2" pgid
    case "$pid" in ''|*[!0-9]*|0|1)
        echo "Shoukichi stop refusing unsafe PID target: '$pid'" >&2
        return 1 ;;
    esac
    pgid=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
    if [ -z "$pgid" ] || [ "$pgid" = 0 ] || [ "$pgid" = 1 ] || [ "$pgid" != "$pid" ]; then
        # The adapter is launched with setsid, so its pgid MUST equal its pid;
        # anything else means the process is not ours or already died and the
        # PID was recycled. Signal the single verified PID only — never a
        # group we did not create.
        echo "Shoukichi verified kill: pid=$pid sig=$sig (pgid '$pgid' not pgl-equal; single-pid form)" >&2
        kill -"$sig" "$pid" 2>/dev/null || true
        return 0
    fi
    echo "Shoukichi verified kill: pid=$pid pgid=$pgid sig=$sig" >&2
    kill -"$sig" -- "-$pgid" 2>/dev/null || true
}

stop_shoukichi() {
    if ! shoukichi_running; then
        echo "shoukichi: not running"
        return 0
    fi
    local pid
    pid="$(cat "$SHOUKICHI_PID_FILE" 2>/dev/null)"
    shoukichi_verified_kill "$pid" TERM
    for _ in {1..40}; do
        shoukichi_running || break
        sleep 0.25
    done
    if shoukichi_running; then
        echo "Shoukichi vibe-bridge did not stop gracefully; forcing the verified PID" >&2
        shoukichi_verified_kill "$pid" KILL
    fi
    shoukichi_running && return 1
    rm -f "$SHOUKICHI_PID_FILE" "$SHOUKICHI_PID_FILE.start"
}

check_shoukichi() {
    if shoukichi_running; then
        echo "shoukichi: RUNNING pid=$(cat "$SHOUKICHI_PID_FILE") (vibe-bridge)"
    else
        echo "shoukichi: STOPPED (vibe-bridge)"
    fi
}

nanobot_private_config_ready() {
    [ -x "$NANOBOT_WRAPPER" ] || {
        echo "Nanobot wrapper missing: $NANOBOT_WRAPPER (stow DotCortex)" >&2
        return 1
    }
    [ -d "$NANOBOT_WORKSPACE" ] || {
        echo "Nanobot workspace missing: $NANOBOT_WORKSPACE" >&2
        return 1
    }
    [ -r "$NANOBOT_CONFIG" ] || {
        echo "Nanobot config missing: $NANOBOT_CONFIG (run telegram-agent-host sync)" >&2
        return 1
    }
    [ -r "$NANOBOT_ENV_FILE" ] || {
        echo "Nanobot private env missing: $NANOBOT_ENV_FILE" >&2
        return 1
    }
    awk -F= '$1 == "TELEGRAM_BOT_TOKEN" && length($2) > 20 { found=1 } END { exit !found }' \
        "$NANOBOT_ENV_FILE" || {
        echo "Nanobot TELEGRAM_BOT_TOKEN is not provisioned in $NANOBOT_ENV_FILE" >&2
        return 1
    }
}

nanobot_gateway_status() {
    "$NANOBOT_WRAPPER" gateway status 2>/dev/null
}

nanobot_running() {
    local status
    status="$(nanobot_gateway_status 2>/dev/null || true)"
    printf '%s\n' "$status" | grep -qx 'Running: yes'
}

nanobot_log_file() {
    local status
    status="$(nanobot_gateway_status 2>/dev/null || true)"
    printf '%s\n' "$status" | awk '
        /^Logs: / { sub(/^Logs: /, ""); print; exit }
        /^Logs:$/ { if (getline > 0) print; exit }
    '
}

check_nanobot() {
    local status pid
    status="$(nanobot_gateway_status 2>/dev/null || true)"
    if printf '%s\n' "$status" | grep -qx 'Running: yes'; then
        pid="$(printf '%s\n' "$status" | sed -n 's/^PID: //p' | head -n1)"
        echo "nanobot: RUNNING pid=${pid:-unknown} (@helmcortex_nano_bot)"
    else
        echo "nanobot: STOPPED (@helmcortex_nano_bot)"
        return 1
    fi
}

start_nanobot() {
    local log_file log_start=0 log_size
    nanobot_private_config_ready || return 1
    if nanobot_running; then
        echo "nanobot is already running"
        return 0
    fi
    # Bind readiness to this launch. Gateway logs are append-only, so an old
    # successful connection must not make a new broken launch look healthy.
    log_file="$(nanobot_log_file 2>/dev/null || true)"
    if [ -n "$log_file" ] && [ -r "$log_file" ]; then
        log_start="$(wc -c < "$log_file" | tr -d '[:space:]')"
        case "$log_start" in ''|*[!0-9]*) log_start=0 ;; esac
    fi
    echo "Starting HelmCortex Nano Telegram gateway..."
    "$NANOBOT_WRAPPER" gateway --background
    for _ in {1..30}; do
        if nanobot_running; then
            log_file="$(nanobot_log_file 2>/dev/null || true)"
            if [ -n "$log_file" ] && [ -r "$log_file" ]; then
                log_size="$(wc -c < "$log_file" | tr -d '[:space:]')"
                case "$log_size" in ''|*[!0-9]*) log_size=0 ;; esac
                [ "$log_size" -ge "$log_start" ] || log_start=0
                if grep -q 'telegram | bot @helmcortex_nano_bot connected' \
                    < <(tail -c "+$((log_start + 1))" "$log_file"); then
                    echo "nanobot connected as @helmcortex_nano_bot"
                    return 0
                fi
            fi
        fi
        sleep 1
    done
    echo "Nanobot failed Telegram readiness; stopping the scoped gateway" >&2
    "$NANOBOT_WRAPPER" gateway stop >/dev/null 2>&1 || true
    return 1
}

stop_nanobot() {
    if ! nanobot_running; then
        echo "nanobot: not running"
        return 0
    fi
    "$NANOBOT_WRAPPER" gateway stop
    for _ in {1..20}; do
        nanobot_running || return 0
        sleep 0.25
    done
    echo "Nanobot gateway did not stop through its owned instance state" >&2
    return 1
}

status_cmd() {
    local requested="${1:-}"
    local host
    host=$(get_hostname)
    if [ "$requested" = "opencode" ]; then
        check_opencode
        return
    fi
    if [ "$requested" = "deepseek-harness" ]; then
        check_deepseek_harness
        return
    fi
    if [ "$requested" = "pi-agent" ]; then
        check_pi_agent
        return
    fi
    if [ "$requested" = "shoukichi" ]; then
        check_shoukichi
        return
    fi
    if [ "$requested" = "nanobot" ]; then
        local delegated=0
        nanobot_delegate status || delegated=$?
        [ "$delegated" -eq 3 ] || return "$delegated"
        check_nanobot
        return
    fi
    echo "Host: $host"
    echo "Enabled agents: $(get_enabled_agents "$host")"
    echo ""
    echo "Running processes:"
    # Every agent's line must print even when an earlier one is degraded or
    # stopped: a failing check_* would otherwise end the whole report under
    # set -e, and readers (operators, agents, telegram-agent-watchdog) would
    # take the missing lines for a missing agent. Per-agent status stays
    # available through "status <agent>".
    check_opencode || true
    check_ductor || true
    check_claudecode || true
    check_hermes || true
    check_codex || true
    check_deepseek_harness || true
    check_pi_agent || true
    check_nanobot || true
    check_shoukichi || true
}

enable_agent() {
    local agent="$1"
    validate_agent "$agent"
    local host
    host=$(get_hostname)

    if [ ! -f "$HOSTS_FILE" ]; then
        echo "Error: hosts.conf not found at $HOSTS_FILE"
        exit 1
    fi

    local line
    line=$(grep -i "^${host}|" "$HOSTS_FILE" 2>/dev/null || true)
    if [ -z "$line" ]; then
        echo "Error: host '$host' not found in hosts.conf"
        exit 1
    fi

    local current_agents
    current_agents=$(echo "$line" | cut -d'|' -f2)

    if echo "$current_agents" | grep -qw "$agent"; then
        echo "$agent is already enabled on $host"
        return
    fi

    local new_agents
    if [ -z "$current_agents" ]; then
        new_agents="$agent"
    else
        new_agents="$current_agents,$agent"
    fi

    local tmp_hosts
    tmp_hosts="${HOSTS_FILE}.tmp.$$"
    awk -F'|' -v host="$host" -v agents="$new_agents" '
        BEGIN { OFS = FS }
        tolower($1) == tolower(host) { $2 = agents }
        { print }
    ' "$HOSTS_FILE" > "$tmp_hosts"
    mv "$tmp_hosts" "$HOSTS_FILE"
    echo "Enabled $agent on $host"
    echo "Run 'telegram-agent-host sync' to apply, then 'telegram-agent-host start'"
}

disable_agent() {
    local agent="$1"
    validate_agent "$agent"
    local host
    host=$(get_hostname)

    if [ ! -f "$HOSTS_FILE" ]; then
        echo "Error: hosts.conf not found at $HOSTS_FILE"
        exit 1
    fi

    local line
    line=$(grep -i "^${host}|" "$HOSTS_FILE" 2>/dev/null || true)
    if [ -z "$line" ]; then
        echo "Error: host '$host' not found in hosts.conf"
        exit 1
    fi

    local current_agents
    current_agents=$(echo "$line" | cut -d'|' -f2)

    if ! echo "$current_agents" | grep -qw "$agent"; then
        echo "$agent is not enabled on $host"
        return
    fi

    local new_agents
    new_agents=$(echo "$current_agents" | tr ',' '\n' | grep -v "^${agent}$" | tr '\n' ',' | sed 's/,$//' | sed 's/^,//')

    local tmp_hosts
    tmp_hosts="${HOSTS_FILE}.tmp.$$"
    awk -F'|' -v host="$host" -v agents="$new_agents" '
        BEGIN { OFS = FS }
        tolower($1) == tolower(host) { $2 = agents }
        { print }
    ' "$HOSTS_FILE" > "$tmp_hosts"
    mv "$tmp_hosts" "$HOSTS_FILE"
    echo "Disabled $agent on $host"
    echo "Run 'telegram-agent-host stop $agent' to stop it"
}

sync_configs() {
    local requested="${1:-}" delegated=0
    if [ -n "$requested" ]; then
        case "$requested" in
            deepseek-harness)
                deepseek_harness_delegate sync || delegated=$?
                [ "$delegated" -eq 3 ] || return "$delegated"
                deepseek_harness_sync_profile_patch
                return
                ;;
            *)
                echo "No scoped config sync exists for agent: $requested" >&2
                return 1
                ;;
        esac
    fi
    echo "Syncing agent configs from DotCortex..."
    local repo="$HOME/DotCortex"

    if [ ! -d "$repo/all/.bots" ]; then
        echo "Error: DotCortex/all/.bots not found"
        exit 1
    fi

    mkdir -p "$HOME/.config/opencode-telegram-bot"
    mkdir -p "$HOME/.config/codex-telegram-helmastra"
    mkdir -p "$HOME/.config/deepseek-harness-telegram"
    mkdir -p "$HOME/.config/pi-agent" 2>/dev/null || true
    mkdir -p "$NANOBOT_CONFIG_DIR"
    mkdir -p "$HOME/.config/telegram-agents"

    chmod 700 "$NANOBOT_CONFIG_DIR"
    if [ ! -e "$NANOBOT_CONFIG" ]; then
        install -m 600 "$repo/all/.bots/templates/nanobot-config.json" "$NANOBOT_CONFIG"
        echo "Installed Nanobot non-secret config template at $NANOBOT_CONFIG"
    fi
    if [ ! -e "$NANOBOT_ENV_FILE" ]; then
        install -m 600 "$repo/all/.bots/templates/nanobot-telegram.env" "$NANOBOT_ENV_FILE"
        echo "Installed Nanobot env template at $NANOBOT_ENV_FILE; provision its token before start"
    fi

    if [ -f "$repo/all/.bots/hosts.conf" ]; then
        cp "$repo/all/.bots/hosts.conf" "$HOME/.config/telegram-agents/hosts.conf"
    fi

    echo "Config sync complete. Update credentials manually if needed."
}

start_agent() {
    local agent="$1"
    validate_agent "$agent"
    case "$agent" in
        opencode)
            local delegated=0
            opencode_delegate start || delegated=$?
            [ "$delegated" -eq 3 ] || return "$delegated"
            load_opencode_continuity_policy
            if [ ! -d "$OPENCODE_PROJECT_ROOT" ]; then
                echo "OpenCode project root not found: $OPENCODE_PROJECT_ROOT" >&2
                return 1
            fi
            if [ ! -x "$OPENCODE_PATCH_APPLIER" ]; then
                echo "OpenCode Telegram patch applier not found: $OPENCODE_PATCH_APPLIER" >&2
                return 1
            fi
            # Resolve node on the runtime PATH: as the operator that is the core
            # profile, as an agent user its own agent profile (run-as delegation).
            if ! env PATH="$AGENT_RUNTIME_PATH" sh -c 'command -v node' >/dev/null 2>&1; then
                echo "Intended OpenCode Node runtime not found on: $AGENT_RUNTIME_PATH" >&2
                return 1
            fi
            if ! env PATH="$AGENT_RUNTIME_PATH" "$OPENCODE_PATCH_APPLIER"; then
                echo "OpenCode Telegram package seam is not ready; refusing start" >&2
                return 1
            fi
            if [ -r "$OPENCODE_STATE_FILE" ]; then
                if check_opencode >/dev/null 2>&1; then
                    echo "opencode is already running"
                    return 0
                fi
                echo "Existing OpenCode owner state is not healthy; validating and stopping only its owned processes..."
                "$OPENCODE_OWNER_HELPER" stop --state "$OPENCODE_STATE_FILE" --project "$OPENCODE_PROJECT_ROOT" --host 127.0.0.1 --port "$OPENCODE_PORT" || true
            fi
            if command -v ss >/dev/null 2>&1 && ss -Hln "sport = :$OPENCODE_PORT" 2>/dev/null | grep -q .; then
                echo "Refusing OpenCode start: port $OPENCODE_PORT is already occupied by an unowned listener" >&2
                return 1
            fi
            echo "Starting opencode serve in $OPENCODE_PROJECT_ROOT..."
            (
                cd "$OPENCODE_PROJECT_ROOT"
                exec nohup env PATH="$AGENT_RUNTIME_PATH" opencode serve --hostname 127.0.0.1 --port "$OPENCODE_PORT"
            ) > "$STATE_DIR/opencode-serve.log" 2>&1 </dev/null &
            printf '%s\n' "$!" > "$OPENCODE_BACKEND_PID_FILE"
            sleep 2
            if [ ! -s "$OPENCODE_BACKEND_PID_FILE" ]; then
                echo "OpenCode backend did not publish an owned PID" >&2
                return 1
            fi
            echo "Starting opencode-telegram in $OPENCODE_PROJECT_ROOT..."
            if ! (umask 077; cd "$OPENCODE_PROJECT_ROOT" && env PATH="$AGENT_RUNTIME_PATH" NODE_OPTIONS="$OPENCODE_NODE_OPTIONS" "$OPENCODE_POLLER_BIN" start --daemon --mode installed > "$STATE_DIR/opencode-telegram.log" 2>&1 </dev/null); then
                backend_pid=$(cat "$OPENCODE_BACKEND_PID_FILE")
                kill -TERM "$backend_pid" 2>/dev/null || true
                rm -f "$OPENCODE_BACKEND_PID_FILE"
                echo "OpenCode Telegram daemon failed to start; rolled back owned backend" >&2
                return 1
            fi
            for _ in {1..15}; do
                [ -s "$OPENCODE_TELEGRAM_HOME/run/bot-service.json" ] && break
                sleep 1
            done
            write_opencode_state || {
                env PATH="$AGENT_RUNTIME_PATH" "$OPENCODE_POLLER_BIN" stop >/dev/null 2>&1 || true
                backend_pid=$(cat "$OPENCODE_BACKEND_PID_FILE")
                kill -TERM "$backend_pid" 2>/dev/null || true
                rm -f "$OPENCODE_BACKEND_PID_FILE" "$OPENCODE_POLLER_PID_FILE"
                echo "OpenCode backend/poller did not produce a complete owner state" >&2
                return 1
            }
            python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["pid"])' "$OPENCODE_TELEGRAM_HOME/run/bot-service.json" > "$OPENCODE_POLLER_PID_FILE"
            ;;
        ductor)
            if command -v ductor >/dev/null 2>&1 && [ -x "$DUCTOR_SUPERVISOR" ]; then
                if ductor_ready; then
                    echo "ductor is already running"
                elif ductor_running; then
                    echo "ductor supervisor is running; waiting for cold-start readiness..."
                    if ! wait_ductor_ready; then
                        echo "ductor supervisor remained degraded after ${DUCTOR_READY_TIMEOUT:-90}s" >&2
                        return 1
                    fi
                    echo "ductor started"
                else
                    echo "Starting ductor (supervised)..."
                    rm -f "$STATE_DIR/ductor-supervise.pid" "$STATE_DIR/ductor-child.pid"
                    nohup setsid env PATH="$AGENT_RUNTIME_PATH" DUCTOR_HOME="$DUCTOR_HOME_DIR" "$DUCTOR_SUPERVISOR" > "$STATE_DIR/ductor-supervise.log" 2>&1 </dev/null &
                    if ! wait_ductor_ready; then
                        echo "ductor failed supervised readiness" >&2
                        return 1
                    fi
                    echo "ductor started"
                fi
            else
                echo "ductor or its canonical supervisor is unavailable"
                return 1
            fi
            ;;
        claudecode)
            echo "claudecode Telegram runs inline via the PTY-supervised claude-auryn launcher."
            echo "Launch Claude with: claude-auryn --telegram"
            echo "Access control: ~/.claude/channels/telegram/access.json"
            ;;
        hermes)
            start_hermes
            ;;
        codex)
            local wrapper="${CODEX_HELMASTRA_WRAPPER:-$HOME/HelmCortex/FORGE/bin/codex-helmastra}"
            if [ ! -x "$wrapper" ]; then
                echo "codex-helmastra wrapper not found at $wrapper"
                return 1
            fi
            if codex_telegram_running; then
                echo "HelmAstra Telegram is already running"
            else
                echo "Starting HelmAstra Codex Telegram adapter..."
                # Managed starts are governed by the private dotenv. A restart
                # launched from inside the old adapter inherits that adapter's
                # model/policy environment; clear it here so stale values cannot
                # outrank the newly authored private configuration.
                if ! env \
                    -u CODEX_HELMASTRA_MODEL \
                    -u CODEX_TELEGRAM_MODEL \
                    -u CODEX_HELMASTRA_EFFORT \
                    -u CODEX_TELEGRAM_EFFORT \
                    -u CODEX_TELEGRAM_APPROVAL_POLICY \
                    -u CODEX_TELEGRAM_APPROVALS_REVIEWER \
                    "$wrapper" --telegram \
                    >> "$STATE_DIR/codex-helmastra-telegram.log" 2>&1 </dev/null; then
                    echo "HelmAstra Telegram adapter failed readiness; inspect $STATE_DIR/codex-helmastra-telegram.log"
                    return 1
                fi
                if ! codex_telegram_running; then
                    echo "HelmAstra Telegram adapter reported ready but is not running"
                    return 1
                fi
            fi
            ;;
        deepseek-harness)
            local delegated=0
            deepseek_harness_delegate start || delegated=$?
            [ "$delegated" -eq 3 ] || return "$delegated"
            mkdir -p "$STATE_DIR"
            deepseek_harness_acquire_start_lock || return 1
            deepseek_harness_validate_private_config || { deepseek_harness_release_start_lock; return 1; }
            deepseek_harness_validate_install || { deepseek_harness_release_start_lock; return 1; }
            if deepseek_harness_ready; then
                deepseek_harness_release_start_lock
                echo "deepseek-harness already has a ready owned poller"
                return 0
            fi
            if deepseek_harness_running; then
                deepseek_harness_release_start_lock
                echo "DeepSeek Harness has a legacy PID-only poller; stop it before starting under the readiness contract" >&2
                return 1
            fi
            deepseek_harness_clear_stale_marker || { deepseek_harness_release_start_lock; return 1; }
            deepseek_harness_retire_stale_owner || { deepseek_harness_release_start_lock; return 1; }
            local other_pid
            other_pid="$(deepseek_harness_find_unowned 2>/dev/null || true)"
            if [ -n "$other_pid" ]; then
                deepseek_harness_release_start_lock
                echo "Refusing DeepSeek Harness start: another dsh poller already uses profile $DSH_TELEGRAM_PROFILE (pid $other_pid)" >&2
                return 1
            fi
            deepseek_harness_preflight_model || { deepseek_harness_release_start_lock; return 1; }
            deepseek_harness_rotate_log
            local launch_generation launch_marker
            launch_generation="$(deepseek_harness_write_generation)" || {
                deepseek_harness_release_start_lock
                echo "DeepSeek Harness could not publish a launch generation" >&2
                return 1
            }
            launch_marker="${DSH_TELEGRAM_READY_MARKER}.${launch_generation}"
            printf '\n=== deepseek-harness launch %s ===\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$DSH_TELEGRAM_LOG_FILE"
            echo "Starting DeepSeek Harness Telegram profile $DSH_TELEGRAM_PROFILE..."
            (
                # Keep the launch lock in the short-lived owner only; the
                # detached poller must not pin it across future boot checks.
                deepseek_harness_release_start_lock
                cd "$DSH_TELEGRAM_WORKSPACE"
                exec nohup setsid env -u TELEGRAM_BOT_TOKEN -u DEEPSEEK_API_KEY -u DEEPSEEK_API_KEY_FILE -u NEURALWATT_API_KEY -u OPENCODE_API_KEY -u OPENCODE_GO_API_KEY \
                    PATH="$AGENT_RUNTIME_PATH" \
                    NODE_OPTIONS="$DSH_TELEGRAM_NODE_OPTIONS" \
                    DSH_HOME="$DSH_HOME" \
                    DSH_TELEGRAM_PROFILE="$DSH_TELEGRAM_PROFILE" \
                    DSH_TELEGRAM_READY_GENERATION="$launch_generation" \
                    DSH_TELEGRAM_READY_MARKER="$launch_marker" \
                    DSH_TELEGRAM_LOG_FILE="$DSH_TELEGRAM_LOG_FILE" \
                    TELEGRAM_BOT_TOKEN_FILE="$TELEGRAM_BOT_TOKEN_FILE" \
                    OPENCODE_GO_API_KEY_FILE="$OPENCODE_GO_API_KEY_FILE" \
                    bash -c '
                        IFS= read -r OPENCODE_GO_API_KEY < "$OPENCODE_GO_API_KEY_FILE"
                        export OPENCODE_GO_API_KEY
                        exec dsh --profile "$DSH_TELEGRAM_PROFILE" > >(
                            sed -u -E \
                                -e '\''s#bot[0-9]{8,}:[A-Za-z0-9_-]{30,}#bot[REDACTED]#g'\'' \
                                -e '\''s#chatId=-?[0-9]+#chatId=[REDACTED]#g'\'' \
                                -e '\''s#bar-sync\(-?[0-9]+\)#bar-sync([REDACTED])#g'\'' \
                                -e '\''s#([?&]token=)[A-Za-z0-9_-]+#\1[REDACTED]#g'\'' \
                                >> "$DSH_TELEGRAM_LOG_FILE"
                        ) 2>&1 </dev/null
                    '
            ) &
            local launched_pid="$!" launched_ticks
            launched_ticks="$(deepseek_harness_start_ticks "$launched_pid" 2>/dev/null || true)"
            printf '%s\n' "$launched_pid" > "$DSH_TELEGRAM_PID_FILE"
            if [ -z "$launched_ticks" ] || ! deepseek_harness_wait_ready; then
                echo "DeepSeek Harness Telegram readiness timeout; refusing PID-only health" >&2
                if [ -n "$launched_ticks" ] && deepseek_harness_kill_owned "$launched_pid" "$launched_ticks"; then
                    rm -f "$DSH_TELEGRAM_PID_FILE"
                else
                    echo "DeepSeek Harness Telegram owner changed; preserving state and refusing unverified stop" >&2
                fi
                deepseek_harness_release_start_lock
                return 1
            fi
            deepseek_harness_release_start_lock
            ;;
        pi-agent)
            start_pi_agent
            ;;
        shoukichi)
            start_shoukichi
            ;;
        nanobot)
            local delegated=0
            nanobot_delegate start || delegated=$?
            [ "$delegated" -eq 3 ] || return "$delegated"
            start_nanobot
            ;;
        *)
            echo "Unknown agent: $agent"
            exit 1
            ;;
    esac
    echo "$agent started"
}

stop_agent() {
    local agent="$1"
    validate_agent "$agent"
    case "$agent" in
        opencode)
            local delegated=0
            opencode_delegate stop || delegated=$?
            [ "$delegated" -eq 3 ] || return "$delegated"
            if [ -x "$OPENCODE_OWNER_HELPER" ]; then
                "$OPENCODE_OWNER_HELPER" stop \
                    --state "$OPENCODE_STATE_FILE" \
                    --project "$OPENCODE_PROJECT_ROOT" \
                    --host 127.0.0.1 --port "$OPENCODE_PORT"
            else
                echo "OpenCode owner helper unavailable; refusing unscoped stop" >&2
                return 1
            fi
            ;;
        ductor)
            stop_ductor_owned
            ;;
        claudecode)
            pkill -f "claude.*channels.*telegram" 2>/dev/null || true
            ;;
        hermes)
            stop_hermes
            ;;
        codex)
            local codex_pid codex_pgid codex_ticks
            codex_pid="$(cat "$STATE_DIR/codex-helmastra-telegram.pid" 2>/dev/null || true)"
            if codex_telegram_supervisor_matches "$codex_pid"; then
                codex_ticks="$(codex_telegram_start_ticks "$codex_pid" 2>/dev/null)" || {
                    echo "HelmAstra Telegram supervisor start ticks unavailable; refusing stop" >&2
                    return 1
                }
                codex_pgid=$(ps -o pgid= -p "$codex_pid" 2>/dev/null | tr -d ' ' || true)
                codex_telegram_supervisor_matches "$codex_pid" "$codex_ticks" || {
                    echo "HelmAstra Telegram supervisor identity changed before signal; refusing stop" >&2
                    return 1
                }
                # Self-kill guard (2026-09-30): the stop signals the supervisor's
                # whole process group, and a HelmAstra turn runs its tools inside
                # that group. A stop issued from within the group kills its own
                # caller before the matching start can run. Refuse instead.
                local guard_pid="$$" guard_pgid
                while [ -n "$guard_pid" ] && [ "$guard_pid" -gt 1 ] 2>/dev/null; do
                    guard_pgid=$(ps -o pgid= -p "$guard_pid" 2>/dev/null | tr -d ' ' || true)
                    if [ "$guard_pid" = "$codex_pid" ] || { [ "$codex_pgid" = "$codex_pid" ] && [ "$guard_pgid" = "$codex_pgid" ]; }; then
                        echo "HelmAstra Telegram host cannot stop itself from inside its own turn; run the stop from outside it (another session or Nurse Joy)" >&2
                        return 1
                    fi
                    guard_pid=$(ps -o ppid= -p "$guard_pid" 2>/dev/null | tr -d ' ' || true)
                done
                if [ "$codex_pgid" = "$codex_pid" ]; then
                    kill -TERM -- "-$codex_pgid" 2>/dev/null || true
                else
                    kill -TERM "$codex_pid" 2>/dev/null || true
                fi
                # Readiness can disappear before the supervisor releases its
                # exclusive launch lock. Wait for the exact captured process,
                # not the composite ready predicate, before permitting restart.
                for _ in {1..20}; do
                    codex_telegram_supervisor_matches "$codex_pid" "$codex_ticks" || break
                    sleep 0.25
                done
                if codex_telegram_supervisor_matches "$codex_pid" "$codex_ticks"; then
                    echo "HelmAstra Telegram did not stop gracefully; forcing its verified process group" >&2
                    if [ "$codex_pgid" = "$codex_pid" ]; then
                        kill -KILL -- "-$codex_pgid" 2>/dev/null || true
                    else
                        kill -KILL "$codex_pid" 2>/dev/null || true
                    fi
                    for _ in {1..20}; do
                        codex_telegram_supervisor_matches "$codex_pid" "$codex_ticks" || break
                        sleep 0.25
                    done
                fi
                if codex_telegram_supervisor_matches "$codex_pid" "$codex_ticks"; then
                    echo "HelmAstra Telegram failed to stop its verified supervisor" >&2
                    return 1
                fi
            fi
            ;;
        deepseek-harness)
            local dsh_pid dsh_ticks dsh_marker delegated=0
            deepseek_harness_delegate stop || delegated=$?
            [ "$delegated" -eq 3 ] || return "$delegated"
            dsh_marker="$(deepseek_harness_marker_path 2>/dev/null || true)"
            if [ ! -e "$DSH_TELEGRAM_PID_FILE" ] && [ ! -e "$DSH_TELEGRAM_READY_MARKER" ] && \
               [ ! -e "$DSH_TELEGRAM_GENERATION_FILE" ] && \
               { [ -z "$dsh_marker" ] || [ ! -e "$dsh_marker" ]; }; then
                return 0
            fi
            dsh_pid="$(cat "$DSH_TELEGRAM_PID_FILE" 2>/dev/null || true)"
            if deepseek_harness_ready || deepseek_harness_pid_matches "$dsh_pid"; then
                dsh_ticks="$(deepseek_harness_start_ticks "$dsh_pid" 2>/dev/null)" || {
                    echo "DeepSeek Harness process start ticks unavailable; refusing stop" >&2
                    return 1
                }
                if ! deepseek_harness_kill_owned "$dsh_pid" "$dsh_ticks"; then
                    echo "DeepSeek Harness Telegram failed to stop its verified owner" >&2
                    return 1
                fi
            elif [ -n "$(deepseek_harness_find_unowned 2>/dev/null || true)" ]; then
                echo "DeepSeek Harness owner state is stale but an unowned poller uses this profile; refusing cleanup" >&2
                return 1
            fi
            rm -f "$DSH_TELEGRAM_PID_FILE" "$DSH_TELEGRAM_READY_MARKER" "$DSH_TELEGRAM_GENERATION_FILE"
            [ -z "$dsh_marker" ] || rm -f "$dsh_marker"
            ;;
        pi-agent)
            stop_pi_agent
            ;;
        shoukichi)
            stop_shoukichi
            ;;
        nanobot)
            local delegated=0
            nanobot_delegate stop || delegated=$?
            [ "$delegated" -eq 3 ] || return "$delegated"
            stop_nanobot
            ;;
        *)
            echo "Unknown agent: $agent"
            exit 1
            ;;
    esac
    echo "$agent stopped"
}

start_all() {
    local host
    host=$(get_hostname)
    local agents
    agents=$(get_enabled_agents "$host")

    if [ -z "$agents" ]; then
        echo "No agents enabled for $host. Run 'telegram-agent-host enable <agent>' first."
        exit 1
    fi

    echo "Starting enabled agents for $host: $agents"
    local failed=0
    for agent in $agents; do
        if start_agent "$agent"; then
            clear_intentional_stop "$agent"
        else
            echo "Failed to start enabled agent: $agent" >&2
            failed=1
        fi
    done
    return "$failed"
}

# Intentional-stop markers: telegram-agent-watchdog skips an enabled agent whose
# marker exists, so an operator stop is not fought. Written only after a
# successful stop, cleared by a successful start.
INTENT_DIR="$STATE_DIR/intentional-stop"
mark_intentional_stop() { mkdir -p "$INTENT_DIR" && : > "$INTENT_DIR/$1"; }
clear_intentional_stop() { rm -f "$INTENT_DIR/$1"; }

stop_all() {
    for agent in opencode ductor claudecode hermes codex deepseek-harness pi-agent nanobot; do
        { stop_agent "$agent" 2>/dev/null && mark_intentional_stop "$agent"; } || true
    done
    echo "All agents stopped"
}

switch_to_machine() {
    local target="$1"
    local current_host
    current_host=$(get_hostname)

    if [ "$current_host" = "$target" ]; then
        echo "Already on $target"
        return
    fi

    local target_agents
    target_agents=$(get_enabled_agents "$target")

    if [ -z "$target_agents" ]; then
        echo "No agents configured for $target"
        exit 1
    fi

    local target_ssh
    target_ssh=$(grep -i "^${target}|" "$HOSTS_FILE" 2>/dev/null | cut -d'|' -f3)

    echo "Switching from $current_host to $target"

    echo "Stopping all agents on $current_host..."
    stop_all

    echo "Stopping agents on $target before restart..."
    if [ -n "$target_ssh" ]; then
        ssh "$target_ssh" "systemctl --user stop hermes-gateway.service 2>/dev/null || pkill -x hermes 2>/dev/null || true; pkill -f 'ductor' 2>/dev/null || true" 2>/dev/null || true
        sleep 1
    fi

    echo "Starting agents on $target via SSH..."
    if [ -n "$target_ssh" ]; then
        ssh "$target_ssh" "\$HOME/.local/bin/telegram-agent-remote-start $target_agents"
        echo "Switched to $target"
    else
        echo "No SSH config for $target. Manually start on target machine:"
        echo " ssh $target"
        echo " telegram-agent-host start"
    fi
    echo ""
    echo "Enabled on $target: $target_agents"
}

bring_here() {
    local current_host
    current_host=$(get_hostname)
    local agents
    agents=$(get_enabled_agents "$current_host")

    if [ -z "$agents" ]; then
        echo "No agents configured for $current_host"
        exit 1
    fi

    echo "Bringing agents to $current_host..."

    for host_line in $(grep -v '^#' "$HOSTS_FILE" | grep -v '^$'); do
        local other_host
        other_host=$(echo "$host_line" | cut -d'|' -f1)
        if [ "$other_host" != "$current_host" ]; then
            local other_ssh
            other_ssh=$(echo "$host_line" | cut -d'|' -f3)
            if [ -n "$other_ssh" ]; then
                echo "Stopping agents on $other_host..."
                ssh "$other_ssh" "systemctl --user stop hermes-gateway.service 2>/dev/null || pkill -x hermes 2>/dev/null || true; pkill -f 'ductor' 2>/dev/null || true" 2>/dev/null || true
            fi
        fi
    done

    sleep 1
    echo "Starting agents locally..."
    start_all
}

COMMAND="${1:-}"
shift || true

case "$COMMAND" in
    -h|--help|help) usage; exit 0 ;;
esac

mkdir -p "$STATE_DIR"

case "$COMMAND" in
    list) list_agents ;;
    status) status_cmd "${1:-}" ;;
    enable) enable_agent "${1:-}" ;;
    disable) disable_agent "${1:-}" ;;
    sync) sync_configs "${1:-}" ;;
    enabled) get_enabled_agents "$(get_hostname)" ;;
    start)
        if [ -n "${1:-}" ]; then
            # Standalone call, not an && list: set -e is ignored inside a
            # function that runs in an && context, which changes start_agent.
            start_agent "$1"
            start_rc=$?
            [ "$start_rc" -ne 0 ] || clear_intentional_stop "$1"
            exit "$start_rc"
        else
            start_all
        fi
        ;;
    stop)
        if [ -n "${1:-}" ]; then
            stop_agent "$1"
            stop_rc=$?
            [ "$stop_rc" -ne 0 ] || mark_intentional_stop "$1"
            exit "$stop_rc"
        else
            stop_all
        fi
        ;;
    switch) switch_to_machine "${1:-}" ;;
    bring) bring_here ;;
    *) usage; exit 1 ;;
esac
# Agent Control Script:1 ends here
# Shoukichi Instance Wrapper:2 ends here
