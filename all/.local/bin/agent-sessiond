#!/usr/bin/env bash
# agent-sessiond

# [[file:../../../services-agent-sessiond.org::*agent-sessiond][agent-sessiond:1]]
set -euo pipefail

# Cron runs this with a bare /usr/bin:/bin PATH. tmux, claude, codex and the
# other probed binaries live in Guix extra profiles and ~/.local/bin, so a
# cron snapshot used to report tmux=false and an empty tmux section on every
# machine (found 2026-08-21 while wiring Nurse Joy). Prefix the known lanes;
# an interactive shell's PATH still wins for anything it already resolves.
for _lane in "$HOME/.local/bin" "$HOME/.npm-global/bin" "$HOME/.guix-extra-profiles"/*/*/bin; do
  [ -d "$_lane" ] && case ":$PATH:" in *":$_lane:"*) ;; *) PATH="$PATH:$_lane" ;; esac
done
export PATH
# tmux sanitises control characters in -F output unless the client locale is
# UTF-8: with no LANG (cron) the tab delimiters below come out as "_" and the
# session/pane tables parse into one garbage field. Cron sets no locale.
if [ -z "${LC_ALL:-}" ] && [ -z "${LANG:-}" ]; then
  export LANG=C.UTF-8
fi

STATE_DIR="${AGENT_SESSIOND_STATE_DIR:-$HOME/HelmCortex/ROOTS/DotRoot/agent-session}"
INTERVAL="${AGENT_SESSIOND_INTERVAL:-10}"
PROC_PATTERNS=(opencode opencode-telegram claude codex hermes pi-agent sapphire)

usage() {
  cat <<'EOF'
Usage: agent-sessiond <once|watch|status|native-sample>

Commands:
  once    collect one snapshot and write JSON atomically
  watch   collect repeatedly every AGENT_SESSIOND_INTERVAL seconds, default 10
  status  print a summary of the latest local state snapshot
  native-sample <claude|codex> [N] [--json]
          print the N most-recently-modified native sessions
          for the given agent (default N=5)
EOF
}

need_python() {
  if ! command -v python3 >/dev/null 2>&1; then
    echo "agent-sessiond: python3 is required for JSON emission" >&2
    exit 1
  fi
}

state_file() {
  local host
  host="$(hostname 2>/dev/null || echo unknown)"
  printf '%s/state.%s.json\n' "$STATE_DIR" "$host"
}

latest_state_file() {
  printf '%s/state.latest.json\n' "$STATE_DIR"
}

collect_once() {
  need_python
  mkdir -p "$STATE_DIR"

  local host timestamp workdir outfile latest tmp latest_tmp session_index
  host="$(hostname 2>/dev/null || echo unknown)"
  timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  workdir="$(mktemp -d "${TMPDIR:-/tmp}/agent-sessiond.XXXXXX")"
  outfile="$STATE_DIR/state.$host.json"
  latest="$(latest_state_file)"
  tmp="$outfile.tmp.$$"
  latest_tmp="$latest.tmp.$$"

  # Resolve session-index path (AGENT_SESSION_INDEX env overrides hostname default)
  session_index="${AGENT_SESSION_INDEX:-}"
  if [ -z "$session_index" ]; then
    case "$host" in
      *) session_index="$HOME/HelmCortex/ROOTS/AgentRoot/session-index.json" ;;
    esac
  fi

  cleanup_collect() {
    rm -rf "$workdir" "$tmp" "$latest_tmp"
  }
  trap cleanup_collect RETURN
  trap 'cleanup_collect; exit 0' INT TERM

  printf '%s\n' "$host"          >"$workdir/hostname"
  printf '%s\n' "$timestamp"     >"$workdir/timestamp"
  printf '%s\n' "$session_index" >"$workdir/session-index-path"

  if command -v tmux >/dev/null 2>&1; then
    tmux list-sessions -F '#{session_id}	#{session_name}	#{session_windows}	#{?session_attached,attached,detached}	#{session_created}' >"$workdir/tmux-sessions" 2>/dev/null || true
    tmux list-panes -a -F '#{session_name}	#{window_index}	#{window_name}	#{pane_index}	#{pane_id}	#{pane_active}	#{pane_current_path}	#{pane_current_command}	#{pane_pid}' >"$workdir/tmux-panes" 2>/dev/null || true
  else
    : >"$workdir/tmux-sessions"
    : >"$workdir/tmux-panes"
  fi

  : >"$workdir/processes"
  for pattern in "${PROC_PATTERNS[@]}"; do
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      pid="${line%%[[:space:]]*}"
      command="${line#"$pid"}"
      command="${command#"${command%%[![:space:]]*}"}"
      case "$pid:$command" in
        "$$:"*|"$BASHPID:"*|*"/agent-sessiond "*|*" agent-sessiond "*|*"pgrep -af $pattern"*)
          continue
          ;;
      esac
      printf '%s\t%s\t%s\n' "$pattern" "$pid" "$command" >>"$workdir/processes"
    done < <(pgrep -af "$pattern" 2>/dev/null || true)
  done

  if command -v telegram-agent-host >/dev/null 2>&1; then
    if telegram-agent-host status >"$workdir/telegram.out" 2>"$workdir/telegram.err"; then
      printf '0\n' >"$workdir/telegram.exit"
    else
      printf '%s\n' "$?" >"$workdir/telegram.exit"
    fi
    printf '1\n' >"$workdir/telegram.available"
  else
    : >"$workdir/telegram.out"
    printf 'telegram-agent-host not found\n' >"$workdir/telegram.err"
    printf '127\n' >"$workdir/telegram.exit"
    printf '0\n'   >"$workdir/telegram.available"
  fi

  python3 - "$workdir" >"$tmp" <<'PY'
import json
import os
import pathlib
import re
import shutil
import sqlite3
import sys
import time
from datetime import datetime, timezone

root = pathlib.Path(sys.argv[1])
home = pathlib.Path.home()

warnings = []

try:
    PAGE_SIZE_KB = os.sysconf("SC_PAGESIZE") // 1024
except (AttributeError, ValueError, OSError):
    PAGE_SIZE_KB = 4


def read_text(name):
    return (root / name).read_text(errors="replace")

def read_lines(name):
    return [ln for ln in read_text(name).splitlines() if ln]

def parse_tsv(lines, fields):
    rows = []
    for line in lines:
        parts = line.split("\t")
        if len(parts) < len(fields):
            parts.extend([""] * (len(fields) - len(parts)))
        rows.append(dict(zip(fields, parts[:len(fields)])))
    return rows

def iso_from_mtime(mt):
    return (datetime.fromtimestamp(mt, tz=timezone.utc)
            .isoformat(timespec="seconds")
            .replace("+00:00", "Z"))


# ── /proc metrics (Linux only; all fields guarded) ────────────────────────────
def proc_metrics(pid_str):
    m = {"ppid": None, "pgid": None, "sid": None, "proc_status": None,
         "cwd": None, "cpu_ticks": None, "rss_kb": None,
         "io_read_bytes": None, "io_write_bytes": None}
    try:
        m["cwd"] = os.readlink(f"/proc/{pid_str}/cwd")
    except OSError:
        pass
    try:
        raw   = pathlib.Path(f"/proc/{pid_str}/stat").read_text()
        after = raw[raw.rfind(")") + 2:]
        f     = after.split()
        m["proc_status"] = f[0]
        m["ppid"]        = int(f[1])
        m["pgid"]        = int(f[2])
        m["sid"]         = int(f[3])
        m["cpu_ticks"]   = int(f[11]) + int(f[12])
        m["rss_kb"]      = int(f[21]) * PAGE_SIZE_KB
    except Exception:
        pass
    try:
        for line in pathlib.Path(f"/proc/{pid_str}/io").read_text().splitlines():
            k, _, v = line.partition(":")
            k = k.strip()
            if k == "read_bytes":
                m["io_read_bytes"] = int(v.strip())
            elif k == "write_bytes":
                m["io_write_bytes"] = int(v.strip())
    except Exception:
        pass
    return m


# ── session ID extraction from cmdline ────────────────────────────────────────
_RESUME_RE       = re.compile(r"(?:--resume|-s)[= ]([A-Za-z0-9/_.:@-]{8,})")
_CODEX_RESUME_RE = re.compile(r"\bresume\s+([A-Za-z0-9/_.:@-]{8,})")

def session_id_from_cmdline(cmdline, agent):
    m = _RESUME_RE.search(cmdline)
    if m:
        return m.group(1), "cmdline_flag"
    if agent == "codex":
        m = _CODEX_RESUME_RE.search(cmdline)
        if m:
            return m.group(1), "cmdline_subcommand"
    return None, None


# ── session ID probing via pid session file and fd scanning ───────────────────
_CLAUDE_SESSIONS_DIR  = home / ".claude/sessions"
_CODEX_SESSION_FD_RE  = re.compile(r"/\.codex/sessions/.+/([^/]+)\.jsonl$")
_OPENCODE_LOG_FD_RE   = re.compile(r"/\.local/share/opencode/log/[^/]+\.log$")
_OPENCODE_SESSION_RE  = re.compile(r"/session/(ses_[A-Za-z0-9_-]{10,})")

def _fd_entries(pid_str):
    """Yield readlink targets for /proc/<pid>/fd, silently skipping permission errors."""
    try:
        for entry in pathlib.Path(f"/proc/{pid_str}/fd").iterdir():
            try:
                yield os.readlink(str(entry))
            except Exception:
                pass
    except Exception:
        pass

def session_id_probe(pid_str, agent):
    """Try non-cmdline session ID extraction. Returns (sid, source, fd_path, fd_kind)."""
    # claude-family: read ~/.claude/sessions/<pid>.json written by claude at startup
    if agent in ("claude", "auryn", "auryn-chan", "helmastra"):
        session_file = _CLAUDE_SESSIONS_DIR / f"{pid_str}.json"
        try:
            data = json.loads(session_file.read_text())
            sid = data.get("sessionId")
            if sid:
                return sid, "session_file", str(session_file), "claude"
        except Exception:
            pass
    # codex: scan /proc/<pid>/fd for open rollout session jsonl
    if agent == "codex":
        for target in _fd_entries(pid_str):
            m = _CODEX_SESSION_FD_RE.search(target)
            if m:
                return m.group(1), "fd_probe", target, "codex"
    # opencode: find open log file, scan tail for most-recent session request path
    if agent == "opencode":
        log_candidates = []
        for target in _fd_entries(pid_str):
            if _OPENCODE_LOG_FD_RE.search(target):
                try:
                    log_candidates.append((os.path.getsize(target), target))
                except OSError:
                    pass
        if log_candidates:
            _, log_path = max(log_candidates)
            try:
                with open(log_path, errors="replace") as fh:
                    content = fh.read()
                matches = list(_OPENCODE_SESSION_RE.finditer(content))
                if matches:
                    return matches[-1].group(1), "fd_probe", log_path, "opencode"
            except Exception:
                pass
    return None, None, None, None


# ── PPID ancestry helpers for tmux linkage ────────────────────────────────────
def ppid_read(pid_str):
    """Return parent PID string from /proc/<pid>/stat, or None."""
    try:
        raw   = pathlib.Path(f"/proc/{pid_str}/stat").read_text()
        after = raw[raw.rfind(")") + 2:]
        return after.split()[1]
    except Exception:
        return None

def ppid_chain_walk(pid_str, pane_pid_set, max_depth=32):
    """Walk parent chain; return (matched_pane_pid_str, chain) or (None, chain)."""
    chain = []
    cur   = ppid_read(pid_str)
    for _ in range(max_depth):
        if cur is None or cur in ("0", "1"):
            break
        chain.append(cur)
        if cur in pane_pid_set:
            return cur, chain
        cur = ppid_read(cur)
    return None, chain


# ── model context window table (static, source always labeled "model_table") ─
CONTEXT_WINDOW_SIZES = {
    "claude-sonnet-5-5": 1000000,  # native 1M (Claude Code 2.1.285 model catalog)
    "claude-opus-4-7":   200000, "claude-opus-4-5":   200000,
    "claude-sonnet-4-6": 200000, "claude-sonnet-4-5": 200000,
    "claude-haiku-4-5":  200000,
}

def _ctx_window(model):
    if not model:
        return None
    if model in CONTEXT_WINDOW_SIZES:
        return CONTEXT_WINDOW_SIZES[model]
    for k, v in CONTEXT_WINDOW_SIZES.items():
        if model.startswith(k):
            return v
    return None

_STALE_THRESH_S = 86400  # metadata older than 24h is stale


# ── claude model/context probe (read project JSONL) ──────────────────────────
_CLAUDE_PROJECTS_DIR = home / ".claude/projects"

def _claude_model_probe(pid_str, session_id):
    """Return model/usage dict from the most recent assistant JSONL entry."""
    try:
        sf   = _CLAUDE_SESSIONS_DIR / f"{pid_str}.json"
        data = json.loads(sf.read_text())
        cwd  = data.get("cwd") or ""
        if not cwd:
            return {}
        encoded = cwd.replace("/", "-")
        jf = _CLAUDE_PROJECTS_DIR / encoded / f"{session_id}.jsonl"
        if not jf.exists():
            for d in _CLAUDE_PROJECTS_DIR.iterdir():
                c = d / f"{session_id}.jsonl"
                if c.exists():
                    jf = c
                    break
            else:
                return {}
        with open(jf, "rb") as fh:
            fh.seek(0, 2)
            size = fh.tell()
            fh.seek(max(0, size - 65536))
            tail = fh.read().decode(errors="replace")
        model = None
        usage = {}
        for line in tail.splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                entry = json.loads(line)
                msg   = entry.get("message", {})
                if msg.get("role") == "assistant" and msg.get("model") and msg.get("usage"):
                    model = msg["model"]
                    usage = msg["usage"]
            except Exception:
                pass
        if not model:
            return {}
        inp = ((usage.get("input_tokens") or 0) +
               (usage.get("cache_read_input_tokens") or 0) +
               (usage.get("cache_creation_input_tokens") or 0))
        win = _ctx_window(model)
        pct = round(inp / win * 100, 1) if (win and inp) else None
        mts = jf.stat().st_mtime
        return {
            "provider":              "anthropic",
            "provider_source":       "claude_jsonl",
            "model":                 model,
            "model_source":          "claude_jsonl",
            "model_confidence":      "high",
            "context_size":          inp or None,
            "context_size_source":   "claude_jsonl",
            "context_window":        win,
            "context_window_source": "model_table" if win else "unknown",
            "context_percent":       pct,
            "metadata_ts":           mts,
        }
    except Exception:
        return {}


# ── codex model probe (read logs_2.sqlite) ───────────────────────────────────
# NOTE: logs_2.sqlite can be multi-GB / tens of millions of rows. A per-PID
# query (WHERE process_uuid LIKE 'pid:<pid>:%') forces SQLite to walk the
# ts index across the whole table looking for LIKE matches, which can take
# minutes per PID with several live codex processes. Instead we run ONE
# bounded query per collection cycle (ts >= now - horizon, LIMIT N), cache
# the most-recent match per pid in a module-level dict, and turn
# _codex_model_probe() into a plain dict lookup. The ts lower bound lets
# the descending index scan terminate at the horizon regardless of how
# many rows match feedback_log_body LIKE '%model=%'.
_CODEX_LOG_DB       = home / ".codex/logs_2.sqlite"
_CODEX_MODEL_RE     = re.compile(r'\bmodel=([A-Za-z0-9._:/-]+)')
_CODEX_PID_RE       = re.compile(r'^pid:(\d+):')
_CODEX_PROBE_HORIZON_S = 48 * 3600
_CODEX_PROBE_LIMIT     = 2000
_codex_model_by_pid    = None  # populated on first probe of this cycle

def _codex_model_probe_scan():
    """One bounded pass over logs_2.sqlite, cached per collection cycle.

    Returns {pid_str: extra_dict} built from the most-recent (ts DESC)
    matching row per pid within the horizon window."""
    result = {}
    if not _CODEX_LOG_DB.exists():
        return result
    try:
        conn = sqlite3.connect(f"file:{_CODEX_LOG_DB}?mode=ro", uri=True, timeout=5)
        try:
            conn.execute("PRAGMA busy_timeout=2000")
            horizon = time.time() - _CODEX_PROBE_HORIZON_S
            rows = conn.execute(
                "SELECT process_uuid, feedback_log_body, ts FROM logs "
                "WHERE ts >= ? AND feedback_log_body LIKE '%model=%' "
                "ORDER BY ts DESC, ts_nanos DESC LIMIT ?",
                (horizon, _CODEX_PROBE_LIMIT)
            ).fetchall()
        finally:
            conn.close()
        for (process_uuid, body, ts) in rows:
            if not body or not process_uuid:
                continue
            pm = _CODEX_PID_RE.match(process_uuid)
            if not pm:
                continue
            pid_str = pm.group(1)
            if pid_str in result:
                continue  # already have the most-recent (rows are ts DESC)
            mm = _CODEX_MODEL_RE.search(body)
            if mm:
                result[pid_str] = {
                    "provider":              "openai",
                    "provider_source":       "codex_log",
                    "model":                 mm.group(1),
                    "model_source":          "codex_log",
                    "model_confidence":      "high",
                    "context_size":          None,
                    "context_size_source":   "unknown",
                    "context_window":        None,
                    "context_window_source": "unknown",
                    "context_percent":       None,
                    "metadata_ts":           float(ts) if ts else None,
                }
    except Exception:
        return {}
    return result

def _codex_model_probe(pid_str):
    """Extract most-recent model for this PID from Codex logs_2.sqlite.

    Backed by a single bounded scan per collection cycle (see
    _codex_model_probe_scan) instead of a per-PID query."""
    global _codex_model_by_pid
    if _codex_model_by_pid is None:
        _codex_model_by_pid = _codex_model_probe_scan()
    return _codex_model_by_pid.get(str(pid_str), {})


# ── capabilities (binary presence) ───────────────────────────────────────────
CAPABILITY_BINS = [
    "python3", "pgrep", "tmux", "fzf",
    "claude", "opencode", "codex", "hermes",
    "auryn", "auryn-chan", "helmastra", "codex-helmastra",
    "gemma-pi", "gemini-pi", "sapphire", "ductor", "pi-agent",
    "telegram-agent-host", "obsidian",
]
capabilities = {k: shutil.which(k) is not None for k in CAPABILITY_BINS}


