party = []
for entry in PARTY_STATIC:
    e = dict(entry)
    b = e.get("binary")
    e["binary_present"] = (shutil.which(b) is not None) if b else None
    party.append(e)


# ── raw processes + /proc enrichment ─────────────────────────────────────────
raw_procs = []
seen = set()
for row in parse_tsv(read_lines("processes"), ["pattern", "pid", "command"]):
    key = (row["pattern"], row["pid"], row["command"])
    if key in seen:
        continue
    seen.add(key)
    raw_procs.append({**row, **proc_metrics(row["pid"])})


# ── tmux ──────────────────────────────────────────────────────────────────────
tmux_sessions = parse_tsv(read_lines("tmux-sessions"),
    ["id", "name", "windows", "attached", "created"])
tmux_panes = parse_tsv(read_lines("tmux-panes"),
    ["session", "window_index", "window_name", "pane_index",
     "pane_id", "active", "current_path", "current_command", "pid"])
pane_by_pid  = {p["pid"]: p for p in tmux_panes if p.get("pid")}
pane_pid_set = set(pane_by_pid.keys())


# ── pid_session_links (evidence table) ───────────────────────────────────────
pid_session_links = []
for proc in raw_procs:
    pid   = proc["pid"]
    agent = proc["pattern"]
    sid, sid_src = session_id_from_cmdline(proc["command"], agent)
    fd_session_path = None
    fd_session_kind = None
    if sid is None:
        sid, sid_src, fd_session_path, fd_session_kind = session_id_probe(pid, agent)

    pane             = None
    tmux_link_source = None
    tmux_pane_pid    = None
    ppid_chain_list  = None

    # 1. Direct PID match (agent pid IS the tmux pane_pid)
    if pid in pane_by_pid:
        pane             = pane_by_pid[pid]
        tmux_link_source = "direct_pid"
        tmux_pane_pid    = pid
    # 2. SID match: agent inherits session from pane shell (shell pid == SID)
    elif proc.get("sid") and str(proc["sid"]) in pane_by_pid:
        pane             = pane_by_pid[str(proc["sid"])]
        tmux_link_source = "sid_match"
        tmux_pane_pid    = str(proc["sid"])
    # 3. PPID ancestry walk: find a pane_pid among ancestors
    else:
        ancestor, chain  = ppid_chain_walk(pid, pane_pid_set)
        ppid_chain_list  = chain if chain else None
        if ancestor:
            pane             = pane_by_pid[ancestor]
            tmux_link_source = "ppid_chain"
            tmux_pane_pid    = ancestor

    confidence = ("high"   if (sid and pane) else
                  "medium" if sid else
                  "low"    if pane else "none")
    pid_session_links.append({
        "pid":               pid,
        "agent":             agent,
        "cmdline":           proc["command"][:200],
        "session_id":        sid,
        "session_id_source": sid_src,
        "cwd":               proc.get("cwd"),
        "ppid":              proc.get("ppid"),
        "fd_session_path":   fd_session_path,
        "fd_session_kind":   fd_session_kind,
        "tmux_pane_id":      pane.get("pane_id")         if pane else None,
        "tmux_session_name": pane.get("session")         if pane else None,
        "tmux_window_index": pane.get("window_index")    if pane else None,
        "tmux_window_name":  pane.get("window_name")     if pane else None,
        "tmux_link_source":  tmux_link_source,
        "tmux_pane_pid":     tmux_pane_pid,
        "ppid_chain":        ppid_chain_list,
        "confidence":        confidence,
    })
links_by_pid = {ln["pid"]: ln for ln in pid_session_links}


# ── opencode model/provider lookup (read-only DB probe) ───────────────────────
_oc_db = home / ".local/share/opencode/opencode.db"
_model_by_sid = {}
if _oc_db.exists():
    _oc_sids = [
        ln["session_id"] for ln in pid_session_links
        if ln.get("fd_session_kind") == "opencode" and ln.get("session_id")
    ]
    if _oc_sids:
        try:
            _conn = sqlite3.connect(f"file:{_oc_db}?mode=ro", uri=True)
            for _sid in _oc_sids:
                _row = _conn.execute(
                    "SELECT json_extract(data,'$.providerID'),"
                    "       json_extract(data,'$.modelID'),"
                    "       json_extract(data,'$.tokens.input'),"
                    "       json_extract(data,'$.tokens.cache.read'),"
                    "       time_created "
                    "FROM message "
                    "WHERE session_id=? "
                    "  AND json_extract(data,'$.providerID') IS NOT NULL "
                    "ORDER BY time_created DESC LIMIT 1",
                    (_sid,)
                ).fetchone()
                if _row and _row[0]:
                    _ctx_inp = (_row[2] or 0) + (_row[3] or 0)
                    _mts = _row[4] / 1000.0 if _row[4] else None
                    _model_by_sid[_sid] = {
                        "provider":     _row[0],
                        "model":        _row[1] or "—",
                        "context_size": _ctx_inp if _ctx_inp > 0 else None,
                        "metadata_ts":  _mts,
                    }
            _conn.close()
        except Exception as _exc:
            warnings.append(f"opencode model probe: {_exc}")

for ln in pid_session_links:
    _sid   = ln.get("session_id")
    _agent = ln.get("agent")
    _kind  = ln.get("fd_session_kind")
    _pid   = ln.get("pid")
    _extra = {}
    if _kind == "opencode" and _sid and _sid in _model_by_sid:
        _mi  = _model_by_sid[_sid]
        _ctx = _mi.get("context_size")
        _extra = {
            "provider":              _mi["provider"],
            "provider_source":       "opencode_db",
            "model":                 _mi["model"],
            "model_source":          "opencode_db",
            "model_confidence":      "high",
            "context_size":          _ctx,
            "context_size_source":   "opencode_db" if _ctx else "unknown",
            "context_window":        None,
            "context_window_source": "unknown",
            "context_percent":       None,
            "metadata_ts":           _mi.get("metadata_ts"),
        }
    elif _kind == "claude" and _sid and _pid:
        _extra = _claude_model_probe(_pid, _sid)
    elif _agent in ("codex", "codex-helmastra") and _pid:
        _extra = _codex_model_probe(_pid)
    ln["provider"]              = _extra.get("provider")
    ln["provider_source"]       = _extra.get("provider_source")       or "unknown"
    ln["model"]                 = _extra.get("model")
    ln["model_source"]          = _extra.get("model_source")          or "unknown"
    ln["model_confidence"]      = _extra.get("model_confidence")      or "none"
    ln["context_size"]          = _extra.get("context_size")
    ln["context_size_source"]   = _extra.get("context_size_source")   or "unknown"
    ln["context_window"]        = _extra.get("context_window")
    ln["context_window_source"] = _extra.get("context_window_source") or "unknown"
    ln["context_percent"]       = _extra.get("context_percent")
    _mts = _extra.get("metadata_ts")
    ln["metadata_ts"]           = _mts
    ln["metadata_age_s"]        = round(time.time() - _mts) if _mts else None
    ln["metadata_stale"]        = (ln["metadata_age_s"] or 0) > _STALE_THRESH_S


# ── active_agents ─────────────────────────────────────────────────────────────
active_agents = []
for proc in raw_procs:
    pid = proc["pid"]
    lnk = links_by_pid.get(pid, {})
    active_agents.append({
        "pattern":           proc["pattern"],
        "pid":               pid,
        "ppid":              proc.get("ppid"),
        "pgid":              proc.get("pgid"),
        "sid":               proc.get("sid"),
        "proc_status":       proc.get("proc_status"),
        "command":           proc["command"],
        "cwd":               proc.get("cwd"),
        "cpu_ticks":         proc.get("cpu_ticks"),
        "rss_kb":            proc.get("rss_kb"),
        "io_read_bytes":     proc.get("io_read_bytes"),
        "io_write_bytes":    proc.get("io_write_bytes"),
        "session_id":        lnk.get("session_id"),
        "session_id_source": lnk.get("session_id_source"),
        "fd_session_path":   lnk.get("fd_session_path"),
        "fd_session_kind":   lnk.get("fd_session_kind"),
        "tmux_pane_id":      lnk.get("tmux_pane_id"),
        "tmux_session_name": lnk.get("tmux_session_name"),
        "tmux_window_name":  lnk.get("tmux_window_name"),
        "tmux_pane_pid":     lnk.get("tmux_pane_pid"),
        "tmux_link_source":  lnk.get("tmux_link_source"),
        "link_confidence":   lnk.get("confidence"),
        "provider":              lnk.get("provider"),
        "provider_source":       lnk.get("provider_source"),
        "model":                 lnk.get("model"),
        "model_source":          lnk.get("model_source"),
        "model_confidence":      lnk.get("model_confidence"),
        "context_size":          lnk.get("context_size"),
        "context_size_source":   lnk.get("context_size_source"),
        "context_window":        lnk.get("context_window"),
        "context_window_source": lnk.get("context_window_source"),
        "context_percent":       lnk.get("context_percent"),
        "metadata_ts":           lnk.get("metadata_ts"),
        "metadata_age_s":        lnk.get("metadata_age_s"),
        "metadata_stale":        lnk.get("metadata_stale"),
    })


# ── native_stores ─────────────────────────────────────────────────────────────
native_stores = {}

claude_root = home / ".claude/projects"
if claude_root.exists():
    files  = [f for f in claude_root.rglob("*.jsonl") if "/subagents/" not in f.as_posix()]
    newest = max((f.stat().st_mtime for f in files), default=None)
    native_stores["claude"] = {
        "path": str(claude_root), "type": "jsonl_dir", "present": True,
        "session_count": len(files),
        "newest_mtime":  iso_from_mtime(newest) if newest else None,
    }
else:
    native_stores["claude"] = {
        "path": str(claude_root), "type": "jsonl_dir", "present": False,
        "session_count": 0, "newest_mtime": None,
    }

opencode_db = home / ".local/share/opencode/opencode.db"
if opencode_db.exists():
    try:
        conn = sqlite3.connect(f"file:{opencode_db}?mode=ro", uri=True)
        cnt  = conn.execute("select count(*) from session where time_archived is null").fetchone()[0]
        conn.close()
        native_stores["opencode"] = {
            "path": str(opencode_db), "type": "sqlite", "present": True,
            "session_count": cnt,
            "newest_mtime":  iso_from_mtime(opencode_db.stat().st_mtime),
        }
    except Exception as exc:
        warnings.append(f"opencode: sqlite probe failed: {exc}")
        native_stores["opencode"] = {
            "path": str(opencode_db), "type": "sqlite", "present": True,
            "session_count": None, "newest_mtime": None,
        }
else:
    native_stores["opencode"] = {
        "path": str(opencode_db), "type": "sqlite", "present": False,
        "session_count": 0, "newest_mtime": None,
    }

# Codex: primary path is sessions/; logs_2.sqlite may be a newer store format
codex_sessions = home / ".codex/sessions"
codex_sqlite   = home / ".codex/logs_2.sqlite"
codex_entry    = {
    "path": str(codex_sessions), "type": "jsonl_dir",
    "present": codex_sessions.exists(),
    "session_count": 0, "newest_mtime": None,
}
if codex_sessions.exists():
    files  = list(codex_sessions.rglob("*.jsonl"))
    newest = max((f.stat().st_mtime for f in files), default=None)
    codex_entry["session_count"] = len(files)
    codex_entry["newest_mtime"]  = iso_from_mtime(newest) if newest else None
if codex_sqlite.exists():
    codex_entry["fallback_path"] = str(codex_sqlite)
    codex_entry["fallback_type"] = "sqlite"
    if not codex_sessions.exists():
        warnings.append(
            f"codex: {codex_sessions} not found; {codex_sqlite} present"
            " — store format may have changed")
native_stores["codex"] = codex_entry

# Hermes: canonical store is state.db; legacy fallback is sessions/*.json
hermes_db       = home / ".hermes/state.db"
hermes_sessions = home / ".hermes/sessions"
hermes_entry    = {
    "path": str(hermes_db), "type": "sqlite",
    "present": False, "session_count": 0, "newest_mtime": None,
}
if hermes_db.exists():
    try:
        conn = sqlite3.connect(f"file:{hermes_db}?mode=ro", uri=True)
        cnt  = conn.execute("select count(*) from sessions where ended_at is null").fetchone()[0]
        conn.close()
        hermes_entry.update({
            "present": True, "session_count": cnt,
            "newest_mtime": iso_from_mtime(hermes_db.stat().st_mtime),
        })
    except Exception as exc:
        hermes_entry["present"] = True
        warnings.append(f"hermes: state.db probe failed: {exc}")
elif hermes_sessions.exists():
    files = list(hermes_sessions.glob("session_*.json"))
    hermes_entry.update({
        "path": str(hermes_sessions), "type": "json_dir",
        "present": True, "session_count": len(files),
    })
    warnings.append("hermes: state.db not found; legacy sessions/ dir present")
else:
    warnings.append(
        "hermes: no native store found"
        " (checked ~/.hermes/state.db and ~/.hermes/sessions/)")
native_stores["hermes"] = hermes_entry

# Antigravity: protobuf conversations + plaintext brain entries
ag_root = home / ".gemini/antigravity"
if ag_root.exists():
    conv_dir  = ag_root / "conversations"
    brain_dir = ag_root / "brain"
    pb_cnt    = len(list(conv_dir.glob("*.pb"))) if conv_dir.exists() else 0
    brain_cnt = (sum(1 for p in brain_dir.iterdir() if p.is_dir())
                 if brain_dir.exists() else 0)
    native_stores["antigravity"] = {
        "path": str(ag_root), "type": "mixed_dir", "present": True,
        "session_count":  max(pb_cnt, brain_cnt),
        "pb_conversations": pb_cnt, "brain_entries": brain_cnt,
        "newest_mtime": None,
    }
else:
    native_stores["antigravity"] = {
        "path": str(ag_root), "type": "mixed_dir", "present": False,
        "session_count": 0, "newest_mtime": None,
    }


# ── sessions index summary ────────────────────────────────────────────────────
index_path_str   = read_text("session-index-path").strip()
sessions_summary = {
    "index_path":         index_path_str,
    "index_exists":       False,
    "index_generated_at": None,
    "counts": {"open": 0, "closed": 0, "unknown": 0, "abandoned": 0, "total": 0},
}
if index_path_str:
    index_path = pathlib.Path(index_path_str)
    if index_path.exists():
        try:
            payload = json.loads(index_path.read_text(encoding="utf-8"))
            entries = payload.get("sessions", [])
            counts  = {"open": 0, "closed": 0, "unknown": 0, "abandoned": 0,
                       "total": len(entries)}
            for s in entries:
                st = s.get("status") or "unknown"
                if st in counts:
                    counts[st] += 1
            newest_ts = max(
                (s.get("indexedat") or "" for s in entries), default=None,
            ) or None
            sessions_summary.update({
                "index_exists":       True,
                "index_generated_at": newest_ts,
                "counts":             counts,
            })
        except Exception as exc:
            warnings.append(f"sessions: index read failed: {exc}")
    else:
        warnings.append(f"sessions: index not found at {index_path_str}")


# ── telegram ──────────────────────────────────────────────────────────────────
try:
    tg_available = read_text("telegram.available").strip() == "1"
except Exception:
    tg_available = False
try:
    tg_exit = int(read_text("telegram.exit").strip() or "0")
except Exception:
    tg_exit = None

telegram = {
    "host_available": tg_available,
    "host_exit_code":  tg_exit,
    "host_stdout":     read_lines("telegram.out"),
    "host_stderr":     read_lines("telegram.err"),
}


# ── final assembly ────────────────────────────────────────────────────────────
state = {
    "schema":            "agent-sessiond.v2",
    "host":              read_text("hostname").strip(),
    "generated_at":      read_text("timestamp").strip(),
    "party":             party,
    "active_agents":     active_agents,
    "sessions":          sessions_summary,
    "native_stores":     native_stores,
    "pid_session_links": pid_session_links,
    "telegram":          telegram,
    "tmux":              {"sessions": tmux_sessions, "panes": tmux_panes},
    "capabilities":      capabilities,
    "warnings":          warnings,
}

json.dump(state, sys.stdout, indent=2, sort_keys=True)
sys.stdout.write("\n")
PY

  mv "$tmp" "$outfile"
  cp "$outfile" "$latest_tmp"
  mv "$latest_tmp" "$latest"
  printf 'agent-sessiond: wrote %s and %s\n' "$outfile" "$latest"
}

print_status() {
  need_python
  local file
  file="$(state_file)"
  if [ ! -s "$file" ]; then
    echo "agent-sessiond: no state file found at $file" >&2
    exit 1
  fi

  python3 - "$file" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as fh:
    state = json.load(fh)

tmux_sess  = state.get("tmux", {}).get("sessions", [])
tmux_panes = state.get("tmux", {}).get("panes", [])
active     = state.get("active_agents", [])
stores     = state.get("native_stores", {})
idx        = state.get("sessions", {})
warns      = state.get("warnings", [])

print(f"agent-sessiond state: {path}")
print(f"schema : {state.get('schema', '?')}")
print(f"host   : {state.get('host', '?')}")
print(f"time   : {state.get('generated_at', '?')}")
print(f"tmux   : {len(tmux_sess)} sessions  {len(tmux_panes)} panes")
if tmux_sess:
    names = ", ".join(s.get("name", "") for s in tmux_sess if s.get("name"))
    print(f"         {names}")

if active:
    print(f"live   : {len(active)} process(es)")
    for a in active:
        sid   = a.get("session_id") or "?"
        pane  = a.get("tmux_pane_id") or "no-pane"
        rss   = a.get("rss_kb")
        rss_s = f"  rss={rss}KB" if rss else ""
        conf  = a.get("link_confidence") or "?"
        src   = a.get("tmux_link_source") or ""
        src_s = f"/{src}" if src and a.get("tmux_pane_id") else ""
        print(f"         {a['pattern']}  pid={a['pid']}  sid={sid}"
              f"  pane={pane}{src_s}{rss_s}  [{conf}]")
else:
    print("live   : none")

counts = idx.get("counts", {})
if any(counts.get(k, 0) for k in ("open", "closed", "unknown", "abandoned")):
    print(f"index  : {counts.get('open',0)} open  {counts.get('closed',0)} closed"
          f"  {counts.get('unknown',0)} unknown  {counts.get('abandoned',0)} abandoned")
    if not idx.get("index_exists"):
        print("         (index not found — run FORGE/bin/agent-session scan)")

present = sorted(k for k, v in stores.items() if isinstance(v, dict) and v.get("present"))
absent  = sorted(k for k, v in stores.items() if isinstance(v, dict) and not v.get("present"))
if present:
    print(f"stores : present={','.join(present)}")
if absent:
    print(f"         absent={','.join(absent)}")

for w in warns:
    print(f"WARN   : {w}")
PY
}

cmd_native_sample() {
  need_python
  local agent="" n=5 json_flag=0 arg
  for arg in "$@"; do
    case "$arg" in
      --json) json_flag=1 ;;
      claude|codex) agent="$arg" ;;
      ''|*[!0-9]*) ;;
      *) n="$arg" ;;
    esac
  done
  if [ -z "$agent" ]; then
    echo "agent-sessiond: native-sample requires an agent: claude|codex" >&2
    usage >&2
    exit 2
  fi

  python3 - "$agent" "$n" "$json_flag" <<'PY'
import json
import pathlib
import re
import sys
from datetime import datetime, timezone

agent, n_arg, json_flag = sys.argv[1], sys.argv[2], sys.argv[3] == "1"
try:
    N = max(1, int(n_arg))
except ValueError:
    N = 5

home = pathlib.Path.home()
warnings_global = []

HEAD_SCAN_MAX_BYTES = 65536      # bounded head read -- never full-file parse
TAIL_SCAN_MAX_BYTES = 65536      # bounded tail read
EXACT_COUNT_MAX_BYTES = 300_000  # below this, count lines exactly; above, estimate


def iso_from_epoch(ts):
    try:
        return (datetime.fromtimestamp(float(ts), tz=timezone.utc)
                 .isoformat(timespec="seconds").replace("+00:00", "Z"))
    except Exception:
        return None


def iso_from_mtime(path):
    try:
        return iso_from_epoch(path.stat().st_mtime)
    except Exception:
        return None


def read_head(path, max_bytes=HEAD_SCAN_MAX_BYTES):
    """Read a bounded prefix; never seeks past max_bytes."""
    try:
        with open(path, "rb") as fh:
            data = fh.read(max_bytes)
        return data.decode(errors="replace")
    except Exception as exc:
        warnings_global.append(f"{path.name}: head read failed: {exc}")
        return ""


def read_tail(path, max_bytes=TAIL_SCAN_MAX_BYTES):
    """Read a bounded suffix; drops a possibly-truncated first partial line."""
    try:
        size = path.stat().st_size
        with open(path, "rb") as fh:
            fh.seek(max(0, size - max_bytes))
            data = fh.read()
        text = data.decode(errors="replace")
        lines = text.split("\n")
        if size > max_bytes and lines:
            lines = lines[1:]
        return lines
    except Exception as exc:
        warnings_global.append(f"{path.name}: tail read failed: {exc}")
        return []


def iter_json_lines(lines):
    """Yield parsed dicts, skipping unparseable or empty lines silently."""
    for ln in lines:
        ln = ln.strip()
        if not ln:
            continue
        try:
            obj = json.loads(ln)
        except Exception:
            continue
        if isinstance(obj, dict):
            yield obj


def estimate_message_count(path, tail_lines):
    """Exact line count for small files; tail-density estimate for large ones."""
    try:
        size = path.stat().st_size
    except Exception:
        return None, "unknown"
    if size <= EXACT_COUNT_MAX_BYTES:
        try:
            with open(path, "rb") as fh:
                count = sum(1 for _ in fh)
            return count, "exact"
        except Exception:
            return None, "unknown"
    sample = [l for l in tail_lines if l.strip()]
    if not sample:
        return None, "unknown"
    tail_bytes = sum(len(l.encode(errors="replace")) + 1 for l in sample)
    if tail_bytes <= 0:
        return None, "unknown"
    avg_len = tail_bytes / len(sample)
    if avg_len <= 0:
        return None, "unknown"
    return round(size / avg_len), "estimated_from_tail_sample"


def truncate(s, n=140):
    if not s:
        return s
    s = " ".join(s.split())
    return s if len(s) <= n else s[: n - 1] + "…"


# -- claude sample -------------------------------------------------------------
def sample_claude(path):
    warnings = []
    session_id = path.stem

    cwd = None
    title = None
    git_branch = None
    for obj in iter_json_lines(read_head(path).splitlines()):
        if cwd is None and isinstance(obj.get("cwd"), str):
            cwd = obj["cwd"]
        if git_branch is None and isinstance(obj.get("gitBranch"), str):
            git_branch = obj["gitBranch"]
        if title is None and obj.get("type") == "user":
            msg = obj.get("message") or {}
            content = msg.get("content")
            if isinstance(content, str):
                title = content
            elif isinstance(content, list):
                for block in content:
                    if isinstance(block, dict) and block.get("type") == "text":
                        title = block.get("text")
                        break
        if cwd and title and git_branch:
            break
    if cwd is None:
        warnings.append("no cwd found in bounded head scan")
    if title is None:
        warnings.append("no first user message found in bounded head scan")

    tail_lines = read_tail(path)
    model = None
    updated_at = None
    for obj in reversed(list(iter_json_lines(tail_lines))):
        if updated_at is None and isinstance(obj.get("timestamp"), str):
            updated_at = obj["timestamp"]
        if git_branch is None and isinstance(obj.get("gitBranch"), str):
            git_branch = obj["gitBranch"]
        if model is None:
            msg = obj.get("message") or {}
            if msg.get("role") == "assistant" and msg.get("model") and msg.get("usage"):
                model = msg["model"]
        if model and updated_at:
            break
    if model is None:
        warnings.append("no assistant model found in bounded tail scan")
    if updated_at is None:
        updated_at = iso_from_mtime(path)
        warnings.append("no timestamp in tail scan; fell back to file mtime")

    msg_count, msg_count_source = estimate_message_count(path, tail_lines)

    return {
        "agent": "claude",
        "session_id": session_id,
        "cwd": cwd,
        "model": model,
        "git_branch": git_branch,
        "title": truncate(title),
        "updated_at": updated_at,
        "message_count": msg_count,
        "message_count_source": msg_count_source,
        "resume_cmd": f"claude --resume {session_id}",
        "source_path": str(path),
        "size_bytes": path.stat().st_size if path.exists() else None,
        "warnings": warnings,
    }


# -- codex sample ----------------------------------------------------------------
_CODEX_ID_FROM_NAME = re.compile(r"([0-9a-f]{8}-[0-9a-f-]{27,})\.jsonl$")

def sample_codex(path):
    warnings = []
    session_id = None
    cwd = None
    git_branch = None
    cli_version = None

    head_text = read_head(path)
    head_lines = head_text.splitlines()
    if head_lines:
        try:
            first = json.loads(head_lines[0])
            if first.get("type") == "session_meta":
                payload = first.get("payload") or {}
                session_id = payload.get("session_id") or payload.get("id")
                cwd = payload.get("cwd")
                cli_version = payload.get("cli_version")
                git_branch = (payload.get("git") or {}).get("branch")
        except Exception as exc:
            warnings.append(f"session_meta parse failed: {exc}")
    if session_id is None:
        m = _CODEX_ID_FROM_NAME.search(path.name)
        session_id = m.group(1) if m else path.stem
        warnings.append("session_id fell back to filename parse")
    if cwd is None:
        warnings.append("no cwd found in session_meta head line")

    tail_lines = read_tail(path)
    model = None
    title = None
    updated_at = None
    for obj in reversed(list(iter_json_lines(tail_lines))):
        if updated_at is None and isinstance(obj.get("timestamp"), str):
            updated_at = obj["timestamp"]
        if model is None and obj.get("type") == "turn_context":
            payload = obj.get("payload") or {}
            if isinstance(payload.get("model"), str):
                model = payload["model"]
        if title is None and obj.get("type") == "event_msg":
            payload = obj.get("payload") or {}
            if payload.get("type") == "task_complete" and payload.get("last_agent_message"):
                title = payload["last_agent_message"]
        if model and title and updated_at:
            break
    if model is None:
        warnings.append("no model found in bounded tail scan (turn_context)")
    if title is None:
        warnings.append("no task_complete message found in bounded tail scan")
    if updated_at is None:
        updated_at = iso_from_mtime(path)
        warnings.append("no timestamp in tail scan; fell back to file mtime")

    msg_count, msg_count_source = estimate_message_count(path, tail_lines)

    return {
        "agent": "codex",
        "session_id": session_id,
        "cwd": cwd,
        "model": model,
        "git_branch": git_branch,
        "cli_version": cli_version,
        "title": truncate(title),
        "updated_at": updated_at,
        "message_count": msg_count,
        "message_count_source": msg_count_source,
        "resume_cmd": f"codex resume {session_id}",
        "source_path": str(path),
        "size_bytes": path.stat().st_size if path.exists() else None,
        "warnings": warnings,
    }


# -- file discovery --------------------------------------------------------------
def newest_files(root, pattern, n, exclude_substr=None):
    if not root.exists():
        return []
    files = []
    for f in root.rglob(pattern):
        if exclude_substr and exclude_substr in f.as_posix():
            continue
        try:
            files.append((f.stat().st_mtime, f))
        except OSError:
            continue
    files.sort(key=lambda t: t[0], reverse=True)
    return [f for _, f in files[:n]]


samples = []
if agent == "claude":
    root = home / ".claude/projects"
    for f in newest_files(root, "*.jsonl", N, exclude_substr="/subagents/"):
        try:
            samples.append(sample_claude(f))
        except Exception as exc:
            warnings_global.append(f"{f}: sample_claude failed: {exc}")
elif agent == "codex":
    root = home / ".codex/sessions"
    for f in newest_files(root, "*.jsonl", N):
        try:
            samples.append(sample_codex(f))
        except Exception as exc:
            warnings_global.append(f"{f}: sample_codex failed: {exc}")
else:
    print(f"agent-sessiond: unknown agent '{agent}' (expected claude|codex)", file=sys.stderr)
    sys.exit(2)

if json_flag:
    out = {
        "schema": "agent-sessiond.native-sample.v1",
        "agent": agent,
        "samples": samples,
        "warnings": warnings_global,
    }
    json.dump(out, sys.stdout, indent=2, sort_keys=True)
    sys.stdout.write("\n")
else:
    print(f"native-sample: {agent}  ({len(samples)} of requested {N})")
    for s in samples:
        sid = s["session_id"][:12] if s.get("session_id") else "?"
        model = s.get("model") or "?"
        cwd = s.get("cwd") or "?"
        updated = s.get("updated_at") or "?"
        title = s.get("title") or ""
        print(f"  {sid}  {updated}  {model:<16}  {cwd}")
        if title:
            print(f"      {title}")
        print(f"      resume: {s['resume_cmd']}")
        for w in s.get("warnings", []):
            print(f"      WARN: {w}")
    for w in warnings_global:
        print(f"WARN: {w}")
PY
}

cmd="${1:-status}"
case "$cmd" in
  once)
    collect_once
    ;;
  watch)
    while :; do
      collect_once
      sleep "$INTERVAL"
    done
    ;;
  status)
    print_status
    ;;
  native-sample)
    shift
    cmd_native_sample "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
# agent-sessiond:1 ends here
