#!/usr/bin/env python3
import os
from pathlib import Path
import sys


def main():
    override = os.environ.get("DOTCORTEX_APPROVAL_ENGINE")
    if override:
        candidates = [Path(override)]
    else:
        source_local = Path(__file__).resolve().parents[1] / "lib/dotcortex/claude_approval_p3.py"
        candidates = [
            Path.home() / ".local/lib/dotcortex/claude_approval_p3.py",
            source_local,
        ]
    for engine in candidates:
        if engine.is_file():
            try:
                os.execv("/usr/bin/python3", ["/usr/bin/python3", str(engine)])
            except OSError:
                return 0
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
