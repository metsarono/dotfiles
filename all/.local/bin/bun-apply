#!/usr/bin/env bash
# Apply manifest inside DotCortex env

# [[file:../../../package-bun.org::*Apply manifest inside DotCortex env][Apply manifest inside DotCortex env:1]]
# ~/DotCortex/all/.local/bin/bun-apply
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bun-apply [-h|--help]

Reconcile the DotCortex Bun global-package and source-build manifests.
Operational arguments are not accepted; configure an apply with environment variables.

Options:
  -h, --help              Show this help and exit before any apply or build work.

Environment:
  ENFORCE=0|1             Reconcile packages absent from the manifest (default: 1).
  UNINSTALL=0|1           Remove extras when ENFORCE=1 (default: 1).
  UPDATE=0|1              Update installed globals and source checkouts (default: 0).
  BUN_BUILD_ONLY=NAME     Skip global add/remove work and run only the named build row.
  DOTCORTEX_ROOT=PATH     Root for relative build paths and gate fallback
                          (default: $HOME/DotCortex).
  PROVISION_APPLY=1       Permit additive installs on a gated host; never removals.
  BUN_INSTALL=PATH        Bun installation root (default: $HOME/.bun).
  BUN_GLOBAL_DIR=PATH     Installed-global tree scanned by the Bun runner
                          (default: $BUN_INSTALL/install/global).
  BUN_GLOBAL_BIN_DIR=PATH Bun global executable directory exported by the runner
                          (default: $BUN_INSTALL/bin).
  BUN_BUILD_MANIFEST=PATH Source-build manifest (default:
                          $DOTCORTEX_ROOT/all/.local/share/dotcortex/manifests/bun/build.ssv).
  BUN_BUILD_STATE_ROOT=PATH
                          Source-build fingerprint state (default:
                          ${XDG_STATE_HOME:-$HOME/.local/state}/dotcortex/bun-build).
  DOTCORTEX_BUN_ENV=PATH  Command wrapper used by source-build steps
                          (default: $HOME/.local/bin/dotcortex-bun-env).
  XDG_STATE_HOME=PATH     State base when BUN_BUILD_STATE_ROOT is unset.
EOF
}

if [ "$#" -gt 0 ]; then
  case "$1" in
    -h|--help)
      if [ "$#" -eq 1 ]; then
        usage
        exit 0
      fi
      echo "bun-apply: $1 does not accept additional arguments" >&2
      usage >&2
      exit 2
      ;;
    *)
      echo "bun-apply: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
fi

MAN="$HOME/DotCortex/all/.local/share/dotcortex/manifests/bun/global.ssv"
RUN="$HOME/.local/bin/dotcortex-bun-env"

ENFORCE="${ENFORCE:-1}"
UNINSTALL="${UNINSTALL:-1}"
UPDATE="${UPDATE:-0}"
BUN_BUILD_ONLY="${BUN_BUILD_ONLY:-}"

# Per-host provisioning gate (package-host-gates.org): a gated host (Honey)
# stops here in dry-run unless PROVISION_APPLY=1, and never uninstalls.
PROVISION_GATE_BIN="$HOME/.local/bin/provision-gate"
[ -x "$PROVISION_GATE_BIN" ] || PROVISION_GATE_BIN="${DOTCORTEX_ROOT:-$HOME/DotCortex}/all/.local/bin/provision-gate"
if [ -x "$PROVISION_GATE_BIN" ]; then
  GATE_MODE="$("$PROVISION_GATE_BIN" mode bun)"
  if [ "$GATE_MODE" != open ]; then
    # A gated host only ever uses its own host lane, never the fleet manifest.
    HOST_MAN="$(dirname "$MAN")/hosts/$("$PROVISION_GATE_BIN" host).ssv"
    if [ ! -f "$HOST_MAN" ]; then
      echo "bun-apply: gated host has no bun host lane ($HOST_MAN): nothing to install, nothing removed"
      exit 0
    fi
  fi
  case "$GATE_MODE" in
    dry-run) echo "bun-apply: gated host, dry-run: host lane $HOST_MAN declares $(awk '!/^[ \t]*#/ && NF' "$HOST_MAN" | wc -l) package(s); nothing installed or removed (PROVISION_APPLY=1 installs missing ones, removals stay refused)"; exit 0 ;;
    additive) UNINSTALL=0; MAN="$HOST_MAN"; echo "bun-apply: gated host, additive only: host lane $HOST_MAN, uninstall of extras disabled" ;;
  esac
fi

echo "== bun apply =="

_emit_norm() {
  awk -v FS='[ \t]+' '
    function dequote(s){ return (s=="\"\"" ? "" : s) }
    $0 ~ /^[ \t]*#/ || NF==0 { next }
    {
      printf "%s|%s|%s|%s|%s\n",
        dequote($1),dequote($2),dequote($3),dequote($4),dequote($5)
    }
  ' "$MAN"
}

declare -A live_ver

while read -r name ver; do
  [ -n "${name:-}" ] || continue
  live_ver["$name"]="$ver"
done < <("$RUN" python3 - <<'PY'
import json
import os

root = os.path.expanduser(os.environ.get("BUN_GLOBAL_DIR", "~/.bun/install/global"))
node_modules = os.path.join(root, "node_modules")

def emit(pkg_dir):
    pkg_json = os.path.join(pkg_dir, "package.json")
    if not os.path.isfile(pkg_json):
        return
    try:
        with open(pkg_json, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except Exception:
        return
    name = data.get("name")
    version = data.get("version", "")
    if name:
        print(f"{name} {version}")

if os.path.isdir(node_modules):
    for entry in sorted(os.listdir(node_modules)):
        path = os.path.join(node_modules, entry)
        if entry.startswith("@") and os.path.isdir(path):
            for sub in sorted(os.listdir(path)):
                emit(os.path.join(path, sub))
        elif os.path.isdir(path):
            emit(path)
PY
)

declare -A want_names

while IFS='|' read -r pkg version flags registry extra
do
  [ -z "$BUN_BUILD_ONLY" ] || continue
  [ -n "$pkg" ] || continue
  want_names["$pkg"]=1

  installed_ver="${live_ver[$pkg]:-}"
  if [ -n "$installed_ver" ] && [ "$UPDATE" != "1" ]; then
    continue
  fi

  if [ -n "$installed_ver" ] && [ -n "$version" ] && [ "$version" = "$installed_ver" ]; then
    continue
  fi

  spec="$pkg"
  if [ -n "$version" ]; then
    spec="$pkg@$version"
  fi

  args=(add -g "$spec")

  if [ -n "$flags" ]; then
    IFS=',' read -ra FF <<<"$flags"
    for f in "${FF[@]}"; do
      [ -n "$f" ] && args+=("$f")
    done
  fi

  if [ -n "$registry" ]; then
    args+=(--registry "$registry")
  fi

  "$RUN" bun "${args[@]}"
done < <(_emit_norm)

if [ -z "$BUN_BUILD_ONLY" ] && [ "$ENFORCE" = "1" ] && [ "$UNINSTALL" = "1" ]; then
  echo "== uninstall extras =="
  for pkg in $(printf '%s\n' "${!live_ver[@]}" | sort); do
    if [ -z "${want_names[$pkg]:-}" ]; then
      "$RUN" bun remove -g "$pkg" || true
    fi
  done
fi

if [ -x "$HOME/.local/bin/dotcortex-bun-build-lib" ]; then
  # Source-build rows are processed in the same pass so updates and installs stay sequential.
  # The build fingerprints suppress reruns when the checkout and commands are unchanged.
  source "$HOME/.local/bin/dotcortex-bun-build-lib"

  echo "== bun build pass =="

  seen_build=0
  while IFS=$'\t' read -r name mode root repo ref subdir install_cmd build_cmd health_cmd extra
  do
    [ -n "$name" ] || continue
    if [ -n "$BUN_BUILD_ONLY" ] && [ "$name" != "$BUN_BUILD_ONLY" ]; then
      continue
    fi

    seen_build=1
    bun_build_ensure_checkout "$UPDATE" "$name" "$mode" "$root" "$repo" "$ref"

    root_abs="$(bun_build_root_abs "$root")"
    workdir_abs="$(bun_build_workdir_abs "$root" "$subdir")"
    state_dir="$(bun_build_state_dir "$name")"
    install_stamp="$state_dir/install.fp"
    build_stamp="$state_dir/build.fp"

    bun_build_apply_extra_guards "$name" "$root_abs" "$ref" "$extra"

    install_effective="$(bun_build_effective_install_cmd "$root_abs" "$workdir_abs" "$install_cmd")"
    build_effective="$(bun_build_effective_build_cmd "$build_cmd")"

    if [ -n "$install_effective" ]; then
      install_fp="$(bun_build_install_fingerprint "$root_abs" "$workdir_abs" "$install_effective")"
      install_materialized=1
      case "$install_effective" in
        *"npm ci"*) [ -d "$workdir_abs/node_modules" ] || install_materialized=0 ;;
      esac
      if [ "$install_materialized" = 1 ] && bun_build_fingerprint_matches "$install_stamp" "$install_fp"; then
        echo ">> [$name] install current"
      else
        bun_build_run_step "$name" install "$workdir_abs" "$install_effective"
        bun_build_write_fingerprint "$install_stamp" "$install_fp"
      fi
    else
      echo ">> [$name] install disabled"
    fi

    if [ -n "$build_effective" ]; then
      build_fp="$(bun_build_build_fingerprint "$root_abs" "$workdir_abs" "$install_effective" "$build_effective")"
      if bun_build_fingerprint_matches "$build_stamp" "$build_fp"; then
        echo ">> [$name] build current"
      else
        bun_build_run_step "$name" build "$workdir_abs" "$build_effective"
        bun_build_write_fingerprint "$build_stamp" "$build_fp"
      fi
    else
      echo ">> [$name] build disabled"
    fi
  done < <(bun_build_rows)

  if [ "$seen_build" = "0" ]; then
    echo "No Bun builds defined in $BUN_BUILD_MANIFEST"
  fi
fi

echo "Done."
# Apply manifest inside DotCortex env:1 ends here
