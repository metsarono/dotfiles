DEBUG_LOG_MAX_BYTES = env_int(
    "CLAUDE_IDLE_CHANNEL_DEBUG_MAX_BYTES", 2 * 1024 * 1024, 65536
)
DEBUG = os.environ.get("CLAUDE_IDLE_COMPACTION_DEBUG", "") in {"1", "true", "yes"}
TERMINAL_CLEANUP_BYTES = (
    b"\x1b[?1000l\x1b[?1002l\x1b[?1003l\x1b[?1004l"
    b"\x1b[?1005l\x1b[?1006l\x1b[?1015l"
    b"\x1b[?2004l\x1b[?25h\x1b[0m"
    # Kitty keyboard protocol: pop every pushed mode, then force legacy flags.
    # A child that dies before popping (e.g. an aborted startup) otherwise leaves
    # release/alternate-key reporting on, and CSI-u garbage leaks into fzf etc.
    b"\x1b[<99u\x1b[=0;1u"
)


def append_debug(path: pathlib.Path, message: str) -> None:
    """Append one prompt-free diagnostic to the session's private debug file."""
    if DEBUG:
        try:
            with path.open("a", encoding="utf-8") as stream:
                stream.write(f"{now():.6f} {message}\n")
            os.chmod(path, 0o600)
        except OSError:
            pass


def short_id(value: object) -> str:
    """Return a non-sensitive truncated identifier for diagnostics."""
    text = str(value or "unknown")
    return text if len(text) <= 12 else text[:8] + "…"


def now() -> float:
    """Return wall-clock seconds used for cache-deadline comparisons."""
    return time.time()


def monotonic() -> float:
    """Return monotonic seconds used only for local retry/poll scheduling."""
    return time.monotonic()


def executable_generation() -> str:
    """Hash executable bytes without confusing install time with load time."""
    try:
        return hashlib.sha256(pathlib.Path(__file__).read_bytes()).hexdigest()
    except OSError:
        return "unavailable"


# Capture once while this generation loads.  A later source/stow update can
# change the installed bytes, but it cannot rewrite this running process.
LOADED_GENERATION = executable_generation()


HERDR_SOURCE = "claude-warm"
HERDR_PANE_RE = re.compile(r"^[A-Za-z0-9_.:-]{1,96}$")
HERDR_AGENT_RE = re.compile(r"^[A-Za-z][A-Za-z0-9 .:_-]{0,63}$")
HERDR_HEARTBEAT_SECONDS = env_float(
    "CLAUDE_WARM_HERDR_HEARTBEAT_SECONDS", 30.0, 5.0
)
HERDR_REGISTRATION_TTL_MS = env_int(
    "CLAUDE_WARM_HERDR_REGISTRATION_TTL_MS", 120000, 1000
)


class HerdrReporter:
    """Register identity and report PTY-derived state through Herdr's pane API."""

    def __init__(self) -> None:
        socket_path = os.environ.get("HERDR_SOCKET_PATH", "")
        pane_id = os.environ.get("HERDR_PANE_ID", "")
        agent = os.environ.get("CLAUDE_WARM_HERDR_AGENT", "") or "Claude Code"
        self.socket_path = pathlib.Path(socket_path) if socket_path else None
        self.pane_id = pane_id if HERDR_PANE_RE.fullmatch(pane_id) else None
        self.agent = agent if HERDR_AGENT_RE.fullmatch(agent) else None
        self.enabled = (
            os.environ.get("HERDR_ENV") == "1"
            and self.socket_path is not None
            and self.socket_path.is_absolute()
            and len(str(self.socket_path)) < 100
            and self.pane_id is not None
            and self.agent is not None
        )
        self.source = HERDR_SOURCE
        self.sequence = 0
        self.registered = False
        self.last_report_at: float | None = None
        self.last_report_state: str | None = None
        self.last_error: str | None = None
        self.next_heartbeat = 0.0
        self.child_pid: int | None = None
        self.agent_session_id: str | None = None

    def state(self) -> dict[str, object]:
        """Return prompt-free Herdr ownership state for the supervisor state file."""
        return {
            "herdr_enabled": self.enabled,
            "herdr_pane_id": self.pane_id,
            "herdr_agent": self.agent,
            "herdr_source": self.source,
            "herdr_registered": self.registered,
            "herdr_last_report_at": self.last_report_at,
            "herdr_last_report_state": self.last_report_state,
            "herdr_last_error": self.last_error,
            "herdr_child_pid": self.child_pid,
            "herdr_agent_session_id": self.agent_session_id,
        }

    @staticmethod
    def _valid_session_id(value: object) -> str | None:
        if isinstance(value, str) and SESSION_RE.fullmatch(value):
            return value
        return None

    def _send(self, method: str, params: dict[str, object]) -> bool:
        """Send one bounded JSON-RPC request to the inherited Herdr socket."""
        if not self.enabled or self.socket_path is None:
            return False
        self.sequence += 1
        request = {
            "id": f"{self.source}:{self.sequence}",
            "method": method,
            "params": params,
        }
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
                connection.settimeout(0.5)
                connection.connect(str(self.socket_path))
                connection.sendall((json.dumps(request, separators=(",", ":")) + "\n").encode())
                response = connection.recv(4096)
            if response:
                decoded = json.loads(response.decode("utf-8"))
                if isinstance(decoded, dict) and decoded.get("error"):
                    error = decoded["error"]
                    code = error.get("code") if isinstance(error, dict) else "request-failed"
                    self.last_error = str(code)[:96]
                    return False
            return True
        except (OSError, ValueError, UnicodeError) as error:
            self.last_error = type(error).__name__
            return False

    def _base(self, session_id: object = None) -> dict[str, object]:
        """Return validated Herdr identity fields, including resumed session ID."""
        safe_session_id = self._valid_session_id(session_id)
        base = {
            "pane_id": self.pane_id,
            "source": self.source,
            "agent": self.agent,
        }
        if safe_session_id:
            base["agent_session_id"] = safe_session_id
        return base

    def _metadata(self) -> dict[str, object]:
        """Return display identity and bounded supervisor/child PID metadata."""
        tokens = {
            "supervisor_pid": str(os.getpid()),
            "pty_owner": "claude-warm",
        }
        if isinstance(self.child_pid, int) and self.child_pid > 0:
            tokens["claude_pid"] = str(self.child_pid)
        return {
            "pane_id": self.pane_id,
            "source": self.source,
            "agent": self.agent,
            "display_agent": self.agent,
            "tokens": tokens,
            "ttl_ms": HERDR_REGISTRATION_TTL_MS,
        }

    def register(self, session_id: object = None) -> None:
        """Refresh identity and metadata without sending a visible state."""
        if not self.enabled:
            return
        safe_session_id = self._valid_session_id(session_id)
        base = self._base(safe_session_id)
        if safe_session_id and safe_session_id != self.agent_session_id:
            self._send("pane.report_agent_session", dict(base))
            self.agent_session_id = safe_session_id
        success = self._send("pane.report_metadata", self._metadata())
        self.registered = success or self.registered
        self.last_report_at = now()
        self.next_heartbeat = monotonic() + HERDR_HEARTBEAT_SECONDS

    def report_state(self, state: str, session_id: object = None) -> None:
        """Report only a state derived from PTY output, never from a hook event."""
        if not self.enabled or state not in {"idle", "working", "blocked", "unknown"}:
            return
        self.register(session_id)
        report = self._base(session_id)
        report["state"] = state
        self._send("pane.report_agent", report)
        self.last_report_state = state
        self.last_report_at = now()
        self.next_heartbeat = monotonic() + HERDR_HEARTBEAT_SECONDS

    def heartbeat(self, state: str | None = None, session_id: object = None) -> None:
        """Refresh metadata, optionally repeating the last PTY-derived state."""
        if self.enabled and monotonic() >= self.next_heartbeat:
            if state in {"idle", "working", "blocked", "unknown"}:
                self.report_state(state, session_id)
            else:
                self.register(session_id)

    def release(self) -> None:
        """Remove this supervisor's Herdr registration on every orderly exit."""
        if not self.enabled or self.socket_path is None:
            return
        params = {
            "pane_id": self.pane_id,
            "source": self.source,
            "agent": self.agent,
        }
        if self._send("pane.release_agent", params):
            self.registered = False
        self.last_report_state = "released"
        self.last_report_at = now()


HERDR_SCREEN_BYTES = 128 * 1024


class ClaudeScreenClassifier:
    """Classify visible Claude PTY output without consuming or rewriting it."""

    OSC_TITLE_RE = re.compile(
        r"\x1b\](?:0|1|2);(.*?)(?:\x07|\x1b\\)", re.DOTALL
    )
    ANSI_RE = re.compile(
        r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\)|[@-_])"
    )
    WORKING_RE = re.compile(
        r"^[✻✳✽✶✷]\s+Working(?:…|\.\.\.)?(?:\s|$)", re.MULTILINE
    )
    PROMPT_RE = re.compile(r"^\s*❯(?:\s.*)?$", re.MULTILINE)
    STRONG_BLOCKERS = (
        "enter to confirm",
        "enter to select",
        "enter to submit",
        "esc to cancel",
        "do you want to proceed?",
        "would you like to proceed?",
        "allow command?",
    )

    def __init__(self) -> None:
        self.raw = bytearray()
        self.osc_title = ""
        self.state: str | None = None

    def reset(self) -> None:
        """Forget the previous screen when Claude binds a new session."""
        self.raw.clear()
        self.osc_title = ""
        self.state = None

    def _visible_text(self) -> str:
        text = self.ANSI_RE.sub("", bytes(self.raw).decode("utf-8", "replace"))
        return "".join(
            character
            for character in text
            if character in "\n\r\t" or ord(character) >= 0x20
        )

    def _classify(self, visible: str) -> str:
        recent = visible[-HERDR_SCREEN_BYTES:]
        lowered = recent.lower()
        lines = [line.rstrip() for line in recent.splitlines() if line.strip()]
        bottom = "\n".join(lines[-8:])
        blocker_positions = [
            lowered.rfind(marker)
            for marker in self.STRONG_BLOCKERS
            if marker in lowered
        ]
        last_blocker = max(blocker_positions, default=-1)
        working_matches = list(self.WORKING_RE.finditer(recent))
        last_working = working_matches[-1].start() if working_matches else -1
        prompt_matches = list(self.PROMPT_RE.finditer(recent))
        last_prompt = prompt_matches[-1].start() if prompt_matches else -1
        # The PTY stream is not a full terminal emulator.  Treat the newest
        # strong cue as authoritative so a later prompt can clear an older
        # approval screen after Claude redraws it with erase/cursor bytes.
        if last_blocker >= 0 and last_blocker >= max(last_working, last_prompt):
            return "blocked"
        if last_working >= 0 and (
            last_working >= last_prompt
            or (last_prompt < 0 and (
            "esc to interrupt" in lowered and "working" in lowered
            ))
        ):
            return "working"
        if last_prompt >= 0 and self.PROMPT_RE.search(bottom):
            return "idle"
        return "unknown"

    def feed(self, data: bytes) -> str | None:
        """Consume a bounded copy for classification and return state changes."""
        if not data:
            return None
        self.raw.extend(data)
        if len(self.raw) > HERDR_SCREEN_BYTES:
            del self.raw[:-HERDR_SCREEN_BYTES]
        titles = list(self.OSC_TITLE_RE.finditer(bytes(self.raw).decode("utf-8", "replace")))
        if titles:
            self.osc_title = titles[-1].group(1)
        state = self._classify(self._visible_text())
        if state == self.state:
            return None
        self.state = state
        return state


class DevelopmentChannelPromptMatcher:
    """Recognize only Claude Code 2.1.291's complete development dialog."""

    BUFFER_BYTES = 64 * 1024
    TITLE = "WARNING: Loading development channels"
    WARNING = (
        "--dangerously-load-development-channels is for local channel "
        "development only. Do not use this option to run channels you have "
        "downloaded off the internet."
    )
    APPROVED_CHANNELS_HELP = (
        "Please use --channels to run a list of approved channels."
    )
    CONFIRM_LABEL = "I am using this for local development"
    EXIT_LABEL = "Exit"
    CHANNELS_RE = re.compile(
        rf"Channels:\s*(?P<entries>{DEVELOPMENT_CHANNEL_ENTRY_PATTERN}"
        rf"(?:\s*,\s*{DEVELOPMENT_CHANNEL_ENTRY_PATTERN})*)"
    )

    def __init__(self, opted_in: tuple[str, ...]):
        self.opted_in = frozenset(opted_in)
        self.raw = bytearray()
        self.matched = False

    def feed(self, data: bytes) -> tuple[str, ...] | None:
        """Return the exact approved entries once, or fail closed."""
        if self.matched or not self.opted_in or not data:
            return None
        self.raw.extend(data)
        if len(self.raw) > self.BUFFER_BYTES:
            del self.raw[:-self.BUFFER_BYTES]
        visible = ClaudeScreenClassifier.ANSI_RE.sub(
            "", bytes(self.raw).decode("utf-8", "replace")
        )
        visible = "".join(
            character
            for character in visible
            if character in "\n\r\t" or ord(character) >= 0x20
        )
        normalized = re.sub(r"\s+", " ", visible)
        title_at = normalized.rfind(self.TITLE)
        if title_at < 0:
            return None
        candidate = normalized[title_at:]
        position = 0
        for marker in (self.TITLE, self.WARNING, self.APPROVED_CHANNELS_HELP):
            found = candidate.find(marker, position)
            if found < 0:
                return None
            position = found + len(marker)
        channels = self.CHANNELS_RE.search(candidate, position)
        if channels is None:
            return None
        confirm_at = candidate.find(self.CONFIRM_LABEL, channels.end())
        exit_at = candidate.find(
            self.EXIT_LABEL,
            confirm_at + len(self.CONFIRM_LABEL) if confirm_at >= 0 else 0,
        )
        if confirm_at < 0 or exit_at < 0:
            return None
        # If a future renderer adds an entry shape this version does not know,
        # its server:/plugin: prefix remains between the parsed list and the
        # affirmative label.  Refuse rather than accepting a partial list.
        remainder = candidate[channels.end():confirm_at]
        if "server:" in remainder or "plugin:" in remainder:
            return None
        prompted = tuple(
            entry.strip() for entry in channels.group("entries").split(",")
        )
        if not prompted or any(entry not in self.opted_in for entry in prompted):
            return None
        self.matched = True
        return prompted


class TerminalInputClassifier:
    """Classify raw outer-terminal input without suppressing any forwarded byte."""

    PASTE_START = b"\x1b[200~"
    PASTE_END = b"\x1b[201~"
    C1_PASTE_START = b"\x9b200~"
    C1_PASTE_END = b"\x9b201~"

    def __init__(self, escape_timeout: float = INPUT_ESCAPE_TIMEOUT_SECONDS):
        self.escape_timeout = escape_timeout
        self.buffer = bytearray()
        self.in_bracketed_paste = False
        self.paste_end_marker: bytes | None = None
        self.pending_since: float | None = None

    @staticmethod
    def _event(kind: str, length: int, human: bool) -> tuple[str, int, bool]:
        return kind, length, human

    @staticmethod
    def _suffix_prefix_length(value: bytes, marker: bytes) -> int:
        maximum = min(len(value), len(marker) - 1)
        for length in range(maximum, 0, -1):
            if value[-length:] == marker[:length]:
                return length
        return 0

    def _drain_paste(self, events: list[tuple[str, int, bool]]) -> bool:
        marker = self.paste_end_marker or self.PASTE_END
        raw = bytes(self.buffer)
        marker_index = raw.find(marker)
        if marker_index >= 0:
            if marker_index:
                events.append(self._event("bracketed-paste-payload", marker_index, True))
                del self.buffer[:marker_index]
            del self.buffer[: len(marker)]
            events.append(self._event("bracketed-paste-end", len(marker), False))
            self.in_bracketed_paste = False
            self.paste_end_marker = None
            return True
        suffix = self._suffix_prefix_length(raw, marker)
        payload_length = len(raw) - suffix
        if payload_length:
            events.append(self._event("bracketed-paste-payload", payload_length, True))
            del self.buffer[:payload_length]
            return True
        return False

    def _classify_csi(self, sequence: bytes, prefix_length: int) -> tuple[str, bool]:
        body = sequence[prefix_length:-1]
        final = sequence[-1:]
        if sequence in {self.PASTE_START, self.C1_PASTE_START}:
            self.in_bracketed_paste = True
            self.paste_end_marker = self.PASTE_END if sequence == self.PASTE_START else self.C1_PASTE_END
            return "bracketed-paste-start", False
        if sequence in {self.PASTE_END, self.C1_PASTE_END}:
            self.in_bracketed_paste = False
            self.paste_end_marker = None
            return "bracketed-paste-end", False
        if final in {b"M", b"m"} and body.startswith(b"<"):
            return "sgr-mouse-report", False
        if not body and final in {b"I", b"O"}:
            return "focus-report", False
        if final == b"R" and re.fullmatch(rb"\d+;\d+", body):
            return "cursor-position-report", False
        if final == b"n":
            return "device-status-report", False
        if final == b"c" and (not body or body[:1] in {b"?", b">", b"!", b"="}):
            return "device-attribute-report", False
        if final == b"y" and body.startswith(b"?"):
            return "terminal-negotiation", False
        if final == b"t" and re.fullmatch(rb"[0-9;]+", body):
            return "terminal-negotiation", False
        if final == b"u":
            return "keyboard-csi-u", True
        return "keyboard-csi" if final else "unknown-input", True

    def _drain(self) -> list[tuple[str, int, bool]]:
        events: list[tuple[str, int, bool]] = []
        while self.buffer:
            if self.in_bracketed_paste:
                if not self._drain_paste(events):
                    break
                continue
            first = self.buffer[0]
            if first not in {0x1B, 0x9B, 0x9D, 0x90, 0x98, 0x9E, 0x9F}:
                protocol_markers = [
                    marker
                    for marker in (0x1B, 0x9B, 0x9D, 0x90, 0x98, 0x9E, 0x9F)
                    if marker in self.buffer
                ]
                length = min(self.buffer.index(marker) for marker in protocol_markers) if protocol_markers else len(self.buffer)
                del self.buffer[:length]
                events.append(self._event("keyboard-input", length, True))
                continue
            if first == 0x9B:
                prefix_length = 1
                if len(self.buffer) < 2:
                    break
                final_index = next(
                    (index for index, value in enumerate(self.buffer[1:], 1) if 0x40 <= value <= 0x7E),
                    None,
                )
                if final_index is None:
                    break
                sequence = bytes(self.buffer[: final_index + 1])
                kind, human = self._classify_csi(sequence, prefix_length)
                del self.buffer[: final_index + 1]
                events.append(self._event(kind, len(sequence), human))
                continue
            if len(self.buffer) < 2:
                break
            if self.buffer[:2] == b"\x1b[":
                if len(self.buffer) == 2:
                    break
                if self.buffer[2:3] == b"M":
                    if len(self.buffer) < 6:
                        break
                    del self.buffer[:6]
                    events.append(self._event("legacy-mouse-report", 6, False))
                    continue
                final_index = next(
                    (index for index, value in enumerate(self.buffer[2:], 2) if 0x40 <= value <= 0x7E),
                    None,
                )
                if final_index is None:
                    break
                sequence = bytes(self.buffer[: final_index + 1])
                kind, human = self._classify_csi(sequence, 2)
                del self.buffer[: final_index + 1]
                events.append(self._event(kind, len(sequence), human))
                continue
            if bytes(self.buffer[:2]) in {b"\x1b]", b"\x1bP", b"\x1b^", b"\x1b_"}:
                bell = self.buffer.find(b"\x07") if self.buffer[1] == 0x5D else -1
                string_terminator = self.buffer.find(b"\x1b\\")
                terminators = [value for value in (bell, string_terminator) if value >= 0]
                if not terminators:
                    break
                terminator = min(terminators)
                length = terminator + (1 if bell == terminator else 2)
                del self.buffer[:length]
                events.append(self._event("terminal-negotiation", length, False))
                continue
            if self.buffer[0] == 0x9D:
                terminator = self.buffer.find(b"\x07")
                if terminator < 0:
                    break
                length = terminator + 1
                del self.buffer[:length]
                events.append(self._event("terminal-negotiation", length, False))
                continue
            if self.buffer[0] in {0x90, 0x98, 0x9E, 0x9F}:
                terminator = self.buffer.find(b"\x9c")
                if terminator < 0:
                    break
                length = terminator + 1
                del self.buffer[:length]
                events.append(self._event("terminal-negotiation", length, False))
                continue
            if self.buffer[:2] == b"\x1bO":
                if len(self.buffer) < 3:
                    break
                del self.buffer[:3]
                events.append(self._event("keyboard-ss3", 3, True))
                continue
            del self.buffer[:2]
            events.append(self._event("unknown-input", 2, True))
        return events

    def feed(self, data: bytes) -> list[tuple[str, int, bool]]:
        if not data:
            return []
        self.buffer.extend(data)
        if self.pending_since is None and self.buffer and self.buffer[0] in {0x1B, 0x9B, 0x9D, 0x90, 0x98, 0x9E, 0x9F}:
            self.pending_since = monotonic()
        events = self._drain()
        if self.buffer and self.pending_since is None:
            self.pending_since = monotonic()
        if not self.buffer:
            self.pending_since = None
        return events

    def flush_expired(self) -> list[tuple[str, int, bool]]:
        if not self.buffer or self.pending_since is None:
            return []
        if monotonic() - self.pending_since < self.escape_timeout:
            return []
        length = len(self.buffer)
        self.buffer.clear()
        self.pending_since = None
        self.in_bracketed_paste = False
        self.paste_end_marker = None
        return [self._event("unknown-input", length, True)]


def atomic_json(path: pathlib.Path, payload: dict) -> None:
    """Write PAYLOAD atomically with owner-only permissions."""
    temporary = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    data = json.dumps(payload, sort_keys=True, separators=(",", ":")) + "\n"
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def safe_mkdir(path: pathlib.Path) -> None:
    """Create PATH as a private directory."""
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path, 0o700)


def effective_profile(requested: str | None) -> str:
    """Resolve a requested Claude cache profile without guessing backend TTL."""
    requested = requested or os.environ.get("CLAUDE_IDLE_CACHE_PROFILE", "auto")
    if requested in {"long", "short"}:
        return requested
    force_short = os.environ.get("FORCE_PROMPT_CACHING_5M", "").lower()
    force_long = os.environ.get("ENABLE_PROMPT_CACHING_1H", "").lower()
    if force_short in {"1", "true", "yes"}:
        return "short"
    if force_long in {"1", "true", "yes"}:
        return "long"
    return "long"


def runtime_root() -> pathlib.Path:
    """Return the required XDG runtime root or fail before launching Claude."""
    value = os.environ.get("XDG_RUNTIME_DIR")
    if not value:
        raise RuntimeError("XDG_RUNTIME_DIR is required for supervised Claude sessions")
    root = pathlib.Path(value) / "claude-idle-compaction"
    safe_mkdir(root)
    return root


def resolve_claude() -> str:
    """Resolve the real Claude executable without recursively selecting this wrapper."""
    explicit = os.environ.get("CLAUDE_IDLE_REAL_EXECUTABLE")
    candidates = [explicit] if explicit else []
    found = shutil.which("claude")
    if found:
        candidates.append(found)
    candidates.extend(
        [
            str(pathlib.Path.home() / ".local/bin/claude"),
            str(pathlib.Path.home() / ".npm-global/bin/claude"),
        ]
    )
    wrapper = pathlib.Path(__file__).resolve()
    for candidate in candidates:
        if not candidate:
            continue
        path = pathlib.Path(candidate).expanduser()
        try:
            resolved = path.resolve()
        except OSError:
            continue
        if resolved == wrapper or not resolved.is_file() or not os.access(resolved, os.X_OK):
            continue
        if resolved.name in {"claude-warm", "claude-warmctl"}:
            continue
        return str(resolved)
    raise RuntimeError("real Claude executable not found; set CLAUDE_IDLE_REAL_EXECUTABLE")


def child_alive(pid: int | None) -> bool:
    """Return whether PID is still a live process."""
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def write_all(fd: int, data: bytes) -> None:
    """Write all DATA to a nonblocking descriptor."""
    offset = 0
    while offset < len(data):
        try:
            written = os.write(fd, data[offset:])
        except InterruptedError:
            continue
        except BlockingIOError:
            time.sleep(0.002)
            continue
        if written <= 0:
            raise OSError(errno.EIO, "PTY write returned zero bytes")
        offset += written


class Inotify:
    """Small Linux inotify wrapper used for event-driven transcript monitoring."""

    EVENT = struct.Struct("iIII")
    IN_MODIFY = 0x00000002
    IN_CLOSE_WRITE = 0x00000008
    IN_MOVED_TO = 0x00000080
    IN_ATTRIB = 0x00000004
    IN_Q_OVERFLOW = 0x00004000
    MASK = IN_MODIFY | IN_CLOSE_WRITE | IN_MOVED_TO | IN_ATTRIB

    def __init__(self, directory: pathlib.Path):
        self.fd = -1
        self.watch_descriptor = -1
        try:
            libc = ctypes.CDLL(None, use_errno=True)
            init1 = libc.inotify_init1
            init1.argtypes = [ctypes.c_int]
            init1.restype = ctypes.c_int
            add_watch = libc.inotify_add_watch
            add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
            add_watch.restype = ctypes.c_int
            self.fd = init1(os.O_NONBLOCK | os.O_CLOEXEC)
            if self.fd < 0:
                raise OSError(ctypes.get_errno(), "inotify_init1")
            self.watch_descriptor = add_watch(self.fd, os.fsencode(str(directory)), self.MASK)
            if self.watch_descriptor < 0:
                raise OSError(ctypes.get_errno(), "inotify_add_watch")
            self.directory = directory
        except Exception:
            self.close()
            raise

    def read(self) -> list[tuple[int, str]]:
        """Drain pending events as `(mask, name)' pairs."""
        events: list[tuple[int, str]] = []
        while True:
            try:
                data = os.read(self.fd, 65536)
            except BlockingIOError:
                break
            if not data:
                break
            offset = 0
            while offset + self.EVENT.size <= len(data):
                _, mask, _, name_length = self.EVENT.unpack_from(data, offset)
                offset += self.EVENT.size
                raw_name = data[offset : offset + name_length]
                offset += name_length
                name = raw_name.split(b"\0", 1)[0].decode("utf-8", "replace")
                events.append((mask, name))
        return events

    def close(self) -> None:
        """Close the inotify descriptor."""
        if self.fd >= 0:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = -1


class PreservationFederationClient:
    """Poll one configured federation bridge from the native owner loop.

    The bridge is a request/response adapter for the tested federation API.
    It owns transport and central-authority access; this process only supplies
    current owner facts and, if directed, invokes its own native preservation
    path.  No local ledger, fallback transport, or second PTY owner exists.
    """

    REQUIRED = {
        "bridge": "CLAUDE_WARM_PRESERVATION_BRIDGE",
        "bridge_adapter": "CLAUDE_WARM_PRESERVATION_BRIDGE_ADAPTER",
        "authority_host": "CLAUDE_WARM_PRESERVATION_AUTHORITY_HOST",
        "authority_identity": "CLAUDE_WARM_PRESERVATION_AUTHORITY_IDENTITY",
        "authority_executable": "CLAUDE_WARM_PRESERVATION_AUTHORITY_EXECUTABLE",
        "ledger_root": "CLAUDE_WARM_PRESERVATION_LEDGER_ROOT",
        "telemetry_source": "CLAUDE_WARM_PRESERVATION_TELEMETRY_SOURCE",
        "telemetry_host": "CLAUDE_WARM_PRESERVATION_TELEMETRY_HOST",
        "transport": "CLAUDE_WARM_PRESERVATION_TRANSPORT",
        "provider": "CLAUDE_WARM_PRESERVATION_PROVIDER",
        "account_hash": "CLAUDE_WARM_PRESERVATION_ACCOUNT_HASH",
        "model_pool": "CLAUDE_WARM_PRESERVATION_MODEL_POOL",
        "estimate": "CLAUDE_WARM_PRESERVATION_ESTIMATE_PERCENT",
        "uncertainty": "CLAUDE_WARM_PRESERVATION_ESTIMATE_UNCERTAINTY_PERCENT",
        "in_flight": "CLAUDE_WARM_PRESERVATION_IN_FLIGHT_RESERVE_PERCENT",
        "control": "CLAUDE_WARM_PRESERVATION_CONTROL_RESERVE_PERCENT",
        "protection": "CLAUDE_WARM_PRESERVATION_PROTECTION_ENABLED",
        "nudge": "CLAUDE_WARM_PRESERVATION_NUDGE_ENABLED",
    }

    def __init__(self, owner: object):
        self.owner = owner
        self.config, self.disabled_reason = self._read_config()
        self.enabled = self.config is not None
        self.next_poll: float | None = (
            monotonic() + PRESERVATION_POLL_SECONDS if self.enabled else None
        )
        self.bridge_thread: threading.Thread | None = None
        self.bridge_result: queue.SimpleQueue | None = None
        self.last_poll_at: float | None = None
        self.last_result: str | None = None
        self.last_error: str | None = None
        self.last_decision: str | None = None
        self.last_next_action: str | None = None
        self.last_observation_age: float | None = None
        self.last_headroom: float | None = None
        self.last_reserve: float | None = None
        self.last_protection_enabled: bool | None = None
        self.last_nudge_enabled: bool | None = None
        self.last_generation_loaded: bool | None = None

    @staticmethod
    def _percent(name: str, value: str) -> float | None:
        try:
            number = float(value)
        except ValueError:
            return None
        return number if 0.0 <= number <= 100.0 else None

    @classmethod
    def _read_config(cls) -> tuple[dict[str, object] | None, str]:
        values = {
            key: os.environ.get(environment, "").strip()
            for key, environment in cls.REQUIRED.items()
        }
        missing = [environment for key, environment in cls.REQUIRED.items() if not values[key]]
        if missing:
            return None, "missing-bindings:" + ",".join(missing)
        bridge = pathlib.Path(str(values["bridge"])).expanduser()
        if (
            not bridge.is_absolute()
            or not bridge.is_file()
            or not os.access(bridge, os.X_OK)
        ):
            return None, "bridge-unavailable"
        for key in ("authority_executable", "ledger_root"):
            if not pathlib.Path(str(values[key])).is_absolute():
                return None, f"{key}-not-absolute"
        if (
            not PRESERVATION_HOST_RE.fullmatch(str(values["authority_host"]))
            or not PRESERVATION_HOST_RE.fullmatch(str(values["authority_identity"]))
            or not PRESERVATION_HOST_RE.fullmatch(str(values["telemetry_host"]))
        ):
            return None, "invalid-authority-host"
        if str(values["transport"]) != "ssh":
            return None, "unsupported-transport"
        if str(values["bridge_adapter"]) != PRESERVATION_BRIDGE_ADAPTER:
            return None, "unsupported-bridge-adapter"
        if str(values["telemetry_source"]) != f'authority:{values["authority_host"]}':
            return None, "telemetry-not-authority-owned"
        for key in ("telemetry_source", "provider", "account_hash", "model_pool"):
            if not PRESERVATION_BINDING_RE.fullmatch(str(values[key])):
                return None, f"invalid-{key}"
        percentages: dict[str, float] = {}
        for key in ("estimate", "uncertainty", "in_flight", "control"):
            number = cls._percent(key, str(values[key]))
            if number is None:
                return None, f"invalid-{key}"
            percentages[key] = number
        booleans: dict[str, bool] = {}
        for key in ("protection", "nudge"):
            if str(values[key]) not in {"0", "1"}:
                return None, f"invalid-{key}"
            booleans[key] = str(values[key]) == "1"
        provider = str(values["provider"])
        account_hash = str(values["account_hash"])
        model_pool = str(values["model_pool"])
        return {
            "bridge": str(bridge),
            "bridge_adapter": PRESERVATION_BRIDGE_ADAPTER,
            "authority_host": str(values["authority_host"]),
            "authority_identity": str(values["authority_identity"]),
            "authority_executable": str(values["authority_executable"]),
            "ledger_root": str(values["ledger_root"]),
            "telemetry_source": str(values["telemetry_source"]),
            "telemetry_host": str(values["telemetry_host"]),
            "transport": "ssh",
            "provider": provider,
            "account_hash": account_hash,
            "model_pool": model_pool,
            "pool_key": f"{provider}:{account_hash}:{model_pool}",
            **percentages,
            **booleans,
        }, ""

    def state(self) -> dict[str, object]:
        """Return bounded operator evidence without secrets or response payloads."""
        return {
            "preservation_federation_enabled": self.enabled,
            "preservation_federation_disabled_reason": self.disabled_reason,
            "preservation_federation_last_poll_at": self.last_poll_at,
            "preservation_federation_last_result": self.last_result,
            "preservation_federation_last_error": self.last_error,
            "preservation_federation_last_decision": self.last_decision,
            "preservation_federation_last_next_action": self.last_next_action,
            "preservation_federation_observation_age_seconds": self.last_observation_age,
            "preservation_federation_limiting_headroom_percent": self.last_headroom,
            "preservation_federation_aggregate_reserve_percent": self.last_reserve,
            "preservation_federation_protection_enabled": self.last_protection_enabled,
            "preservation_federation_nudge_enabled": self.last_nudge_enabled,
            "preservation_federation_generation_loaded": self.last_generation_loaded,
            "preservation_federation_next_poll_monotonic": self.next_poll,
            "preservation_federation_poll_in_flight": (
                self.bridge_thread is not None and self.bridge_thread.is_alive()
            ),
        }

    def _scaled_estimate(self) -> tuple[float, bool]:
        """Scale only unpreserved context with the active model's quota cost.

        Unknown context remains conservatively eligible at the full calibrated
        estimate.  A known context below the native owner's minimum is excluded
        from the aggregate reserve because /compact would reject it.  Context
        retained by the latest successful compaction is a baseline, not new
        preservation liability.  Sonnet consumes approximately one third of
        Opus quota for the same new context, Haiku one third of Sonnet, and a
        genuine Fable-tier model three times Opus.  The Fable owner identity
        does not imply Fable-tier weights when its actual model is Opus.
        Unknown models retain the Opus weight so missing model telemetry never
        weakens protection.
        """
        config = self.config
        assert config is not None
        tokens = self.owner.current_tokens
        baseline = float(config["estimate"])
        if tokens is None:
            return baseline, True
        preserved = self.owner.post_compact_baseline_tokens
        effective_tokens = max(0, tokens - preserved) if preserved is not None else tokens
        if effective_tokens < MIN_TOKENS:
            return 0.0, False
        model = (self.owner.current_model or "").lower()
        if "fable" in model:
            model_weight = 3.0
        elif "haiku" in model:
            model_weight = 1.0 / 9.0
        elif "sonnet" in model:
            model_weight = 1.0 / 3.0
        else:
            model_weight = 1.0
        scaled = baseline * effective_tokens / 500_000.0 * model_weight
        return min(100.0, math.ceil(scaled * 2.0) / 2.0), True

    def _request(self) -> dict[str, object]:
        config = self.config
        assert config is not None
        owner = self.owner
        estimate, eligible = self._scaled_estimate()
        return {
            "schema": PRESERVATION_FEDERATION_SCHEMA,
            "host": socket.gethostname(),
            "now": now(),
            "telemetry": None,
            "telemetry_binding": config["telemetry_source"],
            "bridge": {
                "adapter": config["bridge_adapter"],
                "protocol": PRESERVATION_BRIDGE_PROTOCOL,
            },
            "authority": {
                "host": config["authority_host"],
                "executable": config["authority_executable"],
                "ledger_root": config["ledger_root"],
                "transport": config["transport"],
            },
            "pool": {
                "provider": config["provider"],
                "account_hash": config["account_hash"],
                "model_pool": config["model_pool"],
                "pool_key": config["pool_key"],
            },
            "session": {
                "session_id": owner.session_id,
                "pool_key": config["pool_key"],
                "owner_kind": "claude-warm",
                "owner_label": os.environ.get("CLAUDE_WARM_HERDR_AGENT"),
                "model": owner.current_model,
                "dirty": owner.dirty,
                "current_context_tokens": owner.current_tokens,
                "preservation_eligible": eligible,
                "estimated_preservation_percent": estimate,
                "estimate_uncertainty_percent": config["uncertainty"],
                "in_flight_reserve_percent": config["in_flight"],
                "control_reserve_percent": config["control"],
                "protection_enabled": config["protection"],
                "nudge_enabled": config["nudge"],
            },
            "owner_state": {
                "channel": owner.channel,
                "session_id": owner.session_id,
                "supervisor_pid": os.getpid(),
                "completed_turn_epoch": owner.completed_turn_epoch,
                "loaded_generation": LOADED_GENERATION,
                "installed_generation": executable_generation(),
                "native_state": owner.preservation_state,
                "native_failure": owner.preservation_failure or "",
            },
        }

    def _failure(self, reason: str) -> None:
        reason = re.sub(r"[^A-Za-z0-9_.:-]", "_", str(reason))[:160] or "unknown"
        self.last_result = "failed-closed"
        self.last_error = reason
        self.owner._debug(f"preservation-federation-failed reason={self.last_error}")
        self.owner._guard_log("preservation-federation-failed", reason=self.last_error)

    def _accept_response(self, response: object) -> None:
        config = self.config
        if not isinstance(response, dict) or response.get("schema") != PRESERVATION_FEDERATION_RESPONSE_SCHEMA:
            received = response.get("schema") if isinstance(response, dict) else type(response).__name__
            label = received if isinstance(received, str) and PRESERVATION_BINDING_RE.fullmatch(received) else "unknown"
            self._failure("invalid-response-schema:" + label)
            return
        # The evidence-backed negative response is intentionally small and
        # does not repeat the positive adapter metadata.  It is an authority
        # refusal, not permission to inject, and therefore remains fail-closed.
        if response.get("ok") is False:
            error = response.get("error")
            next_action = response.get("next_action")
            if (
                not isinstance(error, str)
                or not PRESERVATION_BINDING_RE.fullmatch(error)
                or not isinstance(next_action, str)
                or not PRESERVATION_BINDING_RE.fullmatch(next_action)
            ):
                self._failure("invalid-authority-refusal")
            else:
                self._failure(error)
            return
        if (
            response.get("bridge_adapter") != PRESERVATION_BRIDGE_ADAPTER
            or response.get("bridge_protocol") != PRESERVATION_BRIDGE_PROTOCOL
        ):
            self._failure("invalid-bridge-contract")
            return
        if response.get("ok") is not True:
            self._failure("invalid-authority-status")
            return
        if response.get("pool_key") != config["pool_key"]:
            self._failure("non-authoritative-pool")
            return
        for key in ("decision", "next_action"):
            if not isinstance(response.get(key), str) or not PRESERVATION_BINDING_RE.fullmatch(response[key]):
                self._failure("invalid-response-decision")
                return
        for key in ("protection_enabled", "nudge_enabled", "generation_loaded"):
            if not isinstance(response.get(key), bool):
                self._failure("invalid-response-status")
                return
        for key in ("observation_age_seconds", "limiting_headroom_percent", "aggregate_reserve_percent"):
            value = response.get(key)
            if (
                isinstance(value, bool)
                or not isinstance(value, (int, float))
                or not math.isfinite(float(value))
                or float(value) < 0.0
                or (key != "observation_age_seconds" and float(value) > 100.0)
            ):
                self._failure("invalid-response-telemetry")
                return
        directive = response.get("directive")
        if directive is not None and (
            not isinstance(directive, dict)
            or set(directive) != {"request_id", "reservation_id"}
            or not all(
                isinstance(directive[key], str)
                and PRESERVATION_ID_RE.fullmatch(directive[key])
                for key in directive
            )
        ):
            self._failure("invalid-response-directive")
            return
        self.last_result = "accepted"
        self.last_error = ""
        self.last_decision = response["decision"]
        self.last_next_action = response["next_action"]
        self.last_observation_age = float(response["observation_age_seconds"])
        self.last_headroom = float(response["limiting_headroom_percent"])
        self.last_reserve = float(response["aggregate_reserve_percent"])
        self.last_protection_enabled = response["protection_enabled"]
        self.last_nudge_enabled = response["nudge_enabled"]
        self.last_generation_loaded = response["generation_loaded"]
        if directive is None:
            return
        owner = self.owner
        owner_result = owner._request_preservation({
            "kind": "control",
            "channel": owner.channel,
            "request_id": directive["request_id"],
            "reservation_id": directive["reservation_id"],
            "expected_session_id": owner.session_id,
            "expected_supervisor_pid": os.getpid(),
            "expected_epoch": owner.completed_turn_epoch,
        })
        if not isinstance(owner_result, dict) or not owner_result.get("ok"):
            self._failure(str(owner_result.get("error") if isinstance(owner_result, dict) else "owner-refused"))
            return
        self.last_result = "directive-delivered"

    @staticmethod
    def _run_bridge(
        config: dict[str, object], request: dict[str, object]
    ) -> tuple[str, object]:
        """Run only the external adapter; never access or mutate the owner."""
        try:
            result = subprocess.run(
                [
                    str(config["bridge"]), "owner-poll",
                    "--authority-host", str(config["authority_host"]),
                    "--expected-authority-hostname", str(config["authority_identity"]),
                    "--authority-executable", str(config["authority_executable"]),
                    "--authority-root", str(config["ledger_root"]),
                    "--telemetry-host", str(config["telemetry_host"]),
                    "--provider", str(config["provider"]),
                    "--account-hash", str(config["account_hash"]),
                    "--model-pool", str(config["model_pool"]),
                    "--authority-timeout", str(PRESERVATION_BRIDGE_TIMEOUT_SECONDS),
                ],
                input=json.dumps(request, sort_keys=True, separators=(",", ":")) + "\n",
                capture_output=True,
                text=True,
                check=False,
                timeout=PRESERVATION_BRIDGE_TIMEOUT_SECONDS,
            )
        except subprocess.TimeoutExpired:
            return "error", "bridge-timeout"
        except OSError:
            return "error", "bridge-unavailable"
        if result.returncode != 0:
            return "error", f"bridge-exit-{result.returncode}"
        if not isinstance(result.stdout, str):
            return "error", "invalid-bridge-response"
        if len(result.stdout.encode("utf-8")) > PRESERVATION_MAX_BYTES:
            return "error", "bridge-response-too-large"
        try:
            response = json.loads(result.stdout)
        except (TypeError, UnicodeError, ValueError, json.JSONDecodeError):
            return "error", "invalid-bridge-response"
        return "response", response

    @staticmethod
    def _bridge_worker(
        config: dict[str, object],
        request: dict[str, object],
        result_queue: queue.SimpleQueue,
    ) -> None:
        """Worker body is deliberately limited to adapter I/O and queue delivery."""
        result_queue.put(PreservationFederationClient._run_bridge(config, request))

    def poll(self) -> None:
        """Start or reap one bounded poll without blocking the native owner loop."""
        if self.bridge_thread is not None:
            if self.bridge_thread.is_alive():
                return
            self.bridge_thread.join(timeout=0)
            self.bridge_thread = None
            result_queue = self.bridge_result
            self.bridge_result = None
            if result_queue is None:
                self._failure("missing-bridge-result")
            else:
                try:
                    result_kind, result = result_queue.get_nowait()
                except queue.Empty:
                    self._failure("missing-bridge-result")
                else:
                    if result_kind == "error":
                        self._failure(str(result))
                    else:
                        self._accept_response(result)
            self.owner._write_state()
            return
        if not self.enabled or self.next_poll is None or monotonic() < self.next_poll:
            return
        self.next_poll = monotonic() + PRESERVATION_POLL_SECONDS
        owner = self.owner
        native_reconciliation = (
            owner.preservation_state == "native_completed"
            and self.last_result == "directive-delivered"
        )
        if (
            not owner.session_id
            or owner.status not in {"idle", "active"}
            or not child_alive(owner.pid)
            or not (
                owner.dirty
                or owner.preservation_state in {"native_started", "pending_recovery"}
                or native_reconciliation
            )
        ):
            self.last_result = "not-eligible"
            return
        self.last_poll_at = now()
        result_queue = queue.SimpleQueue()
        self.bridge_result = result_queue
        self.bridge_thread = threading.Thread(
            target=self._bridge_worker,
            args=(self.config, self._request(), result_queue),
            name="claude-warm-preservation-bridge",
            daemon=True,
        )
        try:
            self.bridge_thread.start()
        except RuntimeError:
            self.bridge_thread = None
            self.bridge_result = None
            self._failure("bridge-thread-start-failed")
            owner._write_state()


class Supervisor:
    """Own one Claude PTY, lifecycle socket, state file, and idle timer."""

    def __init__(self, argv: list[str], executable: str):
        self.argv = argv
        self.executable = executable
        self.development_channel_opt_ins = accepted_development_channels()
        self.development_channel_prompt_matcher = DevelopmentChannelPromptMatcher(
            self.development_channel_opt_ins
        )
        self.development_channel_accept_deadline: float | None = None
        self.accepted_development_channels: tuple[str, ...] = ()
        self.development_channel_accepted_at: float | None = None
        self.development_channel_acceptance_closed_reason: str | None = (
            None if self.development_channel_opt_ins else "not-configured"
        )
        self.channel_specs = tuple(channel_arguments(argv))
        self.watched_servers = watched_server_names(argv)
        self.channel_process_patterns = channel_process_patterns()
        self.channel = "claude-" + uuid.uuid4().hex
        self.root = runtime_root()
        self.session_dir = self.root / self.channel
        safe_mkdir(self.session_dir)
        self.state_root = persistent_state_root()
        self.guard_log_path = self.state_root / f"{self.channel}.channel-guard.log"
        self.debug_log_path = self.state_root / f"{self.channel}.claude-debug.log"
        self.socket_path = self.session_dir / "control.sock"
        self.state_path = self.session_dir / "state.json"
        self.snapshot_path = self.session_dir / "status.json"
        self.socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.socket.bind(str(self.socket_path))
        os.chmod(self.socket_path, 0o600)
        self.socket.listen(8)
        self.socket.setblocking(False)
        self.selector = selectors.DefaultSelector()
        self.selector.register(self.socket, selectors.EVENT_READ, "server")
        self.next_socket_check = 0.0
        self.pid: int | None = None
        self.master_fd: int | None = None
        self.child_tty: str | None = None
        self.child_status: int | None = None
        self.stdin_eof = False
        self.terminal_attributes = None
        self.stdin_flags: int | None = None
        self.session_id: str | None = None
        self.transcript_path: pathlib.Path | None = None
        # Pinned at the first transcript bind; session-start events whose
        # transcript lives in another project directory are foreign (nested
        # one-shot claudes inheriting this supervisor's control-socket env)
        # and must never rebind the governor (2026-08-20 overnight no-compact).
        self.transcript_project_dir: pathlib.Path | None = None
        self.transcript_baseline: tuple[int, int] | None = None
        self.transcript_inode: int | None = None
        self.transcript_offset = 0
        self.transcript_partial = b""
        self.transcript_activity_at: float | None = None
        self.transcript_quiescence_at: float | None = None
        self.transcript_quiescence_deadline: float | None = None
        self.transcript_gate_blocked = False
        self.transcript_gate_blocked_at: float | None = None
        self.last_transcript_classification: str | None = None
        self.inotify: Inotify | None = None
        self.status = "starting"
        self.enabled = True
        self.dirty = False
        self.compacting = False
        self.compaction_requested_at: float | None = None
        self.compaction_ignore_next_stop = False
        self.rearm_count = 0
        self.last_rearm_reason: str | None = None
        self.current_tokens: int | None = None
        self.current_model: str | None = None
        self.post_compact_baseline_tokens: int | None = None
        self.post_compact_baseline_at: float | None = None
        self.status_timestamp: float | None = None
        self.completed_turn_epoch = 0
        self.status_snapshot_epoch: int | None = None
        self.last_normal_stop: float | None = None
        self.last_local_input: float | None = None
        self.last_local_input_classification: str | None = None
        self.last_terminal_input_log_at = 0.0
        self.last_terminal_input_log_key: str | None = None
        self.last_lifecycle_activity: float | None = None
        self.input_classifier = TerminalInputClassifier()
        self.cache_profile_requested = os.environ.get("CLAUDE_IDLE_CACHE_PROFILE", "auto")
        self.cache_profile = effective_profile(self.cache_profile_requested)
        self.cache_idle_seconds = IDLE_SECONDS[self.cache_profile]
        self.cache_ttl_seconds = TTL_SECONDS[self.cache_profile]
        self.cache_policy = {"mode": "fallback", "reason": "startup"}
        self.timer_deadline: float | None = None
        self.timer_kind: str | None = None
        self.timer_generation = 0
        self.last_cancellation_reason: str | None = None
        self.last_gate_rejection_reason: str | None = None
        self.last_injection_result: str | None = None
        self.last_state_transition = "supervisor-started"
        self.preservation_request_id: str | None = None
        self.preservation_reservation_id: str | None = None
        self.preservation_state: str | None = None
        self.preservation_failure: str | None = None
        self.preservation_expected_epoch: int | None = None
        self.last_channel_activity: float | None = None
        self.last_channel_event: str | None = None
        self.last_channel_death: float | None = None
        self.channel_marker_seen = False
        self.channel_turn_seen = False
        self.channel_attach_checked = not bool(self.watched_servers)
        self.channel_attach_deadline = (
            monotonic() + CHANNEL_ATTACH_WAIT_SECONDS if self.watched_servers else None
        )
        self.channel_health = "none" if not self.watched_servers else "reconnecting"
        self.recovery_pending = False
        self.recovery_awaiting = False
        self.recovery_command_inflight = False
        self.recovery_expected_stop = False
        self.recovery_ignore_next_stop = False
        self.recovery_attempts = 0
        self.recovery_reload_attempted = False
        self.recovery_generation = 0
        self.recovery_command = self._default_recovery_command()
        self.next_debug_bound = monotonic() + 5
        self.shutdown_requested = False
        self.child_exited_at: float | None = None
        self.next_transcript_poll = monotonic() + TRANSCRIPT_POLL_SECONDS
        self.herdr = HerdrReporter()
        self.screen_classifier = ClaudeScreenClassifier()
        self.screen_state: str | None = None
        self.preservation_federation = PreservationFederationClient(self)
        self.lifecycle_health = "pending"
        self.lifecycle_deadline = monotonic() + LIFECYCLE_WAIT_SECONDS
        self.lifecycle_alarm_path = self.state_root / f"{self.channel}.LIFECYCLE-HOOKS-MISSING"
        self._guard_log("supervisor-started")
        self._write_state()

    def _default_recovery_command(self) -> str | None:
        """Return the source-backed/default reconnect command, if configured."""
        configured = os.environ.get("CLAUDE_IDLE_RECONNECT_SERVER", "").strip()
        server = configured or (self.watched_servers[1] if len(self.watched_servers) > 1 else (self.watched_servers[0] if self.watched_servers else ""))
        if not server or not re.fullmatch(r"[A-Za-z0-9_.:-]{1,128}", server):
            return None
        return f"/mcp reconnect {server}"

    def state(self) -> dict:
        """Return safe persisted state for controls and diagnostics."""
        installed_generation = executable_generation()
        return {
            "channel": self.channel,
            "pid": self.pid,
            "supervisor_pid": os.getpid(),
            "loaded_generation": LOADED_GENERATION,
            "installed_generation": installed_generation,
            "generation_loaded": LOADED_GENERATION == installed_generation,
            "pty_master_owned": self.master_fd is not None,
            "pty_master_fd": self.master_fd,
            "pty_child_terminal": self.child_tty,
            "control_socket": str(self.socket_path),
            "session_id": self.session_id,
            "transcript_path": str(self.transcript_path) if self.transcript_path else None,
            "transcript_project_dir": (
                str(self.transcript_project_dir) if self.transcript_project_dir else None
            ),
            "channel_specs": list(self.channel_specs),
            "development_channel_accept_opt_ins": list(
                self.development_channel_opt_ins
            ),
            "development_channel_accept_window_seconds": (
                DEVELOPMENT_CHANNEL_ACCEPT_WINDOW_SECONDS
            ),
            "development_channel_accept_deadline": (
                self.development_channel_accept_deadline
            ),
            "accepted_development_channels": list(
                self.accepted_development_channels
            ),
            "development_channel_accepted_at": (
                self.development_channel_accepted_at
            ),
            "development_channel_acceptance_closed_reason": (
                self.development_channel_acceptance_closed_reason
            ),
            "watched_servers": list(self.watched_servers),
            "channel_health": self.channel_health,
            "channel_marker_seen": self.channel_marker_seen,
            "channel_turn_seen": self.channel_turn_seen,
            "channel_attach_checked": self.channel_attach_checked,
            "channel_attach_deadline": self.channel_attach_deadline,
            "lifecycle_health": self.lifecycle_health,
            "channel_recovery_pending": self.recovery_pending,
            "channel_recovery_awaiting": self.recovery_awaiting,
            "channel_recovery_ignore_next_stop": self.recovery_ignore_next_stop,
            "channel_recovery_attempts": self.recovery_attempts,
            "channel_recovery_reload_attempted": self.recovery_reload_attempted,
            "channel_reconnect_command": self.recovery_command,
            "channel_guard_log": str(self.guard_log_path),
            "channel_debug_log": str(self.debug_log_path) if self.watched_servers else None,
            "status": self.status,
            "current_input_context_tokens": self.current_tokens,
            "current_model": self.current_model,
            "post_compact_baseline_tokens": self.post_compact_baseline_tokens,
            "post_compact_baseline_at": self.post_compact_baseline_at,
            "unpreserved_context_tokens": (
                None if self.current_tokens is None else max(
                    0,
                    self.current_tokens - (self.post_compact_baseline_tokens or 0),
                )
            ),
            "status_snapshot_timestamp": self.status_timestamp,
            "completed_turn_epoch": self.completed_turn_epoch,
            "status_snapshot_epoch": self.status_snapshot_epoch,
            "dirty": self.dirty,
            "compacting": self.compacting,
            "compaction_ignore_next_stop": self.compaction_ignore_next_stop,
            "rearm_count": self.rearm_count,
            "last_rearm_reason": self.last_rearm_reason,
            "idle_anchor": self._idle_anchor(),
            "last_normal_stop": self.last_normal_stop,
            "transcript_quiescence_at": self.transcript_quiescence_at,
            "transcript_quiescence_deadline": self.transcript_quiescence_deadline,
            "transcript_gate_blocked": self.transcript_gate_blocked,
            "transcript_gate_blocked_at": self.transcript_gate_blocked_at,
            "last_transcript_classification": self.last_transcript_classification,
            "last_local_input": self.last_local_input,
            "last_local_input_classification": self.last_local_input_classification,
            "last_lifecycle_activity": self.last_lifecycle_activity,
            "cache_profile": self.cache_profile,
            "cache_profile_requested": self.cache_profile_requested,
            "cache_policy": self.cache_policy,
            "timer_deadline": self.timer_deadline,
            "timer_kind": self.timer_kind,
            "timer_generation": self.timer_generation,
            "last_cancellation_reason": self.last_cancellation_reason,
            "last_gate_rejection_reason": self.last_gate_rejection_reason,
            "last_injection_result": self.last_injection_result,
            "last_state_transition": self.last_state_transition,
            "preservation_request_id": self.preservation_request_id,
            "preservation_reservation_id": self.preservation_reservation_id,
            "preservation_state": self.preservation_state,
            "preservation_failure": self.preservation_failure,
            "preservation_expected_epoch": self.preservation_expected_epoch,
            **self.preservation_federation.state(),
            "last_channel_activity": self.last_channel_activity,
            "last_channel_event": self.last_channel_event,
            "last_channel_death": self.last_channel_death,
            "herdr_screen_state": self.screen_state,
            **self.herdr.state(),
        }

    def _guard_log(self, event: str, **fields: object) -> None:
        """Append one safe, durable channel-guard observation."""
        if not self.watched_servers and not self.development_channel_opt_ins:
            return
        payload = {
            "timestamp": now(),
            "event": event,
            "channel": short_id(self.channel),
            "health": self.channel_health,
            **fields,
        }
        try:
            with self.guard_log_path.open("a", encoding="utf-8") as stream:
                stream.write(json.dumps(payload, sort_keys=True, separators=(",", ":")) + "\n")
            os.chmod(self.guard_log_path, 0o600)
        except OSError as error:
            self._debug(f"channel-log-write-failed channel={short_id(self.channel)} error={error}")

    def _debug(self, message: str) -> None:
        """Write debug output only to this session's private file."""
        append_debug(self.debug_log_path, message)

    def _notice(self, message: str) -> None:
        """Record a fixed diagnostic without writing into the foreground TUI."""
        self._debug(f"notice channel={short_id(self.channel)} message={message}")
        self._guard_log("notice", message=message)

    def _bound_debug_log(self) -> None:
        """Keep the optional Claude debug capture bounded for long-running bots."""
        if not self.watched_servers:
            return
        try:
            size = self.debug_log_path.stat().st_size
            if size <= DEBUG_LOG_MAX_BYTES:
                return
            with self.debug_log_path.open("rb") as stream:
                stream.seek(-DEBUG_LOG_MAX_BYTES, os.SEEK_END)
                tail = stream.read()
            with self.debug_log_path.open("wb") as stream:
                stream.write(tail)
            self._guard_log("debug-log-trimmed", bytes=DEBUG_LOG_MAX_BYTES)
        except OSError:
            pass

    def _write_state(self) -> None:
        """Persist the current state atomically."""
        try:
            atomic_json(self.state_path, self.state())
        except OSError as error:
            self._debug(f"state-write-failed channel={short_id(self.channel)} error={error}")

    def _record_last_session(self, event: str) -> None:
        """Remember the latest session id outside the runtime dir, so a bot that has
        exited can still be resumed by name (nurse-joy) after this dir is removed.
        Written per channel and, when a herdr label names the bot, per label."""
        if not self.session_id:
            return
        payload = {
            "session_id": self.session_id,
            "channel": self.channel,
            "agent": self.herdr.agent,
            "supervisor_pid": os.getpid(),
            "pid": self.pid,
            "cwd": os.getcwd(),
            "argv": list(self.argv),
            "event": event,
            "recorded_at": time.time(),
        }
        targets = [self.state_root / f"{self.channel}.last-session.json"]
        if self.herdr.agent:
            targets.append(self.state_root / f"last-session.{self.herdr.agent.replace(' ', '-')}.json")
        for target in targets:
            try:
                atomic_json(target, payload)
                os.chmod(target, 0o600)
            except OSError as error:
                self._debug(f"last-session-write-failed channel={short_id(self.channel)} error={error}")

    def _register_herdr(self) -> None:
        """Refresh Herdr identity without allowing lifecycle hooks to set state."""
        self.herdr.register(self.session_id)
        self._write_state()

    def _report_screen_state(self, state: str) -> None:
        """Mirror a state classified from the proxied Claude screen."""
        self.screen_state = state
        self.herdr.report_state(state, self.session_id)
        self._write_state()

    def _close_development_channel_acceptance(self, reason: str) -> None:
        """Permanently close this launch's one-shot startup confirmer."""
        if (
            self.accepted_development_channels
            or self.development_channel_acceptance_closed_reason is not None
        ):
            return
        self.development_channel_acceptance_closed_reason = reason
        self._write_state()

    def _expire_development_channel_acceptance(self) -> None:
        """Close the confirmer when its monotonic startup window expires."""
        if (
            self.development_channel_accept_deadline is not None
            and monotonic() >= self.development_channel_accept_deadline
        ):
            self._close_development_channel_acceptance("startup-window-expired")

    def _maybe_accept_development_channel_prompt(self, data: bytes) -> None:
        """Press Enter once for one complete, exact, opted-in startup dialog."""
        if (
            self.development_channel_acceptance_closed_reason is not None
            or self.accepted_development_channels
            or self.development_channel_accept_deadline is None
        ):
            return
        if monotonic() >= self.development_channel_accept_deadline:
            self._close_development_channel_acceptance("startup-window-expired")
            return
        prompted = self.development_channel_prompt_matcher.feed(data)
        if prompted is None:
            return
        if self.master_fd is None:
            self._close_development_channel_acceptance("pty-master-unavailable")
            return
        try:
            write_all(self.master_fd, b"\r")
        except OSError:
            self._close_development_channel_acceptance("pty-write-failed")
            return
        self.accepted_development_channels = prompted
        self.development_channel_accepted_at = now()
        self.development_channel_acceptance_closed_reason = "accepted"
        self._guard_log(
            "development-channel-accepted",
            channels=list(prompted),
        )
        self._write_state()

    def cancel(self, reason: str) -> None:
        """Invalidate the one-shot timer and retain the cancellation reason."""
        self.timer_deadline = None
        self.timer_kind = None
        self.transcript_quiescence_deadline = None
        self.timer_generation += 1
        self.last_cancellation_reason = reason
        self.last_state_transition = f"cancelled:{reason}"
        self._debug(f"cancelled:{reason} channel={short_id(self.channel)}")
        self._guard_log("cancelled", reason=reason)
        self._write_state()

    def arm(self) -> None:
        """Arm exactly one timer after a valid ordinary Stop event."""
        if not (
            self.enabled
            and self.dirty
            and self.status == "idle"
            and not self.compacting
            and self.last_normal_stop
            and child_alive(self.pid)
            and self.timer_deadline is None
            and self.transcript_quiescence_deadline is None
            and not self.recovery_pending
        ):
            return
        _, snapshot_error = self._read_snapshot()
        self.cache_idle_seconds, self.cache_ttl_seconds, self.cache_policy = measured_cache_window(
            self.current_model if snapshot_error is None else None, self.cache_profile
        )
        self.timer_generation += 1
        self.timer_deadline = self.last_normal_stop + self.cache_idle_seconds
        self.timer_kind = "compact"
        self.last_state_transition = "armed"
        self._debug(
            f"armed channel={short_id(self.channel)} profile={self.cache_profile} "
            f"delay={self.cache_idle_seconds} policy={self.cache_policy.get('mode')}"
        )
        self._guard_log(
            "armed",
            kind="compact",
            profile=self.cache_profile,
            delay=self.cache_idle_seconds,
            cache_expires=self.cache_ttl_seconds,
            policy_mode=self.cache_policy.get("mode"),
            policy_reason=self.cache_policy.get("reason"),
            policy_confidence=self.cache_policy.get("confidence"),
            policy_source_harness=self.cache_policy.get("source_harness"),
            policy_provider=self.cache_policy.get("provider"),
            policy_endpoint=self.cache_policy.get("endpoint_id"),
            policy_model=self.cache_policy.get("model"),
            policy_observed_at=self.cache_policy.get("observed_at"),
            policy_sample_count=self.cache_policy.get("sample_count"),
            policy_session_count=self.cache_policy.get("session_count"),
        )
        self._write_state()

    def _refresh_cache_policy_for_action(self) -> bool:
        """Refresh endpoint evidence before an automatic compaction fires.

        A policy can be regenerated, expire, or resolve to a different model
        while a timer is sleeping.  Refreshing only when the timer arms would
        let that stale decision trigger a compaction too early.  Return false
        after re-arming to the newly resolved deadline; manual injections do
        not pass through this method.
        """
        # The snapshot is also the authoritative source for a mid-session
        # model change.  Its validation remains in the final gate below.
        _, snapshot_error = self._read_snapshot()
        previous = self.cache_policy
        self.cache_idle_seconds, self.cache_ttl_seconds, self.cache_policy = measured_cache_window(
            self.current_model if snapshot_error is None else None, self.cache_profile
        )
        anchor = self._idle_anchor()
        refreshed_deadline = (
            anchor + self.cache_idle_seconds if anchor is not None else None
        )
        fields = {
            "profile": self.cache_profile,
            "delay": self.cache_idle_seconds,
            "cache_expires": self.cache_ttl_seconds,
            "previous_mode": previous.get("mode"),
            "policy_mode": self.cache_policy.get("mode"),
            "policy_reason": self.cache_policy.get("reason"),
            "policy_confidence": self.cache_policy.get("confidence"),
            "policy_source_harness": self.cache_policy.get("source_harness"),
            "policy_provider": self.cache_policy.get("provider"),
            "policy_endpoint": self.cache_policy.get("endpoint_id"),
            "policy_model": self.cache_policy.get("model"),
            "policy_observed_at": self.cache_policy.get("observed_at"),
            "policy_sample_count": self.cache_policy.get("sample_count"),
            "policy_session_count": self.cache_policy.get("session_count"),
        }
        if refreshed_deadline is not None and refreshed_deadline > now():
            self.timer_generation += 1
            self.timer_deadline = refreshed_deadline
            self.timer_kind = "compact"
            self.last_state_transition = "policy-refreshed-rearmed"
            self._guard_log("policy-refreshed-rearmed", **fields)
            self._write_state()
            return False
        self._guard_log("policy-refreshed-for-action", **fields)
        self._write_state()
        return True

    def _idle_anchor(self) -> float | None:
        """Return the most recent activity of any kind that moves the idle window."""
        candidates = [
            value
            for value in (
                self.last_normal_stop,
                self.last_local_input,
                self.last_lifecycle_activity,
                self.transcript_activity_at,
            )
            if value
        ]
        return max(candidates) if candidates else None

    def _idle_window_open(self) -> bool:
        """True while any activity is younger than the idle threshold."""
        anchor = self._idle_anchor()
        return anchor is not None and now() - anchor < self.cache_idle_seconds

    def rearm(self, reason: str) -> None:
        """Re-arm the compaction timer after a transient cancellation or refusal.

        The one-shot timer used to die with its first cancellation and only a
        new Stop could revive it, so a stray keystroke, a mid-turn hook event,
        or one failed PTY probe left a session uncompacted all night
        (2026-08-20/21, Fable and Opus).  Durable rule: the timer fires
        IDLE_SECONDS after the most recent activity of any kind, and a
        transient refusal retries after COMPACT_RETRY_SECONDS.  A live turn
        (status active) is not a reason to stay dormant: an injected /compact
        queues behind the running turn and never kills a background process.
        """
        if not (
            self.enabled
            and self.dirty
            and self.status in {"idle", "active"}
            and not self.compacting
            and child_alive(self.pid)
            and self.timer_deadline is None
            and not self.recovery_pending
        ):
            return
        anchor = self._idle_anchor()
        delay = float(COMPACT_RETRY_SECONDS)
        if anchor is not None:
            delay = max(delay, anchor + self.cache_idle_seconds - now())
        self.timer_generation += 1
        self.timer_deadline = now() + delay
        self.timer_kind = "compact"
        self.rearm_count += 1
        self.last_rearm_reason = reason
        self.last_state_transition = f"rearmed:{reason}"
        self._debug(
            f"rearmed channel={short_id(self.channel)} reason={reason} delay={int(delay)}"
        )
        self._guard_log(
            "rearmed",
            kind="compact",
            reason=reason,
            profile=self.cache_profile,
            delay=int(delay),
            rearm_count=self.rearm_count,
        )
        self._write_state()

    def _defer_for_activity(self, reason: str) -> None:
        """Move the idle window for repeated activity of one kind.

        The first keystroke or hook event after arming is a documented
        cancellation (one `cancelled:<reason>' plus one `rearmed').  Every
        further event of the same kind while that re-armed timer is pending
        only slides the deadline quietly, so typing a prompt or a tool-heavy
        turn does not emit a log line per byte.
        """
        if (
            self.timer_deadline is not None
            and self.timer_kind == "compact"
            and self.last_rearm_reason == reason
        ):
            anchor = self._idle_anchor()
            if anchor is not None:
                self.timer_deadline = max(
                    self.timer_deadline, anchor + self.cache_idle_seconds
                )
            self._write_state()
            return
        self.cancel(reason)
        self.rearm(reason)

    def _begin_transcript_quiescence(self) -> None:
        """Allow the completed turn's final transcript records to settle."""
        self.transcript_quiescence_at = None
        self.transcript_quiescence_deadline = now() + TRANSCRIPT_QUIESCENCE_SECONDS
        self.last_state_transition = "transcript-quiescence-wait"
        self._guard_log(
            "transcript-quiescence-wait",
            seconds=TRANSCRIPT_QUIESCENCE_SECONDS,
            completed_turn_epoch=self.completed_turn_epoch,
        )
        self._write_state()

    def _complete_transcript_quiescence(self) -> None:
        """Establish a stable idle point and then arm the compaction timer."""
        if self.transcript_quiescence_deadline is None:
            return
        self.transcript_quiescence_deadline = None
        self.transcript_quiescence_at = now()
        self.last_state_transition = "transcript-quiescent"
        self._guard_log(
            "transcript-quiescent",
            completed_turn_epoch=self.completed_turn_epoch,
        )
        if self.preservation_state == "requested":
            self.attempt(command="/compact", purpose="compact")
        if self.recovery_pending:
            self._arm_recovery()
        else:
            self.arm()
        self._write_state()

    def _record_completed_turn_flush(self) -> None:
        """Extend quiescence for an assistant record belonging to the Stop turn."""
        if self.transcript_quiescence_deadline is None:
            return
        self.transcript_quiescence_deadline = now() + TRANSCRIPT_QUIESCENCE_SECONDS
        self.transcript_quiescence_at = None
        self.last_state_transition = "transcript-final-flush"
        self._guard_log(
            "transcript-final-flush",
            completed_turn_epoch=self.completed_turn_epoch,
        )
        self._write_state()

    def _record_transcript_observation(
        self,
        classification: str,
        *,
        gate_blocked: bool = False,
        record_type: str | None = None,
        record_subtype: str | None = None,
    ) -> None:
        """Persist a prompt-free transcript classification and gate uncertainty."""
        self.last_transcript_classification = classification
        fields: dict[str, object] = {
            "classification": classification,
            "action": "gate-blocked" if gate_blocked else "no-cancellation",
        }
        # These are bounded schema labels only; never persist transcript
        # content, identifiers, or message metadata in the guard log.
        if isinstance(record_type, str) and re.fullmatch(r"[A-Za-z0-9_.:-]{1,64}", record_type):
            fields["record_type"] = record_type
        if isinstance(record_subtype, str) and re.fullmatch(r"[A-Za-z0-9_.:-]{1,128}", record_subtype):
            fields["record_subtype"] = record_subtype
        if gate_blocked:
            self.transcript_gate_blocked = True
            self.transcript_gate_blocked_at = now()
            self.last_state_transition = "transcript-uncertain"
            self._guard_log("transcript-record-unknown", **fields)
        else:
            self._guard_log("transcript-record-ignored", **fields)
        self._write_state()

    def _ensure_control_socket(self) -> None:
        """Resurrect the control socket if its path vanished from disk.

        elogind removes $XDG_RUNTIME_DIR when the user's last login session
        ends (observed 2026-08-29 13:20 on kikin-kushi): the listener fd
        survives in-process but hook clients get ENOENT, so Stops,
        SessionStarts, and the compaction plumbing all go silent while the
        governor believes itself healthy — the latch that only a Stop could
        clear then vetoes compaction forever.  A throttled stat detects the
        loss; rebinding restores the hook path and the state/snapshot writes
        that share the directory.  `loginctl enable-linger` prevents the
        removal at the source; this guard makes the governor self-heal the
        moment the runtime root returns either way.
        """
        current = monotonic()
        if current < self.next_socket_check:
            return
        self.next_socket_check = current + 5.0
        try:
            if self.socket_path.is_socket():
                return
        except OSError:
            pass
        try:
            self.selector.unregister(self.socket)
        except (KeyError, ValueError):
            pass
        try:
            self.socket.close()
        except OSError:
            pass
        try:
            safe_mkdir(self.session_dir)
            self.socket_path.unlink(missing_ok=True)
            self.socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            self.socket.bind(str(self.socket_path))
            os.chmod(self.socket_path, 0o600)
            self.socket.listen(8)
            self.socket.setblocking(False)
            self.selector.register(self.socket, selectors.EVENT_READ, "server")
            self._guard_log("control-socket-rebound")
            self._write_state()
        except OSError as error:
            # The runtime root itself may still be gone (/run/user/<uid> is
            # root-owned); keep trying every throttle tick and heal the
            # instant a login or linger recreates it.
            self._guard_log("control-socket-rebind-failed", error=str(error)[:200])

    def _arm_recovery(self, delay: int | None = None) -> None:
        """Arm the shared one-shot timer for one bounded channel recovery step."""
        if not self.recovery_pending or self.compacting or not child_alive(self.pid):
            return
        self.timer_generation += 1
        self.timer_kind = "channel-recovery"
        self.timer_deadline = now() + (
            CHANNEL_RECOVERY_COOLDOWN_SECONDS if delay is None else max(0, delay)
        )
        self._guard_log(
            "armed",
            kind="channel-recovery",
            delay=(CHANNEL_RECOVERY_COOLDOWN_SECONDS if delay is None else max(0, delay)),
            recovery_generation=self.recovery_generation,
        )
        self._write_state()

    def _same_project_transcript(self, value: object) -> bool:
        """True when a session-start's transcript lives in the bound project.

        Nested one-shot claudes run from another working directory (the
        classifier cds to /tmp by law), so their transcripts land in another
        ~/.claude/projects/<slug>/ directory.  A session-start that cannot
        present a transcript inside the pinned project directory is foreign
        and must not rebind the governor.  Fails closed on a missing path:
        every legitimate SessionStart carries transcript_path.
        """
        if self.transcript_project_dir is None:
            return True
        if not isinstance(value, str) or not value or len(value) > 4096:
            return False
        try:
            parent = pathlib.Path(value).expanduser().parent
        except (OSError, ValueError):
            return False
        return parent == self.transcript_project_dir

    def _set_transcript(self, value: object) -> None:
        """Bind and watch a validated Claude transcript path."""
        if not isinstance(value, str) or not value or len(value) > 4096:
            return
        path = pathlib.Path(value).expanduser()
        self.transcript_path = path
        if self.transcript_project_dir is None:
            self.transcript_project_dir = path.parent
        self._reset_transcript_cursor()
        if self.inotify:
            self.inotify.close()
            self.inotify = None
        try:
            self.inotify = Inotify(path.parent)
            self.selector.register(self.inotify.fd, selectors.EVENT_READ, "inotify")
        except Exception:
            self.inotify = None
            self._debug(f"transcript-watcher=fallback channel={short_id(self.channel)}")
        self._write_state()

    def _reset_transcript_cursor(self) -> None:
        """Start tailing at the current end, never replaying old prompt data."""
        if not self.transcript_path:
            self.transcript_baseline = None
            self.transcript_inode = None
            self.transcript_offset = 0
            self.transcript_partial = b""
            return
        try:
            stat = self.transcript_path.stat()
            self.transcript_baseline = (stat.st_mtime_ns, stat.st_size)
            self.transcript_inode = stat.st_ino
            self.transcript_offset = stat.st_size
            self.transcript_partial = b""
        except OSError:
            self.transcript_baseline = None
            self.transcript_inode = None
            self.transcript_offset = 0
            self.transcript_partial = b""

    def _compaction_failed(self, reason: str) -> None:
        """Clear an asynchronous compaction failure without making it dirty twice."""
        if not self.compacting:
            return
        self.compacting = False
        self.compaction_requested_at = None
        self.compaction_ignore_next_stop = True
        self.dirty = True
        self.last_cancellation_reason = "compaction-failed"
        self.last_injection_result = "failed"
        self.last_state_transition = "compaction-failed"
        self._debug(
            f"compaction-failed channel={short_id(self.channel)} reason={reason}"
        )
        self._guard_log("compaction-failed", reason=reason)
        if self.preservation_state == "native_started":
            self.preservation_state = "pending_recovery"
            self.preservation_failure = reason
            self._save_preservation()
            self._guard_log(
                "preservation-pending-recovery", request_id=self.preservation_request_id, reason=reason
            )
        self._write_state()

    def _is_failed_compaction_entry(self, entry: dict) -> bool:
        """Recognize only Claude's observed fixed marker for rejected /compact."""
        if not self.compacting:
            return False
        if entry.get("type") != "system" or entry.get("subtype") != "local_command":
            return False
        content = entry.get("content")
        if not isinstance(content, str):
            return False
        lowered = content.lower()
        if COMPACTION_FAILURE_MARKER not in lowered:
            return False
        entry_timestamp = transcript_entry_timestamp(entry)
        return not (
            self.compaction_requested_at
            and entry_timestamp is not None
            and entry_timestamp <= self.compaction_requested_at
        )

    def _abort_recovery(self, reason: str) -> None:
        """Stop a pending recovery after activity that is not the death marker."""
        if self.recovery_pending:
            self.recovery_pending = False
            self.recovery_awaiting = False
            self.recovery_command_inflight = False
            self.recovery_expected_stop = False
            self._guard_log("recovery-aborted", reason=reason)
        self.cancel(reason)

    def _watched_names(self, value: object) -> set[str]:
        """Validate one attachment-name list without retaining untrusted text."""
        if not isinstance(value, list):
            return set()
        return {
            item
            for item in value
            if isinstance(item, str)
            and re.fullmatch(r"[A-Za-z0-9_.:-]{1,160}", item)
        }

    def _start_channel_recovery(self, removed: set[str]) -> None:
        """Create one recovery generation for a newly observed channel death."""
        watched_removed = sorted(removed.intersection(self.watched_servers))
        if not watched_removed:
            return
        if self.recovery_pending:
            self._guard_log("channel-death-duplicate", servers=watched_removed)
            return
        current = now()
        self.channel_health = "reconnecting"
        self.last_channel_activity = current
        self.last_channel_event = "removed"
        self.last_channel_death = current
        self.recovery_pending = True
        self.recovery_awaiting = False
        self.recovery_command_inflight = False
        self.recovery_expected_stop = False
        self.recovery_ignore_next_stop = False
        self.recovery_attempts = 0
        self.recovery_reload_attempted = False
        self.recovery_generation += 1
        self.transcript_activity_at = current
        self.cancel("channel-death")
        self._guard_log(
            "channel-dead",
            servers=watched_removed,
            recovery_generation=self.recovery_generation,
        )
        self._notice("channel server disappeared; recovery is waiting for an idle turn")
        if self.status == "idle" and self.last_normal_stop:
            self._arm_recovery()
        self._write_state()

    def _complete_channel_recovery(self, source: str) -> None:
        """Mark the current death generation recovered after a watched add delta."""
        if not self.recovery_pending:
            return
        self.recovery_pending = False
        self.recovery_awaiting = False
        self.recovery_command_inflight = False
        # The attachment may confirm before Claude emits Stop for the slash
        # command.  Consume that one completion without making it a dirty
        # ordinary turn or arming the idle-compaction timer.
        self.recovery_expected_stop = False
        self.recovery_ignore_next_stop = True
        self.channel_health = "attached"
        self.last_channel_event = "added"
        self.cancel("channel-reconnected")
        self._guard_log("channel-recovered", source=source)
        self._notice("channel server reattached")
        self._write_state()

    def _handle_attachment_delta(self, attachment: dict) -> None:
        """Handle Claude's undocumented-but-observed attachment delta shape."""
        added = self._watched_names(attachment.get(CHANNEL_ATTACH_MARKER))
        removed = self._watched_names(attachment.get(CHANNEL_DEATH_MARKER))
        watched_added = sorted(added.intersection(self.watched_servers))
        watched_removed = sorted(removed.intersection(self.watched_servers))
        if not watched_added and not watched_removed:
            return
        self.channel_turn_seen = True
        if watched_added:
            self.last_channel_activity = now()
            self.channel_marker_seen = True
            self.last_channel_event = "added"
            self.channel_health = "attached"
            self.channel_attach_checked = True
            self._guard_log("channel-attached-marker", servers=watched_added)
            if self.recovery_pending and self.recovery_awaiting:
                self._complete_channel_recovery("attachment-added")
        if watched_removed:
            if self.recovery_pending:
                self._guard_log("channel-death-duplicate", servers=watched_removed)
            else:
                self.last_channel_activity = now()
                self.last_channel_event = "removed"
                self._start_channel_recovery(set(watched_removed))
        self._write_state()

    def _tail_transcript(self) -> None:
        """Parse only complete new JSONL lines, retaining a partial tail safely."""
        if not self.transcript_path:
            return
        try:
            stat = self.transcript_path.stat()
            if self.transcript_inode != stat.st_ino or stat.st_size < self.transcript_offset:
                self.transcript_offset = 0
                self.transcript_partial = b""
                self.transcript_inode = stat.st_ino
            with self.transcript_path.open("rb") as stream:
                stream.seek(self.transcript_offset)
                chunk = stream.read()
            self.transcript_offset += len(chunk)
        except OSError:
            return
        if not chunk:
            return
        data = self.transcript_partial + chunk
        lines = data.split(b"\n")
        self.transcript_partial = lines.pop()
        for raw_line in lines:
            if not raw_line.strip():
                continue
            try:
                entry = json.loads(raw_line.decode("utf-8"))
            except (UnicodeError, ValueError):
                self._record_transcript_observation("malformed-json", gate_blocked=True)
                continue
            if not isinstance(entry, dict):
                self._record_transcript_observation("unknown", gate_blocked=True)
                continue
            # The cursor was reset to the transcript end at Stop, so every
            # complete line read here was appended after that lifecycle
            # boundary.  Do not discard same-second user/channel records
            # merely because Claude's embedded timestamp is coarse.
            if entry.get("type") == "attachment" and isinstance(entry.get("attachment"), dict):
                self._handle_attachment_delta(entry["attachment"])
                self._record_transcript_observation("internal-attachment")
                continue
            # A compacting session is expected to append system/boundary lines.
            # PostCompact clears the governor state; these lines must not look
            # like a remote Telegram turn in the meantime.
            if self.compacting:
                if self._is_failed_compaction_entry(entry):
                    self._compaction_failed("transcript-rejected")
                self._record_transcript_observation("compaction-transcript")
                continue
            classification = transcript_entry_classification(entry)
            if (
                classification == "assistant-output"
                and self.transcript_quiescence_deadline is not None
            ):
                # Claude 2.1.220 can flush the completed assistant record
                # after Stop.  It belongs to this completed-turn epoch; only
                # a later human/channel turn is renewed activity.
                self._record_completed_turn_flush()
            self._record_transcript_observation(
                classification,
                gate_blocked=classification == "unknown",
                record_type=entry.get("type"),
                record_subtype=entry.get("subtype"),
            )
            if classification != "user-turn":
                continue
            self._close_development_channel_acceptance("transcript-user-turn")
            if self.last_normal_stop:
                if self.transcript_activity_at and self.transcript_activity_at > self.last_normal_stop:
                    continue
                current = now()
                self.transcript_activity_at = current
                self.last_channel_activity = current
                self.last_channel_event = "transcript"
                self._abort_recovery("transcript-activity")
                self.rearm("transcript-activity")

    def _record_transcript_activity(self) -> None:
        """Tail the transcript after inotify or fallback-poll notification."""
        self._tail_transcript()

    def _install_terminal(self) -> None:
        """Put the caller's terminal in raw mode and register stdin."""
        fd = sys.stdin.fileno()
        is_terminal = os.isatty(fd)
        self.stdin_flags = fcntl.fcntl(fd, fcntl.F_GETFL)
        if is_terminal:
            self.terminal_attributes = termios.tcgetattr(fd)
            tty.setraw(fd)
        os.set_blocking(fd, False)
        try:
            self.selector.register(sys.stdin, selectors.EVENT_READ, "stdin")
        except OSError:
            # Some non-interactive runners expose stdin through a descriptor
            # that cannot be registered with epoll.  There is no local
            # keystroke stream to supervise in that case; a real TTY must
            # remain fail-loud because local-input cancellation is safety
            # critical there.
            if is_terminal:
                raise
            self._debug("stdin-not-pollable")
        if is_terminal:
            self._resize()

    def _restore_terminal(self) -> None:
        """Restore the caller's terminal exactly once."""
        if self.terminal_attributes is not None:
            try:
                termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, self.terminal_attributes)
            except OSError:
                pass
            self.terminal_attributes = None
        if self.stdin_flags is not None:
            try:
                fcntl.fcntl(sys.stdin.fileno(), fcntl.F_SETFL, self.stdin_flags)
            except OSError:
                pass
            self.stdin_flags = None

    def _cleanup_terminal_modes(self) -> None:
        """Reset modes owned by the full-screen child only after it has ended."""
        if not os.isatty(sys.stdout.fileno()):
            return
        try:
            write_all(sys.stdout.fileno(), TERMINAL_CLEANUP_BYTES)
            sys.stdout.flush()
        except OSError:
            pass

    def _resize(self) -> None:
        """Propagate the caller's current window size to the Claude PTY."""
        if self.master_fd is None or not os.isatty(sys.stdout.fileno()):
            return
        try:
            size = shutil.get_terminal_size(fallback=(80, 24))
            winsize = struct.pack("HHHH", size.lines, size.columns, 0, 0)
            fcntl.ioctl(self.master_fd, termios.TIOCSWINSZ, winsize)
            if self.pid and child_alive(self.pid):
                os.kill(self.pid, signal.SIGWINCH)
        except OSError:
            pass

    def _forward_signal(self, signum: int, _frame: object) -> None:
        """Forward process signals to Claude's process group."""
        if self.pid and child_alive(self.pid):
            try:
                os.killpg(self.pid, signum)
            except OSError:
                try:
                    os.kill(self.pid, signum)
                except OSError:
                    pass
        if signum in {signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT}:
            self.shutdown_requested = True

    def _install_signals(self) -> None:
        """Install forwarding handlers for terminal lifecycle signals."""
        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT):
            signal.signal(signum, self._forward_signal)
        signal.signal(signal.SIGWINCH, lambda _signum, _frame: self._resize())

    def launch(self) -> None:
        """Fork Claude on a real PTY and begin byte-level proxying."""
        environment = os.environ.copy()
        environment.update(
            {
                "CLAUDE_IDLE_CHANNEL": self.channel,
                "CLAUDE_IDLE_OWNER": "pty-supervisor",
                "CLAUDE_IDLE_CONTROL_SOCKET": str(self.socket_path),
                "CLAUDE_IDLE_RUNTIME_DIR": str(self.session_dir),
                "CLAUDE_IDLE_SUPERVISOR_PID": str(os.getpid()),
                "CLAUDE_IDLE_WATCHED_SERVERS": ",".join(self.watched_servers),
            }
        )
        pid, master_fd = pty.fork()
        if pid == 0:
            try:
                child_argv = self._child_argv()
                os.execvpe(self.executable, [self.executable, *child_argv], environment)
            except BaseException as error:
                print(f"claude-warm: failed to exec Claude: {error}", file=sys.stderr)
                os._exit(127)
        self.pid = pid
        self.master_fd = master_fd
        os.set_blocking(master_fd, False)
        if self.development_channel_opt_ins:
            self.development_channel_accept_deadline = (
                monotonic() + DEVELOPMENT_CHANNEL_ACCEPT_WINDOW_SECONDS
            )
        # Do not bind while the forked child may still expose the inherited
        # Herdr terminal before exec installs the forkpty slave.  The first
        # final-gate probe binds both values after the child is settled.
        self.child_tty = self.child_tty_device = None
        self.selector.register(master_fd, selectors.EVENT_READ, "master")
        self._install_signals()
        self._install_terminal()
        self.herdr.child_pid = pid
        self._register_herdr()
        self._write_state()

    def _read_child_tty(self) -> str | None:
        """Return the child stdin terminal path from the live process table."""
        if not self.pid:
            return None
        try:
            candidate = os.readlink(f"/proc/{self.pid}/fd/0")
            # Immediately after forkpty the child can still expose the
            # supervisor's inherited pipe while it is between fork and exec.
            # Cache only an actual terminal path; the final gate will retry
            # until exec has installed the PTY slave.
            return candidate if candidate.startswith("/dev/") else None
        except OSError:
            return None

    def _read_child_tty_device(self) -> int | None:
        """Return the child stdin terminal device, independent of mount paths."""
        if not self.pid:
            return None
        try:
            device = os.stat(f"/proc/{self.pid}/fd/0").st_rdev
        except OSError:
            return None
        # Pipes and regular files have no terminal device identity.  A PTY
        # slave keeps the same device identity even when different mount
        # namespaces render it with different /dev/pts/N pathnames.
        return device or None

    def _pty_ownership_failure(self) -> str | None:
        """Return a bounded label for the first failing ownership condition."""
        if not self.pid or self.master_fd is None:
            return "no-child-or-master"
        if not child_alive(self.pid):
            return "child-not-alive"
        if self.child_tty is None:
            self.child_tty = self._read_child_tty()
        current_device = self._read_child_tty_device()
        if getattr(self, "child_tty_device", None) is None:
            self.child_tty_device = current_device
        if self.child_tty is None or self.child_tty_device is None or current_device is None:
            return "child-tty-unknown"
        try:
            if os.getpgid(self.pid) != self.pid:
                return "pgid-mismatch"
            if current_device != self.child_tty_device:
                return "stdin-not-pty"
        except OSError as error:
            return f"oserror-{error.errno or 0}"
        # Keep the display-only path current without making namespace-local
        # /dev/pts numbering part of the ownership decision.
        self.child_tty = self._read_child_tty()
        return None

    def _pty_still_owned(self) -> bool:
        """Verify the live child still owns the PTY slave and its process group.

        One probe is not evidence: on 2026-08-20 a single failed check vetoed
        the only armed compaction of the night while the child lived on for
        another twenty hours.  The probe is retried briefly and every failing
        attempt is logged with the condition that failed.
        """
        failure = None
        for attempt in range(1, PTY_CHECK_ATTEMPTS + 1):
            failure = self._pty_ownership_failure()
            if failure is None:
                return True
            self._guard_log(
                "pty-ownership-check-failed", attempt=attempt, detail=failure
            )
            if failure == "child-not-alive":
                break
            time.sleep(PTY_CHECK_RETRY_SECONDS)
        return False

    def _channel_process_present(self) -> bool:
        """Return whether a watched channel process is a Claude descendant."""
        if not self.pid or not self.watched_servers:
            return False
        pending = proc_children(self.pid)
        seen: set[int] = set()
        while pending:
            candidate = pending.pop()
            if candidate in seen:
                continue
            seen.add(candidate)
            command_line = process_command_line(candidate)
            if any(pattern in command_line for pattern in self.channel_process_patterns):
                return True
            pending.extend(proc_children(candidate))
        return False

    def _check_channel_attach(self) -> None:
        """Verify launch-time channel attachment without requiring a first message."""
        if self.channel_attach_checked or not self.watched_servers:
            return
        if self._channel_process_present():
            self.channel_attach_checked = True
            self.channel_health = "attached"
            self._guard_log("channel-attached-process")
            self._write_state()
            return
        if self.channel_attach_deadline is not None and monotonic() >= self.channel_attach_deadline:
            self.channel_attach_checked = True
            self.channel_health = "failed-attach"
            self.cancel("channel-attach-failed")
            self._guard_log("channel-attach-failed")
            self._notice("channel did not attach; the terminal session remains running")
            self._write_state()

    def _note_lifecycle_event(self) -> None:
        """Any valid hook event proves the lifecycle adapter reaches this supervisor."""
        if self.lifecycle_health == "wired":
            return
        recovered = self.lifecycle_health == "missing"
        self.lifecycle_health = "wired"
        if recovered:
            self._guard_log("lifecycle-hooks-recovered")
            try:
                self.lifecycle_alarm_path.unlink()
            except OSError:
                pass

    def _check_lifecycle_hooks(self) -> None:
        """Flag a session whose Claude never sends a lifecycle event after launch.

        Without claude-hook-idle-event in the settings Claude actually loads
        (an unstowed account, a --settings file that omits it, a missing
        command on PATH), this supervisor never sees a Stop, so it never arms
        the idle timer and never compacts, silently.  The terminal session is
        left untouched; the fault goes to the guard log, the state file (and
        so claude-warmctl list), the debug log, and a durable alarm file.
        """
        if self.lifecycle_health != "pending" or monotonic() < self.lifecycle_deadline:
            return
        self.lifecycle_health = "missing"
        self.last_state_transition = "lifecycle-hooks-missing"
        self._guard_log("lifecycle-hooks-missing", waited=LIFECYCLE_WAIT_SECONDS)
        self._notice("no lifecycle hook event since launch; idle compaction cannot run")
        try:
            atomic_json(self.lifecycle_alarm_path, {
                "timestamp": now(),
                "channel": self.channel,
                "pid": self.pid,
                "waited_seconds": LIFECYCLE_WAIT_SECONDS,
                "cause": "no lifecycle hook event since launch: claude-hook-idle-event is not "
                         "registered in the settings Claude loads, not on its PATH, or Claude "
                         "is blocked before its session started",
            })
        except OSError as error:
            self._debug(f"lifecycle-alarm-write-failed channel={short_id(self.channel)} error={error}")
        self._write_state()

    def _child_argv(self) -> list[str]:
        """Add private Claude debug capture only for channel sessions."""
        if not self.watched_servers:
            return list(self.argv)
        if any(argument == "--debug" or argument.startswith("--debug-") for argument in self.argv):
            return list(self.argv)
        return [*self.argv, "--debug-file", str(self.debug_log_path)]

    def _read_snapshot(self) -> tuple[dict | None, str | None]:
        """Read a session-bound snapshot valid for the governed Stop epoch."""
        try:
            with self.snapshot_path.open(encoding="utf-8") as stream:
                payload = json.load(stream)
        except (OSError, ValueError):
            return None, "status-snapshot-missing"
        if not isinstance(payload, dict):
            return None, "status-snapshot-invalid"
        if payload.get("channel") != self.channel:
            return None, "status-channel-mismatch"
        if payload.get("session_id") != self.session_id:
            return None, "status-session-mismatch"
        tokens = payload.get("current_input_context_tokens")
        model = payload.get("model")
        timestamp = payload.get("update_timestamp")
        if not isinstance(tokens, int) or tokens < 0:
            return None, "status-token-invalid"
        if not isinstance(timestamp, (int, float)):
            return None, "status-timestamp-invalid"
        if model is not None and (
            not isinstance(model, str)
            or not model.strip()
            or model.strip() != model
            or len(model) > 128
        ):
            return None, "status-model-invalid"
        if (
            self.last_normal_stop
            and float(timestamp) + SNAPSHOT_STOP_SKEW_SECONDS < self.last_normal_stop
        ):
            return None, "status-snapshot-before-stop"
        self.current_tokens = tokens
        self.current_model = model
        self.status_timestamp = float(timestamp)
        self.status_snapshot_epoch = self.completed_turn_epoch
        return payload, None

    def _load_latest_compaction_baseline(self, *, require_recent: bool) -> None:
        """Load the newest exact PostCompact token baseline from JSONL metadata."""
        path = self.transcript_path
        if path is None:
            self.post_compact_baseline_tokens = None
            self.post_compact_baseline_at = None
            return
        latest: tuple[int, float] | None = None
        try:
            with path.open(encoding="utf-8") as stream:
                for line in stream:
                    if '"compact_boundary"' not in line:
                        continue
                    try:
                        record = json.loads(line)
                    except (TypeError, ValueError):
                        continue
                    if record.get("type") != "system" or record.get("subtype") != "compact_boundary":
                        continue
                    metadata = record.get("compactMetadata")
                    tokens = metadata.get("postTokens") if isinstance(metadata, dict) else None
                    timestamp = record.get("timestamp")
                    if isinstance(tokens, bool) or not isinstance(tokens, int) or tokens < 0:
                        continue
                    if not isinstance(timestamp, str):
                        continue
                    try:
                        observed = datetime.datetime.fromisoformat(
                            timestamp.replace("Z", "+00:00")
                        ).timestamp()
                    except ValueError:
                        continue
                    latest = (tokens, observed)
        except OSError:
            latest = None
        if latest is None or (require_recent and abs(now() - latest[1]) > 900):
            self.post_compact_baseline_tokens = None
            self.post_compact_baseline_at = None
            return
        self.post_compact_baseline_tokens, self.post_compact_baseline_at = latest

    def _gate_reason(self, purpose: str = "compact") -> str | None:
        """Return the first failed final eligibility condition, if any."""
        if not self.enabled:
            return "session-disabled"
        if self.status not in {"idle", "active"}:
            return "session-not-running"
        if self.compacting:
            return "already-compacting"
        if not self._pty_still_owned():
            return "pty-or-process-gone"
        if not self.session_id or not SESSION_RE.fullmatch(self.session_id):
            return "session-unbound"
        if not self.last_normal_stop:
            return "no-normal-stop"
        # Activity after the last Stop only blocks while it is younger than
        # the idle threshold; old activity has had its full idle window.
        window_open = self._idle_window_open()
        if self.status == "active" and window_open:
            return "session-active"
        if (
            window_open
            and self.last_lifecycle_activity
            and self.last_lifecycle_activity > self.last_normal_stop
        ):
            return "lifecycle-activity"
        if (
            window_open
            and self.last_local_input
            and self.last_local_input > self.last_normal_stop
        ):
            return "user-input"
        if purpose == "compact":
            if not self.dirty:
                return "clean"
            if self.recovery_pending:
                return "channel-recovery-pending"
            if (
                window_open
                and self.transcript_activity_at
                and self.transcript_activity_at > self.last_normal_stop
            ):
                return "transcript-activity"
            if self.transcript_gate_blocked:
                blocked_at = self.transcript_gate_blocked_at or now()
                if now() - blocked_at >= TRANSCRIPT_GATE_MAX_SECONDS:
                    # Bounded caution, not a permanent veto — see the
                    # TRANSCRIPT_GATE_MAX_SECONDS rationale.
                    self.transcript_gate_blocked = False
                    self.transcript_gate_blocked_at = None
                    self._guard_log(
                        "transcript-gate-expired",
                        blocked_seconds=int(now() - blocked_at),
                    )
                else:
                    return "transcript-uncertain"
            if self.transcript_quiescence_deadline is not None:
                return "transcript-not-quiescent"
        elif purpose == "recovery":
            if not self.recovery_pending:
                return "no-channel-recovery"
            if self.recovery_awaiting:
                return "recovery-awaiting-confirmation"
            if self.last_channel_event != "removed":
                return "channel-activity"
            if self.transcript_activity_at and self.transcript_activity_at > self.last_normal_stop:
                # The removal marker is the reason for recovery.  Any other
                # transcript line is handled by _tail_transcript and changes
                # last_channel_event away from `removed'.
                if self.last_channel_activity != self.transcript_activity_at:
                    return "transcript-activity"
        elif purpose != "manual":
            return "unknown-injection-purpose"
        # A cold cache no longer vetoes compaction (ruling 2026-08-21): the
        # first morning turn pays the cold read either way, and it is better
        # paid once over a compacted context.  Warm/cold is recorded on the
        # compaction-requested event instead.
        _, snapshot_error = self._read_snapshot()
        if purpose == "compact" and snapshot_error:
            return snapshot_error
        if purpose == "compact":
            unpreserved_tokens = max(
                0,
                (self.current_tokens or 0) - (self.post_compact_baseline_tokens or 0),
            )
            if unpreserved_tokens < MIN_TOKENS:
                return "below-token-threshold"
        return None

    def _schedule_next_recovery(self) -> None:
        """Schedule another bounded recovery step after a missing confirmation."""
        self.recovery_awaiting = False
        self.recovery_command_inflight = False
        self.recovery_expected_stop = False
        self._arm_recovery()

    def _fail_channel_recovery(self) -> None:
        """Stop retrying a death generation and surface the failure visibly."""
        self.recovery_pending = False
        self.recovery_awaiting = False
        self.recovery_command_inflight = False
        self.recovery_expected_stop = False
        self.channel_health = "dead"
        self.cancel("channel-dead")
        self._guard_log(
            "channel-recovery-failed",
            reconnect_attempts=self.recovery_attempts,
            reload_attempted=self.recovery_reload_attempted,
        )
        self._notice("channel recovery failed after bounded retries; inspect claude-warmctl show")
        self._write_state()

    def _recovery_step(self, expected_generation: int) -> None:
        """Inject one reconnect/reload step, never more than once per timer."""
        if expected_generation != self.timer_generation or not self.recovery_pending:
            return
        reason = self._gate_reason("recovery")
        if reason:
            self.last_cancellation_reason = reason
            self._guard_log("recovery-gate-refused", reason=reason)
            if reason in {"session-active", "no-normal-stop"}:
                self._write_state()
                return
            self._abort_recovery(reason)
            return
        if self.recovery_attempts < 2:
            command = self.recovery_command
            if not command:
                self._fail_channel_recovery()
                return
            self.recovery_attempts += 1
        elif not self.recovery_reload_attempted:
            command = "/reload-plugins"
            self.recovery_reload_attempted = True
        else:
            self._fail_channel_recovery()
            return
        if not self.attempt(
            expected_generation,
            command=command,
            purpose="recovery",
        ):
            self._schedule_next_recovery()

    def _recovery_confirmation(self, expected_generation: int) -> None:
        """Retry or fail when the expected attachment delta did not arrive."""
        if expected_generation != self.timer_generation or not self.recovery_pending:
            return
        if self.channel_health == "attached" and self.channel_marker_seen:
            self._complete_channel_recovery("confirmation")
            return
        self._guard_log(
            "channel-recovery-unconfirmed",
            reconnect_attempts=self.recovery_attempts,
            reload_attempted=self.recovery_reload_attempted,
        )
        self._schedule_next_recovery()

    def attempt(
        self,
        expected_generation: int | None = None,
        command: str = "/compact",
        purpose: str = "compact",
    ) -> bool:
        """Run the final gate and inject one validated command through the PTY."""
        if expected_generation is not None and expected_generation != self.timer_generation:
            self.last_gate_rejection_reason = "stale-timer"
            self.last_state_transition = "gate-refused:stale-timer"
            self._guard_log("gate-refused", purpose=purpose, reason="stale-timer")
            self._write_state()
            return False
        if (
            purpose == "compact"
            and expected_generation is not None
            and not self._refresh_cache_policy_for_action()
        ):
            return False
        reason = self._gate_reason(purpose)
        if reason:
            self.last_cancellation_reason = reason
            self.last_gate_rejection_reason = reason
            self.last_state_transition = f"gate-refused:{reason}"
            self._debug(f"cancelled:{reason} channel={short_id(self.channel)}")
            self._guard_log(
                "gate-refused",
                purpose=purpose,
                reason=reason,
                transient=reason not in DORMANT_GATE_REASONS,
            )
            self._write_state()
            if purpose == "compact" and self.preservation_state == "requested":
                self.preservation_state = "pending_recovery"
                self.preservation_failure = reason
                self._save_preservation()
                self._guard_log(
                    "preservation-pending-recovery", request_id=self.preservation_request_id, reason=reason
                )
            if purpose == "compact" and reason not in DORMANT_GATE_REASONS and self.preservation_state != "pending_recovery":
                self.rearm(f"gate-refused:{reason}")
            return False
        if not validate_inject_command(command, self.watched_servers, self.recovery_command):
            self.last_cancellation_reason = "inject-command-refused"
            self.last_gate_rejection_reason = "inject-command-refused"
            self.last_state_transition = "gate-refused:inject-command-refused"
            self._guard_log("inject-refused", purpose=purpose)
            self._write_state()
            return False
        queued_behind_turn = self.status == "active"
        self.status = "active"
        self.last_gate_rejection_reason = None
        self.last_injection_result = "pending"
        self.last_state_transition = "injection-attempted"
        self.timer_deadline = None
        self.timer_kind = None
        self.timer_generation += 1
        if purpose == "compact":
            self.compacting = True
            self.compaction_requested_at = now()
            self.compaction_ignore_next_stop = False
            self.last_cancellation_reason = "compaction-requested"
        elif purpose == "recovery":
            self.recovery_awaiting = True
            self.recovery_command_inflight = True
            self.recovery_expected_stop = True
            self.last_cancellation_reason = "channel-recovery-requested"
        else:
            self.last_cancellation_reason = "manual-injection-requested"
        self._guard_log("injection-attempted", purpose=purpose)
        self._write_state()
        try:
            if self.master_fd is None:
                raise OSError(errno.EIO, "PTY master unavailable")
            write_all(self.master_fd, (command + "\r").encode("utf-8"))
        except OSError as error:
            if purpose == "compact":
                self.compacting = False
                self.compaction_requested_at = None
                self.dirty = True
                self.last_cancellation_reason = "compaction-injection-failed"
                self.last_injection_result = "failed"
                self.last_state_transition = "injection-failed"
                self._debug(f"compaction-failed channel={short_id(self.channel)} error={error}")
                if self.preservation_state == "requested":
                    self.preservation_state = "pending_recovery"
                    self.preservation_failure = "compaction-injection-failed"
                    self._save_preservation()
                    self._guard_log(
                        "preservation-pending-recovery", request_id=self.preservation_request_id, reason="pty-write-failed"
                    )
            elif purpose == "recovery":
                self.recovery_awaiting = False
                self.recovery_command_inflight = False
                self.recovery_expected_stop = False
                self.status = "idle"
                self.last_cancellation_reason = "channel-recovery-injection-failed"
                self.last_injection_result = "failed"
                self.last_state_transition = "injection-failed"
                self._debug(f"channel-recovery-failed channel={short_id(self.channel)} error={error}")
            else:
                self.status = "idle"
                self.last_cancellation_reason = "manual-injection-failed"
                self.last_injection_result = "failed"
                self.last_state_transition = "injection-failed"
            self._write_state()
            return False
        if purpose == "recovery":
            self.timer_generation += 1
            self.timer_kind = "channel-recovery-confirm"
            self.timer_deadline = now() + CHANNEL_RECOVERY_CONFIRM_SECONDS
            self._guard_log("channel-recovery-requested", command=command)
        elif purpose == "compact":
            self.last_injection_result = "requested"
            self.last_state_transition = "compaction-requested"
            self._debug(f"compaction-requested channel={short_id(self.channel)}")
            cache_age = now() - self.last_normal_stop if self.last_normal_stop else None
            self._guard_log(
                "compaction-requested",
                cache=(
                    "unknown"
                    if cache_age is None
                    else ("warm" if cache_age < self.cache_ttl_seconds else "cold")
                ),
                queued_behind_turn=queued_behind_turn,
            )
            if self.preservation_state == "requested":
                self.preservation_state = "native_started"
                self._save_preservation()
                self._guard_log(
                    "preservation-native-started", request_id=self.preservation_request_id
                )
        else:
            self._guard_log("manual-injection-requested", command=command)
        self._write_state()
        return True

    def _handle_event(self, message: dict) -> dict:
        """Handle one validated lifecycle event from the Claude hook adapter."""
        if message.get("kind") != "event" or message.get("channel") != self.channel:
            return {"ok": False, "error": "invalid-event-owner"}
        event = message.get("event")
        session_id = message.get("session_id")
        if event not in EVENTS or not isinstance(session_id, str) or not SESSION_RE.fullmatch(session_id):
            return {"ok": False, "error": "invalid-event"}
        self._note_lifecycle_event()
        if event == "session-start":
            new_session = self.session_id != session_id
            if new_session and self.session_id and not self._same_project_transcript(
                message.get("transcript_path")
            ):
                # A nested one-shot claude (hook-spawned classifier, bridge
                # call) inherits this supervisor's control-socket env, so its
                # own lifecycle hooks arrive here.  Rebinding to it marks the
                # governor "ended" when the one-shot exits and locks the real
                # session out as session-mismatch — no idle compaction for the
                # rest of the session (2026-08-20 overnight no-compact hunt).
                self._guard_log(
                    "foreign-session-ignored",
                    has_transcript=bool(message.get("transcript_path")),
                )
                return {"ok": True, "ignored": "foreign-session"}
            if self.session_id and new_session:
                self.cancel("session-replaced")
                self.dirty = False
                self.recovery_pending = False
                self.recovery_awaiting = False
                self.recovery_command_inflight = False
                self.recovery_expected_stop = False
                self.recovery_ignore_next_stop = False
                self.compaction_requested_at = None
                self.compaction_ignore_next_stop = False
                self.current_model = None
                self.post_compact_baseline_tokens = None
                self.post_compact_baseline_at = None
                self.channel_health = "none" if not self.watched_servers else "reconnecting"
                self.channel_attach_checked = not bool(self.watched_servers)
                self.channel_attach_deadline = (
                    monotonic() + CHANNEL_ATTACH_WAIT_SECONDS if self.watched_servers else None
                )
            self.session_id = session_id
            if new_session:
                self._load_preservation()
                self._record_last_session("session-bound")
                self.completed_turn_epoch = 0
                self.status_snapshot_epoch = None
                self.transcript_quiescence_at = None
                self.transcript_quiescence_deadline = None
                self.transcript_gate_blocked = False
                self.transcript_gate_blocked_at = None
                self.last_transcript_classification = None
            self._set_transcript(message.get("transcript_path"))
            if new_session:
                self._load_latest_compaction_baseline(require_recent=False)
            self.status = "starting"
            self.screen_classifier.reset()
            self.screen_state = None
            self.last_lifecycle_activity = now()
            self._register_herdr()
            self._guard_log("session-bound")
            self._write_state()
            return {"ok": True}
        if self.session_id != session_id:
            return {"ok": False, "error": "session-mismatch"}
        self._close_development_channel_acceptance(f"lifecycle-{event}")
        current = now()
        if event == "stop":
            if message.get("stop_hook_active") is not False:
                return {"ok": True, "ignored": "stop-hook-active"}
            if self.recovery_ignore_next_stop:
                self.recovery_ignore_next_stop = False
                self.status = "idle"
                self.last_lifecycle_activity = current
                self.cancel("recovery-command-stop")
                self._guard_log("recovery-command-stop")
                return {"ok": True, "ignored": "recovery-command-stop"}
            if self.recovery_awaiting and self.recovery_expected_stop:
                self.status = "idle"
                self.recovery_command_inflight = False
                self.recovery_expected_stop = False
                self._guard_log("recovery-command-stopped")
                self._write_state()
                return {"ok": True, "ignored": "recovery-command-stop"}
            if self.compaction_ignore_next_stop:
                self.compaction_ignore_next_stop = False
                self.status = "idle"
                self.last_lifecycle_activity = current
                self.cancel("compaction-failed-stop")
                return {"ok": True, "ignored": "compaction-failed-stop"}
            if self.compacting:
                self.status = "idle"
                self.cancel("compaction-stop")
                return {"ok": True, "ignored": "compaction-stop"}
            if (
                self.last_normal_stop
                and self.status == "idle"
                and self.dirty
                and current - self.last_normal_stop < 0.5
            ):
                self._guard_log("duplicate-stop")
                return {"ok": True, "ignored": "duplicate-stop"}
            self.status = "idle"
            self.dirty = True
            self.completed_turn_epoch += 1
            self.status_snapshot_epoch = None
            self.last_normal_stop = current
            self.last_lifecycle_activity = current
            self.last_local_input = None
            self.transcript_activity_at = None
            if self.preservation_state == "requested":
                self._guard_log(
                    "preservation-safe-boundary",
                    request_id=self.preservation_request_id,
                    completed_turn_epoch=self.completed_turn_epoch,
                )
            self.transcript_gate_blocked = False
            self.transcript_gate_blocked_at = None
            self.last_transcript_classification = None
            self._reset_transcript_cursor()
            self.cancel("new-normal-turn")
            self._begin_transcript_quiescence()
            return {"ok": True}
        if event == "user-prompt-submit":
            self.status = "active"
            self.last_lifecycle_activity = current
            self.compaction_ignore_next_stop = False
            if self.recovery_ignore_next_stop:
                self._guard_log("recovery-command-prompt-submit")
            elif self.recovery_awaiting and self.recovery_command_inflight:
                self.recovery_command_inflight = False
                self._guard_log("recovery-command-prompt-submit")
            elif self.recovery_pending:
                self._abort_recovery("prompt-submit")
            else:
                self.cancel("prompt-submit")
        elif event == "post-compact":
            self.status = "idle"
            self.dirty = False
            self.compacting = False
            self.compaction_requested_at = None
            self.compaction_ignore_next_stop = False
            self.current_tokens = None
            self._load_latest_compaction_baseline(require_recent=True)
            self.status_timestamp = None
            self.status_snapshot_epoch = None
            self.transcript_quiescence_deadline = None
            self.transcript_quiescence_at = current
            self.transcript_gate_blocked = False
            self.transcript_gate_blocked_at = None
            self.last_transcript_classification = None
            self.last_injection_result = "succeeded"
            self.last_lifecycle_activity = current
            self._reset_transcript_cursor()
            if self.preservation_state == "native_started":
                self.preservation_state = "native_completed"
                self._save_preservation()
                self._guard_log(
                    "preservation-native-completed",
                    request_id=self.preservation_request_id,
                )
            self.cancel("compaction-completed")
            self.last_state_transition = "compaction-completed"
            self._debug(f"compaction-completed channel={short_id(self.channel)}")
            self._guard_log("compaction-completed")
        elif event == "session-end":
            self.status = "ended"
            self.last_lifecycle_activity = current
            self._abort_recovery("session-end")
            self.cancel("session-end")
            self.herdr.release()
        elif event == "stop-failure":
            was_compacting = self.compacting
            if self.compacting:
                self._compaction_failed("stop-failure")
            if was_compacting:
                self.last_injection_result = "failed"
                self.last_state_transition = "stop-failure"
            self.status = "error"
            self.last_lifecycle_activity = current
            self._abort_recovery("stop-failure")
            self.cancel("stop-failure")
            # A stop-failure with a living child is transient from the
            # timer's perspective: cancelling without re-arming leaves zero
            # timers until the next activity, which can be hours away
            # (2026-08-26: two 4091 remote-bridge stop-failures at 08:37Z
            # killed the armed compaction and the window sat cold for 3.5 h).
            # Re-arm on the retry cadence; a dead child stays `error' and is
            # refused by rearm()'s child_alive gate regardless.
            if child_alive(self.pid):
                self.status = "idle"
                self.rearm("stop-failure-retry")
        else:
            self.status = "active"
            self.last_lifecycle_activity = current
            if self.recovery_pending and not self.recovery_expected_stop:
                self._abort_recovery("session-activity")
            elif self.recovery_pending and self.recovery_expected_stop:
                self._guard_log("recovery-command-activity")
            else:
                self._defer_for_activity("session-activity")
        self._write_state()
        return {"ok": True}

    def _preservation_path(self) -> pathlib.Path | None:
        """Return a private, session-stable ledger path without exposing the ID."""
        if not self.session_id:
            return None
        digest = hashlib.sha256(self.session_id.encode("utf-8")).hexdigest()[:32]
        directory = self.state_root / "preservation"
        safe_mkdir(directory)
        return directory / f"{digest}.json"

    def _save_preservation(self) -> None:
        """Persist before acknowledgement so lost replies are safely replayable."""
        path = self._preservation_path()
        if path is None or self.preservation_request_id is None:
            return
        payload = {
            "session_id": self.session_id,
            "request_id": self.preservation_request_id,
            "reservation_id": self.preservation_reservation_id,
            "state": self.preservation_state,
            "failure": self.preservation_failure,
            "expected_epoch": self.preservation_expected_epoch,
        }
        temporary = path.with_suffix(".tmp")
        temporary.write_text(json.dumps(payload, sort_keys=True), encoding="utf-8")
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)

    def _load_preservation(self) -> None:
        """Recover terminal state; in-flight work requires a fresh owner request."""
        self.preservation_request_id = None
        self.preservation_reservation_id = None
        self.preservation_state = None
        self.preservation_failure = None
        self.preservation_expected_epoch = None
        path = self._preservation_path()
        if path is None:
            return
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return
        if payload.get("session_id") != self.session_id:
            return
        self.preservation_request_id = payload.get("request_id")
        self.preservation_reservation_id = payload.get("reservation_id")
        self.preservation_state = payload.get("state")
        self.preservation_failure = payload.get("failure")
        self.preservation_expected_epoch = payload.get("expected_epoch")
        if self.preservation_state in {"reserved", "requested", "native_started"}:
            self.preservation_state = "pending_recovery"
            self.preservation_failure = "owner-restarted"
            self._save_preservation()

    def _request_preservation(self, message: dict) -> dict:
        """Persist one idempotent request and compact only through this PTY owner."""
        request_id = message.get("request_id")
        reservation_id = message.get("reservation_id")
        expected_session_id = message.get("expected_session_id")
        expected_supervisor_pid = message.get("expected_supervisor_pid")
        expected_epoch = message.get("expected_epoch")
        if not all(
            isinstance(value, str) and SESSION_RE.fullmatch(value)
            for value in (request_id, reservation_id, expected_session_id)
        ):
            return {"ok": False, "error": "invalid-preservation-identity"}
        if not isinstance(expected_supervisor_pid, int) or not isinstance(expected_epoch, int):
            return {"ok": False, "error": "invalid-preservation-owner"}
        if self.preservation_request_id == request_id:
            return {"ok": True, "replayed": True, "state": self.state()}
        if self.preservation_request_id and self.preservation_state not in {
            "native_completed", "failed", "pending_recovery",
        }:
            return {"ok": False, "error": "preservation-already-pending", "state": self.state()}
        if not self.enabled:
            return {"ok": False, "error": "protection-disabled", "state": self.state()}
        if (
            expected_session_id != self.session_id
            or expected_supervisor_pid != os.getpid()
            or expected_epoch != self.completed_turn_epoch
        ):
            return {"ok": False, "error": "preservation-owner-mismatch", "state": self.state()}
        self.preservation_request_id = request_id
        self.preservation_reservation_id = reservation_id
        self.preservation_state = "reserved"
        self.preservation_failure = None
        self.preservation_expected_epoch = expected_epoch
        self._save_preservation()
        self._guard_log(
            "preservation-reserved",
            request_id=request_id,
            reservation_id=reservation_id,
        )
        self.preservation_state = "requested"
        self._save_preservation()
        self._guard_log("preservation-requested", request_id=request_id)
        if (
            self.status == "idle"
            and self.transcript_quiescence_deadline is None
            and self.transcript_quiescence_at is not None
        ):
            self.attempt(command="/compact", purpose="compact")
        self._save_preservation()
        self._write_state()
        return {"ok": True, "state": self.state()}

    def _handle_control(self, message: dict) -> dict:
        """Handle one local control command without exposing prompts or secrets."""
        if message.get("kind") != "control":
            return {"ok": False, "error": "invalid-control"}
        if message.get("channel") != self.channel:
            return {"ok": False, "error": "invalid-control-owner"}
        command = message.get("command")
        if command not in CONTROL_COMMANDS:
            return {"ok": False, "error": "unknown-control"}
        if command == "preserve":
            return self._request_preservation(message)
        if command == "state":
            return {"ok": True, "state": self.state()}
        if command == "enable":
            self.enabled = True
            self.arm()
        elif command == "disable":
            self.enabled = False
            self.cancel("session-disabled")
        elif command == "profile":
            profile = message.get("profile")
            if profile not in {"long", "short", "auto"}:
                return {"ok": False, "error": "invalid-profile"}
            self.cache_profile_requested = profile
            self.cache_profile = effective_profile(profile)
            self.cancel("profile-changed")
            if self.recovery_pending:
                self._arm_recovery()
            else:
                self.arm()
        elif command == "cancel":
            self._abort_recovery("manual-cancel")
        elif command == "trigger":
            success = self.attempt()
            self._write_state()
            return {"ok": success, "state": self.state()}
        elif command == "inject":
            text = message.get("text")
            if not validate_inject_command(text, self.watched_servers, self.recovery_command):
                return {"ok": False, "error": "inject-command-refused", "state": self.state()}
            purpose = "compact" if text == "/compact" else "manual"
            success = self.attempt(command=text, purpose=purpose)
            self._write_state()
            return {"ok": success, "state": self.state()}
        self._write_state()
        return {"ok": True, "state": self.state()}

    def _serve_one(self, connection: socket.socket) -> None:
        """Read and answer one hook/control request from the local socket."""
        try:
            connection.settimeout(1.0)
            data = connection.recv(65536)
            if not data:
                return
            message = json.loads(data.split(b"\n", 1)[0].decode("utf-8"))
            if not isinstance(message, dict):
                response = {"ok": False, "error": "invalid-json"}
            elif message.get("kind") == "event":
                response = self._handle_event(message)
            else:
                response = self._handle_control(message)
            connection.sendall((json.dumps(response, separators=(",", ":")) + "\n").encode())
        except (OSError, ValueError, UnicodeError) as error:
            self._debug(f"ipc-error channel={short_id(self.channel)} error={error}")
        finally:
            connection.close()

    def _record_input_observations(
        self,
        observations: list[tuple[str, int, bool]],
        forwarded: bool = True,
    ) -> None:
        """Record safe input classifications and cancel once for real human input."""
        if not observations:
            return
        summary: dict[str, int] = {}
        human = False
        total = 0
        for kind, length, is_human in observations:
            summary[kind] = summary.get(kind, 0) + length
            total += length
            human = human or is_human
        pending = (
            self.timer_deadline is not None
            or self.transcript_quiescence_deadline is not None
            or self.recovery_pending
        )
        log_key = json.dumps(sorted(summary.items()), separators=(",", ":"))
        log_now = monotonic()
        should_log = human and pending
        if not should_log and (
            log_key != self.last_terminal_input_log_key
            or log_now - self.last_terminal_input_log_at >= 5.0
        ):
            should_log = True
        if should_log:
            self.last_terminal_input_log_at = log_now
            self.last_terminal_input_log_key = log_key
            self._guard_log(
                "terminal-input",
                bytes=total,
                classifications=summary,
                forwarded=forwarded,
                human_activity=human,
            )
            self._debug(
                f"terminal-input bytes={total} classifications={log_key} "
                f"forwarded={str(forwarded).lower()} human_activity={str(human).lower()}"
            )
        if not human:
            return
        self._close_development_channel_acceptance("local-input")
        self.last_local_input = now()
        self.last_local_input_classification = ",".join(sorted(summary))
        if not pending:
            self._write_state()
            return
        if self.recovery_pending:
            self._abort_recovery("user-input")
        elif self.last_normal_stop and self.last_local_input > self.last_normal_stop:
            self._defer_for_activity("user-input")
        else:
            self._write_state()

    def _flush_input_classifier(self) -> None:
        """Resolve a lone or incomplete escape after the bounded sequence window."""
        self._record_input_observations(self.input_classifier.flush_expired())

    def _read_stdin(self) -> None:
        """Proxy every byte while distinguishing terminal protocol from human input."""
        try:
            data = os.read(sys.stdin.fileno(), 65536)
        except (OSError, BlockingIOError):
            return
        if not data:
            self.stdin_eof = True
            if self.master_fd is not None:
                try:
                    write_all(self.master_fd, b"\x04")
                except OSError:
                    pass
            try:
                self.selector.unregister(sys.stdin)
            except Exception:
                pass
            return
        forwarded = False
        if self.master_fd is not None:
            try:
                write_all(self.master_fd, data)
                forwarded = True
            except OSError:
                self.shutdown_requested = True
        try:
            observations = self.input_classifier.feed(data)
        except Exception:
            self._debug("terminal-input-classifier-error")
            observations = [("unknown-input", len(data), True)]
        self._record_input_observations(observations, forwarded=forwarded)
        self._write_state()

    def _read_master(self) -> bool:
        """Proxy Claude output to the caller and report whether the PTY remains open."""
        if self.master_fd is None:
            return False
        try:
            data = os.read(self.master_fd, 65536)
        except OSError as error:
            if error.errno in {errno.EIO, errno.EBADF}:
                return False
            return True
        if not data:
            return False
        state = self.screen_classifier.feed(data)
        try:
            write_all(sys.stdout.fileno(), data)
            sys.stdout.flush()
        except OSError:
            self.shutdown_requested = True
        self._maybe_accept_development_channel_prompt(data)
        if state is not None:
            self._report_screen_state(state)
        return True

    def _child_has_exited(self) -> bool:
        """Reap the child once and retain its real exit status."""
        if self.child_status is not None or not self.pid:
            return self.child_status is not None
        try:
            waited_pid, status = os.waitpid(self.pid, os.WNOHANG)
        except ChildProcessError:
            self.child_status = 1 << 8
            return True
        if waited_pid == self.pid:
            self.child_status = status
            self.child_exited_at = now()
            self.status = "exited"
            self.cancel("process-exit")
            self._guard_log("process-exit", exit_code=os.waitstatus_to_exitcode(status))
            return True
        return False

    def _handle_inotify(self) -> None:
        """Classify complete transcript records after a watcher notification."""
        if not self.inotify:
            return
        for mask, name in self.inotify.read():
            if mask & Inotify.IN_Q_OVERFLOW:
                self._record_transcript_observation(
                    "watcher-overflow", gate_blocked=True
                )
                self._record_transcript_activity()
            elif self.transcript_path and name == self.transcript_path.name:
                self._record_transcript_activity()

    def run(self) -> int:
        """Run the PTY proxy until Claude exits, then restore and clean up."""
        self.launch()
        master_open = True
        try:
            while master_open:
                child_exited = self._child_has_exited()
                self.herdr.heartbeat(self.screen_state, self.session_id)
                self.preservation_federation.poll()
                self._check_channel_attach()
                self._expire_development_channel_acceptance()
                if not child_exited:
                    self._check_lifecycle_hooks()
                self._flush_input_classifier()
                if (
                    self.transcript_quiescence_deadline is not None
                    and now() >= self.transcript_quiescence_deadline
                ):
                    self._complete_transcript_quiescence()
                if (
                    self.compacting
                    and self.compaction_requested_at
                    and now() - self.compaction_requested_at >= COMPACT_TIMEOUT_SECONDS
                ):
                    # No PostCompact and no rejection marker inside the
                    # timeout: the injected command was lost (or is queued
                    # behind a turn that has not ended).  Clear the latch so
                    # the governor can try again instead of sitting in
                    # `compacting' forever.  Unlike Claude's explicit
                    # rejection this does not swallow the next Stop: that
                    # Stop is the end of a real turn and must arm normally.
                    self.compacting = False
                    self.compaction_requested_at = None
                    self.compaction_ignore_next_stop = False
                    self.dirty = True
                    self.last_cancellation_reason = "compaction-timeout"
                    self.last_injection_result = "failed"
                    self.last_state_transition = "compaction-timeout"
                    if self.preservation_state == "native_started":
                        self.preservation_state = "failed"
                        self.preservation_failure = "compaction-timeout"
                        self._save_preservation()
                        self._guard_log(
                            "preservation-failed", request_id=self.preservation_request_id, reason="timeout"
                        )
                    self._debug(f"compaction-timeout channel={short_id(self.channel)}")
                    self._guard_log("compaction-failed", reason="timeout")
                    self.rearm("compaction-timeout")
                if self.timer_deadline is not None and now() >= self.timer_deadline:
                    generation = self.timer_generation
                    kind = self.timer_kind
                    self.timer_deadline = None
                    self.timer_kind = None
                    if kind == "compact":
                        self.attempt(generation)
                    elif kind == "channel-recovery":
                        self._recovery_step(generation)
                    elif kind == "channel-recovery-confirm":
                        self._recovery_confirmation(generation)
                # inotify is the fast path; this low-frequency reconciliation
                # poll also covers editor-style atomic replacement and dropped
                # queue notifications without becoming a busy scanner.
                if monotonic() >= self.next_transcript_poll:
                    self.next_transcript_poll = monotonic() + TRANSCRIPT_POLL_SECONDS
                    self._record_transcript_activity()
                if monotonic() >= self.next_debug_bound:
                    self.next_debug_bound = monotonic() + 5
                    self._bound_debug_log()
                if child_exited:
                    master_open = self._read_master()
                    if not master_open:
                        break
                timeout = 1.0
                if self.timer_deadline is not None:
                    timeout = max(0.0, min(timeout, self.timer_deadline - now()))
                if self.transcript_quiescence_deadline is not None:
                    timeout = max(
                        0.0,
                        min(timeout, self.transcript_quiescence_deadline - now()),
                    )
                if self.development_channel_accept_deadline is not None:
                    timeout = max(
                        0.0,
                        min(
                            timeout,
                            self.development_channel_accept_deadline - monotonic(),
                        ),
                    )
                timeout = min(timeout, max(0.0, self.next_transcript_poll - monotonic()))
                next_preservation_poll = self.preservation_federation.next_poll
                if next_preservation_poll is not None:
                    timeout = min(timeout, max(0.0, next_preservation_poll - monotonic()))
                if self.preservation_federation.bridge_thread is not None:
                    # Bounded wake strategy for result reaping.  The owner
                    # loop still sleeps while the worker is in flight, and
                    # all state/control mutations happen after reaping here.
                    timeout = min(timeout, PRESERVATION_IN_FLIGHT_WAKE_SECONDS)
                self._ensure_control_socket()
                events = self.selector.select(timeout)
                for key, _mask in events:
                    if key.data == "server":
                        try:
                            connection, _ = self.socket.accept()
                            self._serve_one(connection)
                        except BlockingIOError:
                            pass
                    elif key.data == "master":
                        master_open = self._read_master()
                    elif key.data == "stdin":
                        self._read_stdin()
                    elif key.data == "inotify":
                        self._handle_inotify()
                if self.shutdown_requested and self.pid and child_alive(self.pid):
                    self._forward_signal(signal.SIGHUP, None)
            self._child_has_exited()
            if self.child_status is None and self.pid:
                try:
                    _, self.child_status = os.waitpid(self.pid, 0)
                except ChildProcessError:
                    self.child_status = 1 << 8
            return os.waitstatus_to_exitcode(self.child_status or 0)
        finally:
            self._cleanup_terminal_modes()
            self._restore_terminal()
            self.cleanup()

    def cleanup(self) -> None:
        """Close PTY/IPC resources and remove only this session's runtime directory."""
        self.herdr.release()
        try:
            self.selector.close()
        except Exception:
            pass
        if self.inotify:
            self.inotify.close()
            self.inotify = None
        if self.master_fd is not None:
            try:
                os.close(self.master_fd)
            except OSError:
                pass
            self.master_fd = None
        try:
            self.socket.close()
        except OSError:
            pass
        self._record_last_session("supervisor-exit")
        try:
            shutil.rmtree(self.session_dir)
        except OSError:
            pass


def control_socket(channel: str) -> pathlib.Path:
    """Return a validated session control socket path."""
    if not CHANNEL_RE.fullmatch(channel):
        raise RuntimeError("invalid Claude idle-compaction channel")
    return runtime_root() / channel / "control.sock"


def send_control(channel: str, command: str, **fields: object) -> dict:
    """Send one safe control command to a supervised session."""
    path = control_socket(channel)
    message = {"kind": "control", "channel": channel, "command": command, **fields}
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        connection.settimeout(2.0)
        connection.connect(str(path))
        connection.sendall((json.dumps(message, separators=(",", ":")) + "\n").encode())
        data = connection.recv(65536)
        return json.loads(data.decode("utf-8"))
    finally:
        connection.close()


def list_sessions() -> int:
    """List live or stale supervised session state without prompt contents."""
    root = runtime_root()
    found = False
    for state_path in sorted(root.glob("claude-*/state.json")):
        found = True
        try:
            state = json.loads(state_path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        state["live"] = child_alive(state.get("pid"))
        print(json.dumps(state, sort_keys=True))
        if state["live"] and state.get("lifecycle_health") == "missing":
            print(f"WARNING {state.get('channel')}: no lifecycle hook event since launch; "
                  "claude-hook-idle-event is not wired, idle compaction cannot run", file=sys.stderr)
    if not found:
        print("no supervised Claude sessions")
    return 0


def control_main(argv: list[str]) -> int:
    """Implement claude-warmctl controls."""
    if not argv or argv[0] in {"-h", "--help"}:
        print("usage: claude-warmctl list | show CHANNEL | enable CHANNEL | disable CHANNEL")
        print("       claude-warmctl profile CHANNEL long|short|auto")
        print("       claude-warmctl cancel CHANNEL | trigger CHANNEL")
        print("       claude-warmctl inject CHANNEL /compact|/reload-plugins|/mcp reconnect SERVER")
        print("       claude-warmctl preserve CHANNEL REQUEST RESERVATION SESSION PID EPOCH")
        return 0
    command = argv[0]
    if command == "list":
        return list_sessions()
    if command not in CONTROL_COMMANDS:
        print(f"unknown control command: {command}", file=sys.stderr)
        return 2
    if len(argv) < 2:
        print(f"{command} requires CHANNEL", file=sys.stderr)
        return 2
    channel = argv[1]
    fields = {"profile": argv[2]} if command == "profile" and len(argv) >= 3 else {}
    if command == "profile" and not fields:
        print("profile requires long, short, or auto", file=sys.stderr)
        return 2
    if command == "inject":
        if len(argv) < 3:
            print("inject requires a whitelisted command", file=sys.stderr)
            return 2
        fields = {"text": " ".join(argv[2:])}
    if command == "preserve":
        if len(argv) != 7:
            print("preserve requires CHANNEL REQUEST RESERVATION SESSION PID EPOCH", file=sys.stderr)
            return 2
        try:
            expected_supervisor_pid = int(argv[5])
            expected_epoch = int(argv[6])
        except ValueError:
            print("preserve PID and EPOCH must be integers", file=sys.stderr)
            return 2
        fields = {
            "request_id": argv[2], "reservation_id": argv[3],
            "expected_session_id": argv[4],
            "expected_supervisor_pid": expected_supervisor_pid,
            "expected_epoch": expected_epoch,
        }
    try:
        response = send_control(channel, "state" if command == "show" else command, **fields)
    except (OSError, RuntimeError, ValueError) as error:
        print(f"control failed: {error}", file=sys.stderr)
        return 1
    print(json.dumps(response, indent=2, sort_keys=True))
    return 0 if response.get("ok") else 1


def main(argv: list[str]) -> int:
    """Launch Claude or dispatch a control command."""
    if argv and argv[0] == "--control":
        return control_main(argv[1:])
    if argv and argv[0] in {"-h", "--help"}:
        print("usage: claude-warm [CLAUDE OPTIONS...]", file=sys.stdout)
        print("Runs the real Claude CLI through a full PTY supervisor.")
        print("Environment: CLAUDE_IDLE_CACHE_PROFILE, CLAUDE_IDLE_COMPACTION_DEBUG,")
        print("CLAUDE_IDLE_COMPACT_SECONDS, CLAUDE_SHORT_CACHE_IDLE_COMPACT_SECONDS,")
        print("CLAUDE_IDLE_COMPACT_MIN_TOKENS, CLAUDE_IDLE_COMPACT_STATUS_STOP_SKEW_SECONDS,")
        print("CLAUDE_IDLE_COMPACT_RETRY_SECONDS, CLAUDE_IDLE_COMPACT_TIMEOUT_SECONDS,")
        print("CLAUDE_IDLE_COMPACT_TRANSCRIPT_QUIESCENCE_SECONDS,")
        print("CLAUDE_IDLE_INPUT_ESCAPE_TIMEOUT_SECONDS,")
        print("CLAUDE_IDLE_WATCHED_SERVERS, CLAUDE_IDLE_RECONNECT_SERVER,")
        print("CLAUDE_IDLE_CHANNEL_ATTACH_WAIT_SECONDS, CLAUDE_IDLE_CHANNEL_RECOVERY_COOLDOWN_SECONDS")
        print("CLAUDE_WARM_ACCEPT_DEV_CHANNELS,")
        print("CLAUDE_WARM_DEV_CHANNEL_ACCEPT_WINDOW_SECONDS")
        print("CLAUDE_WARM_HERDR_AGENT, CLAUDE_WARM_HERDR_HEARTBEAT_SECONDS,")
        print("CLAUDE_WARM_HERDR_REGISTRATION_TTL_MS")
        print("CLAUDE_WARM_PRESERVATION_* (all bindings are required; unset is inert)")
        print("Use claude-warmctl for per-session state and controls.")
        return 0
    try:
        supervisor = Supervisor(argv, resolve_claude())
        return supervisor.run()
    except (OSError, RuntimeError) as error:
        print(f"claude-warm: {error}", file=sys.stderr)
        return 69


def shell_exit_code(status: int) -> int:
    """Represent a child signal termination with the conventional 128+N code."""
    return 128 - status if status < 0 else status


if __name__ == "__main__":
    raise SystemExit(shell_exit_code(main(sys.argv[1:])))
