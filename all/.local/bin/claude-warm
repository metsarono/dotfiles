)
INPUT_ESCAPE_TIMEOUT_SECONDS = env_float(
    "CLAUDE_IDLE_INPUT_ESCAPE_TIMEOUT_SECONDS", 0.05, 0.01
)
CHANNEL_ATTACH_WAIT_SECONDS = env_int(
    "CLAUDE_IDLE_CHANNEL_ATTACH_WAIT_SECONDS", 30, 0
)
# A supervised session proves its lifecycle hooks are wired by sending any
# event (SessionStart fires at launch).  None inside this window means the
# idle timer can never arm: record it loudly (2026-09-30: Honey's Telegram
# bots ran for days at status "starting", never compacting, hooks unwired).
LIFECYCLE_WAIT_SECONDS = env_int(
