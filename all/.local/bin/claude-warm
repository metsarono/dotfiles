        # Left unknown they set the transcript-uncertain gate after every
        # turn, which vetoes each armed idle compaction at fire time (the
        # 2026-08-20 overnight no-compact hunt).
        "atis-latch",
        "file-history-delta",
        # frame-link joined the same bookkeeping family in 2.1.236 (first seen
        # 2026-08-29 on Fable's channel: 216 unknown-record latches, 555
        # gate-refused cycles, two no-compact nights before diagnosis).
        "frame-link",
        # Claude's own remote-bridge metadata record (bridgeSessionId/owner
        # UUIDs) — session plumbing, not conversation content.
        "bridge-session",
        "summary",
        "recap",
    }
)
COMPACTION_FAILURE_MARKER = "not enough messages"

def env_int(name: str, default: int, minimum: int = 0) -> int:
    """Read a bounded integer configuration value from the environment."""
    try:
        return max(minimum, int(os.environ.get(name, str(default))))
    except ValueError:
        return default


def env_float(name: str, default: float, minimum: float = 0.0) -> float:
    """Read a bounded floating-point configuration value from the environment."""
    try:
        return max(minimum, float(os.environ.get(name, str(default))))
    except ValueError:
        return default


