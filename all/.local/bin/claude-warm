# must never turn the owner loop into a zero-timeout poller.  This cap is only
# a wake bound; it is not a second preservation deadline.
PRESERVATION_IN_FLIGHT_WAKE_SECONDS = 0.25


def channel_arguments(argv: list[str]) -> list[str]:
    """Return channel specifications without changing the child argv."""
    specifications: list[str] = []
    index = 0
    while index < len(argv):
        argument = argv[index]
        if argument.startswith("--channels="):
            specifications.extend(
                value for value in argument.split("=", 1)[1].split(",") if value
            )
        elif argument == "--channels":
            index += 1
            while index < len(argv) and not argv[index].startswith("-"):
                specifications.extend(value for value in argv[index].split(",") if value)
                index += 1
            continue
        index += 1
    return specifications


def accepted_development_channels() -> tuple[str, ...]:
    """Return the exact, validated startup-confirmation opt-in entries."""
    configured = os.environ.get("CLAUDE_WARM_ACCEPT_DEV_CHANNELS", "")
    if not configured:
        return ()
    entries = [entry.strip() for entry in configured.split(",")]
    if not entries or any(
        not entry or DEVELOPMENT_CHANNEL_ENTRY_RE.fullmatch(entry) is None
        for entry in entries
    ):
        return ()
    return tuple(dict.fromkeys(entries))


def watched_server_names(argv: list[str]) -> tuple[str, ...]:
    """Derive safe attachment names from --channels or an explicit override."""
    override = os.environ.get("CLAUDE_IDLE_WATCHED_SERVERS", "")
    if override:
        candidates = [value.strip() for value in override.split(",") if value.strip()]
    else:
        candidates = []
        for specification in channel_arguments(argv):
            base = specification.split("@", 1)[0]
            if not base:
                continue
            candidates.append(base)
            parts = [part for part in base.split(":") if part]
            if len(parts) >= 2:
                # Claude's plugin attachment names are derived from the
                # channel namespace and plugin name.  Keep both observed
                # spellings available without hard-coding a provider.
                candidates.append(base + ":" + parts[-1])
                candidates.append(base.replace(":", "_") + "_" + parts[-1])
    return tuple(sorted({value for value in candidates if re.fullmatch(r"[A-Za-z0-9_.:-]{1,160}", value)}))


def validate_inject_command(
    command: object,
    watched: tuple[str, ...],
    reconnect_command: str | None,
) -> bool:
    """Allow only fixed governor commands and the session's watched reconnect."""
    if not isinstance(command, str) or len(command) > 256:
        return False
    if command in {"/compact", "/reload-plugins"}:
        return True
    if command == reconnect_command:
        return True
    match = INJECT_RE.fullmatch(command)
    return bool(match and match.group(1) in watched)


def channel_process_patterns() -> tuple[str, ...]:
    """Return safe process-name fragments used for launch-time attachment checks."""
    configured = os.environ.get("CLAUDE_IDLE_CHANNEL_PROCESS_PATTERNS", "")
    values = [value.strip() for value in configured.split(",") if value.strip()]
    return tuple(values or ["server.ts"])


def persistent_state_root() -> pathlib.Path:
    """Return the private, durable state root for post-mortem guard logs."""
    base = os.environ.get("XDG_STATE_HOME") or str(pathlib.Path.home() / ".local/state")
    root = pathlib.Path(base) / "claude-idle-compaction"
    safe_mkdir(root)
    return root


def proc_children(pid: int) -> list[int]:
    """Read one Linux process's direct children without invoking a scanner."""
    try:
        value = pathlib.Path(f"/proc/{pid}/task/{pid}/children").read_text()
    except OSError:
        return []
    return [int(child) for child in value.split() if child.isdigit()]


def process_command_line(pid: int) -> str:
    """Read a process command line for a local, non-secret attach check."""
    try:
        raw = pathlib.Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return ""
    return raw.replace(b"\0", b" ").decode("utf-8", "replace")


def expected_completion_transcript_entry(entry: dict) -> bool:
    """Ignore Claude's normal Stop bookkeeping when tailing the transcript."""
    return (
        (
            entry.get("type") == "system"
            and entry.get("subtype") in EXPECTED_COMPLETION_SYSTEM_SUBTYPES
        )
        or entry.get("type") in EXPECTED_COMPLETION_TRANSCRIPT_TYPES
    )


def transcript_entry_classification(entry: object) -> str:
    """Classify one JSONL record without retaining or exposing its contents."""
    if not isinstance(entry, dict):
        return "unknown"
    entry_type = entry.get("type")
    if entry_type == "user":
        if entry.get("isMeta") is True or entry.get("isSidechain") is True:
            return "internal-user-metadata"
        return "user-turn"
    if entry_type == "assistant":
        return "assistant-output"
    if entry_type == "attachment":
        return "internal-attachment"
    if isinstance(entry_type, str) and entry_type in TRANSCRIPT_INTERNAL_TYPES:
        return "internal-" + str(entry_type).replace("_", "-")
    if entry_type == "system":
        subtype = entry.get("subtype")
        if isinstance(subtype, str) and subtype in EXPECTED_COMPLETION_SYSTEM_SUBTYPES:
            return "internal-recap" if subtype == "away_summary" else "internal-completion"
        if isinstance(subtype, str) and subtype in TRANSCRIPT_INTERNAL_SYSTEM_SUBTYPES:
            return "internal-system"
        return "unknown"
    return "unknown"


def transcript_entry_timestamp(entry: dict) -> float | None:
    """Return an installed Claude JSONL timestamp without retaining content."""
    value = entry.get("timestamp")
    if not isinstance(value, str) or not value:
        return None
    try:
        return datetime.datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


IDLE_SECONDS = {
    "long": env_int("CLAUDE_IDLE_COMPACT_SECONDS", 55 * 60),
    "short": env_int("CLAUDE_SHORT_CACHE_IDLE_COMPACT_SECONDS", 4 * 60),
}
TTL_SECONDS = {
    "long": env_int("CLAUDE_IDLE_COMPACT_LONG_CACHE_TTL_SECONDS", 60 * 60),
    "short": env_int("CLAUDE_IDLE_COMPACT_SHORT_CACHE_TTL_SECONDS", 5 * 60),
}


def validated_cache_decision(decision: object, provider: str, endpoint: str,
                             model: str, allow_observed: bool = False) -> dict:
    """Accept only the resolver's exact identity and ordered integer window."""
    if not isinstance(decision, dict):
        raise ValueError("cache-policy-not-object")
    mode, confidence = decision.get("mode"), decision.get("confidence")
    if mode == "fallback" and confidence == "fallback":
        # The caller owns fallback timing; stdout cannot redefine its profile.
        return decision
    if not (mode == "measured" and confidence == "supported" or
            allow_observed and mode == "observed" and confidence == "observed"):
        raise ValueError("cache-policy-confidence-invalid")
    def canonical(value: str) -> str:
        return value.strip().lower().replace("_", "-")
    expected_provider = canonical(provider)
    expected_provider = {"openai-codex": "openai",
                         "openai-codex-oauth": "openai"}.get(expected_provider, expected_provider)
    expected_endpoint = canonical(endpoint)
    if expected_provider == "openai" and expected_endpoint in {"openai", "openai-codex", "openai-codex-oauth"}:
        expected_endpoint = "openai-codex-oauth"
    expected_model = canonical(model)
    if expected_provider == "anthropic":
        expected_model = re.sub(r"-+", "-", re.sub(r"[ .]+", "-", expected_model)).strip("-")
        if not expected_model.startswith("claude-"):
            expected_model = "claude-" + expected_model
    for key, expected in (("provider", expected_provider), ("endpoint_id", expected_endpoint), ("model", expected_model)):
        if decision.get(key) != expected:
            raise ValueError("cache-policy-identity-mismatch")
    compact, expiry = decision.get("compact_before_seconds"), decision.get("cache_expires_seconds")
    if (type(compact) is not int or type(expiry) is not int or
            not 0 < compact < expiry or expiry > 2**31 - 1):
        raise ValueError("cache-policy-window-invalid")
    return decision


def measured_cache_window(model: str | None, profile: str) -> tuple[int, int, dict]:
    fallback_idle = IDLE_SECONDS[profile]
    fallback_ttl = TTL_SECONDS[profile]
    if not model:
        return fallback_idle, fallback_ttl, {"mode": "fallback", "reason": "model-unknown"}
    if any(os.environ.get(name) for name in (
        "ANTHROPIC_BASE_URL", "ANTHROPIC_BEDROCK_BASE_URL",
        "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY",
    )):
        return fallback_idle, fallback_ttl, {"mode": "fallback", "reason": "endpoint-unknown"}
    helper = pathlib.Path(os.environ.get(
        "FLEET_CACHE_POLICY_HELPER", str(pathlib.Path.home() / "HelmCortex/FORGE/bin/cache-policy")
    )).expanduser()
    policy = pathlib.Path(os.environ.get(
        "FLEET_CACHE_POLICY_PATH",
        str(pathlib.Path.home() / "HelmCortex/ROOTS/DotRoot/agent-session/centre/data/cache-policy.json"),
    )).expanduser()
    try:
        completed = subprocess.run(
            [str(helper), "resolve", "--policy", str(policy), "--harness", "claude",
             "--provider", "anthropic", "--endpoint", "anthropic-default",
             "--model", model, "--fallback-compact", str(fallback_idle),
             "--fallback-cache", str(fallback_ttl)],
            capture_output=True, text=True, timeout=5, check=True,
        )
        decision = validated_cache_decision(json.loads(completed.stdout), "anthropic", "anthropic-default", model)
        if decision["mode"] == "fallback":
            return fallback_idle, fallback_ttl, decision
        return decision["compact_before_seconds"], decision["cache_expires_seconds"], decision
    except (OSError, TypeError, ValueError, KeyError, OverflowError, subprocess.SubprocessError):
        return fallback_idle, fallback_ttl, {"mode": "fallback", "reason": "resolver-error"}
MIN_TOKENS = env_int("CLAUDE_IDLE_COMPACT_MIN_TOKENS", 70000)
# An unknown transcript record fails closed (transcript-uncertain), but the
# uncertainty must be a bounded caution, never a permanent veto: with the
# latch unexpired and hook Stops not arriving (dead control socket,
# 2026-08-30), one unknown record silenced compaction for two nights.  After
# this many seconds without cancellation evidence the gate self-heals and
# logs transcript-gate-expired.
TRANSCRIPT_GATE_MAX_SECONDS = env_int("CLAUDE_IDLE_TRANSCRIPT_GATE_MAX_SECONDS", 60 * 60, 60)
COMPACT_RETRY_SECONDS = env_int("CLAUDE_IDLE_COMPACT_RETRY_SECONDS", 5 * 60, 1)
COMPACT_TIMEOUT_SECONDS = env_int("CLAUDE_IDLE_COMPACT_TIMEOUT_SECONDS", 15 * 60, 1)
PTY_CHECK_ATTEMPTS = 3
PTY_CHECK_RETRY_SECONDS = 0.05
# Gate refusals that cannot clear without a new Stop, a control command, or
# a token-count change.  Every other refusal is transient (a PTY probe
# hiccup, activity that simply moved the idle window, a stale snapshot) and
# re-arms the timer instead of leaving the governor dormant.
DORMANT_GATE_REASONS = frozenset(
    {
        "session-disabled",
        "session-not-running",
        "already-compacting",
        "session-unbound",
        "no-normal-stop",
        "clean",
        "channel-recovery-pending",
        "below-token-threshold",
        "stale-timer",
        "inject-command-refused",
        "unknown-injection-purpose",
    }
)
