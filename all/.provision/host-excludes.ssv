# Flatpak GUI apps dropped on headless kikin to reclaim their old runtimes (Mètsàtron 2026-10-22).
# Kept in the global manifest for machines that use them; only kikin excludes them.
kikin-kushi flatpak org.wezfurlong.wezterm "terminal kept on other machines; frees freedesktop 23.08 here"
kikin-kushi flatpak com.mikeasoft.pied "voice-model GUI not used on kikin; frees freedesktop 24.08 here"
kikin-kushi flatpak com.snes9x.Snes9x "Redstone NT is kikin-only; SNES emu dropped here; frees freedesktop 24.08"
# GUI/gaming flatpaks in the global manifest that headless kikin never had installed — excluded so
# flatpak-apply reconciles cleanly instead of installing them (drift fix, Mètsàtron 2026-10-22). The
# gaming set (PCSX2/RPCS3/DuckStation/PPSSPP/Moonlight/pupgui2) is not installed; this declares intent
# and can be re-added deliberately if kikin ever carries that sanctuary with disk headroom.
kikin-kushi flatpak app.zen_browser.zen "headless: GUI browser"
kikin-kushi flatpak cc.arduino.IDE2 "headless: GUI IDE"
kikin-kushi flatpak com.discordapp.Discord "headless: GUI chat"
kikin-kushi flatpak com.leinardi.gwe "headless: NVIDIA GPU GUI, no such GPU on kikin"
kikin-kushi flatpak com.logseq.Logseq "headless: note GUI"
kikin-kushi flatpak com.moonlight_stream.Moonlight "headless: game-streaming GUI client"
kikin-kushi flatpak io.github.dgsasha.Remembrance "headless: reminders GUI"
kikin-kushi flatpak io.github.josephmawa.Bella "headless: GUI app"
kikin-kushi flatpak io.github.qwersyk.Newelle "headless: GUI assistant"
kikin-kushi flatpak io.github.webcamoid.Webcamoid "headless: webcam GUI"
kikin-kushi flatpak me.mitya57.ReText "headless: markdown editor GUI"
kikin-kushi flatpak net.davidotek.pupgui2 "headless: Proton/Wine GUI manager (gaming)"
kikin-kushi flatpak net.pcsx2.PCSX2 "headless: PS2 emulator (Redstone NT gaming; re-add deliberately)"
kikin-kushi flatpak net.rpcs3.RPCS3 "headless: PS3 emulator (Redstone NT gaming; re-add deliberately)"
kikin-kushi flatpak net.xmind.XMind "headless: mind-map GUI"
kikin-kushi flatpak one.ablaze.floorp "headless: GUI browser"
kikin-kushi flatpak org.duckstation.DuckStation "headless: PS1 emulator (Redstone NT gaming; re-add deliberately)"
kikin-kushi flatpak org.ppsspp.PPSSPP "headless: PSP emulator (Redstone NT gaming; re-add deliberately)"
kikin-kushi flatpak org.zotero.Zotero "headless: reference manager GUI"
kikin-kushi flatpak us.zoom.Zoom "headless: video-conferencing GUI"
# host-desktop build toolchains — inert on headless kikin (no host xfce4-panel, no host dock).
# ONLY the panel/plank-SPECIFIC dev headers are excluded; the general build tools in the same
# manifest groups (valac, meson, ninja-build, libx11-dev, python3-pil, libxi-dev, libxfixes-dev)
# stay because kikin builds other things with them (WezTerm, Cargo, cmake projects).
# Group A — native libxfce4panel Vala plugin (SonicDE windowck caption/global-menu):
kikin-kushi nala libxfce4panel-2.0-dev "headless: no host panel; panel-plugin build header"
kikin-kushi nala libxfce4ui-2-dev "headless: no host panel; panel-plugin build header"
kikin-kushi nala libwnck-3-dev "headless: no host panel/dock; wnck build header"
# Group B — Plank Reloaded dock (built from the pinned GitHub fork). bamfdaemon is
# excluded too (Mètsàtron 2026-09-11): the distro `plank` package was installed on
# kikin against manifest intent (the fork is meant to be plank's sole provider) and
# depends on bamfdaemon, so excluding it clears distro plank + libplank1 on the
# headless box where no dock runs anyway.
kikin-kushi nala libgee-0.8-dev "headless: no host dock; plank build dep"
kikin-kushi nala libgnome-menu-3-dev "headless: no host dock; plank build dep"
kikin-kushi nala libbamf3-dev "headless: no host dock; plank build dep"
kikin-kushi nala bamfdaemon "headless: no host dock; clears distro plank drift (Mètsàtron 2026-09-11)"
kikin-kushi nala libxml2-utils "headless: no host dock; plank build dep (xmllint)"
kikin-kushi nala libdbusmenu-gtk3-dev "headless: no host dock; plank build dep"
# Honey (hostname beelink) carries the headless trait in the stow lanes: no icon
# or GTK themes, no desktop/WM config, no Obsidian stub (see "Stow lanes").
beelink stow .icons "headless: cursor and icon themes (icons-home-sync)"
beelink stow .local/share/icons "headless: icon themes (icons-home-sync)"
beelink stow .themes "headless: GTK and WM themes (icons-home-sync)"
beelink stow .local/share/themes "headless: GTK themes (icons-home-sync)"
beelink stow-hook icons-home-sync "headless: no icon or theme roots to sync"
beelink stow .config/bspwm "headless: no window manager"
beelink stow .config/sxhkd "headless: no hotkey daemon"
beelink stow .config/kitty "headless: no GUI terminal"
beelink stow .config/rofi "headless: no launcher"
beelink stow .config/Thunar "headless: no file manager"
beelink stow .config/GTKmenu "headless: the bspwm GTK menu"
beelink stow .config/environment.d "headless: graphical-session env (GTK appmenu, flatpak exports)"
beelink stow .xsessionrc.d "headless: X login hooks"
beelink stow .face "headless: display-manager avatar"
beelink stow .gimp-2.8 "headless: GIMP config"
beelink stow HelmCortex "headless: all/HelmCortex holds only the vault's .obsidian stub; no vault on this host"
beelink stow .config/awesome "headless: no window manager"
beelink stow .config/i3 "headless: no window manager"
beelink stow .config/xfce4 "headless: no XFCE panel"
beelink stow .config/autostart "headless: XDG autostart runs only in a graphical session"
beelink stow .config/Kvantum "headless: Qt widget themes"
beelink stow .config/qt5ct "headless: Qt5 appearance"
beelink stow .config/VSCodium "headless: GUI editor settings"
beelink stow .conky "headless: desktop monitor widgets"
beelink stow .icewm "headless: no window manager"
beelink stow .picom.conf "headless: no compositor"
