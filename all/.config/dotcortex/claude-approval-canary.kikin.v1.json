{
  "schema": "hc.approval.canary.kikin.manifest.v1",
  "manifest_version": "claude-approval-canary.kikin.v2",
  "hard_floor_ids": [
    "floor.kikin-protected-target.v1",
    "floor.kikin-private-log.v1",
    "floor.kikin-palmcortex.v1",
    "floor.kikin-remote.v1",
    "floor.kikin-service-control.v1",
    "floor.kikin-package-install.v1",
    "floor.kikin-writer-option.v1"
  ],
  "decider": {
    "enabled": false,
    "honey_url": null,
    "kikin_url": "http://YOUR_DECIDER_HOST/v1/systemone",
    "timeout_ms": 2200,
    "min_allow_confidence": 0.95,
    "questions": "single"
  },
  "roots": [
    "/home/YOUR_USER/HelmCortex",
    "/home/YOUR_USER/mnt/x230/HelmCortex",
    "/home/YOUR_USER/HelmCortex-wt-kikin",
    "/home/YOUR_USER/mnt/x230/HelmCortex-wt-kikin",
    "/home/YOUR_USER/DotCortex",
    "/home/YOUR_USER/mnt/x230/DotCortex",
    "/home/YOUR_USER/DotCortex-wt-kikin",
    "/home/YOUR_USER/mnt/x230/DotCortex-wt-kikin"
  ],
  "scratch_roots": [
    "/tmp",
    "/home/YOUR_USER/.claude/scratchpad"
  ],
  "classes": [
    {
      "name": "local_read",
      "enabled": false,
      "tool_names": [
        "Read",
        "Glob",
        "Grep"
      ],
      "bash_verbs": [
        "cat",
        "head",
        "tail",
        "grep",
        "rg",
        "ls",
        "stat",
        "wc",
        "find",
        "sed",
        "ps",
        "pgrep",
        "uptime",
        "df",
        "free",
        "tmux",
        "python",
        "python3"
      ]
    },
    {
      "name": "git_observe",
      "enabled": false,
      "subcommands": [
        "status",
        "log",
        "diff",
        "show",
        "merge-base",
        "branch"
      ]
    },
    {
      "name": "centre_render",
      "enabled": false,
      "commands": [
        "pokemon-centre render",
        "FORGE/bin/pokemon-centre render",
        "/usr/bin/python3 FORGE/bin/pokemon-centre render",
        "clubhouse-bosses-refresh",
        "FORGE/bin/clubhouse-bosses-refresh"
      ]
    },
    {
      "name": "safe_commit",
      "enabled": false,
      "commands": [
        "git commit",
        "dotcortex-safe-commit"
      ]
    },
    {
      "name": "ssh_readonly",
      "enabled": true,
      "readonly_hosts": [
        {
          "host": "YOUR_HONEY_HOST",
          "remote_home": "/home/YOUR_HONEY_USER",
          "remote_path_roots": [
            "/home/YOUR_HONEY_USER/DotCortex",
            "/home/YOUR_HONEY_USER/HelmCortex",
            "/home/YOUR_AGENT_CLAUDE",
            "/var/tmp",
            "/etc/init.d",
            "/var/log"
          ],
          "allowed_sudo_targets": [
            "YOUR_AGENT_CLAUDE"
          ]
        }
      ]
    }
  ],
  "unattended": {
    "enabled": false,
    "away_flag": "~/.config/dotcortex/approval-away",
    "presence_file": "~/.local/state/dotcortex/admiral-last-seen",
    "presence_window_minutes": 10,
    "hold_timeout_minutes": 10,
    "admiral_telegram_user_id": "YOUR_ADMIRAL_USER_ID",
    "desk_approval_window_hours": 24,
    "quiet_hours": {
      "enabled": true,
      "start": "23:00",
      "end": "08:00",
      "timezone": "Australia/Melbourne"
    }
  },
  "coordinator_ops": {
    "classes": {
      "mail_send": false,
      "worktree": false,
      "integrate": false,
      "commit": false,
      "codex_dispatch": false,
      "scratch_scp": false
    },
    "seat_account": "YOUR_SEAT@YOUR_HOST.helm",
    "repo_roots": [
      "/home/YOUR_USER/DotCortex"
    ],
    "worktree_roots": [
      "/home/YOUR_USER/DotCortex-wt-YOUR_HOST"
    ],
    "scratch_roots": [
      "/tmp",
      "/home/YOUR_USER/.claude/scratchpad"
    ],
    "build_host": "YOUR_BUILD_HOST",
    "remote_scratch_roots": [
      "/tmp/YOUR_SEAT"
    ],
    "remote_scratch_prefixes": [
      "YOUR_SEAT-"
    ]
  },
  "gate_inversion": {
    "enabled": true,
    "present_refusal": "ask"
  },
  "notifications": {
    "argv": [
      "/home/YOUR_SEAT/.local/bin/approval-telegram-notify"
    ]
  }
}
