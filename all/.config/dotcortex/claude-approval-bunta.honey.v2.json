{
  "schema": "hc.approval.canary.kikin.manifest.v1",
  "manifest_version": "claude-approval-canary.kikin.v2",
  "hard_floor_ids": [
    "floor.kikin-protected-target.v1",
    "floor.kikin-private-log.v1",
    "floor.kikin-palmcortex.v1",
    "floor.kikin-remote.v1",
    "floor.kikin-service-control.v1",
    "floor.kikin-package-install.v1",
    "floor.kikin-writer-option.v1"
  ],
  "decider": {
    "enabled": true,
    "honey_url": "http://YOUR_HONEY_HOST/decide",
    "honey_api": "r2d2d",
    "kikin_url": "http://YOUR_DECIDER_HOST/v1/systemone",
    "timeout_ms": 2200,
    "min_allow_confidence": 0.95,
    "questions": "single"
  },
  "roots": [
    "/home/YOUR_AGENT_CLAUDE/DotCortex",
    "/home/YOUR_AGENT_CLAUDE/honey-work",
    "/var/tmp",
    "/home/YOUR_AGENT_CLAUDE/DotCortex-wt-YOUR_HOST"
  ],
  "scratch_roots": [
    "/var/tmp"
  ],
  "classes": [
    {
      "name": "local_read",
      "enabled": true,
      "tool_names": [
        "Read",
        "Glob",
        "Grep"
      ],
      "bash_verbs": [
        "cat",
        "head",
        "tail",
        "grep",
        "rg",
        "ls",
        "stat",
        "wc",
        "find",
        "sed",
        "ps",
        "pgrep",
        "uptime",
        "df",
        "free",
        "tmux",
        "python",
        "python3"
      ]
    },
    {
      "name": "git_observe",
      "enabled": true,
      "subcommands": [
        "status",
        "log",
        "diff",
        "show",
        "branch"
      ]
    },
    {
      "name": "centre_render",
      "enabled": true,
      "commands": [
        "pokemon-centre render"
      ]
    },
    {
      "name": "safe_commit",
      "enabled": true,
      "commands": [
        "git commit",
        "dotcortex-safe-commit"
      ]
    },
    {
      "name": "ssh_readonly",
      "enabled": true,
      "readonly_host": "YOUR_READONLY_HOST",
      "remote_home": "/home/YOUR_REMOTE_USER",
      "remote_path_roots": [
        "/home/YOUR_REMOTE_USER/HelmCortex"
      ],
      "mailcortex_account": "YOUR_AGENT@YOUR_READONLY_HOST"
    },
    {
      "name": "local_test_run",
      "enabled": false,
      "local_test_roots": [
        "/home/YOUR_AGENT_CLAUDE/DotCortex",
        "/home/YOUR_AGENT_CLAUDE/honey-work"
      ]
    },
    {
      "name": "outbound_tool",
      "enabled": false,
      "tool_names": []
    }
  ],
  "unattended": {
    "enabled": false,
    "away_flag": "~/.config/dotcortex/approval-away",
    "quiet_hours": {
      "enabled": true,
      "start": "23:00",
      "end": "08:00",
      "timezone": "Australia/Melbourne"
    }
  },
  "coordinator_ops": {
    "classes": {
      "mail_send": false,
      "worktree": false,
      "integrate": false,
      "commit": false,
      "codex_dispatch": false,
      "scratch_scp": false
    },
    "seat_account": "YOUR_SEAT@YOUR_HOST.helm",
    "repo_roots": [
      "/home/YOUR_AGENT_CLAUDE/DotCortex"
    ],
    "worktree_roots": [
      "/home/YOUR_AGENT_CLAUDE/DotCortex-wt-YOUR_HOST"
    ],
    "scratch_roots": [
      "/tmp",
      "/home/YOUR_AGENT_CLAUDE/.claude/scratchpad"
    ],
    "build_host": "YOUR_BUILD_HOST",
    "remote_scratch_roots": [
      "/tmp/YOUR_SEAT"
    ],
    "remote_scratch_prefixes": [
      "YOUR_SEAT-"
    ]
  },
  "gate_inversion": {
    "enabled": true
  },
  "notifications": {
    "argv": [
      "/home/YOUR_SEAT/.local/bin/approval-telegram-notify"
    ]
  }
}
