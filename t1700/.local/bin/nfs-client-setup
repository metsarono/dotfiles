#!/usr/bin/env bash
# Setup script: nfs-client-setup
# Run on T1700 after =tangle-one nfs.org && loom stow:t1700=.
# Safe to re-run when servers relocate or fleet membership changes.


# [[file:../../../nfs.org::*Setup script: nfs-client-setup][Setup script: nfs-client-setup:1]]
set -euo pipefail

CONF="${HOME}/.local/share/dotcortex/nfs"
NFS_ENV="${CONF}/nfs.env"
HOSTS_FRAG="${CONF}/hosts-nfs.conf"
AUTOFS_MASTER="${CONF}/nfs-direct.autofs"
AUTOFS_DIRECT="${CONF}/auto.direct"
MARKER_START="# BEGIN DOTCORTEX-NFS"
MARKER_END="# END DOTCORTEX-NFS"

die() { printf 'nfs-client-setup: %s\n' "$*" >&2; exit 1; }

[ -f "$NFS_ENV" ] || die "missing $NFS_ENV — copy: cp ${CONF}/nfs.env.template $NFS_ENV and fill in IPs"
# shellcheck source=/dev/null
source "$NFS_ENV"

[ -f "$AUTOFS_MASTER" ] || die "missing $AUTOFS_MASTER — run: tangle-one nfs.org && loom stow:t1700"
[ -f "$AUTOFS_DIRECT" ] || die "missing $AUTOFS_DIRECT — run: tangle-one nfs.org && loom stow:t1700"

# Generate hosts fragment from env — IPs are never stored in the repo
cat > "$HOSTS_FRAG" <<EOF
# NFS servers — generated from nfs.env, do not edit manually
${X230_TS_IP}   x230
${T480S_TS_IP}   t480s
${T480_TS_IP}   t480
EOF

# Hub consumer mount — install ~/HelmCortex as a first-class NFS mount of the
# hub export instead of the legacy symlink (see §Hub consumer mount above).
HELMCORTEX_HUB="${HELMCORTEX_HUB:-}"
if [ -n "$HELMCORTEX_HUB" ]; then
  hub_ip_var="${HELMCORTEX_HUB^^}_TS_IP"
  hub_ip="${!hub_ip_var:-}"
  [ -n "$hub_ip" ] || die "HELMCORTEX_HUB=$HELMCORTEX_HUB but $hub_ip_var is not set in nfs.env"
  grep -qE "^[[:space:]]*${hub_ip}[[:space:]]+${HELMCORTEX_HUB}[[:space:]]*$" "$HOSTS_FRAG" \
    || printf '%s   %s\n' "$hub_ip" "$HELMCORTEX_HUB" >> "$HOSTS_FRAG"
  HELMCORTEX_DIRECT="$(mktemp)"
  trap 'rm -f "${HELMCORTEX_DIRECT:-}"' EXIT
  cat "$AUTOFS_DIRECT" > "$HELMCORTEX_DIRECT"
  printf '/home/metsatron/HelmCortex -fstype=nfs4,rsize=131072,wsize=131072,async,noatime,soft,timeo=10,retrans=1,intr  %s:/home/metsatron/HelmCortex\n' "$HELMCORTEX_HUB" >> "$HELMCORTEX_DIRECT"
fi

inject_block() {
  local target="$1" src="$2"
  local tmp
  tmp="$(mktemp)"
  if grep -qF "$MARKER_START" "$target" 2>/dev/null; then
    awk "/^${MARKER_START}$/{skip=1} !skip{print} /^${MARKER_END}$/{skip=0}" \
      "$target" > "$tmp"
  else
    cat "$target" > "$tmp" 2>/dev/null || true
  fi
  { printf '\n%s\n' "$MARKER_START"; cat "$src"; printf '%s\n' "$MARKER_END"; } >> "$tmp"
  sudo cp "$tmp" "$target"
  rm -f "$tmp"
}

echo "[1/6] nfs-common + autofs..."
NEED=()
dpkg -s nfs-common &>/dev/null || NEED+=(nfs-common)
dpkg -s autofs     &>/dev/null || NEED+=(autofs)
[ ${#NEED[@]} -eq 0 ] || sudo apt-get install -y "${NEED[@]}"

echo "[2/6] /etc/hosts (server aliases)..."
inject_block /etc/hosts "$HOSTS_FRAG"

echo "[3/6] /etc/auto.master.d/..."
sudo install -d -m 755 /etc/auto.master.d
sudo install -m 644 "$AUTOFS_MASTER" /etc/auto.master.d/nfs-direct.autofs

echo "[4/6] /etc/auto.direct..."
sudo touch /etc/auto.direct
if [ -n "$HELMCORTEX_HUB" ]; then
  inject_block /etc/auto.direct "$HELMCORTEX_DIRECT"
else
  inject_block /etc/auto.direct "$AUTOFS_DIRECT"
fi

echo "[5/6] mount points..."
mkdir -p "${HOME}/mnt/x230" "${HOME}/mnt/t480s" "${HOME}/mnt/t480"
if [ -n "$HELMCORTEX_HUB" ]; then
  if [ -L "${HOME}/HelmCortex" ]; then
    echo "   retiring legacy symlink: $(readlink "${HOME}/HelmCortex")"
    rm -f "${HOME}/HelmCortex"
  fi
  [ -e "${HOME}/HelmCortex" ] || mkdir -p "${HOME}/HelmCortex"
fi

echo "[6/6] autofs..."
sudo service autofs restart

echo "[+] NFS watchdog (firewall + nfs-doctor self-heal)..."
nfs-watchdog-setup || echo "WARNING: nfs-watchdog-setup failed — run it manually"

echo
echo "=== T1700 NFS client ready ==="
echo "Trigger mounts with: ls ${HOME}/mnt/x230 ${HOME}/mnt/t480s ${HOME}/mnt/t480"
# Setup script: nfs-client-setup:1 ends here
